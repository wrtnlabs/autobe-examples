  actor_type String
  
  /// Title of the article at this snapshot.
  title String
  
  /// Content of the article at this snapshot.
  content String
  
  /// When this snapshot was taken.
  created_at DateTime
  
  /// When this article was last updated at this snapshot.
  updated_at DateTime
  
  /// When this article was soft-deleted at this snapshot (null if active).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  article economic_political_discussion_board_articles @relation(fields: [economic_political_discussion_board_article_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
