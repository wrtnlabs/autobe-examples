/// Primary article content management table.
///
/// Stores the core content of articles including title, body, and metadata.
/// Each article belongs to a specific channel and section, and is created by a
/// member. Articles support soft deletion for content recovery and maintain
/// audit trail through snapshots.
///
/// Articles can have multiple tags and attachments, and are the subject of
/// comments. The table includes fields for tracking creation, modification,
/// and deletion times to support content lifecycle management.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_political_discussion_board_articles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Channel where the article is published. {@link
  /// economic_political_discussion_board_channels.id}
  economic_political_discussion_board_channel_id String
  
  /// Section within the channel where the article is categorized. {@link
  /// economic_political_discussion_board_sections.id}
  economic_political_discussion_board_section_id String
  
  /// Member who created the article. {@link
  /// economic_political_discussion_board_members.id}
  economic_political_discussion_board_member_id String
  
  /// Title of the article. Used for display in listings and search results.
  title String
  
  /// Main content of the article. Contains the detailed information and
  /// analysis.
  body String
  
  /// Timestamp when the article was created. Used for sorting and filtering.
  created_at DateTime
  
  /// Timestamp when the article was last modified. Used for tracking changes.
  updated_at DateTime
  
  /// Timestamp when the article was soft-deleted. Null if the article is
  /// active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  channel economic_political_discussion_board_channels @relation(fields: [economic_political_discussion_board_channel_id], references: [id], onDelete: Cascade)
  section economic_political_discussion_board_sections @relation(fields: [economic_political_discussion_board_section_id], references: [id], onDelete: Cascade)
  member economic_political_discussion_board_members @relation(fields: [economic_political_discussion_board_member_id], references: [id], onDelete: Cascade)
  
  economic_political_discussion_board_article_snapshots economic_political_discussion_board_article_snapshots[]
  economic_political_discussion_board_article_tags economic_political_discussion_board_article_tags[]
  economic_political_discussion_board_comments economic_political_discussion_board_comments[]
  economic_political_discussion_board_attachments economic_political_discussion_board_attachments[]
  
  // spellchecker: ignore-next-line
  @@index([economic_political_discussion_board_channel_id, created_at], map: "economic_political_discussion_board_articles_economic__def68990")
  // spellchecker: ignore-next-line
  @@index([economic_political_discussion_board_section_id, created_at], map: "economic_political_discussion_board_articles_economic__c765162a")
  // spellchecker: ignore-next-line
  @@index([economic_political_discussion_board_member_id, created_at], map: "economic_political_discussion_board_articles_economic__a34991aa")
}

/// Historical states of articles for audit trails and version control.
///
/// Stores point-in-time copies of article content to preserve historical
/// information. Each snapshot captures the complete state of an article at a
/// specific moment, including all fields from the main article table. This
/// allows for tracking changes over time and recovering previous versions if
/// needed.
///
/// Snapshots are created whenever an article is modified and are never
/// deleted or modified after creation. They provide a complete audit trail
/// of all
/// changes to articles.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_political_discussion_board_article_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Article that this snapshot represents. {@link
  /// economic_political_discussion_board_articles.id}
  economic_political_discussion_board_article_id String
  
  /// Title of the article at the time of this snapshot.
  title String
  
  /// Content of the article at the time of this snapshot.
  body String
  
  /// Timestamp when this snapshot was created. Represents the point-in-time
  /// state of the article.
  created_at DateTime
  
  /// Timestamp when the article was last modified before this snapshot was
  /// taken.
  updated_at DateTime
  
  /// Timestamp when the article was soft-deleted at the time of this snapshot.
  /// Null if the article was active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  article economic_political_discussion_board_articles @relation(fields: [economic_political_discussion_board_article_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([economic_political_discussion_board_article_id, created_at], map: "economic_political_discussion_board_article_snapshots__82ce4a1c")
}

/// Tags associated with articles for categorization and search.
///
/// Stores tags that describe the content of articles, enabling better
/// categorization and search functionality. Each tag is associated with one
/// or more articles, allowing for flexible content organization.
///
/// Tags are used to improve search results and help users find relevant
/// articles based on their interests. The table maintains a many-to-many
/// relationship with articles through a junction table.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_political_discussion_board_article_tags {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Article that this tag is associated with. {@link
  /// economic_political_discussion_board_articles.id}
  economic_political_discussion_board_article_id String
  
  /// Name of the tag. Used for display and search functionality.
  name String
  
  /// Timestamp when the tag was created. Used for tracking when tags were
  /// added to articles.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  article economic_political_discussion_board_articles @relation(fields: [economic_political_discussion_board_article_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([economic_political_discussion_board_article_id, name], map: "economic_political_discussion_board_article_tags_econo_6e56c3e3")
  // spellchecker: ignore-next-line
  @@index([economic_political_discussion_board_article_id], map: "economic_political_discussion_board_article_tags_econo_8d6def0d")
  @@index([name])
}