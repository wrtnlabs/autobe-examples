/// Represents discussion channels where users can post and discuss economic
/// topics. Each channel has a unique identifier and name, and can belong to
/// a specific section.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_discussion_board_channels {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The section this channel belongs to. {@link
  /// economic_discussion_board_sections.id}
  economic_discussion_board_section_id String
  
  /// The name of the channel.
  name String
  
  /// A brief description of the channel's purpose.
  description String?
  
  /// The date and time when the channel was created.
  created_at DateTime
  
  /// The date and time when the channel was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  section economic_discussion_board_sections @relation(fields: [economic_discussion_board_section_id], references: [id], onDelete: Cascade)
  
  economic_discussion_board_posts economic_discussion_board_posts[]
  
  @@unique([name])
  // spellchecker: ignore-next-line
  @@index([economic_discussion_board_section_id], map: "economic_discussion_board_channels_economic_discussion_c8129c8b")
}

/// Represents sections within the discussion board, grouping related
/// channels together. Each section has a unique identifier and name.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_discussion_board_sections {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The name of the section.
  name String
  
  /// A brief description of the section's purpose.
  description String?
  
  /// The date and time when the section was created.
  created_at DateTime
  
  /// The date and time when the section was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  economic_discussion_board_channels economic_discussion_board_channels[]
  economic_discussion_board_posts economic_discussion_board_posts[]
  
  @@unique([name])
}

/// Stores configuration settings for the economic discussion board, such as
/// default settings, feature flags, and system-wide parameters.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_discussion_board_configurations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The configuration key.
  key String
  
  /// The configuration value.
  value String
  
  /// A brief description of the configuration setting.
  description String?
  
  /// The date and time when the configuration was created.
  created_at DateTime
  
  /// The date and time when the configuration was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  @@unique([key])
}