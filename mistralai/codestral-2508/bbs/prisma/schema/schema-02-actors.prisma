/// User accounts for the economic discussion board platform. Stores
/// authentication credentials and basic profile information for registered
/// users. Each user can create posts, comments, and manage their own
/// content. User accounts are required for all interactive features of the
/// platform.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_discussion_board_users {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User's email address used for authentication and communication. Must be
  /// unique across all users.
  email String
  
  /// Secure hash of the user's password for authentication purposes. Never
  /// store plain text passwords.
  password_hash String
  
  /// Display name chosen by the user for public identification.
  nickname String
  
  /// Timestamp when the user account was created.
  created_at DateTime
  
  /// Timestamp when the user account was last updated.
  updated_at DateTime
  
  /// Timestamp when the user account was soft-deleted. Null if account is
  /// active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  economic_discussion_board_user_sessions economic_discussion_board_user_sessions[]
  economic_discussion_board_posts economic_discussion_board_posts[]
  economic_discussion_board_comments economic_discussion_board_comments[]
  
  @@unique([email])
  @@index([created_at])
}

/// Authentication sessions for users on the economic discussion board.
/// Tracks active user sessions with connection details and temporal
/// information. Each session is associated with a specific user account and
/// provides audit trail for user activities.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_discussion_board_user_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the user account that owns this session. {@link
  /// economic_discussion_board_users.id}
  economic_discussion_board_user_id String
  
  /// IP address from which the session was initiated.
  ip String
  
  /// URL of the page where the session was initiated.
  href String
  
  /// Referrer URL that led to the session initiation.
  referrer String
  
  /// Timestamp when the session was created.
  created_at DateTime
  
  /// Timestamp when the session expired or was terminated. Null if session is
  /// active.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  user economic_discussion_board_users @relation(fields: [economic_discussion_board_user_id], references: [id], onDelete: Cascade)
  
  economic_discussion_board_posts economic_discussion_board_posts[]
  economic_discussion_board_comments economic_discussion_board_comments[]
  
  // spellchecker: ignore-next-line
  @@index([economic_discussion_board_user_id, created_at], map: "economic_discussion_board_user_sessions_economic_discu_2cbe764c")
}

