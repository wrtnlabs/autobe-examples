/// User comments on economic discussion board posts.
///
/// Stores user comments with content, timestamps, and relationships to posts
/// and users.
/// Each comment is associated with a specific post and created by an
/// authenticated user.
/// Comments support soft deletion for content moderation while maintaining
/// audit trails.
/// The comment content includes body text and timestamps for creation and
/// modification.
///
/// @namespace Comments
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_discussion_board_comments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Target post's {@link economic_discussion_board_posts.id}.
  economic_discussion_board_post_id String
  
  /// Comment creator's {@link economic_discussion_board_users.id}.
  economic_discussion_board_user_id String
  
  /// Session used to create comment's {@link
  /// economic_discussion_board_user_sessions.id}.
  economic_discussion_board_user_session_id String
  
  /// Comment content text.
  body String
  
  /// Comment creation timestamp.
  created_at DateTime
  
  /// Comment modification timestamp.
  updated_at DateTime
  
  /// Comment deletion timestamp for soft delete.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  post economic_discussion_board_posts @relation(fields: [economic_discussion_board_post_id], references: [id], onDelete: Cascade)
