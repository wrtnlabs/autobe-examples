  userSession economic_discussion_board_user_sessions @relation(fields: [economic_discussion_board_user_session_id], references: [id], onDelete: Cascade)
  
  economic_discussion_board_comment_snapshots economic_discussion_board_comment_snapshots[]
  economic_discussion_board_attachments economic_discussion_board_attachments[]
  economic_discussion_board_comment_attachments economic_discussion_board_comment_attachments[]
  
  // spellchecker: ignore-next-line
  @@index([economic_discussion_board_user_id], map: "economic_discussion_board_comments_economic_discussion_3ae00edf")
  // spellchecker: ignore-next-line
  @@index([economic_discussion_board_user_session_id], map: "economic_discussion_board_comments_economic_discussion_510ecccc")
  
  // spellchecker: ignore-next-line
  @@index([economic_discussion_board_post_id, created_at], map: "economic_discussion_board_comments_economic_discussion_f21d9cbd")
}

/// Historical snapshots of economic discussion board comments.
///
/// Stores point-in-time states of comments for audit trails and change
/// tracking.
/// Each snapshot captures the complete state of a comment at a specific
/// moment in time.
/// Snapshots are created whenever a comment is modified and are never
/// updated or deleted.
/// The snapshot includes all comment fields at the time of creation for
/// historical accuracy.
///
/// @namespace Comments
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_discussion_board_comment_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Source comment's {@link economic_discussion_board_comments.id}.
  economic_discussion_board_comment_id String
  
  /// Comment content text at snapshot time.
  body String
  
  /// Snapshot creation timestamp.
  created_at DateTime
  
  /// Comment modification timestamp at snapshot time.
  updated_at DateTime
  
  /// Comment deletion timestamp at snapshot time.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  comment economic_discussion_board_comments @relation(fields: [economic_discussion_board_comment_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([economic_discussion_board_comment_id, created_at], map: "economic_discussion_board_comment_snapshots_economic_d_b5d62c79")
}