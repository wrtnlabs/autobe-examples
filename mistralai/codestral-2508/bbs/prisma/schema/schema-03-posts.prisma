/// Primary entity for user-generated content in the economic discussion board.
///
/// Represents the core content creation feature where users can share their
/// thoughts, insights, and questions about economic and political topics.
/// Each post belongs to a specific channel and section, and is created by an
/// authenticated user through their active session.
///
/// Posts can be edited or deleted by their authors, and can accumulate
/// comments and attachments. The content includes title and body fields for
/// structured information presentation.
///
/// Soft deletion is supported to maintain audit trails while allowing
/// content moderation.
///
/// @namespace Posts
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_discussion_board_posts {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Channel where the post is published. {@link
  /// economic_discussion_board_channels.id}.
  economic_discussion_board_channel_id String
  
  /// Section within the channel where the post is categorized. {@link
  /// economic_discussion_board_sections.id}.
  economic_discussion_board_section_id String
  
  /// User who created the post. {@link economic_discussion_board_users.id}.
  economic_discussion_board_user_id String
  
  /// Session during which the post was created. {@link
  /// economic_discussion_board_user_sessions.id}.
  economic_discussion_board_user_session_id String
  
  /// Title of the post summarizing its content.
  title String
  
  /// Main content of the post containing detailed information.
  body String
  
  /// Timestamp when the post was created.
  created_at DateTime
  
  /// Timestamp when the post was last updated.
  updated_at DateTime
  
  /// Timestamp when the post was deleted (soft delete).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  channel economic_discussion_board_channels @relation(fields: [economic_discussion_board_channel_id], references: [id], onDelete: Cascade)
  section economic_discussion_board_sections @relation(fields: [economic_discussion_board_section_id], references: [id], onDelete: Cascade)
