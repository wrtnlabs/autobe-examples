  userSession economic_discussion_board_user_sessions @relation(fields: [economic_discussion_board_user_session_id], references: [id], onDelete: Cascade)
  
  economic_discussion_board_post_snapshots economic_discussion_board_post_snapshots[]
  economic_discussion_board_comments economic_discussion_board_comments[]
  economic_discussion_board_attachments economic_discussion_board_attachments[]
  economic_discussion_board_post_attachments economic_discussion_board_post_attachments[]
  
  // spellchecker: ignore-next-line
