/// Historical record of post states for audit trail and content change
/// tracking.
///
/// Captures point-in-time states of economic_discussion_board_posts to
/// maintain a complete history of all modifications. Each snapshot records
/// the complete state of a post at a specific moment, including all content
/// fields and metadata.
///
/// Snapshots are created whenever a post is created, updated, or deleted,
/// providing a complete audit trail of all changes. The snapshot data
/// includes all fields from the original post to ensure historical accuracy.
///
/// This table supports content moderation by allowing administrators to
/// review the complete history of a post's evolution.
///
/// @namespace Posts
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_discussion_board_post_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Post that this snapshot records. {@link
  /// economic_discussion_board_posts.id}.
  economic_discussion_board_post_id String
  
  /// Title of the post at the time of snapshot.
  title String
  
  /// Main content of the post at the time of snapshot.
  body String
  
  /// Timestamp when the snapshot was created.
  created_at DateTime
  
  /// Timestamp when the post was last updated (from original post).
  updated_at DateTime
  
  /// Timestamp when the post was deleted (from original post).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  post economic_discussion_board_posts @relation(fields: [economic_discussion_board_post_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([economic_discussion_board_post_id, created_at], map: "economic_discussion_board_post_snapshots_economic_disc_d6b10edc")
}