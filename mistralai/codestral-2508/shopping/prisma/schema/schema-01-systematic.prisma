/// Shopping mall channel information. Represents individual sales channels
/// within the mall system. Each channel has unique configuration and can
/// contain multiple sections. Channels are managed by administrators and
/// referenced by other domain entities.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_channels {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique channel code. Used for identification and reference across the
  /// system.
  code String
  
  /// Display name of the channel. Used for user-facing identification.
  name String
  
  /// Detailed description of the channel. Provides context about the channel's
  /// purpose and content.
  description String?
  
  /// Timestamp when the channel was created. Used for auditing and sorting.
  created_at DateTime
  
  /// Timestamp when the channel was last updated. Used for version tracking.
  updated_at DateTime
  
  /// Timestamp when the channel was deleted. Used for soft deletion and
  /// auditing.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shopping_mall_sections shopping_mall_sections[]
  shopping_mall_configurations shopping_mall_configurations[]
  shopping_mall_sales shopping_mall_sales[]
  shopping_mall_coupons shopping_mall_coupons[]
  shopping_mall_article_categories shopping_mall_article_categories[]
  
  @@unique([code])
  @@index([name])
}

/// Shopping mall section information. Represents organizational units within
/// channels. Sections group related products and content within a channel.
/// Each section belongs to a specific channel and can contain multiple
/// configurations.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_sections {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belongs to channel's {@link shopping_mall_channels.id}.
  shopping_mall_channel_id String
  
  /// Unique section code within the channel. Used for identification and
  /// reference.
  code String
  
  /// Display name of the section. Used for user-facing identification.
  name String
  
  /// Detailed description of the section. Provides context about the section's
  /// purpose and content.
  description String?
  
  /// Timestamp when the section was created. Used for auditing and sorting.
  created_at DateTime
  
  /// Timestamp when the section was last updated. Used for version tracking.
  updated_at DateTime
  
  /// Timestamp when the section was deleted. Used for soft deletion and
  /// auditing.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  channel shopping_mall_channels @relation(fields: [shopping_mall_channel_id], references: [id], onDelete: Cascade)
  
  shopping_mall_configurations shopping_mall_configurations[]
  shopping_mall_sales shopping_mall_sales[]
  
  @@unique([shopping_mall_channel_id, code])
  @@index([name])
  @@index([shopping_mall_channel_id])
}

/// Shopping mall configuration information. Represents system settings and
/// preferences for channels and sections. Configurations control behavior
/// and appearance of the mall components. Each configuration belongs to
/// either a channel or a section.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_configurations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belongs to channel's {@link shopping_mall_channels.id}.
  shopping_mall_channel_id String?
  
  /// Belongs to section's {@link shopping_mall_sections.id}.
  shopping_mall_section_id String?
  
  /// Configuration key. Identifies the specific setting being configured.
  key String
  
  /// Configuration value. Contains the setting's value or data.
  value String
  
  /// Detailed description of the configuration. Explains the purpose and usage
  /// of the setting.
  description String?
  
  /// Timestamp when the configuration was created. Used for auditing and
  /// sorting.
  created_at DateTime
  
  /// Timestamp when the configuration was last updated. Used for version
  /// tracking.
  updated_at DateTime
  
  /// Timestamp when the configuration was deleted. Used for soft deletion and
  /// auditing.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  channel shopping_mall_channels? @relation(fields: [shopping_mall_channel_id], references: [id], onDelete: Cascade)
  section shopping_mall_sections? @relation(fields: [shopping_mall_section_id], references: [id], onDelete: Cascade)
  
  @@unique([shopping_mall_channel_id, key])
  @@unique([shopping_mall_section_id, key])
  @@index([key])
  @@index([shopping_mall_channel_id])
  @@index([shopping_mall_section_id])
}