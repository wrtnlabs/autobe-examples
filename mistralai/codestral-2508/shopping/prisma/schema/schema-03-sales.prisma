/// Product sales information for the shopping mall.
///
/// Represents individual product sales transactions within the shopping
/// mall. Each sale is associated with a specific product variant and
/// customer. Contains details about the sale amount, quantity, and
/// timestamps for tracking the sale lifecycle.
///
/// Key relationships:
///
/// - Belongs to a specific product variant ({@link shopping_mall_sale_units})
/// - Created by a specific customer ({@link shopping_mall_customers})
/// - Has a specific seller ({@link shopping_mall_sellers})
/// - Has a specific channel ({@link shopping_mall_channels})
/// - Has a specific section ({@link shopping_mall_sections})
///
/// The sale records the point-in-time pricing and quantity at the moment of
/// purchase, which may differ from current product prices. This historical
/// data is preserved through the snapshot architecture.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_sales {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belongs to a specific product variant. {@link shopping_mall_sale_units.id}
  shopping_mall_sale_unit_id String
  
  /// Created by a specific customer. {@link shopping_mall_customers.id}
  shopping_mall_customer_id String
  
  /// Has a specific seller. {@link shopping_mall_sellers.id}
  shopping_mall_seller_id String
  
  /// Has a specific channel. {@link shopping_mall_channels.id}
  shopping_mall_channel_id String
  
  /// Has a specific section. {@link shopping_mall_sections.id}
  shopping_mall_section_id String
  
  /// Amount of cash payment.
  amount Float
  
  /// Quantity of product sold.
  quantity Int
  
  /// When the sale was created.
  created_at DateTime
  
  /// When the sale was last updated.
  updated_at DateTime
  
  /// When the sale was deleted (soft delete).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  saleUnit shopping_mall_sale_units @relation(fields: [shopping_mall_sale_unit_id], references: [id], onDelete: Cascade)
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
