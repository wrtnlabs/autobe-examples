/// recording.
///
/// Key relationships:
///
/// - Belongs to a specific sale ({@link shopping_mall_sales})
///
/// The snapshot architecture ensures that changes to sales data can be
/// tracked and analyzed over time, providing a complete audit trail of all
/// modifications to sale records.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_sale_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belongs to a specific sale. {@link shopping_mall_sales.id}
  shopping_mall_sale_id String
  
  /// Amount of cash payment at the time of snapshot.
  amount Float
  
  /// Quantity of product sold at the time of snapshot.
  quantity Int
  
  /// When the snapshot was created.
  created_at DateTime
  
  /// When the snapshot was last updated.
  updated_at DateTime
  
  /// When the snapshot was deleted (soft delete).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  sale shopping_mall_sales @relation(fields: [shopping_mall_sale_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_sale_id, created_at], map: "shopping_mall_sale_snapshots_shopping_mall_sale_id_cre_36e298a1")
}

