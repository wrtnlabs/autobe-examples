/// Core todo item entity representing tasks that users need to complete.
///
/// Stores the fundamental task information including title, description, and
/// due date.
/// Each todo item is associated with a specific user and has a status and
/// priority.
/// Supports soft deletion to allow for task recovery and history tracking.
///
/// This entity forms the central focus of the todo list application,
/// allowing users to
/// manage their tasks through creation, modification, and completion tracking.
/// The todo item maintains relationships with user accounts, status types, and
/// priority levels to provide comprehensive task management capabilities.
///
/// @namespace TodoItems
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_list_todo_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User who owns this todo item. {@link todo_list_users.id}
  todo_list_user_id String
  
  /// Current status of this todo item. {@link todo_list_todo_item_statuses.id}
  todo_list_todo_item_status_id String
  
  /// Priority level of this todo item. {@link
  /// todo_list_todo_item_priorities.id}
  todo_list_todo_item_priority_id String
  
  /// Title of the todo item. Must be between 1 and 100 characters.
  title String
  
  /// Detailed description of the todo item. Can be up to 1000 characters.
  description String?
  
  /// Date and time when the todo item is due. Must be in the future.
  due_date DateTime?
  
  /// Timestamp when the todo item was created.
  created_at DateTime
  
  /// Timestamp when the todo item was last updated.
  updated_at DateTime
  
  /// Timestamp when the todo item was soft-deleted. Null if not deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  user todo_list_users @relation(fields: [todo_list_user_id], references: [id], onDelete: Cascade)
  status todo_list_todo_item_statuses @relation(fields: [todo_list_todo_item_status_id], references: [id], onDelete: Cascade)
  priority todo_list_todo_item_priorities @relation(fields: [todo_list_todo_item_priority_id], references: [id], onDelete: Cascade)
  
  @@index([todo_list_user_id, created_at])
  @@index([todo_list_todo_item_status_id])
  @@index([todo_list_todo_item_priority_id])
}

/// Enumeration of possible statuses for todo items.
///
/// Defines the lifecycle states that todo items can transition through,
/// providing
/// clear visibility into task progress. Statuses include pending, in-progress,
/// completed, and archived, allowing users to track task completion and
/// prioritize their workload effectively.
///
/// This entity serves as a reference table for todo item statuses, enabling
/// consistent status management across the application. The predefined status
/// values ensure standardized task tracking and reporting capabilities.
///
/// @namespace TodoItems
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_list_todo_item_statuses {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Name of the status. Must be one of: pending, in-progress, completed,
  /// archived.
  name String
  
  /// Detailed description of the status meaning and usage.
  description String?
  
  //----
  // RELATIONS
  //----
  todo_list_todo_items todo_list_todo_items[]
  
  @@unique([name])
}

/// Enumeration of possible priority levels for todo items.
///
/// Defines the importance levels that can be assigned to todo items, allowing
/// users to prioritize their tasks effectively. Priority levels include low,
/// medium, high, and critical, enabling clear task prioritization and
/// workload management.
///
/// This entity serves as a reference table for todo item priorities, enabling
/// consistent priority management across the application. The predefined
/// priority
/// levels ensure standardized task prioritization and reporting capabilities.
///
/// @namespace TodoItems
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_list_todo_item_priorities {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Name of the priority level. Must be one of: low, medium, high, critical.
  name String
  
  /// Detailed description of the priority level meaning and usage.
  description String?
  
  //----
  // RELATIONS
  //----
  todo_list_todo_items todo_list_todo_items[]
  
  @@unique([name])
}