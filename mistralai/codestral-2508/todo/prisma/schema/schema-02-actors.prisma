/// User accounts for the todo list application.
///
/// Stores core user information including authentication credentials and
/// account status. Each user has a unique email address and username.
/// Passwords are stored as secure hashes. Users can have multiple login
/// methods (email, username, social media).
///
/// Supports soft deletion to allow account recovery while maintaining audit
/// trails. Includes timestamps for account creation and last update.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_list_users {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User's email address for authentication and communication. Must be unique
  /// across all users.
  email String
  
  /// User's chosen username for authentication. Must be unique across all
  /// users.
  username String
  
  /// Secure hash of user's password. Never store plain text passwords.
  password_hash String
  
  /// Timestamp when the user account was created.
  created_at DateTime
  
  /// Timestamp when the user account was last updated.
  updated_at DateTime
  
  /// Timestamp when the user account was soft-deleted. Null if account is
  /// active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  todo_list_user_sessions todo_list_user_sessions[]
  todo_list_user_email_logins todo_list_user_email_logins[]
  todo_list_user_username_logins todo_list_user_username_logins[]
  todo_list_user_social_media_logins todo_list_user_social_media_logins[]
  todo_list_user_password_resets todo_list_user_password_resets[]
  todo_list_todo_items todo_list_todo_items[]
  
  @@unique([email])
  @@index([created_at])
}

/// User session records for tracking active user sessions.
///
/// Stores information about active user sessions including IP address,
/// connection
/// context, and session duration. Each session is associated with a specific
/// user account and session type.
///
/// Supports session expiration and provides audit trail for user activity.
/// Includes timestamps for session creation and expiration.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_list_user_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User account associated with this session. {@link todo_list_users.id}
  todo_list_user_id String
  
  /// IP address from which the session was initiated.
  ip String
  
  /// URL of the page where the session was initiated.
  href String
  
  /// Referrer URL that led to the session initiation.
  referrer String
  
  /// Timestamp when the session was created.
  created_at DateTime
  
  /// Timestamp when the session expired or was terminated. Null if session is
  /// active.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  user todo_list_users @relation(fields: [todo_list_user_id], references: [id], onDelete: Cascade)
  
  @@index([todo_list_user_id, created_at])
}

