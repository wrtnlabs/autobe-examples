/// User information for authentication and authorization. Stores username,
/// email, and password hash for secure login.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_list_users {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique username for login
  username String
  
  /// User email address for notifications
  email String
  
  /// Hashed password for secure authentication
  password_hash String
  
  /// Timestamp when user account was created
  created_at DateTime
  
  /// Timestamp when user information was last updated
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  todo_list_user_sessions todo_list_user_sessions[]
  todo_list_tasks todo_list_tasks[]
  
  @@unique([username])
}

/// Manages user sessions for authentication. Tracks session details
/// including IP, URL, and expiration time.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_list_user_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Foreign key referencing todo_list_users.id
  user_id String
  
  /// IP address of the user during session creation
  ip String
  
  /// URL accessed during session creation
  href String
  
  /// Referrer URL during session creation
  referrer String
  
  /// Timestamp when session was created
  created_at DateTime
  
  /// Timestamp when session expires
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  user todo_list_users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([user_id, created_at])
}