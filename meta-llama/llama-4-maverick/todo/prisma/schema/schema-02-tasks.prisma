/// Tasks created by users for their todo lists. Each task is associated with
/// a user through the user_id foreign key. Tasks have title, optional
/// description, completion status, and timestamps for creation and last
/// update.
///
/// @namespace Tasks
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_list_tasks {
  //----
  // COLUMNS
  //----
  /// Primary key for task identification.
  id String @id
  
  /// Foreign key referencing the user who created the task.
  user_id String
  
  /// Title of the task.
  title String
  
  /// Detailed description of the task.
  description String?
  
  /// Status indicating whether the task is completed.
  completed Boolean
  
  /// Timestamp when the task was created.
  created_at DateTime
  
  /// Timestamp when the task was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  user todo_list_users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([user_id, created_at])
}