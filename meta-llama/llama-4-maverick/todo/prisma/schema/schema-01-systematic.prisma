/// System-wide configuration settings for the Todo List application
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_list_configurations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Configuration key
  key String
  
  /// Configuration value
  value String
  
  /// Configuration description
  description String?
  
  /// Creation timestamp
  created_at DateTime
  
  /// Last update timestamp
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  @@unique([key])
}