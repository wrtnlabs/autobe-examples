/// This model represents the users of the discussion board. It contains
/// essential information such as email, password hash, and timestamps for
/// creation and updates. The model is correctly defined with appropriate
/// fields and constraints.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_users {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User's email address for authentication and communication.
  email String
  
  /// Hashed password for secure authentication.
  password_hash String
  
  /// Timestamp when the user account was created.
  created_at DateTime
  
  /// Timestamp when the user account was last updated.
  updated_at DateTime
  
  /// Timestamp when the user account was soft-deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  discussion_board_user_sessions discussion_board_user_sessions[]
  discussion_board_attachments discussion_board_attachments[]
  discussion_board_content_reports discussion_board_content_reports[]
  
  @@unique([email])
}

/// This model manages user sessions for authentication.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_user_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Foreign key referencing discussion_board_users.id.
  user_id String
  
  /// IP address of the user during session creation.
  ip String
  
  /// URL of the user's current session.
  href String
  
  /// Referrer URL for the user's session.
  referrer String
  
  /// Timestamp when the session was created.
  created_at DateTime
  
  /// Timestamp when the session expires.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  user discussion_board_users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([user_id, created_at])
}

