/// Configuration table for storing system-wide settings as key-value pairs
/// with additional metadata.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_configurations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Configuration key representing the setting name.
  key String
  
  /// Configuration value associated with the key.
  value String
  
  /// Detailed description of the configuration setting and its purpose.
  description String?
  
  /// Timestamp when the configuration was created.
  created_at DateTime
  
  /// Timestamp when the configuration was last updated.
  updated_at DateTime
  
  /// Timestamp when the configuration was soft-deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  @@unique([key])
}