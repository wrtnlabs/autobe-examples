/// Main table for storing article information. Contains core details about
/// each article posted by users.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_articles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Title of the article.
  title String
  
  /// Main content of the article in Markdown format.
  content String
  
  /// Timestamp when the article was created.
  created_at DateTime
  
  /// Timestamp when the article was last updated.
  updated_at DateTime
  
  /// Timestamp when the article was soft-deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  discussion_board_article_attachments discussion_board_article_attachments[]
  discussion_board_article_versions discussion_board_article_versions[]
  discussion_board_comments discussion_board_comments[]
  discussion_board_reported_content discussion_board_reported_content[]
  
  @@index([created_at])
}

/// Stores file attachments associated with articles. Each record represents
/// a file attached to an article.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_article_attachments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Foreign key referencing discussion_board_articles.id.
  article_id String
  
  /// Name of the attached file.
  file_name String
  
  /// MIME type of the attached file.
  file_type String
  
  /// Size of the attached file in bytes.
  file_size Int
  
  /// Timestamp when the attachment was created.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  article discussion_board_articles @relation(fields: [article_id], references: [id], onDelete: Cascade)
  
  @@index([article_id])
}

/// Maintains version history of article changes. Each record represents a
/// snapshot of the article at a particular point in time.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_article_versions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Foreign key referencing discussion_board_articles.id.
  article_id String
  
  /// Title of the article at this version.
  title String
  
  /// Content of the article at this version.
  content String
  
  /// Version number of this snapshot.
  version_number Int
  
  /// Timestamp when this version was created.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  article discussion_board_articles @relation(fields: [article_id], references: [id], onDelete: Cascade)
  
  @@unique([article_id, version_number])
  @@index([article_id])
}