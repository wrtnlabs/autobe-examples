/// User information, but not a person but a connection basis
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model users {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Email for notifications and login.
  email String
  
  /// Password hash for secure authentication.
  password_hash String
  
  //----
  // RELATIONS
  //----
  user_sessions user_sessions[]
  comments comments[]
  replies replies[]
  access_tokens access_tokens[]
  refresh_tokens refresh_tokens[]
  notifications notifications[]
  
  @@unique([email])
}

/// User session information for authentication
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model user_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Foreign Key. {@link users.id}
  user_id String
  
  /// IP address of the user's device.
  ip String
  
  /// URL of the user's session.
  href String
  
  /// Referrer URL of the user's session.
  referrer String
  
  /// Timestamp when the session was created.
  created_at DateTime
  
  /// Timestamp when the session expires.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([user_id, created_at])
}

