/// Stores usage and engagement metrics for analytics purposes.
///
/// @namespace Analytics
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model analytics_data {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Timestamp when the analytics data was recorded.
  created_at DateTime
  
  /// Timestamp when the analytics data was last updated.
  updated_at DateTime
  
  /// Serialized data containing usage and engagement metrics.
  data String
}