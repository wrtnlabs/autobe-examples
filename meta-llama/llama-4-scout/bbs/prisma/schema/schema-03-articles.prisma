/// Main entity for articles on the discussion board. Each article can have
/// multiple attachments.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model articles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belongs to member. {@link members.id}
  member_id String
  
  /// Article title.
  title String
  
  /// Article content.
  content String
  
  /// Timestamp when the article was created.
  created_at DateTime
  
  /// Timestamp when the article was last updated.
  updated_at DateTime
  
  /// Timestamp when the article was soft-deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  member members @relation(fields: [member_id], references: [id], onDelete: Cascade)
  
  article_attachments article_attachments[]
  comments comments[]
  attachments attachments[]
  
  @@index([member_id])
}

/// Junction table for article attachments. Establishes many-to-many
/// relationships between articles and attachments.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model article_attachments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belongs to article. {@link articles.id}
  article_id String
  
  /// Belongs to attachment. {@link attachments.id}
  attachment_id String
  
  //----
  // RELATIONS
  //----
  article articles @relation(fields: [article_id], references: [id], onDelete: Cascade)
  attachment attachments @relation(fields: [attachment_id], references: [id], onDelete: Cascade)
  
  @@index([article_id])
  @@index([attachment_id])
}