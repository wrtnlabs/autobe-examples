/// Represents a communication channel in the system.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model channels {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Name of the channel.
  name String
  
  /// Description of the channel.
  description String?
  
  //----
  // RELATIONS
  //----
  sections sections[]
}

/// Represents a section within a channel.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model sections {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Foreign key referencing the Channels table.
  channel_id String
  
  /// Name of the section.
  name String
  
  /// Description of the section.
  description String?
  
  //----
  // RELATIONS
  //----
  channel channels @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  
  @@index([channel_id])
}

/// Represents system configurations.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model configurations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Configuration key.
  key String
  
  /// Configuration value.
  value String
  
  //----
  // RELATIONS
  //----
  @@unique([key])
}