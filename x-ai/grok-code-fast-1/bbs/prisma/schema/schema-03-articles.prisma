/// Core content unit where members publish articles on economic and
/// political topics. Each article serves as the foundation for discussion,
/// containing title and body text that can be enhanced with various
/// attachments for supporting evidence and data.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_discussion_board_articles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Authenticated member who created this article. {@link
  /// economic_discussion_board_members.id}
  economic_discussion_board_member_id String
  
  /// Article title limited to 200 characters for concise topic identification.
  title String
  
  /// Main article content supporting rich text formatting and up to 10,000
  /// characters for comprehensive economic analysis.
  body String
  
  /// Publication status indicating article state: draft, pending (awaiting
  /// moderation), published (visible to all), rejected (moderation denied).
  status String
  
  /// Timestamp when the article was first created.
  created_at DateTime
  
  /// Timestamp when the article was last modified.
  updated_at DateTime
  
  /// Soft delete timestamp for removed articles.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  creator economic_discussion_board_members @relation(fields: [economic_discussion_board_member_id], references: [id], onDelete: Cascade)
  
  economic_discussion_board_attachments economic_discussion_board_attachments[]
  economic_discussion_board_comments economic_discussion_board_comments[]
  
  // spellchecker: ignore-next-line
  @@index([economic_discussion_board_member_id, created_at], map: "economic_discussion_board_articles_economic_discussion_410152b4")
}

/// Supporting materials attached to articles, including images and documents
/// that provide visual evidence or data sources for economic discussions.
/// Each attachment belongs to exactly one article.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_discussion_board_attachments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Associated article this attachment supports. {@link
  /// economic_discussion_board_articles.id}
  economic_discussion_board_article_id String
  
  /// Original filename of the uploaded attachment.
  name String
  
  /// Storage path or URL where the attachment file is located.
  path String
  
  /// File type of the attachment (e.g., 'image/jpeg', 'application/pdf').
  type String
  
  /// File size in bytes for storage management.
  size Int
  
  /// Timestamp when the attachment was uploaded.
  created_at DateTime
  
  /// Timestamp when the attachment was last modified.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  article economic_discussion_board_articles @relation(fields: [economic_discussion_board_article_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([economic_discussion_board_article_id], map: "economic_discussion_board_attachments_economic_discuss_90086b70")
}