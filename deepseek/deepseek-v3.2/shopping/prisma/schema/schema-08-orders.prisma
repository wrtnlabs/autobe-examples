  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  orderItems ecommerce_mall_order_items[]
  snapshots ecommerce_mall_order_snapshots[]
  orderShippingAddressSnapshot ecommerce_mall_order_shipping_address_snapshots?
  orderAddressSnapshot ecommerce_mall_order_address_snapshots?
  reviewOrderConstraints ecommerce_mall_review_order_constraints[]
  administratorActionLogs ecommerce_mall_administrator_action_logs[]
