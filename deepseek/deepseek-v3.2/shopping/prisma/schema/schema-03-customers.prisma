  customer ecommerce_mall_customers? @relation(fields: [ecommerce_mall_customer_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_customer_profile_id, created_at], map: "ecommerce_mall_customer_profile_snapshots_ecommerce_ma_e2650f11")
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_customer_id, created_at], map: "ecommerce_mall_customer_profile_snapshots_ecommerce_ma_a8284649")
