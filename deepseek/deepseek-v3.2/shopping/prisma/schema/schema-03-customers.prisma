  //   - format: (propertyKey targetModel)
  //----
  snapshots ecommerce_mall_customer_profile_snapshots[]
  shoppingCart ecommerce_mall_shopping_carts?
  
  //----
  // INDEXES
  //----
  @@unique([customer_id])
  @@index([created_at, deleted_at])
}

