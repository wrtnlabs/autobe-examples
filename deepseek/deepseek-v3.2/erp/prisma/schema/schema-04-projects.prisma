  //----
  /// Primary Key.
  id String @id
  
  /// Parent organization that owns this project. {@link
  /// erp_time_track_organizations.id}.
  organization_id String
  
  /// Project name for identification and reference.
  name String
  
  /// Detailed project description explaining purpose, scope, and objectives.
  description String?
  
