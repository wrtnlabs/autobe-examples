  /// Data type definition at snapshot time.
  data_type String
  
  /// Default value at snapshot time.
  default_value String
  
  /// Validation rules at snapshot time.
  validation_rules String?
  
  /// Configuration category at snapshot time.
  category String
  
  /// Sensitivity flag at snapshot time.
  is_sensitive Boolean
  
  /// Required flag at snapshot time.
  is_required Boolean
  
  /// Configuration version at snapshot time.
  version Int
  
  /// Reason for creating this snapshot (e.g., 'version_update', 'bug_fix',
  /// 'compliance').
  snapshot_reason String
  
  /// Timestamp when this snapshot was created.
  created_at DateTime
  
  //----
  // RELATIONS
