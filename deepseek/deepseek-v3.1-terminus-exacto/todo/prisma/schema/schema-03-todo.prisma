  /// The todo that this snapshot captures. {@link multi_user_todo_todos.id}.
  multi_user_todo_todo_id String
  
  /// The title of the todo at the time of snapshot creation.
  title String
  
  /// The description of the todo at the time of snapshot creation, if present.
  description String?
  
  /// The start date of the todo at the time of snapshot creation, if set.
  start_date DateTime?
  
  /// The due date of the todo at the time of snapshot creation, if set.
  due_date DateTime?
  
  /// The completion status of the todo at the time of snapshot creation.
  is_completed Boolean
  
  /// Whether the todo was deleted at the time of snapshot creation.
  is_deleted Boolean
  
  /// Timestamp when this snapshot was created.
  created_at DateTime
  
  //----
