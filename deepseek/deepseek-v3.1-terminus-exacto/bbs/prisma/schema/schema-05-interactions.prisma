/// Main entity representing user comments on discussion board articles.
///
/// Stores the core content of comments made by members and moderators on
/// articles. Each comment contains the actual text content, references to
/// the parent article, and maintains relationships with voting and
/// attachment entities.
///
/// Comments support nested replies through parent-child relationships,
/// allowing for threaded conversations. The entity tracks creation and
/// modification timestamps for audit purposes and supports soft deletion for
/// content moderation.
///
/// Comments are independently manageable entities that require search and
/// filtering capabilities across all articles, justifying primary stance
/// classification. The actor_type field enables routing to appropriate
/// subtype entities for member and moderator creation contexts.
///
/// @namespace Interactions
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_comments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the parent article where this comment is posted. {@link
  /// discussion_board_articles.id}
  discussion_board_article_id String
  
  /// Self-referencing foreign key for nested comment replies. Points to the
  /// parent comment if this is a reply. {@link discussion_board_comments.id}
  parent_id String?
  
  /// Type of actor who created the comment. Valid values: 'member',
  /// 'moderator'. Used for routing to appropriate subtype entity.
  actor_type String
  
  /// The actual content of the comment. Supports rich text formatting and must
  /// contain substantive discussion content.
  body String
  
  /// Current moderation status of the comment. Valid values: 'pending',
  /// 'approved', 'rejected', 'flagged'.
  status String
  
  /// Timestamp when the comment was originally created.
  created_at DateTime
  
  /// Timestamp when the comment was last modified.
  updated_at DateTime
  
  /// Timestamp when the comment was soft deleted. Null if comment is active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  parent discussion_board_comments? @relation("recursive", fields: [parent_id], references: [id], onDelete: Cascade)
  
  discussion_board_comment_attachments discussion_board_comment_attachments[]
  recursive discussion_board_comments[] @relation("recursive")
  discussion_board_comments_of_members discussion_board_comments_of_members?
  discussion_board_comments_of_moderators discussion_board_comments_of_moderators?
  discussion_board_comment_votes discussion_board_comment_votes[]
  discussion_board_content_reports discussion_board_content_reports[]
  discussion_board_moderation_action_of_comments discussion_board_moderation_action_of_comments[]
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, created_at], map: "discussion_board_comments_discussion_board_article_id__aa7deb51")
  @@index([actor_type, created_at])
  @@index([status, created_at])
  @@index([parent_id])
}

