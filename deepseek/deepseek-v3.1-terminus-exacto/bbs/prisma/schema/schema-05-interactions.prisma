  discussion_board_member_id String
  
  /// Reference to the member session when the vote was cast. {@link
  /// discussion_board_member_sessions.id}
  discussion_board_member_session_id String
  
  /// Type of vote cast. Valid values: 'upvote', 'downvote'.
  vote_type String
  
  /// Timestamp when the vote was cast.
  created_at DateTime
  
