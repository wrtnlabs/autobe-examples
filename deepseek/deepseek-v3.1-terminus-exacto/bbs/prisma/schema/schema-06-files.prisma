/// Core file upload entity tracking the lifecycle of uploaded files
/// including processing status, storage information, and access controls.
/// Files are uploaded by members or moderators and undergo security scanning
/// before being made available for attachment to posts and comments.
///
/// @namespace Files
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_file_uploads {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Member who uploaded the file. {@link discussion_board_members.id}
  discussion_board_member_id String?
  
  /// Moderator who uploaded the file. {@link discussion_board_moderators.id}
  discussion_board_moderator_id String?
  
  /// Session context for member uploads. {@link
  /// discussion_board_member_sessions.id}
  discussion_board_member_session_id String?
  
  /// Session context for moderator uploads. {@link
  /// discussion_board_moderator_sessions.id}
  discussion_board_moderator_session_id String?
  
  /// Type of actor who uploaded the file (member or moderator).
  actor_type String
  
  /// Original filename as uploaded by the user.
  file_name String
  
  /// File size in bytes.
  file_size Int
  
  /// MIME type of the uploaded file.
  mime_type String
  
  /// Path to the file in storage system.
  storage_path String
  
  /// Current status of the upload process (pending, processing, completed,
  /// failed).
  upload_status String
  
  /// Security scan status (pending, clean, infected, failed).
  scan_status String
  
  /// Whether the file is publicly accessible.
  is_public Boolean
  
  /// Unique access key for secure file retrieval.
  access_key String
  
  /// Timestamp when the file upload was initiated.
  created_at DateTime
  
  /// Timestamp when the file upload was last updated.
  updated_at DateTime
  
  /// Timestamp when the file was soft-deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  member discussion_board_members? @relation(fields: [discussion_board_member_id], references: [id], onDelete: Cascade)
  moderator discussion_board_moderators? @relation(fields: [discussion_board_moderator_id], references: [id], onDelete: Cascade)
  memberSession discussion_board_member_sessions? @relation(fields: [discussion_board_member_session_id], references: [id], onDelete: Cascade)
  moderatorSession discussion_board_moderator_sessions? @relation(fields: [discussion_board_moderator_session_id], references: [id], onDelete: Cascade)
  
  discussion_board_post_attachments discussion_board_post_attachments[]
  discussion_board_comment_attachments discussion_board_comment_attachments[]
  discussion_board_file_metadata discussion_board_file_metadata?
  discussion_board_file_scans discussion_board_file_scans[]
  
  @@index([discussion_board_member_id])
  // spellchecker: ignore-next-line
  @@index([discussion_board_moderator_id], map: "discussion_board_file_uploads_discussion_board_moderat_582c0c5a")
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_session_id], map: "discussion_board_file_uploads_discussion_board_member__a1ce7bda")
  // spellchecker: ignore-next-line
  @@index([discussion_board_moderator_session_id], map: "discussion_board_file_uploads_discussion_board_moderat_3482225b")
  
  @@unique([access_key])
  @@index([actor_type, created_at])
  @@index([upload_status])
  @@index([scan_status])
  @@index([created_at])
}

/// Metadata and descriptive information for uploaded files. Contains
/// additional file properties, descriptions, and categorization information
/// that supplements the core file upload record.
///
/// @namespace Files
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_file_metadata {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the file upload record. {@link
  /// discussion_board_file_uploads.id}
  discussion_board_file_upload_id String
  
  /// Descriptive title for the file.
  title String?
  
  /// Detailed description of the file content.
  description String?
  
  /// Category of file type (image, document, data, etc.).
  file_type_category String
  
  /// Image dimensions for visual files (width x height).
  dimensions String?
  
  /// Number of pages for document files.
  page_count Int?
  
  /// Language of the file content.
  language String?
  
  /// Author or creator of the file content.
  author String?
  
  /// Copyright or licensing information.
  copyright_info String?
  
  /// Comma-separated tags for content categorization.
  tags String?
  
  /// Timestamp when the metadata was created.
  created_at DateTime
  
  /// Timestamp when the metadata was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  fileUpload discussion_board_file_uploads @relation(fields: [discussion_board_file_upload_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([discussion_board_file_upload_id], map: "discussion_board_file_metadata_discussion_board_file_u_d282c647")
  
  @@index([file_type_category])
  @@index([created_at])
}

/// Security scanning results and audit trail for file uploads. Records virus
/// scan outcomes, security assessments, and scanning history to ensure
/// uploaded files meet platform security standards.
///
/// @namespace Files
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_file_scans {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the file upload record. {@link
  /// discussion_board_file_uploads.id}
  discussion_board_file_upload_id String
  
  /// Name of the antivirus/security scanning engine used.
  scan_engine String
  
  /// Version of the scanning engine.
  scan_version String
  
  /// Result of the security scan (clean, infected, suspicious, error).
  scan_result String
  
  /// Name of detected threat if file is infected.
  threat_name String?
  
  /// Type of security threat detected.
  threat_type String?
  
  /// Duration of scan in milliseconds.
  scan_duration Int
  
  /// Hash of the file content for integrity verification.
  file_hash String
  
  /// Timestamp when the scan was performed.
  scan_timestamp DateTime
  
  /// Whether the file was quarantined due to security concerns.
  is_quarantined Boolean
  
  /// Reason for quarantine if applicable.
  quarantine_reason String?
  
  /// Timestamp when the scan record was created.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  fileUpload discussion_board_file_uploads @relation(fields: [discussion_board_file_upload_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_file_upload_id], map: "discussion_board_file_scans_discussion_board_file_uplo_312f8659")
  
  @@index([scan_result])
  @@index([scan_timestamp])
  @@index([file_hash])
}