  //----
  /// Primary Key.
  id String @id
  
  /// Unique anonymous identifier for guest tracking without authentication
  /// requirements.
  guest_token String
  
  /// Timestamp when the guest account was created.
  created_at DateTime
  
  /// Timestamp when the guest account was last updated.
  updated_at DateTime
  
  /// Timestamp when the guest account was soft deleted.
  deleted_at DateTime?
  
