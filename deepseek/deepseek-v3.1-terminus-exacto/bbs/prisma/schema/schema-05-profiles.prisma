/// Extended user profile information beyond basic authentication data.
/// Contains personal details, biography, and customization preferences that
/// enhance user identity for economic/political discussion participation.
/// {@link discussion_board_members.id}
///
/// @namespace Profiles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_user_profiles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the member who owns this profile. {@link
  /// discussion_board_members.id}
  discussion_board_member_id String
  
  /// User's personal introduction and background relevant to
  /// economic/political discussions. Maximum 500 characters.
  biography String?
  
  /// Geographic location at country/region level for discussion context.
  location String?
  
  /// User's professional experience or expertise relevant to discussion topics.
  professional_background String?
  
  /// Specific economic/political topics the user is most interested in.
  areas_of_interest String?
  
  /// URL to user's profile avatar image.
  avatar_url String?
  
  /// Privacy setting controlling who can view the profile (public,
  /// registered_users, private).
  profile_visibility String
  
  /// Timestamp when the profile was created.
  created_at DateTime
  
  /// Timestamp when the profile was last updated.
  updated_at DateTime
  
  /// Timestamp when the profile was soft-deleted for privacy.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  member discussion_board_members @relation(fields: [discussion_board_member_id], references: [id], onDelete: Cascade)
  
  discussion_board_user_preferences discussion_board_user_preferences?
  discussion_board_activity_history discussion_board_activity_history[]
  discussion_board_saved_content discussion_board_saved_content[]
  
  @@unique([discussion_board_member_id])
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_id, created_at], map: "discussion_board_user_profiles_discussion_board_member_934050b6")
  @@index([profile_visibility])
  @@index([created_at])
}

