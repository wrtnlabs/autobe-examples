/// Main sections table storing core section information for organizing
/// discussion board content.
///
/// Sections serve as the primary organizational structure for the discussion
/// board, categorizing articles by topics such as Politics, Economy, and
/// Current Affairs. Each section contains a name, description, and metadata
/// about its creation and management.
///
/// Sections are created and managed exclusively by administrators. Regular
/// users can browse sections and post articles within them, but cannot
/// create or modify section definitions. The table maintains audit trails
/// through snapshot relationships and tracks section statistics separately.
///
/// {@link discussion_board_section_snapshots} provides version history for
/// section changes.
/// {@link discussion_board_section_statistics} tracks usage metrics and
/// engagement data.
/// {@link discussion_board_section_administrators} manages administrator
/// permissions for each section.
/// {@link discussion_board_admins} and {@link discussion_board_super_admins}
/// are the administrator entities that create and manage sections.
///
/// @namespace Sections
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_sections {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Administrator who created this section. References either regular admin
  /// or super admin. {@link discussion_board_admins.id} or {@link
  /// discussion_board_super_admins.id}.
  created_by_admin_id String
  
  /// Administrator who last modified this section. References either regular
  /// admin or super admin. {@link discussion_board_admins.id} or {@link
  /// discussion_board_super_admins.id}.
  last_modified_by_admin_id String?
  
  /// Unique name of the section used for display and URL generation.
  name String
  
  /// Detailed description explaining the section's purpose and content scope.
  description String
  
  /// Current status of the section: 'active', 'inactive', or 'archived'.
  status String
  
  /// Numerical order for displaying sections in the user interface.
  display_order Int
  
  /// Timestamp when the section was created.
  created_at DateTime
  
  /// Timestamp when the section was last modified.
  updated_at DateTime
  
  /// Timestamp when the section was soft-deleted (archived).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  createdByAdmin discussion_board_admins @relation("discussion_board_sections_of_created_by_admin_id", fields: [created_by_admin_id], references: [id], onDelete: Cascade)
  lastModifiedByAdmin discussion_board_admins? @relation("discussion_board_sections_of_last_modified_by_admin_id", fields: [last_modified_by_admin_id], references: [id], onDelete: Cascade)
  
  auditActions discussion_board_audit_logs[]
  snapshots discussion_board_section_snapshots[]
  statistic discussion_board_section_statistics?
  administratorAssignments discussion_board_section_administrators[]
  preferences discussion_board_section_preferences[]
  archive discussion_board_section_archives?
  files discussion_board_section_files[]
  images discussion_board_section_images[]
  articles discussion_board_articles[]
  moderationLogs discussion_board_moderation_logs[]
  
  @@unique([name])
  @@index([status, display_order])
  @@index([created_by_admin_id, created_at])
  // spellchecker: ignore-next-line
  @@index([last_modified_by_admin_id, updated_at], map: "discussion_board_sections_last_modified_by_admin_id_up_0336caf0")
}

/// Point-in-time snapshots of section data for audit trail and version history.
///
/// This table captures the complete state of a section at specific moments
/// in time, typically when modifications are made by administrators. Each
/// snapshot preserves the section's name, description, and configuration
/// settings as they existed at the time of capture, enabling historical
/// tracking of changes and supporting audit requirements.
///
/// The snapshots are created automatically when section data is modified and
/// serve as an immutable record of section evolution. This supports
/// compliance requirements, facilitates rollback capabilities, and provides
/// administrators with visibility into section modification history.
///
/// @namespace Sections
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_section_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the original section being snapshotted. {@link
  /// discussion_board_sections.id}
  discussion_board_section_id String
  
  /// Section name as it existed at the time of snapshot.
  name String
  
  /// Section description as it existed at the time of snapshot.
  description String
  
  /// Timestamp when this snapshot was created.
  created_at DateTime
  
  /// Timestamp when this snapshot was last updated (typically matches
  /// created_at for snapshots).
  updated_at DateTime
  
  /// Timestamp when this snapshot was soft-deleted, if applicable.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  section discussion_board_sections @relation(fields: [discussion_board_section_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_section_id, created_at], map: "discussion_board_section_snapshots_discussion_board_se_39571b0c")
}

