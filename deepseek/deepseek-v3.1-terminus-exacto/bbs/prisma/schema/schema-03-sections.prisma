/// Mapping table linking administrators to sections they manage with
/// permission levels and assignment tracking.
///
/// This table establishes the many-to-many relationship between
/// administrators and sections, enabling flexible permission management
/// across the discussion board. Each record represents a specific
/// administrator's assignment to manage a particular section with defined
/// permission levels.
///
/// The table supports both regular administrators and super administrators,
/// with permission levels determining the scope of management capabilities
/// within each section. This design allows for granular control over section
/// management while maintaining audit trails for assignment changes.
///
/// References: {@link discussion_board_admins.id}, {@link
/// discussion_board_super_admins.id}, {@link discussion_board_sections.id}
///
/// @namespace Sections
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_section_administrators {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the regular administrator assigned to this section. {@link
  /// discussion_board_admins.id}
  discussion_board_admin_id String?
  
  /// Reference to the super administrator assigned to this section. {@link
  /// discussion_board_super_admins.id}
  discussion_board_super_admin_id String?
  
  /// Reference to the section being managed. {@link
  /// discussion_board_sections.id}
  discussion_board_section_id String
  
  /// Permission level assigned to the administrator for this section.
  /// Determines what actions they can perform within the section.
  permission_level String
  
  /// Date when the administrator was assigned to manage this section.
  assignment_date DateTime
  
  /// Timestamp when this assignment record was created.
  created_at DateTime
  
  /// Timestamp when this assignment record was last updated.
  updated_at DateTime
  
  /// Timestamp when this assignment was soft deleted, if applicable.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  admin discussion_board_admins? @relation(fields: [discussion_board_admin_id], references: [id], onDelete: Cascade)
  superAdmin discussion_board_super_admins? @relation(fields: [discussion_board_super_admin_id], references: [id], onDelete: Cascade)
  section discussion_board_sections @relation(fields: [discussion_board_section_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([discussion_board_admin_id, discussion_board_section_id], map: "discussion_board_section_administrators_discussion_boa_728d3f9a")
  // spellchecker: ignore-next-line
  @@unique([discussion_board_super_admin_id, discussion_board_section_id], map: "discussion_board_section_administrators_discussion_boa_e3773ce3")
  // spellchecker: ignore-next-line
  @@index([discussion_board_section_id, permission_level], map: "discussion_board_section_administrators_discussion_boa_4bb66fef")
  // spellchecker: ignore-next-line
  @@index([permission_level, assignment_date], map: "discussion_board_section_administrators_permission_lev_91b53ce8")
  @@index([created_at])
}

