/// Core article entity storing title, content, section assignment, and
/// author information.
///
/// This table represents the main content unit of the discussion board where
/// users create and share articles on economic and political topics. Each
/// article belongs to a specific section and is authored by a registered
/// user. The table supports article lifecycle management including creation,
/// editing, deletion, and publication status tracking.
///
/// Articles can have multiple attachments, tags, and engagement metrics
/// through related child tables. The content field stores the main article
/// text while the title provides a concise summary. The status field manages
/// article workflow from draft to published to archived states.
///
/// Related entities include: {@link discussion_board_sections.id} for
/// section assignment, {@link discussion_board_users.id} for author
/// identification, and various child tables for attachments, tags, and
/// engagement metrics.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_articles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Section where this article is published. {@link
  /// discussion_board_sections.id}
  discussion_board_section_id String
  
  /// Author who created this article. {@link discussion_board_users.id}
  discussion_board_user_id String
  
  /// Article title that summarizes the content. Must be between 5 and 200
  /// characters.
  title String
  
  /// Main article content containing the full text of the discussion. Must be
  /// at least 50 characters.
  content String
  
  /// Publication status of the article. Values: draft, published, archived.
  status String
  
  /// Timestamp when the article was first created.
  created_at DateTime
  
  /// Timestamp when the article was last modified.
  updated_at DateTime
  
  /// Timestamp when the article was soft-deleted, or null if active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  section discussion_board_sections @relation(fields: [discussion_board_section_id], references: [id], onDelete: Cascade)
  author discussion_board_users @relation(fields: [discussion_board_user_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  auditActions discussion_board_audit_logs[]
  snapshots discussion_board_article_snapshots[]
  files discussion_board_article_files[]
  images discussion_board_article_images[]
  tags discussion_board_article_tags[]
  viewStat discussion_board_article_view_stats?
  favoritedBies discussion_board_article_favorites[]
  drafts discussion_board_article_drafts[]
  viewStatEvents discussion_board_article_view_stat_events[]
  comments discussion_board_comments[]
  commentPaginationSetting discussion_board_comment_pagination_settings?
  moderationLogs discussion_board_moderation_logs[]
  moderationHistories discussion_board_moderated_content_histories[]
  contentFlags discussion_board_content_flags[]
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([discussion_board_section_id, created_at], map: "discussion_board_articles_discussion_board_section_id__cb7d94c3")
  // spellchecker: ignore-next-line
  @@index([discussion_board_user_id, created_at], map: "discussion_board_articles_discussion_board_user_id_cre_906977c0")
  @@index([status, created_at])
}

/// Audit trail for article changes with version history and edit tracking.
///
/// This table captures point-in-time states of articles whenever they are
/// modified, providing a complete version history for audit purposes. Each
/// snapshot contains a denormalized copy of the article's state at the time
/// of modification, including title, content, section assignment, and author
/// information.
///
/// The snapshots are append-only records that support rollback capabilities,
/// content moderation tracking, and compliance requirements. They reference
/// the parent {@link discussion_board_articles} table and maintain the
/// complete edit history of each article.
///
/// Key business uses include:
/// - Tracking content changes for moderation and compliance
/// - Enabling article version comparison and rollback
/// - Providing audit trail for content modifications
/// - Supporting historical analysis of article evolution
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_article_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the parent article being snapshotted. {@link
  /// discussion_board_articles.id}
  discussion_board_article_id String
  
  /// Title of the article at the time of snapshot creation.
  title String
  
  /// Full content of the article at the time of snapshot creation.
  content String
  
  /// Section assignment of the article at the time of snapshot creation.
  /// {@link discussion_board_sections.id}
  discussion_board_section_id String
  
  /// Author of the article at the time of snapshot creation. {@link
  /// discussion_board_users.id}
  discussion_board_user_id String
  
  /// Timestamp when this snapshot was created.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, created_at], map: "discussion_board_article_snapshots_discussion_board_ar_12be945f")
  // spellchecker: ignore-next-line
  @@index([discussion_board_user_id, created_at], map: "discussion_board_article_snapshots_discussion_board_us_d95c7d7d")
  // spellchecker: ignore-next-line
  @@index([discussion_board_section_id, created_at], map: "discussion_board_article_snapshots_discussion_board_se_f2ef0f8a")
}

/// Stores file attachments associated with articles, supporting multiple
/// file types and formats.
///
/// This table manages all file attachments that users can add to their
/// articles, including documents, PDFs, and other supported file formats.
/// Each file attachment is linked to a specific article and includes
/// metadata such as file name, type, size, and storage path.
///
/// Files are managed through the parent article entity and cannot exist
/// independently. When an article is deleted, all associated file
/// attachments are also removed. The system supports various file types with
/// appropriate validation and storage handling.
///
/// Related entities: {@link discussion_board_articles} (parent article),
/// {@link discussion_board_users} (uploading user if tracked).
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_article_files {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The article to which this file attachment belongs. {@link
  /// discussion_board_articles.id}
  discussion_board_article_id String
  
  /// Original name of the uploaded file as provided by the user.
  file_name String
  
  /// MIME type or file extension indicating the file format (e.g.,
  /// 'application/pdf', 'image/jpeg').
  file_type String
  
  /// Size of the file in bytes for storage management and download tracking.
  file_size Int
  
  /// Path to the file in the storage system for retrieval and download
  /// operations.
  storage_path String
  
  /// User who uploaded this file attachment. {@link discussion_board_users.id}
  uploaded_by String?
  
  /// Optional description of the file attachment provided by the user.
  description String?
  
  /// Number of times this file has been downloaded for usage analytics.
  download_count Int
  
  /// Timestamp when the file attachment was created.
  created_at DateTime
  
  /// Timestamp when the file attachment was last updated.
  updated_at DateTime
  
  /// Timestamp when the file attachment was soft-deleted, or null if active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  commentAttachments discussion_board_comment_attachments[]
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, created_at], map: "discussion_board_article_files_discussion_board_articl_29eaf080")
  @@index([file_type, created_at])
}

