  recovery_data String?
  
  /// Timestamp when the draft was first created.
  draft_created_at DateTime
  
  /// Timestamp when the draft was last modified.
  draft_updated_at DateTime
  
  /// Timestamp when the draft was soft-deleted, allowing for recovery.
  draft_deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
