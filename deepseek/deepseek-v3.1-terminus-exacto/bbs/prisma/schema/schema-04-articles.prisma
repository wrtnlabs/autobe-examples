  /// Timestamp when the tag was associated with the article.
  created_at DateTime
  
  /// Timestamp when the tag association was last modified.
  updated_at DateTime
  
  /// Timestamp when the tag association was soft-deleted, allowing for tag
  /// removal tracking.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
