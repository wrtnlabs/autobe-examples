  discussion_board_member_id String
  
  /// Type of notification indicating the event that triggered it. Examples:
  /// post_reply, comment_like, moderation_action, system_announcement.
  notification_type String
  
  /// Notification title summarizing the event or message.
  title String
  
  /// Detailed notification message content providing context and information.
  message String
  
  /// Current delivery status of the notification. Values: unread, read,
  /// dismissed.
  status String
  
  /// Method used to deliver the notification. Values: in_app, email, both.
