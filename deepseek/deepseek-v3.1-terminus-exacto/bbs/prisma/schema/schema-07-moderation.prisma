  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  banAppeals discussion_board_ban_appeals[]
  banRecordOfAdmin discussion_board_ban_record_of_admins?
  superAdminBanRecord discussion_board_ban_record_of_super_admins?
  
  //----
  // INDEXES
  //----
  @@index([ban_status, expires_at])
  @@index([expires_at])
}

