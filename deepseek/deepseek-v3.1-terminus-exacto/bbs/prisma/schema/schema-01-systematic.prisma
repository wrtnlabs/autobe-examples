/// Defines discussion channels for organizing content by economic/political
/// topics. Each channel represents a distinct discussion area with specific
/// configuration settings and content organization rules. Channels serve as
/// the top-level organizational structure for the platform.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_channels {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique name of the discussion channel (e.g., 'Economic Policy',
  /// 'Political Analysis').
  name String
  
  /// Detailed description explaining the channel's purpose and focus area.
  description String?
  
  /// Unique code identifier for the channel used in URLs and API references.
  code String
  
  /// Indicates whether the channel is currently active and accepting new
  /// content.
  is_active Boolean
  
  /// Numerical order for displaying channels in lists and navigation.
  sort_order Int
  
  /// Timestamp when the channel was created.
  created_at DateTime
  
  /// Timestamp when the channel was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  discussion_board_sections discussion_board_sections[]
  discussion_board_posts discussion_board_posts[]
  
  @@unique([name])
  @@unique([code])
  @@index([is_active, sort_order])
  @@index([created_at])
}

/// Represents organizational sections within discussion channels. Sections
/// provide hierarchical organization for content within channels, allowing
/// for sub-categorization of economic/political topics. Each section belongs
/// to a specific channel.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_sections {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent channel that contains this section. {@link
  /// discussion_board_channels.id}
  discussion_board_channel_id String
  
  /// Name of the section within the channel.
  name String
  
  /// Description explaining the section's specific focus area.
  description String?
  
  /// Unique code identifier for the section within its channel.
  code String
  
  /// Indicates whether the section is currently active.
  is_active Boolean
  
  /// Order for displaying sections within their parent channel.
  sort_order Int
  
  /// Timestamp when the section was created.
  created_at DateTime
  
  /// Timestamp when the section was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  channel discussion_board_channels @relation(fields: [discussion_board_channel_id], references: [id], onDelete: Cascade)
  
  discussion_board_posts discussion_board_posts[]
  
  @@unique([discussion_board_channel_id, name])
  @@unique([discussion_board_channel_id, code])
  // spellchecker: ignore-next-line
  @@index([discussion_board_channel_id, is_active, sort_order], map: "discussion_board_sections_discussion_board_channel_id__1a594474")
  @@index([created_at])
}

/// Defines content categorization system for organizing posts and
/// discussions. Categories provide thematic grouping across the platform,
/// allowing users to filter and discover content by specific
/// economic/political topics.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Category name (e.g., 'Economic Policy', 'Market Discussions', 'Policy
  /// Debates').
  name String
  
  /// Detailed description of the category's scope and focus.
  description String?
  
  /// Unique code identifier for the category used in content filtering.
  code String
  
  /// Color code for visual representation of the category.
  color String?
  
  /// Indicates whether the category is available for content assignment.
  is_active Boolean
  
  /// Display order for category lists and selection interfaces.
  sort_order Int
  
  /// Timestamp when the category was created.
  created_at DateTime
  
  /// Timestamp when the category was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  @@unique([name])
  @@unique([code])
  @@index([is_active, sort_order])
  @@index([created_at])
}

/// Stores platform-wide configuration settings and system parameters. This
/// table contains all configurable options that control platform behavior,
/// appearance, and functionality. Configuration changes affect the entire
/// discussion board environment.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_configurations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique configuration key identifier (e.g., 'max_post_length',
  /// 'file_upload_limit').
  key String
  
  /// Configuration value stored as string (may represent various data types).
  value String
  
  /// Data type of the configuration value (string, number, boolean, json).
  data_type String
  
  /// Human-readable description of the configuration setting's purpose.
  description String?
  
  /// Configuration category for organizational grouping (e.g., 'posting',
  /// 'moderation', 'ui').
  category String
  
  /// Indicates whether this configuration setting is currently active.
  is_active Boolean
  
  /// Timestamp when the configuration was created.
  created_at DateTime
  
  /// Timestamp when the configuration was last modified.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  @@unique([key])
  @@index([category, is_active])
  @@index([created_at])
}