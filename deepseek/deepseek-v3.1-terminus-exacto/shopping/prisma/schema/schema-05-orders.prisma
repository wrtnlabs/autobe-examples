/// Core order entity representing completed transactions in the e-commerce
/// platform.
///
/// Stores comprehensive order information including customer details, order
/// totals, shipping information, and fulfillment status. Each order
/// represents a completed purchase transaction with associated payment and
/// shipping records.
///
/// Orders follow a defined lifecycle from placement through delivery, with
/// status tracking at each stage. The system maintains audit trails for
/// order modifications, cancellations, and fulfillment updates to ensure
/// transaction integrity and customer satisfaction.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_orders {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who placed the order. {@link ecommerce_mall_customers.id}
  ecommerce_mall_customer_id String
  
  /// Seller responsible for order fulfillment. {@link
  /// ecommerce_mall_sellers.id}
  ecommerce_mall_seller_id String
  
  /// Shipping address for order delivery. {@link
  /// ecommerce_mall_customer_addresses.id}
  shipping_address_id String
  
  /// Billing address for payment processing. {@link
  /// ecommerce_mall_customer_addresses.id}
  billing_address_id String
  
  /// Unique order identifier for customer reference and tracking.
  order_number String
  
  /// Current order status (pending, processing, shipped, delivered, cancelled,
  /// completed).
  status String
  
  /// Internal business status for workflow management and reporting.
  business_status String
  
  /// Total order amount including products, shipping, and taxes.
  total_amount Float
  
  /// Order subtotal before shipping and taxes.
  subtotal_amount Float
  
  /// Shipping cost for the order.
  shipping_amount Float
  
  /// Tax amount calculated for the order.
  tax_amount Float
  
  /// Currency code for order amounts (e.g., USD, EUR, GBP).
  currency String
  
  /// Customer notes or special instructions for the order.
  notes String?
  
  /// Estimated delivery date provided to customer.
  estimated_delivery_date DateTime?
  
  /// Actual delivery date when order is completed.
  actual_delivery_date DateTime?
  
  /// Order creation timestamp.
  created_at DateTime
  
  /// Last order update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp for order cancellation or archival.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer ecommerce_mall_customers @relation(fields: [ecommerce_mall_customer_id], references: [id], onDelete: Cascade)
  seller ecommerce_mall_sellers @relation(fields: [ecommerce_mall_seller_id], references: [id], onDelete: Cascade)
  shippingAddress ecommerce_mall_customer_addresses @relation("ecommerce_mall_orders_of_shipping_address_id", fields: [shipping_address_id], references: [id], onDelete: Cascade)
  billingAddress ecommerce_mall_customer_addresses @relation("ecommerce_mall_orders_of_billing_address_id", fields: [billing_address_id], references: [id], onDelete: Cascade)
  
  ecommerce_mall_order_items ecommerce_mall_order_items[]
  ecommerce_mall_payments ecommerce_mall_payments[]
  ecommerce_mall_shipments ecommerce_mall_shipments[]
  ecommerce_mall_reviews ecommerce_mall_reviews[]
  ecommerce_mall_customer_order_history ecommerce_mall_customer_order_history?
  ecommerce_mall_customer_order_summaries ecommerce_mall_customer_order_summaries?
  
  @@index([shipping_address_id])
  @@index([billing_address_id])
  
  @@unique([order_number])
  @@index([ecommerce_mall_customer_id, created_at])
  @@index([ecommerce_mall_seller_id, created_at])
  @@index([status, created_at])
  @@index([estimated_delivery_date])
}

/// Individual items within an order, representing specific products purchased.
///
/// Each order item corresponds to a product variant selected by the
/// customer, with quantity and pricing details. Items maintain references to
/// both the parent order and the original product for inventory tracking and
/// customer reference.
///
/// Order items support complex product configurations through associated
/// option records, enabling detailed order tracking and accurate fulfillment
/// processing. The total_price field has been removed to maintain 3NF
/// compliance - this should be calculated at application level.
///
/// Items now include enhanced status tracking and seller references for
/// improved fulfillment management.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_order_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent order containing this item. {@link ecommerce_mall_orders.id}
  ecommerce_mall_order_id String
  
  /// Product variant purchased by customer. {@link
  /// ecommerce_mall_product_variants.id}
  ecommerce_mall_product_variant_id String
  
  /// Seller responsible for this item's fulfillment. {@link
  /// ecommerce_mall_sellers.id}
  ecommerce_mall_seller_id String
  
  /// Quantity of the product variant ordered.
  quantity Int
  
  /// Price per unit at time of purchase.
  unit_price Float
  
  /// Item fulfillment status (pending, allocated, shipped, delivered,
  /// cancelled, returned).
  status String
  
  /// Quantity allocated from inventory for this order item.
  allocated_quantity Int
  
  /// Quantity shipped to customer for this order item.
  shipped_quantity Int
  
  /// Quantity cancelled from this order item.
  cancelled_quantity Int
  
  /// Item creation timestamp.
  created_at DateTime
  
  /// Last item update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp for item cancellation.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  order ecommerce_mall_orders @relation(fields: [ecommerce_mall_order_id], references: [id], onDelete: Cascade)
  productVariant ecommerce_mall_product_variants @relation(fields: [ecommerce_mall_product_variant_id], references: [id], onDelete: Cascade)
  seller ecommerce_mall_sellers @relation(fields: [ecommerce_mall_seller_id], references: [id], onDelete: Cascade)
  
  ecommerce_mall_order_item_options ecommerce_mall_order_item_options[]
  
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_order_id, created_at], map: "ecommerce_mall_order_items_ecommerce_mall_order_id_cre_a44064e3")
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_product_variant_id], map: "ecommerce_mall_order_items_ecommerce_mall_product_vari_9fcb9a09")
  @@index([ecommerce_mall_seller_id, status])
  @@index([status])
}

