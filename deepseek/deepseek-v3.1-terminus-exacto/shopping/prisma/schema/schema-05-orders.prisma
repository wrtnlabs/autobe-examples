  shopping_mall_product_variant_id String
  
  /// Seller who provided the product. {@link shopping_mall_sellers.id}
  shopping_mall_seller_id String
  
  /// Quantity of the product variant ordered.
  quantity Int
  
  /// Price per unit at the time of order.
  unit_price Float
  
  /// Total price for this line item (quantity * unit_price).
  total_price Float
  
  /// Product name as it appeared when ordered.
  product_name String
  
  /// JSON string containing product attributes at order time.
  product_attributes String?
  
  /// Item creation timestamp.
  created_at DateTime
  
  /// Last item update timestamp.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
