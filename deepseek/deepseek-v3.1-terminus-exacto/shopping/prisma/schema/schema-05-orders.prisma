/// Payment records associated with customer orders.
///
/// Stores comprehensive payment information including transaction details,
/// payment method, status, and processing history. Each payment record links
/// to a specific order and maintains audit trails for financial compliance
/// and customer service.
///
/// Supports multiple payment methods including credit cards, digital
/// wallets, and bank transfers, with secure handling of payment data through
/// tokenization and compliance with financial regulations. Enhanced with
/// seller references for payment distribution tracking.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_payments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Order being paid. {@link ecommerce_mall_orders.id}
  ecommerce_mall_order_id String
  
  /// Customer making the payment. {@link ecommerce_mall_customers.id}
  ecommerce_mall_customer_id String
  
  /// Seller receiving payment distribution. {@link ecommerce_mall_sellers.id}
  ecommerce_mall_seller_id String
  
  /// Payment method used (credit_card, paypal, bank_transfer, etc.).
  payment_method String
  
  /// Payment gateway processor used for transaction.
  payment_gateway String
  
  /// Unique transaction identifier from payment gateway.
  transaction_id String
  
  /// Payment amount processed.
  amount Float
  
  /// Currency code for payment amount.
  currency String
  
  /// Payment status (pending, processing, completed, failed, refunded,
  /// partially_refunded).
  status String
  
  /// Reason for payment failure if applicable.
  failure_reason String?
  
  /// Timestamp when payment was processed by gateway.
  processed_at DateTime?
  
  /// Amount refunded to customer if applicable.
  refunded_amount Float?
  
  /// Timestamp when refund was processed.
  refunded_at DateTime?
  
  /// Amount distributed to seller after fees and commissions.
  seller_amount Float?
  
  /// Platform commission deducted from payment.
  commission_amount Float?
  
  /// Payment record creation timestamp.
