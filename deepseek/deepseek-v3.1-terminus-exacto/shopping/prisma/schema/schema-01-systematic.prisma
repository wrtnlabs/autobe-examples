  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent category's {@link ecommerce_mall_categories.id} for hierarchical
  /// organization. Null for top-level categories.
  parent_id String?
  
  /// Unique category name used for display and organization. Must be distinct
  /// across all categories.
  name String
  
  /// Detailed category description explaining the product scope and
  /// organizational purpose.
  description String?
  
  /// Unique category code used for system reference and API identification.
  code String
  
  /// Category status controlling visibility and functionality. Valid values:
  /// 'active', 'inactive', 'archived'.
  status String
  
  /// Numerical order for category display sequence. Lower numbers appear first.
  sort_order Int
  
  /// Timestamp when the category was first created in the system.
