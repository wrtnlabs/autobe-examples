/// Core order entity representing customer purchases. Contains order
/// metadata, customer information, and order status tracking. Each order
/// represents a complete transaction from placement to fulfillment.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_orders {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who placed the order. {@link shopping_mall_customers.id}
  shopping_mall_customer_id String
  
  /// Session context when order was placed. {@link
  /// shopping_mall_customer_sessions.id}
  shopping_mall_customer_session_id String
  
  /// Unique order identifier for customer reference.
  order_number String
  
  /// Current order status (pending, confirmed, processing, shipped, delivered,
  /// cancelled, refunded).
  status String
  
  /// Total order amount including products, shipping, and taxes.
  total_amount Float
  
  /// Currency code for the order transaction.
  currency String
  
  /// Complete shipping address for order delivery.
  shipping_address String
  
  /// Billing address for payment processing.
  billing_address String
  
  /// Customer instructions for order handling.
  special_instructions String?
  
  /// Order creation timestamp.
  created_at DateTime
  
  /// Last order update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp for order cancellation.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  customerSession shopping_mall_customer_sessions @relation(fields: [shopping_mall_customer_session_id], references: [id], onDelete: Cascade)
  
  shopping_mall_order_items shopping_mall_order_items[]
  shopping_mall_payments shopping_mall_payments?
  shopping_mall_shipping shopping_mall_shipping?
  shopping_mall_order_tracking shopping_mall_order_tracking[]
  shopping_mall_reviews shopping_mall_reviews[]
  shopping_mall_ratings shopping_mall_ratings[]
  shopping_mall_support_tickets shopping_mall_support_tickets[]
  
  @@index([shopping_mall_customer_session_id])
  
  @@unique([order_number])
  @@index([shopping_mall_customer_id, created_at])
  @@index([status])
  @@index([created_at])
}

/// Individual items within an order. Links products and variants to orders
/// with specific quantities and pricing at time of purchase.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_order_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent order containing this item. {@link shopping_mall_orders.id}
  shopping_mall_order_id String
  
  /// Product purchased in this order item. {@link shopping_mall_products.id}
  shopping_mall_product_id String
  
  /// Specific product variant purchased. {@link
  /// shopping_mall_product_variants.id}
  shopping_mall_product_variant_id String?
  
  /// Quantity of the product variant ordered.
  quantity Int
  
  /// Price per unit at time of order placement.
  unit_price Float
  
  /// Total price for this line item (quantity × unit_price).
  total_price Float
  
  /// Currency code matching the parent order.
  currency String
  
  /// Order item creation timestamp.
  created_at DateTime
  
  /// Last order item update timestamp.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  productVariant shopping_mall_product_variants? @relation(fields: [shopping_mall_product_variant_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_mall_product_variant_id])
  
  @@index([shopping_mall_order_id])
  @@index([shopping_mall_product_id])
}

/// Payment transactions associated with orders. Tracks payment methods,
/// amounts, status, and processing details.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_payments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Order being paid. {@link shopping_mall_orders.id}
  shopping_mall_order_id String
  
  /// Session context during payment processing. {@link
  /// shopping_mall_customer_sessions.id}
  shopping_mall_customer_session_id String
  
  /// Payment method used (credit_card, paypal, bank_transfer,
  /// cash_on_delivery).
  payment_method String
  
  /// Current payment status (pending, authorized, completed, failed, refunded).
  payment_status String
  
  /// Payment amount processed.
  amount Float
  
  /// Currency code for the payment.
  currency String
  
  /// External payment gateway transaction identifier.
  transaction_id String?
  
  /// Raw response from payment gateway for debugging.
  gateway_response String?
  
  /// Payment creation timestamp.
  created_at DateTime
  
  /// Last payment update timestamp.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  customerSession shopping_mall_customer_sessions @relation(fields: [shopping_mall_customer_session_id], references: [id], onDelete: Cascade)
  
  @@unique([shopping_mall_order_id])
  @@index([shopping_mall_customer_session_id])
  
  @@unique([transaction_id])
  @@index([shopping_mall_order_id])
  @@index([payment_status])
  @@index([created_at])
}

/// Shipping information and carrier details for order fulfillment. Tracks
/// shipping methods, costs, and delivery estimates.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_shipping {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Order being shipped. {@link shopping_mall_orders.id}
  shopping_mall_order_id String
  
  /// Shipping carrier and service level (standard, express, overnight).
  shipping_method String
  
  /// Cost of shipping for this order.
  shipping_cost Float
  
  /// Carrier tracking number for package tracking.
  tracking_number String?
  
  /// Name of shipping carrier (FedEx, UPS, DHL, etc.).
  carrier_name String?
  
  /// Estimated delivery date provided by carrier.
  estimated_delivery DateTime?
  
  /// Actual delivery timestamp when package is delivered.
  actual_delivery DateTime?
  
  /// Shipping record creation timestamp.
  created_at DateTime
  
  /// Last shipping update timestamp.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  
  @@unique([shopping_mall_order_id])
  
  @@unique([tracking_number])
  @@index([shopping_mall_order_id])
  @@index([estimated_delivery])
}

/// Historical tracking events for order lifecycle. Captures status changes,
/// payment events, and shipping updates for audit trail.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_order_tracking {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Order being tracked. {@link shopping_mall_orders.id}
  shopping_mall_order_id String
  
  /// Type of tracking event (status_change, payment_processed,
  /// shipping_update, etc.).
  event_type String
  
  /// Detailed description of the tracking event.
  event_description String
  
  /// Order status before this event occurred.
  previous_status String?
  
  /// Order status after this event occurred.
  new_status String?
  
  /// Tracking event creation timestamp.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_order_id, created_at], map: "shopping_mall_order_tracking_shopping_mall_order_id_cr_5f2eb82a")
  @@index([event_type])
}