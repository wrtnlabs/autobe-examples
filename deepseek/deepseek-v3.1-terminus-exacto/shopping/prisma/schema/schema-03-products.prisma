/// Hierarchical product category structure for organizing the e-commerce
/// catalog.
///
/// Supports unlimited nesting levels with parent-child relationships to
/// create a comprehensive category tree. Each category can contain multiple
/// products and subcategories, enabling flexible product organization.
///
/// Categories maintain their own metadata including descriptions, images,
/// and display preferences. The hierarchy supports breadcrumb navigation and
/// efficient product filtering by category paths.
///
/// Soft deletion is supported to maintain historical relationships while
/// allowing category restructuring.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent category reference for hierarchical structure. {@link
  /// ecommerce_mall_categories.id}.
  parent_id String?
  
  /// Category name used for display and navigation.
  name String
  
  /// Detailed category description for administrative and customer reference.
  description String?
  
  /// URL-friendly category identifier for SEO optimization.
  slug String
  
  /// Category image URL for visual representation in the catalog.
  image_url String?
  
  /// Sort order for category display in navigation menus.
  display_order Int
  
  /// Category status: active, inactive, or archived.
  status String
  
  /// Category creation timestamp.
  created_at DateTime
  
  /// Last category update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp for category archiving.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  parent ecommerce_mall_categories? @relation("recursive", fields: [parent_id], references: [id], onDelete: Cascade)
  
  recursive ecommerce_mall_categories[] @relation("recursive")
  ecommerce_mall_products ecommerce_mall_products[]
  
  @@unique([slug])
  @@index([parent_id, display_order])
  @@index([status, display_order])
}

/// Core product catalog containing all sellable items in the e-commerce
/// platform.
///
/// Stores comprehensive product information including titles, descriptions,
/// pricing, and metadata. Products belong to categories and are associated
/// with sellers who manage their inventory and sales.
///
/// Each product can have multiple variants with specific attributes like
/// color, size, or material. Products support rich media with multiple
/// images and detailed specifications.
///
/// The product lifecycle includes creation, approval, activation, and
/// eventual retirement with full audit trail support.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product category assignment. {@link ecommerce_mall_categories.id}.
  ecommerce_mall_category_id String
  
  /// Seller who owns and manages this product. {@link
  /// ecommerce_mall_sellers.id}.
  ecommerce_mall_seller_id String
  
  /// Product name for display and search.
  name String
  
  /// Detailed product description with features and specifications.
  description String
  
  /// Stock Keeping Unit - unique product identifier.
  sku String
  
  /// Product brand or manufacturer name.
  brand String?
  
  /// Standard product price before discounts.
  base_price Float
  
  /// Current sale price if applicable.
  sale_price Float?
  
  /// Product cost for margin calculation.
  cost_price Float?
  
  /// Product status: draft, pending, active, inactive, discontinued.
  status String
  
  /// Flag indicating featured product status for promotions.
  is_featured Boolean
  
  /// Flag indicating digital/virtual product (no shipping required).
  is_virtual Boolean
  
  /// Product weight for shipping calculations.
  weight Float?
  
  /// Product dimensions (LxWxH) for packaging.
  dimensions String?
  
  /// Product creation timestamp.
  created_at DateTime
  
  /// Last product update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp for product retirement.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  category ecommerce_mall_categories @relation(fields: [ecommerce_mall_category_id], references: [id], onDelete: Cascade)
  seller ecommerce_mall_sellers @relation(fields: [ecommerce_mall_seller_id], references: [id], onDelete: Cascade)
  
  ecommerce_mall_product_variants ecommerce_mall_product_variants[]
  ecommerce_mall_seller_products ecommerce_mall_seller_products[]
  ecommerce_mall_reviews ecommerce_mall_reviews[]
  
  @@unique([sku])
  @@unique([ecommerce_mall_seller_id, sku])
  @@index([ecommerce_mall_category_id, status])
  @@index([ecommerce_mall_seller_id, status])
  @@index([base_price])
  @@index([status, is_featured])
  @@index([created_at])
}

/// Product variants representing different versions of a base product with
/// specific attributes.
///
/// Each variant corresponds to a unique SKU with distinct pricing,
/// inventory, and attribute combinations. Variants enable customers to
/// choose specific product options like size, color, or material.
///
/// Variants inherit core product information while maintaining their own
/// pricing adjustments and variant-specific images. This allows for
/// efficient management of product variations without duplicating common
/// attributes.
///
/// The variant system supports complex product configurations with multiple
/// attribute dimensions. Current price is calculated dynamically from base
/// product price plus variant adjustment to maintain normalization.
///
/// Soft deletion is supported to maintain historical relationships while
/// allowing variant retirement.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_product_variants {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product that this variant belongs to. {@link
  /// ecommerce_mall_products.id}.
  ecommerce_mall_product_id String
  
  /// Unique SKU for this specific product variant.
  variant_sku String
  
  /// Variant-specific name or description.
  variant_name String?
  
  /// Price difference from base product price (can be positive or negative).
  price_adjustment Float
  
  /// Variant status: active, inactive, out_of_stock.
  status String
  
  /// Variant-specific image URL.
  image_url String?
  
  /// Variant creation timestamp.
  created_at DateTime
  
  /// Last variant update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp for variant removal.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product ecommerce_mall_products @relation(fields: [ecommerce_mall_product_id], references: [id], onDelete: Cascade)
  
  ecommerce_mall_product_variant_options ecommerce_mall_product_variant_options[]
  ecommerce_mall_inventory ecommerce_mall_inventory?
  ecommerce_mall_inventory_snapshots ecommerce_mall_inventory_snapshots[]
  ecommerce_mall_cart_items ecommerce_mall_cart_items[]
  ecommerce_mall_wishlist_items ecommerce_mall_wishlist_items[]
  ecommerce_mall_order_items ecommerce_mall_order_items[]
  
  @@unique([variant_sku])
  // spellchecker: ignore-next-line
  @@unique([ecommerce_mall_product_id, variant_sku], map: "ecommerce_mall_product_variants_ecommerce_mall_product_b619d943")
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_product_id, status], map: "ecommerce_mall_product_variants_ecommerce_mall_product_c90c3102")
  @@index([price_adjustment])
  @@index([status])
}

/// Individual attribute options that define specific product variants.
///
/// Stores the actual attribute values that differentiate variants, such as
/// "Red" for color or "Large" for size. Each option belongs to a variant and
/// represents one dimension of the product configuration.
///
/// Options enable flexible product attribute management and support complex
/// variant combinations. The system can handle multiple attribute types
/// including colors, sizes, materials, and custom options.
///
/// This table supports the variant selection process by providing the
/// specific attribute values for each available variant. Soft deletion is
/// added for consistency with other entities.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_product_variant_options {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product variant that this option belongs to. {@link
  /// ecommerce_mall_product_variants.id}.
  ecommerce_mall_product_variant_id String
  
  /// Type of attribute: color, size, material, etc.
  attribute_type String
  
  /// Specific value for this attribute option.
  attribute_value String
  
  /// Sort order for attribute display in selection interfaces.
  display_order Int
  
  /// Option creation timestamp.
  created_at DateTime
  
  /// Last option update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp for option removal.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  variant ecommerce_mall_product_variants @relation(fields: [ecommerce_mall_product_variant_id], references: [id], onDelete: Cascade)
  
  ecommerce_mall_cart_item_options ecommerce_mall_cart_item_options[]
  ecommerce_mall_order_item_options ecommerce_mall_order_item_options[]
  
  // spellchecker: ignore-next-line
  @@unique([ecommerce_mall_product_variant_id, attribute_type], map: "ecommerce_mall_product_variant_options_ecommerce_mall__244e839b")
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_product_variant_id, display_order], map: "ecommerce_mall_product_variant_options_ecommerce_mall__2a87a186")
  @@index([attribute_type])
}

/// Real-time inventory tracking for product variants with stock level
/// management.
///
/// Maintains current stock quantities, reserved quantities for pending
/// orders, and supports inventory thresholds for low stock alerts. The
/// available stock is calculated dynamically from current stock minus
/// reserved stock to maintain normalization.
///
/// The inventory system prevents overselling by reserving stock during
/// checkout and provides real-time availability information to customers.
/// Supports multiple inventory management strategies including just-in-time
/// and safety stock levels.
///
/// Inventory updates are transactional to ensure data consistency during
/// high-volume order processing. Soft deletion is supported for inventory
/// record archiving.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_inventory {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product variant being tracked. {@link ecommerce_mall_product_variants.id}.
  ecommerce_mall_product_variant_id String
  
  /// Current physical inventory quantity available.
  current_stock Int
  
  /// Quantity reserved for pending orders.
  reserved_stock Int
  
  /// Stock level that triggers low inventory alerts.
  low_stock_threshold Int
  
  /// Stock level that triggers reorder recommendations.
  reorder_point Int
  
  /// Inventory status: in_stock, low_stock, out_of_stock.
  status String
  
  /// Date when inventory was last replenished.
  last_restock_date DateTime?
  
  /// Inventory record creation timestamp.
  created_at DateTime
  
  /// Last inventory update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp for inventory record archiving.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  variant ecommerce_mall_product_variants @relation(fields: [ecommerce_mall_product_variant_id], references: [id], onDelete: Cascade)
  
  @@unique([ecommerce_mall_product_variant_id])
  
  @@index([status])
  @@index([current_stock])
  @@index([low_stock_threshold])
  @@index([last_restock_date])
}

/// Historical inventory records capturing point-in-time stock levels for
/// audit and analytics.
///
/// Provides complete inventory history for tracking stock movements, sales
/// patterns, and inventory accuracy. Each snapshot captures the inventory
/// state before and after significant events like sales, returns, or stock
/// adjustments.
///
/// The snapshot system supports inventory reconciliation, trend analysis,
/// and compliance reporting. Helps identify inventory discrepancies and
/// provides data for demand forecasting and purchasing decisions.
///
/// Snapshots are append-only and preserve the complete inventory history for
/// each product variant.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_inventory_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product variant being snapshotted. {@link
  /// ecommerce_mall_product_variants.id}.
  ecommerce_mall_product_variant_id String
  
  /// Stock quantity before the inventory change.
  previous_stock Int
  
  /// Stock quantity after the inventory change.
  new_stock Int
  
  /// Net change in stock quantity (positive for additions, negative for
  /// deductions).
  change_amount Int
  
  /// Type of inventory change: sale, return, adjustment, restock.
  change_type String
  
  /// Description or reference for the inventory change.
  change_reason String?
  
  /// Timestamp when the snapshot was taken.
  snapshot_date DateTime
  
  //----
  // RELATIONS
  //----
  variant ecommerce_mall_product_variants @relation(fields: [ecommerce_mall_product_variant_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_product_variant_id, snapshot_date], map: "ecommerce_mall_inventory_snapshots_ecommerce_mall_prod_3bd0fde6")
  // spellchecker: ignore-next-line
  @@index([change_type, snapshot_date], map: "ecommerce_mall_inventory_snapshots_change_type_snapsho_0b8a759d")
  @@index([snapshot_date])
}