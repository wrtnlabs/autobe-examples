/// Coupon codes that customers can apply to their orders for discounts.
/// Coupons can be general or customer-specific with usage limits and
/// expiration dates.
///
/// @namespace Promotions
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_coupons {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Optional customer who owns this coupon. {@link shopping_mall_customers.id}
  shopping_mall_customer_id String?
  
  /// Optional sale this coupon is associated with. {@link
  /// shopping_mall_sales.id}
  shopping_mall_sale_id String?
  
  /// Unique coupon code that customers enter during checkout.
  code String
  
  /// Type of discount: percentage or fixed_amount.
  discount_type String
  
  /// Value of the discount based on discount_type.
  discount_value Float
  
  /// Minimum order amount required to use this coupon.
  minimum_order_amount Float?
  
  /// Maximum discount amount for percentage-based coupons.
  maximum_discount Float?
  
  /// Maximum number of times this coupon can be used.
  usage_limit Int?
  
  /// Number of times this coupon has been used.
  used_count Int
  
  /// Date and time when the coupon becomes valid.
  valid_from DateTime
  
  /// Date and time when the coupon expires.
  valid_until DateTime
  
  /// Coupon status: active, expired, cancelled, or used_up.
  status String
  
  /// When this coupon was created.
  created_at DateTime
  
  /// When this coupon was last updated.
  updated_at DateTime
  
  /// When this coupon was soft deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_mall_customers? @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  sale shopping_mall_sales? @relation(fields: [shopping_mall_sale_id], references: [id], onDelete: Cascade)
  
  shopping_mall_discounts shopping_mall_discounts[]
  
  @@index([shopping_mall_sale_id])
  
  @@index([status, valid_until])
  @@index([shopping_mall_customer_id, status])
  @@index([valid_from, valid_until])
}

/// Marketing promotions and campaigns that can include discounts, special
/// offers, or bundled products. Promotions can be targeted to specific
/// customers, products, or categories.
///
/// @namespace Promotions
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_promotions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Optional seller who created this promotion. {@link
  /// shopping_mall_sellers.id}
  shopping_mall_seller_id String?
  
  /// Optional product this promotion applies to. {@link
  /// shopping_mall_products.id}
  shopping_mall_product_id String?
  
  /// Optional category this promotion applies to. {@link
  /// shopping_mall_categories.id}
  shopping_mall_category_id String?
  
  /// Name of the promotion for administrative purposes.
  name String
  
  /// Detailed description of the promotion for customers.
  description String?
  
  /// Type of promotion: discount, bundle, buy_x_get_y, free_shipping, etc.
  promotion_type String
  
  /// Percentage discount for discount-type promotions.
  discount_percentage Float?
  
  /// Fixed amount discount for discount-type promotions.
  discount_amount Float?
  
  /// Buy quantity for buy_x_get_y promotions.
  buy_quantity Int?
  
  /// Get quantity for buy_x_get_y promotions.
  get_quantity Int?
  
  /// Minimum order amount required for the promotion.
  minimum_order_amount Float?
  
  /// Maximum discount amount for percentage-based promotions.
  maximum_discount Float?
  
  /// When the promotion becomes active.
  start_date DateTime
  
  /// When the promotion expires.
  end_date DateTime
  
  /// Promotion status: draft, active, paused, expired, or cancelled.
  status String
  
  /// Whether the promotion is visible to customers.
  is_visible Boolean
  
  /// Maximum number of times this promotion can be used.
  usage_limit Int?
  
  /// Number of times this promotion has been used.
  used_count Int
  
  /// When this promotion was created.
  created_at DateTime
  
  /// When this promotion was last updated.
  updated_at DateTime
  
  /// When this promotion was soft deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  seller shopping_mall_sellers? @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  product shopping_mall_products? @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  category shopping_mall_categories? @relation(fields: [shopping_mall_category_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_mall_product_id])
  @@index([shopping_mall_category_id])
  
  @@index([status, end_date])
  @@index([promotion_type, status])
  @@index([shopping_mall_seller_id, status])
  @@index([start_date, end_date])
}

/// Discount rules that can be applied to products, categories, or orders.
/// Discounts can be automatic or require coupon codes, with various
/// calculation methods.
///
/// @namespace Promotions
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_discounts {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Optional product this discount applies to. {@link
  /// shopping_mall_products.id}
  shopping_mall_product_id String?
  
  /// Optional category this discount applies to. {@link
  /// shopping_mall_categories.id}
  shopping_mall_category_id String?
  
  /// Optional coupon required to activate this discount. {@link
  /// shopping_mall_coupons.id}
  shopping_mall_coupon_id String?
  
  /// Name of the discount rule for administrative purposes.
  name String
  
  /// Description of the discount rule.
  description String?
  
  /// Type of discount: percentage, fixed_amount, buy_x_get_y, etc.
  discount_type String
  
  /// Value of the discount based on discount_type.
  discount_value Float
  
  /// How the discount is calculated: pre_tax, post_tax, etc.
  calculation_method String
  
  /// Minimum quantity required for the discount to apply.
  minimum_quantity Int?
  
  /// Maximum quantity the discount applies to.
  maximum_quantity Int?
  
  /// Minimum order amount required for the discount.
  minimum_order_amount Float?
  
  /// Maximum discount amount for percentage-based discounts.
  maximum_discount Float?
  
  /// When the discount becomes active.
  start_date DateTime
  
  /// When the discount expires.
  end_date DateTime
  
  /// Discount status: active, inactive, expired, or cancelled.
  status String
  
  /// Whether the discount applies automatically or requires a coupon.
  is_automatic Boolean
  
  /// Priority level for discount application order.
  priority Int
  
  /// Maximum number of times this discount can be used.
  usage_limit Int?
  
  /// Number of times this discount has been used.
  used_count Int
  
  /// When this discount was created.
  created_at DateTime
  
  /// When this discount was last updated.
  updated_at DateTime
  
  /// When this discount was soft deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products? @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  category shopping_mall_categories? @relation(fields: [shopping_mall_category_id], references: [id], onDelete: Cascade)
  coupon shopping_mall_coupons? @relation(fields: [shopping_mall_coupon_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_mall_product_id])
  @@index([shopping_mall_category_id])
  @@index([shopping_mall_coupon_id])
  
  @@index([status, end_date])
  @@index([discount_type, status])
  @@index([is_automatic, status])
  @@index([priority, status])
  @@index([start_date, end_date])
}