/// Detailed rating breakdowns for comprehensive review evaluations.
///
/// Stores individual rating components that make up the overall review
/// score. Each rating record belongs to a specific review and provides
/// detailed evaluation across multiple dimensions.
///
/// Ratings support detailed product or service evaluation with specific
/// criteria scoring, enabling comprehensive analysis of review quality and
/// specific area performance. As subsidiary entities, ratings are managed
/// through parent review operations.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_review_ratings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent review that this rating belongs to. {@link
  /// shopping_mall_reviews.id}
  shopping_mall_review_id String
  
  /// Type of rating: quality, value, service, delivery, etc.
  rating_type String
  
  /// Rating score from 1.0 to 5.0 for this specific dimension.
  score Float
  
  /// Weight factor for calculating overall rating importance.
  weight Float
  
  /// Timestamp when the rating was created.
  created_at DateTime
  
  /// Timestamp when the rating was last modified.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  review shopping_mall_reviews @relation(fields: [shopping_mall_review_id], references: [id], onDelete: Cascade)
  
  shopping_mall_review_rating_of_customers shopping_mall_review_rating_of_customers?
  shopping_mall_review_rating_of_sellers shopping_mall_review_rating_of_sellers?
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_review_id, rating_type], map: "shopping_mall_review_ratings_shopping_mall_review_id_r_1bf6f5d8")
  @@index([rating_type])
  @@index([score])
  @@index([created_at])
}

