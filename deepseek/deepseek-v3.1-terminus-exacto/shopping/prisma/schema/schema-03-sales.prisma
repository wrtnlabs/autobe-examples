/// Main images are prioritized for product listings while additional images
/// provide comprehensive product views.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_images {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product that owns these images. {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// URL pointing to the stored product image.
  image_url String
  
  /// Alternative text for accessibility and SEO purposes.
  alt_text String?
  
  /// Whether this is the main product image for listings.
  is_primary Boolean
  
  /// Sorting order for image display in product galleries.
  display_order Int
  
  /// Timestamp when the image was uploaded.
  created_at DateTime
  
  /// Timestamp when the image was last modified.
  updated_at DateTime
  
  /// Timestamp when the image was soft deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, display_order], map: "shopping_mall_product_images_shopping_mall_product_id__1e493e13")
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, is_primary], map: "shopping_mall_product_images_shopping_mall_product_id__36ad223d")
}

/// Sales transactions representing completed purchases in the shopping mall.
///
/// Records finalized sales with complete transaction details including
/// pricing, quantities, and customer information. Sales are created when
/// orders are successfully paid and processed.
///
/// Each sale links to the original order for tracking purposes and includes
/// financial details for accounting and reporting. Sales data is used for
/// analytics, seller payouts, and business intelligence.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_sales {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Original order that generated this sale. {@link shopping_mall_orders.id}.
  shopping_mall_order_id String
  
  /// Customer who made the purchase. {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Seller who received the sale. {@link shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Total sale amount including taxes and shipping.
  sale_amount Float
  
  /// Total number of items sold in this transaction.
  item_count Int
  
  /// Current status of the sale: completed, refunded, disputed.
  sale_status String
  
  /// Platform commission percentage applied to this sale.
  commission_rate Float
  
  /// Final amount after commission and fees for seller payout.
  net_amount Float
  
  /// Timestamp when the sale was finalized.
  sale_date DateTime
  
  /// Timestamp when the sale record was created.
  created_at DateTime
  
  /// Timestamp when the sale was last modified.
  updated_at DateTime
  
  /// Timestamp when the sale was soft deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  
  shopping_mall_sale_snapshots shopping_mall_sale_snapshots[]
  
  @@unique([shopping_mall_order_id])
  @@index([shopping_mall_customer_id, sale_date])
  @@index([shopping_mall_seller_id, sale_date])
  @@index([sale_status, sale_date])
  @@index([sale_amount])
}

/// Historical snapshots of sales data for audit trails and reporting.
///
/// Captures point-in-time state of sales transactions for historical
/// accuracy and compliance. Snapshots preserve sales data as it existed at
/// the time of transaction, protecting against later modifications.
///
/// Used for financial reporting, audit trails, and historical analysis. Each
/// snapshot represents the complete state of a sale at a specific moment,
/// including all financial details and status information.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_sale_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Original sale that this snapshot captures. {@link shopping_mall_sales.id}.
  shopping_mall_sale_id String
  
  /// JSON representation of complete sale state at snapshot time.
  sale_data String
  
  /// Reason for creating this snapshot: audit, refund, status_change.
  snapshot_reason String
  
  /// Timestamp when the snapshot was created.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  sale shopping_mall_sales @relation(fields: [shopping_mall_sale_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_sale_id, created_at], map: "shopping_mall_sale_snapshots_shopping_mall_sale_id_cre_36e298a1")
  @@index([snapshot_reason, created_at])
}