/// Hierarchical product category system for organizing products in the
/// shopping mall.
///
/// Provides a structured categorization system with parent-child
/// relationships for flexible product organization. Categories can be nested
/// to create multi-level hierarchies for better product discovery and
/// navigation.
///
/// Each category includes metadata for display purposes and can be managed
/// independently by administrators. Categories support soft deletion to
/// maintain referential integrity while allowing content moderation.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent category reference for hierarchical structure. {@link
  /// shopping_mall_categories.id}.
  parent_id String?
  
  /// Category name displayed to users.
  name String
  
  /// Detailed description explaining the category purpose and contents.
  description String?
  
  /// Sorting order for category display in listings.
  display_order Int
  
  /// Whether the category is visible and available for product assignment.
  active Boolean
  
  /// Timestamp when the category was created.
  created_at DateTime
  
  /// Timestamp when the category was last modified.
  updated_at DateTime
  
  /// Timestamp when the category was soft deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  parent shopping_mall_categories? @relation("recursive", fields: [parent_id], references: [id], onDelete: Cascade)
  
  recursive shopping_mall_categories[] @relation("recursive")
  shopping_mall_products shopping_mall_products[]
  shopping_mall_promotion_rules shopping_mall_promotion_rules[]
  
  @@unique([name])
  @@index([parent_id, display_order])
  @@index([active, display_order])
}

/// Core product catalog containing all items available for sale in the
/// shopping mall.
///
/// Stores comprehensive product information including pricing, inventory,
/// and categorization details. Products are created by sellers and managed
/// through the seller dashboard with administrative oversight.
///
/// Products support multiple variants, attributes, and images to provide
/// rich product experiences. Inventory tracking ensures accurate stock
/// management and prevents overselling.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Primary category assignment for product organization. {@link
  /// shopping_mall_categories.id}.
  shopping_mall_category_id String
  
  /// Seller who owns and manages this product. {@link
  /// shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Product name displayed to customers.
  name String
  
  /// Detailed product description with features and specifications.
  description String
  
  /// Stock Keeping Unit identifier unique per seller.
  sku String
  
  /// Current selling price of the product.
  price Float
  
  /// Original price for comparison (strikethrough pricing).
  compare_price Float?
  
  /// Cost price for margin calculation.
  cost_price Float?
  
  /// Current available inventory quantity.
  stock_quantity Int
  
  /// Product status: draft, active, inactive, archived.
  status String
  
  /// Product condition: new, used, refurbished.
  condition String
  
  /// Product weight for shipping calculations.
  weight Float?
  
  /// Product dimensions (LxWxH) for shipping.
  dimensions String?
  
  /// Timestamp when the product was created.
  created_at DateTime
  
  /// Timestamp when the product was last modified.
  updated_at DateTime
  
  /// Timestamp when the product was soft deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  category shopping_mall_categories @relation(fields: [shopping_mall_category_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  
  shopping_mall_product_attributes shopping_mall_product_attributes[]
  shopping_mall_product_variants shopping_mall_product_variants[]
  shopping_mall_product_images shopping_mall_product_images[]
  shopping_mall_promotion_rules shopping_mall_promotion_rules[]
  shopping_mall_reviews shopping_mall_reviews[]
  shopping_mall_wishlist_items shopping_mall_wishlist_items[]
  shopping_mall_favorites shopping_mall_favorites[]
  
  @@unique([shopping_mall_seller_id, sku])
  @@index([shopping_mall_category_id, status])
  @@index([status, created_at])
  @@index([price])
  @@index([stock_quantity])
}

/// Product-specific attributes and specifications for detailed product
/// information.
///
/// Stores attribute values that define product characteristics like size,
/// color, material, and technical specifications. Attributes are associated
