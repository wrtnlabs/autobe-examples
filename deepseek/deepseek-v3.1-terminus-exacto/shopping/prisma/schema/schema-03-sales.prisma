/// and product comparison features.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_attributes {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product that owns these attributes. {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Name of the attribute (e.g., Color, Size, Material).
  attribute_name String
  
  /// Value of the attribute (e.g., Red, Large, Cotton).
  attribute_value String
  
  /// Sorting order for attribute display on product pages.
  display_order Int
  
  /// Timestamp when the attribute was created.
  created_at DateTime
  
  /// Timestamp when the attribute was last modified.
  updated_at DateTime
  
  /// Timestamp when the attribute was soft deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_product_id, attribute_name], map: "shopping_mall_product_attributes_shopping_mall_product_fd79683f")
  // spellchecker: ignore-next-line
  @@index([attribute_name, attribute_value], map: "shopping_mall_product_attributes_attribute_name_attrib_9fcc9d80")
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, display_order], map: "shopping_mall_product_attributes_shopping_mall_product_d1fcc32e")
}

/// Product variations with different attributes like size, color, or style
/// options.
///
/// Manages product variants that share the same base product but have
/// different attribute combinations. Each variant can have unique pricing,
/// inventory, and SKU information.
///
/// Supports complex product configurations where customers can select from
/// multiple options. Variants are essential for products with multiple
/// options like clothing sizes or electronics models.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_variants {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product that this variant belongs to. {@link
  /// shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Descriptive name for the variant (e.g., Large Blue Shirt).
  variant_name String
  
  /// Unique SKU for this specific variant.
  sku String
  
  /// Variant-specific price (overrides product price if different).
  price Float?
  
  /// Inventory quantity specific to this variant.
  stock_quantity Int
  
  /// JSON string containing variant attribute combinations.
  attributes String
  
  /// Whether this variant is available for purchase.
  active Boolean
  
  /// Timestamp when the variant was created.
  created_at DateTime
  
  /// Timestamp when the variant was last modified.
  updated_at DateTime
  
  /// Timestamp when the variant was soft deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  shopping_mall_cart_items shopping_mall_cart_items[]
  shopping_mall_order_items shopping_mall_order_items[]
  
  @@unique([shopping_mall_product_id, sku])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, active], map: "shopping_mall_product_variants_shopping_mall_product_i_3af18701")
  @@index([stock_quantity])
}

/// Product image gallery storing multiple images for each product.
