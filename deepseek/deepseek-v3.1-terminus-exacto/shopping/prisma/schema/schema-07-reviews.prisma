/// Customer reviews for purchased products.
///
/// Stores detailed feedback from customers who have purchased products,
/// including overall ratings and written comments. Each review is tied to a
/// specific product purchase and requires verification that the customer
/// actually bought the product.
///
/// Reviews go through a moderation workflow before publication and support
/// features like photo uploads, helpfulness voting, and seller responses.
/// The system maintains review history through snapshots for audit purposes
/// and content moderation tracking.
///
/// Individual rating breakdowns are stored in the separate
/// ecommerce_mall_ratings table to maintain proper normalization and avoid
/// data redundancy.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_reviews {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who submitted the review. {@link ecommerce_mall_customers.id}
  ecommerce_mall_customer_id String
  
  /// Customer session when review was submitted. {@link
  /// ecommerce_mall_customer_sessions.id}
  ecommerce_mall_customer_session_id String
  
  /// Product being reviewed. {@link ecommerce_mall_products.id}
  ecommerce_mall_product_id String
  
  /// Order that contained the reviewed product. {@link
  /// ecommerce_mall_orders.id}
  ecommerce_mall_order_id String
  
  /// Review title summarizing the customer feedback.
  title String
  
  /// Detailed review content with customer comments.
  body String
  
  /// Overall product rating from 1 to 5 stars.
  overall_rating Int
  
  /// Review status: pending, approved, rejected, flagged.
  status String
  
  /// Number of users who found this review helpful.
  helpful_count Int
  
  /// Number of users who did not find this review helpful.
  not_helpful_count Int
  
  /// Number of photos attached to this review.
  photo_count Int
  
  /// Indicates if review is from a verified purchase.
  is_verified_purchase Boolean
  
  /// Reason provided for moderation actions.
  moderation_reason String?
  
  /// Timestamp when the review was submitted.
  created_at DateTime
  
  /// Timestamp when the review was last updated.
  updated_at DateTime
  
  /// Timestamp when the review was soft deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer ecommerce_mall_customers @relation(fields: [ecommerce_mall_customer_id], references: [id], onDelete: Cascade)
  customerSession ecommerce_mall_customer_sessions @relation(fields: [ecommerce_mall_customer_session_id], references: [id], onDelete: Cascade)
  product ecommerce_mall_products @relation(fields: [ecommerce_mall_product_id], references: [id], onDelete: Cascade)
  order ecommerce_mall_orders @relation(fields: [ecommerce_mall_order_id], references: [id], onDelete: Cascade)
  
  ecommerce_mall_review_responses ecommerce_mall_review_responses?
  ecommerce_mall_ratings ecommerce_mall_ratings?
  ecommerce_mall_review_moderation ecommerce_mall_review_moderation[]
  ecommerce_mall_review_helpfulness ecommerce_mall_review_helpfulness[]
  ecommerce_mall_review_snapshots ecommerce_mall_review_snapshots[]
  
  @@index([ecommerce_mall_customer_session_id])
  @@index([ecommerce_mall_product_id])
  @@index([ecommerce_mall_order_id])
  
  // spellchecker: ignore-next-line
  @@unique([ecommerce_mall_customer_id, ecommerce_mall_product_id], map: "ecommerce_mall_reviews_ecommerce_mall_customer_id_ecom_986ad829")
  @@index([status])
  @@index([overall_rating])
  @@index([created_at])
  @@index([helpful_count])
}

