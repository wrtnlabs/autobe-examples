/// Detailed rating breakdowns for reviews.
///
/// Provides structured rating data for different aspects of the customer
/// experience. This table supports the detailed rating categories mentioned
/// in requirements while maintaining normalization by separating ratings
/// from the main review content.
///
/// Ratings are subsidiary to reviews and provide the quantitative data that
/// complements the qualitative feedback in reviews. This separation allows
/// for more flexible rating analysis and reporting.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_ratings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Review that these ratings belong to. {@link ecommerce_mall_reviews.id}
  ecommerce_mall_review_id String
  
  /// Rating for product quality on 1-5 scale.
  product_quality Int?
  
  /// Rating for value for money on 1-5 scale.
  value_for_money Int?
  
  /// Rating for shipping speed on 1-5 scale.
  shipping_speed Int?
  
  /// Rating for seller communication on 1-5 scale.
  seller_communication Int?
  
  /// Rating for packaging quality on 1-5 scale.
  packaging_quality Int?
  
  /// Timestamp when the ratings were recorded.
  created_at DateTime
  
  /// Timestamp when the ratings were last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  review ecommerce_mall_reviews @relation(fields: [ecommerce_mall_review_id], references: [id], onDelete: Cascade)
  
  @@unique([ecommerce_mall_review_id])
  
  @@index([product_quality])
  @@index([value_for_money])
  @@index([shipping_speed])
  @@index([seller_communication])
  @@index([packaging_quality])
}

/// Main moderation entity tracking moderation actions on reviews.
///
/// Serves as the central entity for moderation workflow tracking, supporting
/// polymorphic ownership where different actor types (admins, automated
/// systems) can perform moderation actions. This table contains shared
/// moderation data while actor-specific details are stored in subtype
/// tables.
///
/// The actor_type field identifies which type of actor performed the
/// moderation, enabling proper filtering and relationship management through
/// the corresponding subtype tables.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_review_moderation {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Review being moderated. {@link ecommerce_mall_reviews.id}
  ecommerce_mall_review_id String
  
  /// Type of actor performing moderation: admin, system.
  actor_type String
  
  /// Moderation action: approve, reject, flag, edit.
  action String
  
  /// Reason for the moderation action.
  reason String?
  
  /// Additional notes from the moderator.
  notes String?
  
  /// Review status before moderation.
  previous_status String?
  
  /// Review status after moderation.
  new_status String
  
  /// Timestamp when moderation occurred.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  review ecommerce_mall_reviews @relation(fields: [ecommerce_mall_review_id], references: [id], onDelete: Cascade)
  
  ecommerce_mall_review_moderation_of_admins ecommerce_mall_review_moderation_of_admins?
  
  @@index([ecommerce_mall_review_id])
  
  @@index([actor_type])
  @@index([action])
  @@index([new_status])
  @@index([created_at])
}

