  /// Timestamp when the response was last updated.
  updated_at DateTime
  
  /// Timestamp when the response was soft deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  review ecommerce_mall_reviews @relation(fields: [ecommerce_mall_review_id], references: [id], onDelete: Cascade)
  seller ecommerce_mall_sellers @relation(fields: [ecommerce_mall_seller_id], references: [id], onDelete: Cascade)
