  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  member todo_app_members @relation(fields: [member_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  editHistories todo_app_edit_histories[]
  
  //----
  // INDEXES
  //----
  @@index([member_id, deleted_at, created_at])
  @@index([member_id, deleted_at, start_date])
  @@index([member_id, deleted_at, due_date])
  @@index([member_id, deleted_at, completed_at])
