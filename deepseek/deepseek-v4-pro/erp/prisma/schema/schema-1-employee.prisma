  department erp_hrm_departments? @relation(fields: [erp_hrm_department_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  contracts erp_hrm_contracts[]
  projectMembers erp_hrm_project_members[]
  assignedTasks erp_hrm_tasks[]
  timelogs erp_hrm_timelogs[]
  timesheets erp_hrm_timesheets[]
  timer erp_hrm_timers?
  
  //----
  // INDEXES
  //----
  @@index([erp_hrm_role_id])
  @@index([erp_hrm_department_id])
  @@unique([erp_hrm_member_id, erp_hrm_organization_id])
