  @@index([erp_hrm_permission_id])
  // spellchecker: ignore-next-line
  @@unique([erp_hrm_role_id, erp_hrm_permission_id], map: "erp_hrm_role_permissions_erp_hrm_role_id_erp_hrm_permi_099a80ce")
