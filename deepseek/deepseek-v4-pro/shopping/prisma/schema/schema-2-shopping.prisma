  /// entry — enforced by the unique constraint on (customer_id,
  /// product_variant_id).
  quantity Int
  
  /// Timestamp when the cart entry was first created.
  created_at DateTime
  
  /// Timestamp when the cart entry was last updated (quantity changed).
  updated_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
