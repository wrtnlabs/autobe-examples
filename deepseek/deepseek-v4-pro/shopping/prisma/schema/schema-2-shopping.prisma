  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the customer who owns this cart entry.
  ///
  /// Links to {@link shopping_mall_customers}. Each cart entry belongs to
  /// exactly one customer. NOT NULL — cart items are always customer-scoped.
  shopping_mall_customer_id String
  
  /// Reference to the selected product variant (SKU) the customer wants to
  /// purchase.
  ///
  /// Links to {@link shopping_mall_product_variants}. NOT NULL — product
