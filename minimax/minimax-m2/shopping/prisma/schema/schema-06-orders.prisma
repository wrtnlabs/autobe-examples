/// Main order entity representing complete customer purchase transactions.
/// Tracks all order-level information including customer, shipping details,
/// pricing breakdown, and current status. Orders may contain items from
/// multiple sellers and serve as primary business entity for order
/// management.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_orders {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who placed this order. {@link ecommerce_mall_customers.id}
  ecommerce_mall_customer_id String
  
  /// Shipping address for this order. {@link
  /// ecommerce_mall_shipping_addresses.id}
  ecommerce_mall_shipping_address_id String
  
  /// Shipping method selected for this order. {@link
  /// ecommerce_mall_shipping_methods.id}
  ecommerce_mall_shipping_method_id String
  
  /// Unique order number for customer reference and tracking.
  order_number String
  
  /// Current order status: pending_payment, confirmed, processing, shipped,
  /// delivered, completed, cancelled.
  status String
  
  /// Business workflow status: awaiting_fulfillment, in_fulfillment,
  /// awaiting_shipment, shipped, delivered, returned, disputed.
  business_status String
  
  /// Sum of all item prices before taxes and shipping.
  subtotal Float
  
  /// Shipping cost based on selected shipping method and order details.
  shipping_cost Float
  
  /// Tax amount calculated based on shipping address and applicable tax rates.
  tax_amount Float
  
  /// Total discount amount applied from promotions, coupons, or other
  /// reductions.
  discount_amount Float?
  
  /// Final total amount: subtotal + shipping + tax - discount.
  total_amount Float
  
  /// Currency code for all monetary values (ISO 4217 format).
  currency String
  
  /// Customer notes or special instructions for the order.
  notes String?
  
  /// Timestamp when order was initially created.
  created_at DateTime
  
  /// Timestamp when order was last modified.
  updated_at DateTime
  
  /// Soft delete timestamp for audit trail purposes.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer ecommerce_mall_customers @relation(fields: [ecommerce_mall_customer_id], references: [id], onDelete: Cascade)
  shippingAddress ecommerce_mall_shipping_addresses @relation(fields: [ecommerce_mall_shipping_address_id], references: [id], onDelete: Cascade)
  shippingMethod ecommerce_mall_shipping_methods @relation(fields: [ecommerce_mall_shipping_method_id], references: [id], onDelete: Cascade)
  
  ecommerce_mall_stock_movements ecommerce_mall_stock_movements[]
  ecommerce_mall_order_items ecommerce_mall_order_items[]
  ecommerce_mall_order_status_history ecommerce_mall_order_status_history[]
  ecommerce_mall_order_modifications ecommerce_mall_order_modifications[]
  ecommerce_mall_cancellations ecommerce_mall_cancellations[]
  ecommerce_mall_payment_methods ecommerce_mall_payment_methods[]
  ecommerce_mall_transactions ecommerce_mall_transactions[]
  ecommerce_mall_refunds ecommerce_mall_refunds[]
  ecommerce_mall_disputes ecommerce_mall_disputes[]
  ecommerce_mall_shipments ecommerce_mall_shipments[]
  ecommerce_mall_return_authorizations ecommerce_mall_return_authorizations[]
  ecommerce_mall_reviews ecommerce_mall_reviews[]
  ecommerce_mall_commissions ecommerce_mall_commissions[]
  
  @@index([ecommerce_mall_shipping_address_id])
  @@index([ecommerce_mall_shipping_method_id])
  
  @@unique([order_number])
  @@index([ecommerce_mall_customer_id, created_at])
  @@index([status])
  @@index([business_status])
  @@index([created_at])
}

/// Individual items within customer orders, tracking specific product
/// variants purchased. Each item represents a unique product variant with
/// quantity, pricing, and seller information. Items are independently
/// managed and can be fulfilled separately.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_order_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent order containing this item. {@link ecommerce_mall_orders.id}
  ecommerce_mall_order_id String
  
  /// Product being ordered. {@link ecommerce_mall_products.id}
  ecommerce_mall_product_id String
  
  /// Specific product variant being ordered (size, color, etc.). {@link
  /// ecommerce_mall_product_variants.id}
  ecommerce_mall_product_variant_id String
  
  /// Seller providing this product. {@link ecommerce_mall_sellers.id}
  ecommerce_mall_seller_id String
  
  /// Product name at time of order for historical accuracy.
  product_name String
  
  /// Human-readable variant description (e.g., 'Size: Medium, Color: Blue').
  variant_details String
  
  /// Stock Keeping Unit identifier for this variant at time of order.
  sku String
  
  /// Number of units ordered.
  quantity Int
  
  /// Price per unit at time of order.
  unit_price Float
  
  /// Total price for this item: quantity * unit_price.
  total_price Float
  
  /// Item fulfillment status: pending, confirmed, packed, shipped, delivered,
  /// returned, cancelled.
  status String
  
  /// Seller notes or special handling instructions for this item.
  seller_notes String?
  
  /// Timestamp when order item was created.
  created_at DateTime
  
  /// Timestamp when order item was last modified.
  updated_at DateTime
  
  /// Soft delete timestamp for audit trail purposes.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  order ecommerce_mall_orders @relation(fields: [ecommerce_mall_order_id], references: [id], onDelete: Cascade)
  product ecommerce_mall_products @relation(fields: [ecommerce_mall_product_id], references: [id], onDelete: Cascade)
  productVariant ecommerce_mall_product_variants @relation(fields: [ecommerce_mall_product_variant_id], references: [id], onDelete: Cascade)
  seller ecommerce_mall_sellers @relation(fields: [ecommerce_mall_seller_id], references: [id], onDelete: Cascade)
  
  @@index([ecommerce_mall_product_id])
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_product_variant_id], map: "ecommerce_mall_order_items_ecommerce_mall_product_vari_eb246768")
  
  @@index([ecommerce_mall_order_id])
  @@index([ecommerce_mall_seller_id])
  @@index([status])
}

