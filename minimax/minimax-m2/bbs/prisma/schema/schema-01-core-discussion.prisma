/// Core discussion articles for economic and political topics.
///
/// Stores user-generated discussion posts focused on economic policies,
/// political developments, market analysis, and related topics. Each article
/// represents a primary discussion thread that users can create, edit, and
/// engage with independently.
///
/// Articles support rich content including title, detailed content, and
/// optional category classification for economic/political topics. The
/// system maintains full temporal tracking and supports soft deletion for
/// content management.
///
/// Each article links to a user author and can have multiple file
/// attachments through the established relationship with the attachment
/// system.
///
/// @namespace CoreDiscussion
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model econ_political_discussion_articles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Author who created this article discussion. {@link
  /// econ_political_discussion_users.id}.
  econ_political_discussion_user_id String
  
  /// Article title for the discussion post. Descriptive topic heading.
  title String
  
  /// Full article content for the economic/political discussion. Rich text
  /// content body.
  content String
  
  /// Topic category for economic/political classification (e.g., 'Economic
  /// Policy', 'Political Analysis', 'Market Discussion').
  category String
  
  /// Article publication status. Default 'published' for active discussions.
  status String
  
  /// When this discussion article was originally created.
  created_at DateTime
  
  /// When this discussion article was last modified.
  updated_at DateTime
  
  /// Soft delete timestamp for archived or removed discussions.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  author econ_political_discussion_users @relation(fields: [econ_political_discussion_user_id], references: [id], onDelete: Cascade)
  
  econ_political_discussion_attachments econ_political_discussion_attachments[]
  
  // spellchecker: ignore-next-line
  @@index([econ_political_discussion_user_id], map: "econ_political_discussion_articles_econ_political_disc_d231c45c")
  
  @@index([created_at])
  @@index([category])
  @@index([status])
}

/// Simple user profiles for discussion board participants.
///
/// Provides basic user identification and profile management for discussion
/// participants. Maintains minimal user concepts as requested for the simple
/// economic and political discussion board.
///
/// Users can create articles, build discussion profiles, and maintain basic
/// account information. The design focuses on simple author identification
/// rather than complex user management systems.
///
/// Supports standard profile fields including display name and optional bio,
/// with complete temporal tracking for account lifecycle management.
///
/// @namespace CoreDiscussion
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model econ_political_discussion_users {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User's display name for article authorship and community identification.
  display_name String
  
  /// User email address for account management and notifications.
  email String
  
  /// Optional user biography describing interests or background in
  /// economics/politics.
  bio String?
  
  /// Optional profile picture URL for user identification in discussions.
  avatar_url String?
  
  /// User account status (active, suspended, etc.).
  status String
  
  /// When this user account was originally created.
  created_at DateTime
  
  /// When this user profile was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp for deactivated user accounts.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  econ_political_discussion_articles econ_political_discussion_articles[]
  
  @@unique([email])
  @@index([status])
  @@index([created_at])
}