  category ecommerce_mall_categories @relation(fields: [ecommerce_mall_category_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  productImages ecommerce_mall_product_images[]
  variants ecommerce_mall_product_variants[]
  productSnapshots ecommerce_mall_product_snapshots[]
  wishlistItems ecommerce_mall_wishlist_items[]
  orderItems ecommerce_mall_order_items[]
  reviews ecommerce_mall_reviews[]
  
  //----
  // INDEXES
  //----
  @@index([ecommerce_mall_category_id])
  @@index([ecommerce_mall_seller_id, created_at])
}

