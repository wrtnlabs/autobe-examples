/// Main order records capturing completed purchase transactions with unique
/// order numbers, customer reference, shipping address, and computed totals.
///
/// This table stores the primary order entity representing customer
/// purchases. Each order belongs to exactly one customer and references a
/// specific shipping address for delivery. Orders contain multiple order
/// items capturing the purchased products at their prices at time of
/// purchase.
///
/// Order status is derived from item statuses: 'paid' (all items paid),
/// 'shipped' (any item shipped), 'delivered' (all items delivered),
/// 'cancelled' (all items cancelled), 'refunded' (all items refunded), or
/// 'partially_completed' (mixed states).
///
/// Relationships:
/// - Belongs to {@link ecommerce_mall_customers} via customer_id
/// - References {@link ecommerce_mall_shipping_addresses} for delivery
/// destination
/// - Has many {@link ecommerce_mall_order_items} representing purchased
/// products
/// - Order items reference {@link ecommerce_mall_product_snapshots} and
/// {@link ecommerce_mall_seller_profile_snapshots} for historical data
///
/// Soft delete via deleted_at preserves order history for legal compliance
/// and seller records.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_orders {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the customer who placed this order. {@link
  /// ecommerce_mall_customers.id}.
  ecommerce_mall_customer_id String
  
  /// Reference to the shipping address for this order. {@link
  /// ecommerce_mall_shipping_addresses.id}. Locked at order placement time.
  ecommerce_mall_shipping_address_id String
  
  /// Unique order number for customer reference. Generated at order creation
  /// time.
  order_number String
  
  /// Sum of all order item prices before shipping costs. Calculated at
  /// checkout.
  subtotal Float
  
  /// Total shipping fee for this order. Zero if free shipping applies.
  shipping_cost Float
  
  /// Final order total including subtotal and shipping. subtotal +
  /// shipping_cost.
  total_amount Float
  
  /// Computed order status derived from order items: 'paid', 'shipped',
  /// 'delivered', 'cancelled', 'refunded', or 'partially_completed'.
  status String
  
  /// Timestamp when the order was created (payment completed).
  created_at DateTime
  
  /// Timestamp when the order was last modified.
  updated_at DateTime
  
  /// Soft delete timestamp. Null when active, set when order is cancelled or
  /// archived.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer ecommerce_mall_customers @relation(fields: [ecommerce_mall_customer_id], references: [id], onDelete: Cascade)
  shippingAddress ecommerce_mall_shipping_addresses @relation(fields: [ecommerce_mall_shipping_address_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  orderItems ecommerce_mall_order_items[]
  shipments ecommerce_mall_shipments[]
  
  //----
  // INDEXES
  //----
  @@index([ecommerce_mall_shipping_address_id])
  @@unique([order_number])
  @@index([ecommerce_mall_customer_id, created_at])
}

