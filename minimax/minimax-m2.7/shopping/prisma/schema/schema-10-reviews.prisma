/// Customer reviews for products with star ratings. Each review links to the
/// customer who wrote it, the product being reviewed, and the order item
/// that verifies the purchase. Soft-deleted reviews are hidden from display
/// but preserved with snapshots for audit trail. Customers can only review
/// products they have purchased and received.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_reviews {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who wrote the review. {@link ecommerce_mall_customers.id}
  ecommerce_mall_customer_id String
  
  /// Product being reviewed. {@link ecommerce_mall_products.id}
  ecommerce_mall_product_id String
  
  /// Order item that verifies this purchase. Only delivered items can be
  /// reviewed. {@link ecommerce_mall_order_items.id}
  ecommerce_mall_order_item_id String
  
  /// Star rating from 1 to 5. Required field for all reviews.
  rating Int
  
  /// Optional text content of the review. Customers can write detailed
  /// feedback about the product.
  content String?
  
  /// Timestamp when the review was created.
  created_at DateTime
  
  /// Timestamp when the review was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp. Null means active, non-null means deleted and
  /// hidden from display.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer ecommerce_mall_customers @relation(fields: [ecommerce_mall_customer_id], references: [id], onDelete: Cascade)
  product ecommerce_mall_products @relation(fields: [ecommerce_mall_product_id], references: [id], onDelete: Cascade)
  orderItem ecommerce_mall_order_items @relation(fields: [ecommerce_mall_order_item_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  reviewSnapshots ecommerce_mall_review_snapshots[]
  
  //----
  // INDEXES
  //----
  @@index([ecommerce_mall_order_item_id])
  // spellchecker: ignore-next-line
  @@unique([ecommerce_mall_customer_id, ecommerce_mall_product_id, ecommerce_mall_order_item_id], map: "ecommerce_mall_reviews_ecommerce_mall_customer_id_ecom_0c1bc04f")
  @@index([ecommerce_mall_product_id, created_at])
}

/// Immutable historical snapshots of review edits capturing previous rating
/// and text content for dispute resolution.
///
/// Stores point-in-time records of review modifications including the rating
/// value and text content before each edit. These snapshots are created
/// automatically when customers edit their reviews, providing an immutable
/// audit trail for dispute resolution. Each snapshot belongs to exactly one
/// review via foreign key reference. Snapshots cannot be deleted and are
/// retained indefinitely per the platform's data retention policy.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_review_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the parent review this snapshot captures. {@link
  /// ecommerce_mall_reviews.id}.
  ecommerce_mall_review_id String
  
  /// Star rating value (1-5) of the review before this edit was made.
  rating Int
  
  /// Text content of the review before this edit was made. Null for reviews
  /// that had no text content.
  body String?
  
  /// Timestamp when this snapshot was created, representing when the review
  /// edit occurred.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  review ecommerce_mall_reviews @relation(fields: [ecommerce_mall_review_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_review_id, created_at], map: "ecommerce_mall_review_snapshots_ecommerce_mall_review__47db8772")
}