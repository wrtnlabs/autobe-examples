/// Employee records linking users to organizations with role assignments and
/// employment details.
///
/// Each employee record represents the association between a user account
/// (member) and an organization. Employees are assigned a role that
/// determines their permissions within the organization. Each employee can
/// optionally belong to a department and can have multiple employment
/// contracts (though only one can be active at a time).
///
/// An employee must have an active status to log time or submit timesheets.
/// Deactivated employees preserve their historical data but cannot perform
/// time tracking operations.
///
/// @namespace HRM
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model erp_hrm_employees {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User account associated with this employee record. {@link
  /// erp_hrm_members.id}.
  erp_hrm_member_id String
  
  /// Organization this employee belongs to. {@link erp_hrm_organizations.id}.
  erp_hrm_organization_id String
  
  /// Role assigned to this employee determining their permissions. {@link
  /// erp_hrm_roles.id}.
  erp_hrm_role_id String
  
  /// Optional department this employee belongs to. {@link
  /// erp_hrm_departments.id}.
  erp_hrm_department_id String?
  
  /// Job title or position of the employee within the organization.
  position String?
  
  /// Type of employment classification. Valid values: full-time, part-time,
  /// contractor, intern.
  employment_type String
  
  /// Employment status. Valid values: active (can log time and submit
  /// timesheets), deactivated (historical data preserved but cannot perform
  /// time tracking).
  status String
  
  /// Timestamp when the employee record was created.
  created_at DateTime
  
  /// Timestamp when the employee record was last updated.
  updated_at DateTime
  
  /// Timestamp when the employee record was soft deleted. Null if not deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  member erp_hrm_members @relation(fields: [erp_hrm_member_id], references: [id], onDelete: Cascade)
  organization erp_hrm_organizations @relation(fields: [erp_hrm_organization_id], references: [id], onDelete: Cascade)
  role erp_hrm_roles @relation(fields: [erp_hrm_role_id], references: [id], onDelete: Cascade)
  department erp_hrm_departments? @relation(fields: [erp_hrm_department_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  contracts erp_hrm_contracts[]
  projectMemberships erp_hrm_project_members[]
  assignedTasks erp_hrm_tasks[]
  timelogs erp_hrm_timelogs[]
  timesheets erp_hrm_timesheets[] @relation("erp_hrm_timesheets_of_erp_hrm_employee_id")
  reviewedTimesheets erp_hrm_timesheets[] @relation("erp_hrm_timesheets_of_erp_hrm_reviewer_employee_id")
  timers erp_hrm_timers[]
  
  //----
  // INDEXES
  //----
  @@index([erp_hrm_role_id])
  @@index([erp_hrm_department_id])
  @@unique([erp_hrm_member_id, erp_hrm_organization_id])
  @@index([employment_type, status])
  @@index([erp_hrm_organization_id, status])
}

/// Organization-scoped roles defining permission sets for employees. Each
/// role contains a name and a collection of permissions that determine what
/// actions assigned employees can perform. Three built-in roles (Owner,
/// Manager, Employee) cannot be deleted, while custom roles can be created
/// and managed by organization owners with org:manage permission. All role
/// names must be unique within an organization scope. Links to employees via
/// {@link erp_hrm_employees.role_id} and to permissions via {@link
/// erp_hrm_role_permissions}.
///
/// @namespace HRM
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model erp_hrm_roles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Organization this role belongs to. {@link erp_hrm_organizations.id}.
  erp_hrm_organization_id String
  
  /// Role name unique within the organization. Examples: Owner, Manager,
  /// Employee, or custom role names.
  name String
  
  /// Whether this is a built-in role that cannot be deleted. Built-in roles
  /// are Owner, Manager, and Employee.
  is_builtin Boolean
  
  /// Timestamp when the role was created.
  created_at DateTime
  
  /// Timestamp when the role was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp. Null if not deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  organization erp_hrm_organizations @relation(fields: [erp_hrm_organization_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  employees erp_hrm_employees[]
  rolePermissions erp_hrm_role_permissions[]
  invitations erp_hrm_invitations[]
  
  //----
  // INDEXES
  //----
  @@unique([erp_hrm_organization_id, name])
  @@index([erp_hrm_organization_id, created_at])
  @@index([is_builtin])
}

/// Junction table linking roles to their assigned permissions. Each role can
/// have multiple permissions, and each permission can be assigned to
/// multiple roles. Permissions are string codes (e.g., 'org:manage',
/// 'employee:manage', 'project:view'). This table enforces that the same
/// permission cannot be assigned twice to the same role.
///
/// @namespace HRM
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model erp_hrm_role_permissions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged role's {@link erp_hrm_roles.id}.
  erp_hrm_role_id String
  
  /// Permission code string such as 'org:manage', 'employee:manage',
  /// 'employee:view', 'project:manage', 'project:view', 'time:manage',
  /// 'time:approve', 'time:view_all', or 'report:view'.
  permission String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  role erp_hrm_roles @relation(fields: [erp_hrm_role_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@unique([erp_hrm_role_id, permission])
  @@index([erp_hrm_role_id])
}

/// Organization departments supporting optional one-level parent hierarchy
/// for organizational structure.
///
/// Each department belongs to exactly one organization and can optionally
/// have a parent department for hierarchical categorization. The one-level
/// parent constraint ensures simple organizational structures without deep
/// nesting. Departments provide a way to group employees within an
/// organization for reporting and management purposes.
///
/// Related entities:
/// - Belongs to {@link erp_hrm_organizations} as the tenant container
/// - Employees in {@link erp_hrm_employees} reference this for department
/// assignment
/// - Parent department creates self-referential hierarchy via {@link
/// erp_hrm_departments.parent_id}
///
/// @namespace HRM
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model erp_hrm_departments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged organization's {@link erp_hrm_organizations.id}. Each department
  /// must belong to an organization for multi-tenant isolation.
  erp_hrm_organization_id String
  
  /// Optional parent department's {@link erp_hrm_departments.id} for one-level
  /// hierarchical categorization. Null indicates a root-level department.
  parent_id String?
  
  /// Department name used for identification within the organization.
  name String
  
  /// Optional description providing details about the department's purpose or
  /// responsibilities.
  description String?
  
  /// Timestamp when the department was created.
  created_at DateTime
  
  /// Timestamp when the department was last modified.
  updated_at DateTime
  
  /// Soft delete timestamp. Null means active, non-null means deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  organization erp_hrm_organizations @relation(fields: [erp_hrm_organization_id], references: [id], onDelete: Cascade)
  parent erp_hrm_departments? @relation("recursive", fields: [parent_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  employees erp_hrm_employees[]
  children erp_hrm_departments[] @relation("recursive")
  invitations erp_hrm_invitations[]
  
  //----
  // INDEXES
  //----
  @@unique([erp_hrm_organization_id, name])
  @@index([erp_hrm_organization_id, deleted_at])
  @@index([parent_id])
}

/// Employee contracts storing employment terms with temporal constraints.
/// Each contract defines pay rate, pay period, working hours, and validity
/// dates for an employment relationship. Only one contract can be active at
/// a time per employee. Contracts are immutable historical records - past
/// contracts cannot be edited once superseded.
///
/// This table is always managed through its parent {@link erp_hrm_employees}
/// entity. Users cannot create, search, or manage contracts independently
/// from employees.
///
/// @namespace HRM
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model erp_hrm_contracts {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged employee this contract belongs to. {@link erp_hrm_employees.id}
  erp_hrm_employee_id String
  
  /// Contract start date. Required. Marks when this contract term begins.
  start_date DateTime
  
  /// Contract end date. Optional - null indicates an ongoing contract with no
  /// end date.
  end_date DateTime?
  
  /// Pay rate amount for this contract. Numeric value representing
  /// compensation.
  pay_rate Float
  
  /// Pay period type. One of: hourly, daily, weekly, monthly. Determines how
  /// pay rate is applied.
  pay_period String
  
  /// Contracted working hours per week. Required numeric value.
  working_hours_per_week Float
  
  /// Optional notes or comments about this contract.
  notes String?
  
  /// Timestamp when this contract was created.
  created_at DateTime
  
  /// Timestamp when this contract was last updated.
  updated_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  employee erp_hrm_employees @relation(fields: [erp_hrm_employee_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@unique([erp_hrm_employee_id, start_date])
  @@index([erp_hrm_employee_id, created_at])
  @@index([erp_hrm_employee_id, end_date])
}