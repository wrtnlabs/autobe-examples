/// Main todo items owned by users with title, description, dates, completion
/// status, and soft-delete support via deleted_at timestamp for trash
/// workflow.
///
/// Each todo belongs to exactly one member and captures task management data
/// including optional start/due dates and completion status. The soft-delete
/// pattern enables the trash workflow where users can view deleted todos,
/// restore them, or permanently delete them.
///
/// Relationships:
/// - Owned by {@link multi_user_todo_members} via multi_user_todo_member_id
/// FK for privacy isolation
/// - Has many {@link multi_user_todo_todo_edit_histories} entries recording
/// all field mutations
///
/// @namespace Todos
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model multi_user_todo_todos {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Owner's member ID. References {@link multi_user_todo_members.id} for
  /// privacy isolation - each user can only see their own todos.
  multi_user_todo_member_id String
  
  /// Todo title - the main task description. Required on creation.
  title String
  
  /// Optional detailed description of the todo. Can be empty string.
  description String
  
  /// Optional start date for the todo. Null if not set.
  start_date DateTime?
  
  /// Optional due date for the todo. Null if not set.
  due_date DateTime?
  
  /// Completion status flag. False by default when todo is created.
  completed Boolean
  
  /// Timestamp when the todo was created.
  created_at DateTime
  
  /// Timestamp when the todo was last modified.
  updated_at DateTime
  
  /// Soft-delete timestamp. Null means not deleted. When set, todo is in trash
  /// and excluded from normal list.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  member multi_user_todo_members @relation(fields: [multi_user_todo_member_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  editHistories multi_user_todo_todo_edit_histories[]
  
  //----
  // INDEXES
  //----
  @@index([multi_user_todo_member_id, created_at])
  @@index([multi_user_todo_member_id, deleted_at])
}

/// Edit history entries recording field-level mutations for todo items. Each
/// entry captures old and new values for title, description, start_date, and
/// due_date when a todo is edited, with a timestamp. History entries are
/// created automatically when todos are edited and cannot be modified or
/// deleted independently by users.
///
/// @namespace Todos
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model multi_user_todo_todo_edit_histories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The todo item this edit history entry belongs to. {@link
  /// multi_user_todo_todos.id}
  multi_user_todo_todo_id String
  
  /// Timestamp when this edit was made.
  created_at DateTime
  
  /// Previous title value before this edit. Null if title was not changed in
  /// this edit.
  old_title String?
  
  /// New title value after this edit. Null if title was not changed in this
  /// edit.
  new_title String?
  
  /// Previous description value before this edit. Null if description was not
  /// changed in this edit.
  old_description String?
  
  /// New description value after this edit. Null if description was not
  /// changed in this edit.
  new_description String?
  
  /// Previous start date value before this edit. Null if start date was not
  /// changed in this edit.
  old_start_date DateTime?
  
  /// New start date value after this edit. Null if start date was not changed
  /// in this edit.
  new_start_date DateTime?
  
  /// Previous due date value before this edit. Null if due date was not
  /// changed in this edit.
  old_due_date DateTime?
  
  /// New due date value after this edit. Null if due date was not changed in
  /// this edit.
  new_due_date DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  todo multi_user_todo_todos @relation(fields: [multi_user_todo_todo_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([multi_user_todo_todo_id, created_at], map: "multi_user_todo_todo_edit_histories_multi_user_todo_to_e9d2e4ac")
}