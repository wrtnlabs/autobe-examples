/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_comments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Sequential citizen identifier for human-readable comment numbering.
  /// References {@link discussion_board_comment_citizens.id}.
  citizen_id String
  
  /// Reference to the parent article. {@link discussion_board_articles.id}.
  /// Comments are cascade deleted when the article is deleted.
  discussion_board_article_id String
  
  /// Reference to the comment author. {@link discussion_board_users.id}.
  /// Comments are cascade deleted when the user account is deleted.
  discussion_board_user_id String
  
  /// The comment body text. Must contain at least 1 non-whitespace character
