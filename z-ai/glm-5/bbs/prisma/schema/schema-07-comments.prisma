  //----
  citizen discussion_board_comment_citizens @relation(fields: [citizen_id], references: [id], onDelete: Cascade)
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  author discussion_board_users @relation(fields: [discussion_board_user_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([discussion_board_user_id])
  @@unique([citizen_id])
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, created_at], map: "discussion_board_comments_discussion_board_article_id__aa7deb51")
}