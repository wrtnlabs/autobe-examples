  createdRoles hrm_time_tracking_roles[]
  employees hrm_time_tracking_employees[]
  sentEmployeeInvitations hrm_time_tracking_employee_invitations[]
  taskHistories hrm_time_tracking_task_histories[]
  reviewedTimesheets hrm_time_tracking_timesheets[]
  activityLogs hrm_time_tracking_activity_logs[]
  
  //----
  // INDEXES
  //----
  @@unique([email])
  @@index([created_at])
}

