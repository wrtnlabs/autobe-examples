  tasks hrm_time_tracking_tasks[]
  timelogs hrm_time_tracking_timelogs[]
  timers hrm_time_tracking_timers[]
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([hrm_time_tracking_organization_id, name], map: "hrm_time_tracking_projects_hrm_time_tracking_organizat_59737056")
  // spellchecker: ignore-next-line
