  disabled_at DateTime?
  
  //----
  // RELATIONS
  //----
  todo_list_admin_sessions todo_list_admin_sessions[]
  todo_list_admin_audit_logs todo_list_admin_audit_logs[]
  
  @@unique([email])
  @@index([created_at, disabled_at])
}

