/// Password reset tokens for secure credential recovery flows.
///
/// Each record stores a per-user, one-time-use token valid for password
/// reset. Tokens are securely generated, time-limited, and are tightly
/// linked to a specific user. Only valid, unexpired, and unused tokens may
/// be applied for recovering access to a user account. Used token records
/// remain in the system for audit trail purposes. This table is solely for
/// credential reset/recovery and not for login/session flows.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_list_password_reset_tokens {
  //----
  // COLUMNS
  //----
  /// Primary Key. Unique identifier per token record.
  id String @id
  
  /// Reference to user who owns this reset token. {@link todo_list_users.id}.
  todo_list_user_id String
  
  /// Reset token string. Securely random, used only for password reset
  /// operations.
  token String
  
  /// Timestamp when the reset token was created.
  created_at DateTime
  
  /// Expiration datetime, after which further use is forbidden.
  expires_at DateTime
  
  /// Timestamp of use (if any). Null means token unused and active.
  used_at DateTime?
  
  //----
  // RELATIONS
  //----
  user todo_list_users @relation(fields: [todo_list_user_id], references: [id], onDelete: Cascade)
  
  @@unique([token])
  // spellchecker: ignore-next-line
  @@index([todo_list_user_id, expires_at], map: "todo_list_password_reset_tokens_todo_list_user_id_expi_21a7a487")
}