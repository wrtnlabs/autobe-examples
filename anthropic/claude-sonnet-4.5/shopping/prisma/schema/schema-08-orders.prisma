  change_reason String?
  
  /// IP address of the actor when the status change occurred for security
  /// audit.
  ip_address String?
  
  /// Timestamp when this status change occurred.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  orderSeller shopping_mall_order_sellers? @relation(fields: [shopping_mall_order_seller_id], references: [id], onDelete: Cascade)
  
