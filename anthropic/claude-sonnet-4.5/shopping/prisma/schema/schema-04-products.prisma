  name String
  
  /// Display sequence order for variant selector presentation to buyers. Lower
  /// numbers appear first.
  display_order Int
  
  /// Timestamp when the variant attribute was created.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  sale shopping_mall_sales @relation(fields: [shopping_mall_sale_id], references: [id], onDelete: Cascade)
  
  shopping_mall_sale_variant_values shopping_mall_sale_variant_values[]
  
