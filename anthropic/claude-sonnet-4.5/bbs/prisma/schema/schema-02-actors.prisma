/// Guest users who browse the discussion board without authentication.
/// Guests have read-only access to public content and cannot create articles
/// or post comments. This table tracks guest sessions for analytics and rate
/// limiting purposes.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_guests {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique session identifier for tracking guest activity across requests.
  session_token String
  
  /// IP address of the guest user for security monitoring and rate limiting.
  ip_address String
  
  /// Browser user agent string for analytics and compatibility tracking.
  user_agent String?
  
  /// Timestamp of the guest's most recent activity for session management.
  last_activity_at DateTime
  
  /// Timestamp when the guest session was created.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  @@unique([session_token])
  @@index([last_activity_at])
  @@index([ip_address, created_at])
}

/// Registered and authenticated users who can create articles, post
/// comments, and engage in discussions. Members are the core participants of
/// the discussion board with full content creation and interaction
/// privileges. Supports email verification, soft deletion for account
/// recovery, and comprehensive privacy controls.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_members {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique username for member identification and login. Must be 3-30
  /// characters, alphanumeric with underscores and hyphens only.
  username String
  
  /// Email address for authentication, notifications, and account recovery.
  /// Must be unique and verified.
  email String
  
  /// Securely hashed password for authentication. Never stored in plain text.
  password_hash String
  
  /// Optional display name shown publicly instead of username. 1-50 characters.
  display_name String?
  
  /// Optional member biography or self-description. Maximum 500 characters.
  bio String?
  
  /// Optional geographic location (free text). Maximum 100 characters.
  location String?
  
  /// Optional personal or professional website URL.
  website_url String?
  
  /// URL of the member's profile picture. Falls back to default avatar if null.
  profile_picture_url String?
  
  /// Whether the member's email address has been verified. Must be true to
  /// post content.
  email_verified Boolean
  
  /// Account status: pending_email_verification, active, suspended, or deleted.
  status String
  
  /// Profile visibility setting: public, members_only, or private.
  profile_visibility String
  
  /// Activity history visibility: public, members_only, or hidden.
  activity_visibility String
  
  /// Timestamp of the member's most recent successful login.
  last_login_at DateTime?
  
  /// Timestamp when the member account was created.
  created_at DateTime
  
  /// Timestamp when the member profile was last modified.
  updated_at DateTime
  
  /// Timestamp when the member account was soft-deleted. Null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  discussion_board_member_sessions discussion_board_member_sessions[]
  discussion_board_articles discussion_board_articles[]
  discussion_board_article_snapshots discussion_board_article_snapshots[]
  discussion_board_comments discussion_board_comments[]
  discussion_board_article_images discussion_board_article_images[]
  discussion_board_article_documents discussion_board_article_documents[]
  discussion_board_reports discussion_board_reports[]
  discussion_board_user_warnings discussion_board_user_warnings[]
  discussion_board_user_suspensions discussion_board_user_suspensions[]
  
  @@unique([username])
  @@unique([email])
  @@index([status, created_at])
  @@index([email_verified, status])
}

