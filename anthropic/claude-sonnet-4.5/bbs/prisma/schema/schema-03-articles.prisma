/// Main article entity for economic and political discussions. Articles are
/// the primary content type created by members and moderators, containing
/// title, body content, and metadata. Articles can have multiple categories
/// and tags through junction tables, and maintain version history through
/// snapshots. Supports soft deletion for content recovery.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_articles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Author member who created this article. {@link
  /// discussion_board_members.id}
  discussion_board_member_id String
  
  /// Moderator who last modified this article, if applicable. {@link
  /// discussion_board_moderators.id}
  last_modified_by_moderator_id String?
  
  /// Article title, between 5 and 200 characters. Used for display in listings
  /// and search results.
  title String
  
  /// Main article content, between 20 and 50000 characters. Supports rich text
  /// formatting and contains the full article text.
  body String
  
  /// Optional article excerpt or summary, maximum 500 characters. Used for
  /// previews in article listings.
  summary String?
  
  /// Publication status of the article. Values: published, draft, archived.
  /// Controls article visibility and lifecycle.
  status String
  
  /// Number of times this article has been viewed. Incremented on each article
  /// page visit.
  view_count Int
  
  /// Cached count of comments on this article. Updated when comments are added
  /// or removed.
  comment_count Int
  
  /// Timestamp when the article was originally created. Immutable after
  /// creation.
  created_at DateTime
  
  /// Timestamp when the article was last modified. Updated on each edit
  /// operation.
  updated_at DateTime
  
  /// Soft deletion timestamp. When set, article is hidden from public view but
  /// retained for recovery and audit purposes.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  author discussion_board_members @relation(fields: [discussion_board_member_id], references: [id], onDelete: Cascade)
  lastModifiedByModerator discussion_board_moderators? @relation(fields: [last_modified_by_moderator_id], references: [id], onDelete: Cascade)
  
  discussion_board_article_snapshots discussion_board_article_snapshots[]
  discussion_board_article_categories discussion_board_article_categories[]
  discussion_board_article_tags discussion_board_article_tags[]
  discussion_board_comments discussion_board_comments[]
  discussion_board_article_images discussion_board_article_images[]
  discussion_board_article_documents discussion_board_article_documents[]
  discussion_board_reports discussion_board_reports[]
  
  @@index([last_modified_by_moderator_id])
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_id, created_at], map: "discussion_board_articles_discussion_board_member_id_c_f434e708")
  @@index([status, created_at])
  @@index([created_at])
}

/// Historical snapshots of article content for version control and audit
/// trails. Each snapshot captures the complete state of an article at a
/// specific point in time, preserving title, body, and metadata. Snapshots
/// are created on article creation and each subsequent edit, enabling
/// rollback and change tracking.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_article_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the parent article this snapshot belongs to. {@link
  /// discussion_board_articles.id}
  discussion_board_article_id String
  
  /// Member who created this snapshot version, either the original author or
  /// an editor. {@link discussion_board_members.id}
  created_by_member_id String
  
  /// Article title at the time of this snapshot. Preserved for historical
  /// accuracy.
  title String
  
  /// Article body content at the time of this snapshot. Complete content
  /// preserved for version comparison.
  body String
  
  /// Article summary at the time of this snapshot, if provided.
  summary String?
  
  /// Article status at the time of this snapshot. Values: published, draft,
  /// archived.
  status String
  
  /// Timestamp when this snapshot was created. Marks the point in time this
  /// version was saved.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  createdBy discussion_board_members @relation(fields: [created_by_member_id], references: [id], onDelete: Cascade)
  
  @@index([created_by_member_id])
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, created_at], map: "discussion_board_article_snapshots_discussion_board_ar_12be945f")
}

/// Junction table establishing many-to-many relationship between articles
/// and categories. Articles can belong to multiple categories for flexible
/// organization, and categories can contain multiple articles. Used for
/// article organization and category-based browsing.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_article_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the article in this relationship. {@link
  /// discussion_board_articles.id}
  discussion_board_article_id String
  
  /// Reference to the category in this relationship. {@link
  /// discussion_board_categories.id}
  discussion_board_category_id String
  
  /// Timestamp when this article-category association was created.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  category discussion_board_categories @relation(fields: [discussion_board_category_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([discussion_board_article_id, discussion_board_category_id], map: "discussion_board_article_categories_discussion_board_a_d24a46b3")
  // spellchecker: ignore-next-line
  @@index([discussion_board_category_id, created_at], map: "discussion_board_article_categories_discussion_board_c_6049250c")
}

