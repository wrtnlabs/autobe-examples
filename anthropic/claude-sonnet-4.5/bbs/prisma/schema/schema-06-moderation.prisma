/// Content reports submitted by members flagging articles or comments that
/// potentially violate community guidelines. Reports are reviewed by
/// moderators who can take appropriate action. Each report targets either an
/// article or a comment (polymorphic relationship) and tracks the reporter,
/// reason, status, and resolution.
///
/// @namespace Moderation
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_reports {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reporter who submitted this report. {@link discussion_board_members.id}.
  discussion_board_member_id String
  
  /// Reported article if the report targets an article. {@link
  /// discussion_board_articles.id}. Mutually exclusive with
  /// reported_comment_id.
  reported_article_id String?
  
  /// Reported comment if the report targets a comment. {@link
  /// discussion_board_comments.id}. Mutually exclusive with
  /// reported_article_id.
  reported_comment_id String?
  
  /// Moderator currently reviewing or who resolved this report. {@link
  /// discussion_board_moderators.id}. Nullable when report is pending.
  reviewing_moderator_id String?
  
  /// Category of the violation being reported (e.g., spam, harassment,
  /// misinformation, offensive content).
  report_reason String
  
  /// Detailed explanation provided by the reporter describing why the content
  /// violates guidelines.
  report_details String?
  
  /// Current status of the report: pending (not yet reviewed), under_review
  /// (moderator is reviewing), resolved (action taken), dismissed (no
  /// violation found).
  status String
  
  /// Notes from the moderator explaining the decision or action taken on this
  /// report.
  resolution_notes String?
  
  /// Timestamp when the report was submitted.
  created_at DateTime
  
  /// Timestamp when the report was last updated (status change, moderator
  /// assignment, resolution).
  updated_at DateTime
  
  /// Soft delete timestamp for audit trail. When set, the report is hidden but
  /// preserved for historical records.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  reporter discussion_board_members @relation(fields: [discussion_board_member_id], references: [id], onDelete: Cascade)
  reportedArticle discussion_board_articles? @relation(fields: [reported_article_id], references: [id], onDelete: Cascade)
  reportedComment discussion_board_comments? @relation(fields: [reported_comment_id], references: [id], onDelete: Cascade)
  reviewingModerator discussion_board_moderators? @relation(fields: [reviewing_moderator_id], references: [id], onDelete: Cascade)
  
  discussion_board_moderation_actions discussion_board_moderation_actions[]
  
  @@index([reported_article_id])
  @@index([reported_comment_id])
  
  @@index([status, created_at])
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_id, created_at], map: "discussion_board_reports_discussion_board_member_id_cr_b29a74da")
  @@index([reviewing_moderator_id, created_at])
}

/// Audit log of all moderation actions taken by moderators. Records every
/// moderator intervention including content edits, deletions, user warnings,
/// suspensions, and bans. Provides complete accountability and traceability
/// for all moderation decisions.
///
/// @namespace Moderation
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_moderation_actions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Moderator who performed this action. {@link
  /// discussion_board_moderators.id}.
  discussion_board_moderator_id String
  
  /// Report that triggered this moderation action if applicable. {@link
  /// discussion_board_reports.id}. Nullable for proactive moderation not
  /// triggered by reports.
  related_report_id String?
  
  /// Type of moderation action: edit_content, delete_content, restore_content,
  /// warn_user, suspend_user, ban_user, lift_suspension, dismiss_report.
  action_type String
  
  /// Type of entity targeted by this action: article, comment, user, report.
  target_type String
  
  /// UUID of the targeted entity (article ID, comment ID, user ID, or report
  /// ID depending on target_type).
  target_id String
  
  /// Reason or justification for taking this moderation action.
  reason String
  
  /// Additional details or notes about the action taken, including what was
  /// changed or why the decision was made.
  details String?
  
  /// Timestamp when the moderation action was performed.
  created_at DateTime
  
  /// Timestamp when the action record was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  moderator discussion_board_moderators @relation(fields: [discussion_board_moderator_id], references: [id], onDelete: Cascade)
  relatedReport discussion_board_reports? @relation(fields: [related_report_id], references: [id], onDelete: Cascade)
  
  discussion_board_user_warnings discussion_board_user_warnings[]
  discussion_board_user_suspensions discussion_board_user_suspensions[]
  
  @@index([related_report_id])
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_moderator_id, created_at], map: "discussion_board_moderation_actions_discussion_board_m_74437f0e")
  @@index([action_type, created_at])
  @@index([target_type, target_id])
}

/// Warnings issued to users for policy violations. Part of progressive
/// discipline system where users receive warnings before suspensions or
/// bans. Tracks warning severity, acknowledgment, and relationship to
/// moderation actions.
///
/// @namespace Moderation
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_user_warnings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User who received this warning. {@link discussion_board_members.id}.
  discussion_board_member_id String
  
  /// Moderator who issued this warning. {@link discussion_board_moderators.id}.
  discussion_board_moderator_id String
  
  /// Moderation action that resulted in this warning. {@link
  /// discussion_board_moderation_actions.id}. Nullable for warnings issued
  /// independently.
  related_moderation_action_id String?
  
  /// Category or type of violation that triggered this warning (e.g., spam,
  /// harassment, off-topic content).
  warning_reason String
  
  /// Detailed explanation of the violation and what behavior needs to change.
  warning_details String
  
  /// Severity level of the warning: minor, moderate, severe. Used for
  /// progressive discipline tracking.
  severity String
  
  /// Timestamp when the user acknowledged receipt of this warning. Nullable if
  /// not yet acknowledged.
  acknowledged_at DateTime?
  
  /// Timestamp when the warning was issued.
  created_at DateTime
  
  /// Timestamp when the warning record was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp if the warning is retracted or removed. Nullable
  /// for active warnings.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  warnedUser discussion_board_members @relation(fields: [discussion_board_member_id], references: [id], onDelete: Cascade)
  issuingModerator discussion_board_moderators @relation(fields: [discussion_board_moderator_id], references: [id], onDelete: Cascade)
  relatedModerationAction discussion_board_moderation_actions? @relation(fields: [related_moderation_action_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([related_moderation_action_id], map: "discussion_board_user_warnings_related_moderation_acti_e0ce256e")
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_id, created_at], map: "discussion_board_user_warnings_discussion_board_member_21e960af")
  // spellchecker: ignore-next-line
  @@index([discussion_board_moderator_id, created_at], map: "discussion_board_user_warnings_discussion_board_modera_3d800875")
}

/// Account suspensions preventing users from logging in and participating.
