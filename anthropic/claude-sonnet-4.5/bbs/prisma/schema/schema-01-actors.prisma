model discussion_board_moderator_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the moderator who owns this session. {@link
  /// discussion_board_moderators.id}
  discussion_board_moderator_id String
  
  /// IP address from which the moderator established this session.
  ip String
  
  /// Connection URL where the session was initiated.
  href String
  
  /// Referrer URL indicating where the moderator came from when starting the
  /// session.
  referrer String
  
  /// Timestamp when the session was created (moderator login time).
  created_at DateTime
  
  /// Timestamp when the session expired or was terminated. Null indicates an
  /// active moderator session.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  moderator discussion_board_moderators @relation(fields: [discussion_board_moderator_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_moderator_id, created_at], map: "discussion_board_moderator_sessions_discussion_board_m_086f6f8b")
}