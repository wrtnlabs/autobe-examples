  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id], map: "discussion_board_content_violation_records_discussion__949fbe0c")
  // spellchecker: ignore-next-line
  @@index([discussion_board_comment_id], map: "discussion_board_content_violation_records_discussion__ec5936c6")
