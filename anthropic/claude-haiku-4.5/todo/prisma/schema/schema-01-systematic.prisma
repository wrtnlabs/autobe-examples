/// System-wide configuration and metadata storage for the Todo List
/// application. This table maintains operational settings, feature flags,
/// and deployment-specific configuration that applies across the entire
/// system. Configuration entries are stored as key-value pairs with type
/// information and versioning, enabling flexible management of system
/// behavior without database schema migrations.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_list_system_config {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique configuration key identifier. Examples: 'max_todos_per_user',
  /// 'enable_feature_flag_xyz', 'deployment_environment',
  /// 'token_expiration_minutes'. Used to lookup specific configuration values.
  config_key String
  
  /// Configuration value as string. The actual value is stored as string for
  /// flexibility; type conversion handled by application based on value_type
  /// field. Examples: '10000', 'true', 'production', '900'.
  config_value String
  
  /// Data type of the configuration value. Valid values: 'string', 'integer',
  /// 'boolean', 'float'. Used by application to parse and convert config_value
  /// to appropriate type for processing.
  value_type String
  
  /// Human-readable description explaining the purpose and usage of this
  /// configuration setting. Helps operations team understand what this setting
  /// controls and when it should be modified.
  description String?
  
  /// Version number of this configuration entry. Incremented each time the
  /// value is updated. Starts at 1 for new entries. Enables tracking of
  /// configuration evolution over time.
  version Int
  
  /// Timestamp when this configuration entry was initially created in UTC.
  /// Immutable after creation. Used for audit trail and history tracking.
  created_at DateTime
  
  /// Timestamp when this configuration entry was last modified in UTC. Updated
  /// whenever the config_value or other fields change. Used to track most
  /// recent configuration updates.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  @@unique([config_key])
  @@index([created_at])
  @@index([updated_at])
}