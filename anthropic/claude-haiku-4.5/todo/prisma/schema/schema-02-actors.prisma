/// Regular user accounts for personal todo management. Stores authentication
/// credentials, profile information, and account metadata for users who can
/// create and manage their own todo items. Each user maintains a completely
/// private, isolated todo list that no other user can access.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_user {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User's email address used for authentication and account recovery. Must
  /// be in valid email format and unique across all user accounts. This is the
  /// primary login identifier.
  email String
  
  /// Encrypted password hash using bcrypt with salt rounds >= 12. Passwords
  /// are never stored in plain text. The hash includes the salt and algorithm
  /// metadata.
  password_hash String
  
  /// User account creation timestamp in UTC. This value is immutable and
  /// records when the user first registered.
  created_at DateTime
  
  /// Last modification timestamp. Updated whenever user profile information or
  /// password is changed. Enables tracking of account activity.
  updated_at DateTime
  
  /// Soft deletion timestamp. If null, the account is active. If set, the
  /// account is marked for deletion but data is retained for compliance and
  /// potential recovery within retention period.
  deleted_at DateTime?
  
  /// Timestamp of the user's most recent activity (login or API request).
  /// Updated with each authenticated request. Used to identify inactive
  /// accounts for monitoring and engagement analysis.
  last_active_at DateTime?
  
  //----
  // RELATIONS
  //----
  todo_app_user_session todo_app_user_session[]
  todo_app_todo todo_app_todo[]
  todo_app_audit_log todo_app_audit_log[]
  
  @@unique([email])
  @@index([created_at])
  @@index([deleted_at])
}

/// Authentication sessions for regular users. Records active login sessions
/// with connection metadata and timing information. Each session represents
/// an authenticated connection from a specific device or browser, enabling
/// multi-device login support and session management.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_user_session {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Foreign key referencing the user who owns this session. Links this
  /// authentication session to a specific user account. {@link
  /// todo_app_user.id}
  user_id String
  
  /// Client IP address where the session was initiated. Used for security
  /// monitoring and detecting suspicious login patterns from unusual
  /// locations.
  ip String
  
  /// Connection URL (referrer or entry point URL). Records what page or
  /// endpoint was accessed when the session was established. Useful for
  /// understanding user entry patterns.
  href String
  
  /// HTTP Referrer header or source that led to the connection. May indicate
  /// if user came from bookmark, search, external link, or direct access.
  referrer String
  
  /// Session creation timestamp when user successfully authenticated. Recorded
  /// in UTC. Used to calculate session age and enforce timeout policies.
  created_at DateTime
  
  /// Session expiration or logout timestamp. If null, the session is still
  /// active. If set, indicates when the session ended (either by user logout
  /// or automatic expiration).
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  user todo_app_user @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([user_id, created_at])
}

/// Administrator accounts with elevated system-wide permissions. Separate
/// from regular users to maintain clear permission boundaries. Admins can
/// manage user accounts, view system statistics, access audit logs, and
/// configure system settings. Admin data follows same security practices as
/// user accounts.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_admin {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Admin's email address used for authentication and system notifications.
  /// Must be in valid email format and unique across all admin accounts. This
  /// is the primary login identifier for admin panel access.
  email String
  
  /// Encrypted password hash using bcrypt with salt rounds >= 12. Passwords
  /// are never stored in plain text. The hash includes the salt and algorithm
  /// metadata.
  password_hash String
  
  /// Admin account creation timestamp in UTC. This value is immutable and
  /// records when the admin account was first created by system operator.
  created_at DateTime
  
  /// Last modification timestamp. Updated whenever admin profile information
  /// or password is changed. Enables tracking of account modifications.
  updated_at DateTime
  
  /// Soft deletion timestamp. If null, the account is active. If set, the
  /// admin account is marked for deletion but data is retained for audit trail
  /// and compliance purposes.
  deleted_at DateTime?
  
  /// Timestamp of the admin's most recent activity (login or API request).
  /// Updated with each authenticated request. Used to monitor admin activity
  /// and identify inactive admin accounts.
  last_active_at DateTime?
  
  //----
  // RELATIONS
  //----
  todo_app_admin_session todo_app_admin_session[]
  
  @@unique([email])
  @@index([created_at])
  @@index([deleted_at])
}

/// Authentication sessions for administrators. Records active admin login
/// sessions with connection metadata and timing. Each session represents an
/// authenticated admin connection, enabling admin multi-device access and
/// comprehensive session tracking for security auditing.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_admin_session {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Foreign key referencing the admin who owns this session. Links this
  /// authentication session to a specific admin account. {@link
  /// todo_app_admin.id}
  admin_id String
  
  /// Client IP address where the session was initiated. Used for security
  /// monitoring, audit trail, and detecting unauthorized admin access attempts
  /// from unexpected locations.
  ip String
  
  /// Connection URL (entry point URL). Records what endpoint was accessed when
  /// the admin session was established. Useful for understanding admin panel
  /// access patterns.
  href String
  
  /// HTTP Referrer header or source that led to the admin connection. May
  /// indicate internal navigation or external access to admin panel.
  referrer String
  
  /// Session creation timestamp when admin successfully authenticated.
  /// Recorded in UTC. Used to track when admin panel access occurred and
  /// enforce session timeout policies.
  created_at DateTime
  
  /// Session expiration or logout timestamp. If null, the session is still
  /// active. If set, indicates when the admin session ended (by logout or
  /// automatic expiration after inactivity).
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  admin todo_app_admin @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  
  @@index([admin_id, created_at])
}