  /// Reference ID from payment processor (for linking related transactions)
  gateway_reference_id String?
  
  /// Authorization code if applicable
  authorization_code String?
  
  /// Response code from payment processor
  response_code String?
  
  /// Response message from payment processor
  response_message String?
  
  /// Error code if transaction failed
  error_code String?
  
  /// Error message if transaction failed
  error_message String?
  
  /// Address Verification System response (if card transaction)
  avs_response String?
  
  /// CVV verification response (if card transaction)
  cvv_response String?
  
  /// Full request JSON sent to payment processor (for audit trail, no
