/// Refund request and processing records. Tracks lifecycle of refunds from
/// initiation through completion. Separate entity (not nullable fields on
/// payments) enables proper refund state management and audit trail. Refunds
/// can be partial, have multiple statuses, and require approval workflows.
///
/// @namespace Payments
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_refunds {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the original payment being refunded. {@link
  /// shopping_mall_payments.id}
  shopping_mall_payment_id String
  
  /// Reference to the order. {@link shopping_mall_orders.id}
  shopping_mall_order_id String
  
  /// Unique refund identifier (REF-YYYYMMDD-XXXXXX format)
  refund_number String
  
  /// Reason for refund: customer_request, payment_failure,
  /// seller_cancellation, order_cancellation, return_accepted,
  /// dispute_resolution, chargeback, other
  refund_reason String
  
  /// Amount to be refunded (may be less than original payment for partial
  /// refunds)
  refund_amount Float
  
  /// Original payment amount (for reference)
  original_amount Float
  
  /// Current refund status: initiated, approved, processing, completed,
  /// failed, reversed, cancelled
  refund_status String
  
  /// How refund will be issued: original_payment_method, store_credit,
  /// bank_transfer, other
  refund_method String
  
  /// Amount deducted from refund (restocking fee, condition deduction, etc.)
  deduction_amount Float?
  
  /// Reason for deduction (e.g., item condition, restocking fee)
  deduction_reason String?
  
  /// Internal notes about this refund (admin comments, investigation notes,
  /// etc.)
  notes String?
  
  /// Who initiated the refund: customer, seller, admin, system
  initiated_by String
  
  /// Admin ID who approved the refund (if applicable)
  approved_by String?
  
  /// When refund was initiated
  initiation_timestamp DateTime
  
  /// When refund was approved for processing
  approval_timestamp DateTime?
  
  /// When refund processing was initiated with payment processor
  processing_timestamp DateTime?
  
  /// When refund was completed/credited to customer
  completion_timestamp DateTime?
  
  /// Expected date/time refund will appear in customer account
  expected_completion_date DateTime?
  
  /// Refund ID from payment processor
  gateway_refund_id String?
  
  /// Record creation timestamp
  created_at DateTime
  
  /// Last update timestamp
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  payment shopping_mall_payments @relation(fields: [shopping_mall_payment_id], references: [id], onDelete: Cascade)
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  
  @@unique([refund_number])
  @@unique([gateway_refund_id])
  @@index([shopping_mall_payment_id])
  @@index([shopping_mall_order_id])
  @@index([refund_status])
  @@index([initiation_timestamp])
}

/// Customer payment methods stored on file. Tokenized payment references for
