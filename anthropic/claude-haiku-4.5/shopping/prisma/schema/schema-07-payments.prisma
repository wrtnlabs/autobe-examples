/// Core payment records for customer orders. Stores order-level payment
/// information including customer, order reference, payment method, and
/// final payment status. This is separate from detailed payment processor
/// transactions to maintain clean separation of concerns between order-level
/// payment state and gateway-level transaction details.
///
/// @namespace Payments
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_payments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the order being paid for. {@link shopping_mall_orders.id}
  shopping_mall_order_id String
  
  /// Customer making the payment. {@link shopping_mall_customers.id}
  shopping_mall_customer_id String
  
  /// Payment method used for this transaction. {@link
  /// shopping_mall_payment_methods.id}
  shopping_mall_payment_method_id String?
  
  /// Human-readable order number for reference (e.g., ORD-20250115-ABC123)
  order_number String
  
  /// Payment amount in platform currency (stored in cents to avoid floating
  /// point errors)
  amount Float
  
  /// ISO 4217 currency code (USD, EUR, INR, etc.)
  currency String
  
  /// Current payment status: pending_payment, payment_processing,
  /// payment_confirmed, payment_failed, payment_pending, refund_processing,
  /// refund_completed, refund_failed
  payment_status String
  
  /// Type of payment method: credit_card, debit_card, paypal, bank_transfer,
  /// digital_wallet
  payment_method_type String
  
  /// Last 4 digits of card (if card payment), masked for security
  card_last_four String?
  
  /// Name on the payment method
  cardholder_name String?
  
  /// Billing address provided at payment time (JSON formatted for address
  /// components)
  billing_address String?
  
  /// Authorization code from payment processor if transaction was approved
  authorization_code String?
  
  /// Unique transaction ID from payment processor
  transaction_id String?
  
  /// Standardized response code from payment processor (00 for success, etc.)
  response_code String?
  
  /// Human-readable response message from payment processor
  response_message String?
  
  /// Error code if transaction failed (insufficient funds, expired card, etc.)
  error_code String?
  
  /// Detailed error explanation if transaction declined or failed
  error_message String?
  
  /// Risk assessment score from payment processor (0-100, higher = more risky)
  fraud_score Float?
  
  /// 3D Secure authentication status: not_applicable, authenticated,
  /// attempted, not_enrolled
  three_d_secure_status String?
  
  /// Unique key for idempotent payment processing to prevent duplicate charges
  idempotency_key String?
  
  /// Customer IP address when payment was attempted
  ip_address String?
  
  /// Browser/device user agent information
  user_agent String?
  
  /// When the payment request was received
  request_timestamp DateTime
  
  /// When payment authorization was received from processor
  authorization_timestamp DateTime?
  
  /// Payment record creation timestamp
  created_at DateTime
  
  /// Last update timestamp for this payment record
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  paymentMethod shopping_mall_payment_methods? @relation(fields: [shopping_mall_payment_method_id], references: [id], onDelete: Cascade)
  
  shopping_mall_payment_transactions shopping_mall_payment_transactions[]
  shopping_mall_refunds shopping_mall_refunds[]
  
  @@unique([shopping_mall_order_id])
  @@index([shopping_mall_payment_method_id])
  
  @@unique([transaction_id])
  @@unique([idempotency_key])
  @@index([shopping_mall_customer_id, created_at])
  @@index([payment_status])
  @@index([created_at])
}

/// Detailed payment processor transaction records. Captures every
/// interaction with the payment gateway including authorization, capture,
