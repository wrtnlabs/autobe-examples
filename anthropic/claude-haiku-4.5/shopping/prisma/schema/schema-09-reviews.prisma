  vote_type String
  
  /// Timestamp when customer submitted their vote. ISO 8601 format. Records
  /// when vote was cast.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  review shopping_mall_product_reviews @relation(fields: [shopping_mall_product_review_id], references: [id], onDelete: Cascade)
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_product_review_id, shopping_mall_customer_id], map: "shopping_mall_review_helpful_votes_shopping_mall_produ_3507a9f3")
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_review_id], map: "shopping_mall_review_helpful_votes_shopping_mall_produ_4a045360")
  // spellchecker: ignore-next-line
  @@index([shopping_mall_customer_id], map: "shopping_mall_review_helpful_votes_shopping_mall_custo_b750afe0")
  @@index([vote_type])
}

/// Denormalized materialized view aggregating product ratings.
/// Pre-calculates average rating, total review count, and rating
/// distribution for each product. Provides fast access to rating data
/// without expensive aggregation queries. Read-only table updated via batch
/// job.
