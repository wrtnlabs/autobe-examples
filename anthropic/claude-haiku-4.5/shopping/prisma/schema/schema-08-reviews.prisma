  /// Positive feedback percentage on this date. Tracks satisfaction trend.
  positive_feedback_percentage Float
  
  /// Return rate on this date. Tracks quality trend.
  return_rate_percentage Float
  
  /// On-time delivery percentage on this date. Tracks reliability trend.
  on_time_delivery_percentage Float
  
  /// Cumulative orders on this date. Tracks seller growth.
  total_orders_sold Int
  
  /// Average response time on this date. Tracks communication speed trend.
  average_response_hours Float?
  
  /// Record creation timestamp (when snapshot was taken). Set at metric
  /// calculation time.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  seller ecommerce_mall_sellers @relation(fields: [ecommerce_mall_seller_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
