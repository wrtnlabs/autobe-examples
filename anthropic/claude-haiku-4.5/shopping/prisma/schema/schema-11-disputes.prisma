  user_agent String?
  
  /// Timestamp when action was performed (ISO 8601 format, UTC). Immutable
  /// record timestamp.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  dispute shopping_mall_disputes @relation(fields: [shopping_mall_dispute_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_dispute_id, created_at], map: "shopping_mall_dispute_audit_trail_shopping_mall_disput_24a54d62")
  @@index([actor_type, actor_id])
  @@index([action_type])
  @@index([created_at])
}