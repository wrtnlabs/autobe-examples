  appeal_decision_reason String?
  
  /// Timestamp when appeal was submitted (ISO 8601 format).
  created_at DateTime
  
  /// Timestamp when appeal was reviewed and decision made (null if not yet
  /// decided).
  reviewed_at DateTime?
  
  //----
  // RELATIONS
  //----
  dispute shopping_mall_disputes @relation(fields: [shopping_mall_dispute_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_dispute_id, appeal_number], map: "shopping_mall_dispute_appeals_shopping_mall_dispute_id_a9c37e22")
  // spellchecker: ignore-next-line
  @@index([appealing_party_type, appealing_party_id], map: "shopping_mall_dispute_appeals_appealing_party_type_app_a1d0546a")
  @@index([status])
  @@index([reviewed_by_admin_id])
}

/// Immutable audit log of all significant actions and state changes on
/// disputes. Records every operation performed on dispute records by any
/// actor (customer, seller, admin, system). Essential for compliance and
/// investigation.
///
/// @namespace Disputes
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_dispute_audit_trail {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the dispute being audited. {@link shopping_mall_disputes.id}.
  shopping_mall_dispute_id String
  
  /// Type of action performed: created, status_changed, evidence_added,
  /// communication_sent, resolution_recorded, appeal_submitted,
  /// appeal_decided, assigned_to_admin, reassigned, closed. Categorizes the
  /// audit entry.
  action_type String
  
  /// Type of actor performing the action: customer, seller, admin, system.
