/// tracked in the {@link todo_app_guest_sessions} table. Guests have
/// strictly limited access compared to authenticated members and cannot
/// create or manage todos.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
