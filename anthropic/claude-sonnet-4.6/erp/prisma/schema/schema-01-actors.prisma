  id String @id
  
  /// The guest actor this session belongs to. References {@link
  /// erp_hrm_guests.id}.
  erp_hrm_guest_id String
  
  /// IP address of the client that initiated this guest session.
  ip String
  
  /// Full URL (href) of the page the guest was on when the session was created.
  href String
  
  /// HTTP referrer URL indicating the origin page that led the guest to this
  /// session entry point.
  referrer String
  
  /// Timestamp when this guest session was created.
  created_at DateTime
  
