  //----
  // RELATIONS
  //----
  fulfillment shopping_mall_fulfillments @relation(fields: [fulfillment_id], references: [id], onDelete: Cascade)
  shipment shopping_mall_shipments @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  
  @@unique([fulfillment_id, shipment_id])
  @@index([shipment_id, fulfillment_id])
}

