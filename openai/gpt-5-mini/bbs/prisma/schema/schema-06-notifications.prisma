/// Queued notification messages targeted to members. Each record represents
/// a delivery task produced by subscription events or direct notifications
/// (mentions, system messages). Contains scheduling, delivery attempts,
/// status, optional relation to article and originating subscription, and
/// temporal fields for auditing. Managed by worker processes for delivery
/// and retries.
///
/// @namespace Notifications
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_notifications {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Recipient member's {@link discussion_board_member.id}.
  recipient_member_id String
  
  /// Originating subscription's {@link discussion_board_subscriptions.id}.
  /// Nullable when notification was created outside a subscription (e.g.,
  /// mention).
  discussion_board_subscription_id String?
  
  /// Optional related article {@link discussion_board_articles.id} that
  /// triggered the notification.
  discussion_board_article_id String?
  
  /// Notification type (e.g., "subscription_update", "mention", "system").
  type String
  
  /// Opaque JSON payload or small text describing the notification content.
  /// Application enforces size limits.
  payload String?
  
  /// Delivery status: "pending", "sent", or "failed".
  status String
  
  /// Delivery priority, higher values indicate earlier processing.
  priority Int
  
  /// Number of delivery attempts made.
  delivery_attempts Int
  
  /// Timestamp of the last delivery attempt.
  last_attempted_at DateTime?
  
  /// Scheduled time for the next retry attempt (backoff).
  next_retry_at DateTime?
  
  /// When the notification is scheduled to be delivered (worker will consider
  /// scheduled_at <= now).
  scheduled_at DateTime
  
  /// Timestamp when notification was successfully delivered.
  sent_at DateTime?
  
  /// Optional short failure reason from last attempt.
  fail_reason String?
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  /// Soft-delete timestamp.
  deleted_at DateTime?
  
