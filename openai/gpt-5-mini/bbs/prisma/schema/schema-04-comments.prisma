/// User comments on articles. Stores threaded replies via a self-referencing
/// parent_comment_id and preserves author attribution while allowing account
/// deletion (author nullable). Used for moderation, search, and comment
/// listings tied to articles. This corrected model enforces SET NULL on
/// author and parent relationships to preserve conversation history when
/// accounts/parents are removed.
///
/// @namespace Comments
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_comments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged article's {@link discussion_board_articles.id}.
  discussion_board_article_id String
  
  /// Comment author's {@link discussion_board_member.id}. Nullable to allow
  /// SET NULL when a member account is removed.
  discussion_board_author_id String?
  
  /// Parent comment reference for threaded replies. {@link
  /// discussion_board_comments.id}. Nullable for root comments or when parent
  /// is deleted.
  discussion_board_parent_comment_id String?
  
  /// Comment body text. Application-enforced maximum length applies (e.g.,
  /// 500-5000 chars depending on product policy). Used for full-text search.
  content String
  
  /// Whether the comment is hidden by moderation or automated rules.
  is_hidden Boolean
  
  /// Creation timestamp (ISO 8601 UTC).
  created_at DateTime
  
  /// Last modification timestamp (ISO 8601 UTC).
  updated_at DateTime
  
  /// Soft-delete timestamp. Null if not soft-deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  author discussion_board_member? @relation(fields: [discussion_board_author_id], references: [id], onDelete: Cascade)
  parent discussion_board_comments? @relation("recursive", fields: [discussion_board_parent_comment_id], references: [id], onDelete: Cascade)
  
  recursive discussion_board_comments[] @relation("recursive")
  discussion_board_comment_attachments discussion_board_comment_attachments[]
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_parent_comment_id, created_at], map: "discussion_board_comments_discussion_board_parent_comm_8f97a165")
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, created_at], map: "discussion_board_comments_discussion_board_article_id__aa7deb51")
  // spellchecker: ignore-next-line
  @@index([discussion_board_author_id, created_at], map: "discussion_board_comments_discussion_board_author_id_c_000936ff")
}

