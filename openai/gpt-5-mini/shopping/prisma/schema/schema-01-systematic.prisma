/// Platform-wide configuration key/value store. Stores namespaced settings
/// used by administrative and operational flows (feature flags, thresholds,
/// toggles). Added explicit value format metadata to make structured
/// settings (JSON) and schema versioning explicit for safe evolution and
/// validation.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_system_settings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Logical namespace for the setting (e.g., "shopping", "payments",
  /// "notifications").
  namespace String
  
  /// Setting key within the namespace (unique per namespace).
  key String
  
  /// Serialized setting value (string). For structured content the
  /// `value_is_json` flag indicates JSON payload.
  value String
  
  /// Indicates whether `value` contains JSON serialized text (true) or plain
  /// string (false). Allows safe parsing by consumers during migration to Json
  /// column.
  value_is_json Boolean
  
  /// Optional schema identifier or version for structured JSON config (e.g.,
  /// "featureFlag:v1"). Useful for validation and migration tooling.
  value_schema String?
  
  /// Human-friendly description and operational guidance for the setting.
  description String?
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last modification timestamp.
  updated_at DateTime
  
  /// Soft-delete timestamp; null when active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  @@unique([namespace, key])
  @@index([namespace, created_at])
}

/// Currency reference table. Contains ISO currency code, display name,
/// symbol, decimal precision and active flag. Serves as authoritative
/// currency metadata for pricing, formatting, and settlement flows.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_currencies {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// ISO 4217 currency code (e.g., "USD", "KRW"). Unique business key.
  code String
  
  /// Human-readable currency name (e.g., "US Dollar").
  name String
  
  /// Display symbol for the currency (e.g., "$", "₩").
  symbol String?
  
  /// Number of decimal digits used for the currency (e.g., 2 for USD, 0 for
  /// JPY).
  decimal_digits Int
  
  /// Whether this currency is currently enabled for use on the platform.
  is_active Boolean
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  /// Soft-delete timestamp; null when active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shopping_mall_countries shopping_mall_countries[]
  shopping_mall_shipping_profiles shopping_mall_shipping_profiles[]
  shopping_mall_orders shopping_mall_orders[]
  shopping_mall_payments shopping_mall_payments[]
  shopping_mall_refund_requests shopping_mall_refund_requests[]
  shopping_mall_disputes shopping_mall_disputes[]
  shopping_mall_coupons shopping_mall_coupons[]
  shopping_mall_payouts shopping_mall_payouts[]
  shopping_mall_settlements shopping_mall_settlements[]
  shopping_mall_seller_balances shopping_mall_seller_balances[]
  
  @@unique([code])
  @@index([is_active, updated_at])
}

/// Country and region metadata used by shipping, tax, and localization
/// subsystems. Added nullable FK to shopping_mall_currencies to avoid drift
/// between string codes and canonical currency records while preserving
/// `default_currency_code` for compatibility.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_countries {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Optional canonical currency reference for the country. {@link
  /// shopping_mall_currencies.id}. Nullable for countries without assigned
  /// currency in platform configuration.
  shopping_mall_currency_id String?
  
  /// ISO 3166-1 alpha-2 country code (e.g., "KR", "US"). Unique key.
  iso_code String
  
  /// Country display name.
  name String
  
  /// Geographic region grouping (e.g., "Asia", "Europe").
  region String?
  
  /// International dialing code (E.164 prefix, e.g., "+82").
  calling_code String?
  
  /// Optional ISO currency code commonly used in the country. Retained for
  /// backward compatibility; prefer shopping_mall_currency_id when present.
  default_currency_code String?
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  /// Soft-delete timestamp; null when active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  currency shopping_mall_currencies? @relation(fields: [shopping_mall_currency_id], references: [id], onDelete: Cascade)
  
  shopping_mall_tax_profiles shopping_mall_tax_profiles[]
  
  @@unique([iso_code])
  @@index([region, updated_at])
  @@index([shopping_mall_currency_id, iso_code])
}

/// Shipping profile definitions that describe carrier rules, base pricing,
/// and optional free-shipping thresholds. Added explicit currency FK and
/// store monetary amounts in minor units (int) to avoid floating point
/// rounding and multi-currency ambiguity.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_shipping_profiles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Currency used for profile amounts. {@link shopping_mall_currencies.id}.
  shopping_mall_currency_id String
  
  /// Unique machine-friendly code for the shipping profile (e.g.,
  /// "standard_domestic").
  code String
  
  /// Human-friendly shipping profile name.
  name String
  
  /// Operational notes describing the profile behavior and carrier mapping.
  description String?
  
  /// Base shipping price in minor currency units (e.g., cents) to avoid
  /// floating-point rounding issues.
  base_price Int
  
  /// Order subtotal threshold in minor currency units above which shipping is
  /// free for this profile; null if not applicable.
  free_threshold Int?
  
  /// Whether the shipping profile is currently available for selection.
  is_active Boolean
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  /// Soft-delete timestamp; null when active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  currency shopping_mall_currencies @relation(fields: [shopping_mall_currency_id], references: [id], onDelete: Cascade)
  
  @@unique([code])
  @@unique([name])
  @@index([is_active, updated_at])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_currency_id, is_active], map: "shopping_mall_shipping_profiles_shopping_mall_currency_58472164")
}

/// Tax profile definitions used to compute taxes during checkout. Each tax
/// profile is associated with a country (shopping_mall_countries) and
/// defines a percentage rate and whether the tax is inclusive. Profiles are
/// versionable by creating new records (historical snapshots handled by
/// separate components if needed).
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_tax_profiles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced country's {@\link shopping_mall_countries.id}.
  shopping_mall_country_id String
  
  /// Tax profile name (e.g., "VAT 10% - Domestic").
  name String
  
  /// Tax rate expressed as a percentage (e.g., 10.0 for 10%).
  rate Float
  
  /// Whether tax is price-inclusive (true) or added on top of price (false).
  is_inclusive Boolean
  
  /// Operational notes and jurisdictional guidance for the tax profile.
  description String?
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  /// Soft-delete timestamp; null when active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  country shopping_mall_countries @relation(fields: [shopping_mall_country_id], references: [id], onDelete: Cascade)
  
  @@unique([shopping_mall_country_id, name])
  @@index([shopping_mall_country_id, rate])
}