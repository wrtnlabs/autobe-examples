/// Product container representing a seller-owned catalog item. Removed
/// derived aggregate fields (average_rating, review_count) to avoid storing
/// calculated metrics in the primary business table. Aggregate metrics are
/// provided by a materialized view (mv_shopping_mall_product_ratings).
/// Product remains the canonical product metadata store and links to seller
/// and snapshots.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Owning seller reference. {@link shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Human-readable product title used in listings and search.
  title String
  
  /// Unique URL-friendly product slug.
  slug String
  
  /// Long-form product description for detail pages.
  description String?
  
  /// Canonical product image URI used as thumbnail.
  default_image_uri String?
  
  /// Whether the product is visible to customers.
  is_published Boolean
  
  /// Record creation time.
  created_at DateTime
  
  /// Last update time.
  updated_at DateTime
  
  /// Soft-delete timestamp; null when active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  
  shopping_mall_product_images shopping_mall_product_images[]
  shopping_mall_product_categories shopping_mall_product_categories[]
  shopping_mall_variants shopping_mall_variants[]
  shopping_mall_product_snapshots shopping_mall_product_snapshots[]
  mv_shopping_mall_product_ratings mv_shopping_mall_product_ratings?
  shopping_mall_inquiries shopping_mall_inquiries[]
  
  @@unique([slug])
  @@index([shopping_mall_seller_id, created_at])
}

