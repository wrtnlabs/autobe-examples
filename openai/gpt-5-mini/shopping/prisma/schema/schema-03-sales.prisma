/// Materialized view (read-only) storing denormalized product rating
/// aggregates for fast reads. This mv replaces storing average_rating and
/// review_count on the product table and must be refreshed on a schedule or
/// updated incrementally by triggers/background jobs. Marked material: true
/// and stance: "subsidiary".
///
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model mv_shopping_mall_product_ratings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced product {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Computed average rating for the product (derived from reviews). Stored
  /// here in the materialized view for fast reads.
  average_rating Float
  
  /// Count of published reviews for the product at aggregation time.
  review_count Int
  
  /// When this materialized row was last refreshed.
  last_updated_at DateTime
  
  /// Creation timestamp for this mv row (can mirror last_updated_at).
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  @@unique([shopping_mall_product_id])
  @@index([last_updated_at])
}