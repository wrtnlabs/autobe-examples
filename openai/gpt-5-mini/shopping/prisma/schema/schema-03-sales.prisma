/// SKU (variant) entities representing sellable units with independent price
/// and inventory. Added explicit inventory counters
/// (available/reserved/committed) as canonical low-latency fields. The
/// transactional inventory log (shopping_mall_inventory_transactions) and
/// reservation table remain the audit and reservation sources; these
/// counters are the fast-access snapshot used by storefront and availability
/// checks.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_variants {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product reference. {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Platform-unique SKU code.
  sku String
  
  /// Variant display title (e.g., 'Red / L').
  title String?
  
  /// Current price for this variant.
  price Float
  
  /// Units currently available for sale (not reserved/committed). This is the
  /// canonical availability counter used by storefront queries.
  available Int
  
  /// Quantity currently reserved (checkout holds) for this variant.
  /// Reservation lifecycle maintained in shopping_mall_inventory_reservations;
  /// this counter is a snapshot to speed availability checks.
  reserved Int
  
  /// Quantity permanently committed to paid orders (not yet shipped). Used for
  /// settlement and reconciliation calculations.
  committed Int
  
  /// Optional weight for shipping calculations.
  weight Float?
  
  /// Flag indicating whether backorders are allowed.
  is_backorder Boolean
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last modification timestamp.
  updated_at DateTime
  
  /// Soft-delete timestamp.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  shopping_mall_variant_options shopping_mall_variant_options[]
  shopping_mall_variant_images shopping_mall_variant_images[]
  shopping_mall_cart_items shopping_mall_cart_items[]
  shopping_mall_wishlist_items shopping_mall_wishlist_items[]
  shopping_mall_order_items shopping_mall_order_items[]
  shopping_mall_inventory_transactions shopping_mall_inventory_transactions[]
  shopping_mall_inventory_reservations shopping_mall_inventory_reservations[]
  shopping_mall_inventory_reconciliations shopping_mall_inventory_reconciliations[]
  
  @@unique([sku])
  @@index([shopping_mall_product_id, available])
}

