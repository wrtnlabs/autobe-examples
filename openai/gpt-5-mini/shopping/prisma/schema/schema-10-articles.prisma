  //----
  /// Primary Key.
  id String @id
  
  /// Authoring admin's {@link shopping_mall_admins.id}.
  shopping_mall_admin_id String
  
  /// Article title used for listings and search.
  title String
  
  /// URL-friendly unique slug for the article.
  slug String
  
  /// Short summary or teaser shown in lists and share cards.
  excerpt String?
  
  /// Full article body. Stored as text for rendering and snapshotting.
  body String
  
  /// URI to the article's cover image.
