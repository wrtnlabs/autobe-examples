  //----
  /// Primary Key.
  id String @id
  
  /// Owner user reference. {@link todo_app_todouser.id}.
  todo_app_todouser_id String
  
  /// List title. Non-empty user-provided name for the list.
  title String
  
  /// Optional list description or notes.
  description String?
  
  /// List visibility setting (e.g., 'private','shared-invite-only','public').
  visibility String
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
