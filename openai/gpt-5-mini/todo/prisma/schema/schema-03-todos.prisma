  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent list reference. {@link todo_app_lists.id}.
  todo_app_list_id String
  
  /// Task title. Required short text for the task (1..200 chars enforced at
  /// application layer).
  title String
  
  /// Optional detailed description of the task (max 4000 chars enforced by
  /// application).
  description String?
  
  /// Completion flag.
  is_completed Boolean
  
  /// When the task was completed; null if not completed.
  completed_at DateTime?
  
  /// Optional due date for scheduling and sorting.
  due_date DateTime?
  
  /// Optional priority value. Business enum: 'low','medium','high','urgent'.
  /// Nullable if not provided.
  priority String?
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  /// Soft-delete timestamp; null when active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  list todo_app_lists @relation(fields: [todo_app_list_id], references: [id], onDelete: Cascade)
  
  todo_app_task_tag_relations todo_app_task_tag_relations[]
  todo_app_task_snapshots todo_app_task_snapshots[]
  todo_app_audit_logs todo_app_audit_logs[]
  todo_app_user_activity_logs todo_app_user_activity_logs[]
  
  @@index([todo_app_list_id, created_at])
  @@index([todo_app_list_id, is_completed])
  @@index([todo_app_list_id, due_date])
}

