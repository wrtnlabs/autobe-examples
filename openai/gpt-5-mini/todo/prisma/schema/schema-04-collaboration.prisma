  /// Referenced list for the public share. {@link todo_app_lists.id}.
  todo_app_list_id String
  
  /// User who created the public share. {@link todo_app_todouser.id}.
  created_by_todouser_id String
  
  /// Opaque token used to validate share access (unique).
