/// Invitation records for list collaboration. Captures inviter, optional
/// invitee (registered user), invitee email, an opaque invite_code, human
/// message, lifecycle state (pending/accepted/declined/expired), expiry
/// timestamp (14-day business rule), and audit timestamps. Adjusted to
/// enforce uniqueness for registered-user invites to prevent duplicate
/// invitations to the same user for the same list.
///
/// @namespace Collaboration
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_invitations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Target list. {@link todo_app_lists.id}.
  todo_app_list_id String
  
  /// Inviter user. {@link todo_app_todouser.id}.
  inviter_todouser_id String
  
  /// Inviter session for audit/tracing. {@link todo_app_todouser_sessions.id}.
  inviter_todouser_session_id String?
  
  /// Invitee when the invited user is already registered. {@link
  /// todo_app_todouser.id}.
  invitee_todouser_id String?
  
  /// Email address used to send the invitation when invitee is not yet
  /// registered.
  invitee_email String?
  
  /// Opaque invite code used for acceptance links. Business-unique token.
  invite_code String
  
  /// Optional human message included with the invitation.
  message String?
  
  /// Invitation lifecycle state: 'pending', 'accepted', 'declined', 'expired'.
  /// Consider enforcing as enum at application/DB level.
  state String
  
  /// Expiration timestamp enforcing the 14-day expiry business rule.
  expires_at DateTime
  
  /// When the invitation was accepted (if accepted).
  accepted_at DateTime?
  
  /// Record creation time.
  created_at DateTime
  
  /// Last update time.
  updated_at DateTime
  
  /// Soft-delete timestamp for recoverable audit.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  list todo_app_lists @relation(fields: [todo_app_list_id], references: [id], onDelete: Cascade)
  inviter todo_app_todouser @relation("todo_app_invitations_of_inviter_todouser_id", fields: [inviter_todouser_id], references: [id], onDelete: Cascade)
  inviterSession todo_app_todouser_sessions? @relation(fields: [inviter_todouser_session_id], references: [id], onDelete: Cascade)
  invitee todo_app_todouser? @relation("todo_app_invitations_of_invitee_todouser_id", fields: [invitee_todouser_id], references: [id], onDelete: Cascade)
  
  @@unique([invite_code])
  @@unique([todo_app_list_id, invitee_email])
  @@unique([todo_app_list_id, invitee_todouser_id])
  @@index([inviter_todouser_id])
  @@index([inviter_todouser_session_id])
  @@index([invitee_todouser_id])
  @@index([state, created_at])
  @@index([todo_app_list_id, state])
}

/// Collaborator membership records linking a registered user to a list.
/// Enforces one membership per (list, user), stores assigned role
/// (read-only/read-write), acceptance timestamp, who added the collaborator,
/// and audit timestamps. Added a list-scoped composite index to optimize
/// list->collaborators queries.
///
/// @namespace Collaboration
/// @author AutoBE - https://github.com/wrtnlabs/autobe
