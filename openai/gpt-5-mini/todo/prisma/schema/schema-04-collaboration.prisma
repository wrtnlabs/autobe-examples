  /// Optional expiry for the public share.
  expires_at DateTime?
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  /// Soft-delete timestamp.
  deleted_at DateTime?
  
  //----
  // RELATIONS
