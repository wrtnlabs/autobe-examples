  /// Referenced list. {@link todo_app_lists.id}.
  todo_app_list_id String
  
  /// Collaborator user. {@link todo_app_todouser.id}.
  todo_app_todouser_id String
  
  /// User who added the collaborator. {@link todo_app_todouser.id}.
  added_by_todouser_id String
  
  /// Collaborator role: 'read-only' or 'read-write'. Consider enforcing as
  /// enum.
  role String
  
  /// When a pending collaborator accepted membership (nullable if added by
  /// owner and not pending).
  accepted_at DateTime?
  
  /// Record creation time.
  created_at DateTime
  
  /// Last update time.
  updated_at DateTime
  
  /// Soft-delete timestamp.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  list todo_app_lists @relation(fields: [todo_app_list_id], references: [id], onDelete: Cascade)
  user todo_app_todouser @relation("todo_app_list_collaborators_of_todo_app_todouser_id", fields: [todo_app_todouser_id], references: [id], onDelete: Cascade)
  addedBy todo_app_todouser @relation("todo_app_list_collaborators_of_added_by_todouser_id", fields: [added_by_todouser_id], references: [id], onDelete: Cascade)
  
  @@index([added_by_todouser_id])
  
  // spellchecker: ignore-next-line
  @@unique([todo_app_list_id, todo_app_todouser_id], map: "todo_app_list_collaborators_todo_app_list_id_todo_app__6cf382f5")
  @@index([todo_app_todouser_id, created_at])
  @@index([role, created_at])
  @@index([todo_app_list_id, created_at])
}

/// Canonical permission definitions used by collaboration features. Stores
/// permission code, human description, and metadata. Supporting table used
/// by application logic to validate and present permission choices.
///
/// @namespace Collaboration
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_collaboration_permissions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Permission code (e.g., 'list.read', 'list.write').
  code String
  
  /// Human-friendly description of the permission.
  description String?
  
  /// Whether this permission can be granted to collaborators.
  is_grantable Boolean
  
  /// Creation time of the permission record.
  created_at DateTime
  
  /// Last update time.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  @@unique([code])
  @@index([is_grantable, code])
}

/// Public share metadata for lists. Stores share token, optional public URL,
/// visibility flags, expiry, and audit timestamps. One-to-one with {@link
/// todo_app_lists.id} to represent the list's public share entry.
