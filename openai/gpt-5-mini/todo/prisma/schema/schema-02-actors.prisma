/// Representation of an unauthenticated visitor (guest) for audit,
/// preferences, and lightweight identification. Guests are not authenticated
/// actors and therefore do not have session records in this schema. Used for
/// recording guest-specific metadata, referral tracking, and limited audit
/// trails. Relates indirectly to lists and public interactions via other
/// components. {@link todo_app_lists.id}.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_guest {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  /// Soft-delete timestamp; null when active.
  deleted_at DateTime?
  
  /// Optional transient label for display purposes (non-authenticated).
  anonymous_label String?
  
  //----
  // RELATIONS
  //----
  @@index([created_at])
}

/// Authenticated end-user account for todoApp. Extended to include
/// authentication lifecycle and security fields required by business rules:
/// failed login counters, last failed timestamp, password reset tokens and
/// expiry, refresh token revocation marker, and optional MFA metadata. These
/// additions enable DB-level support for lockout (5 attempts/15min),
/// password-reset-driven token invalidation, and MFA opt-in while preserving
/// existing relationships to lists, sessions, invitations, collaborators,
/// and audit logs.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_todouser {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Primary email address used for login and notifications; unique per
  /// account.
  email String
  
  /// Hashed password for authentication; never store plaintext.
  password_hash String
  
  /// User-facing display name for search and UI.
  display_name String?
  
  /// Whether the user has verified their email address.
  is_verified Boolean
  
  /// Account lifecycle status (e.g., pending_verification, active, suspended,
  /// pending_deletion, deleted).
  status String
  
  /// Rolling count of recent failed login attempts. Application logic should
  /// reset this on successful authentication or after lockout window
  /// expiration.
  failed_login_attempts Int
  
  /// Timestamp of the most recent failed authentication attempt; used to
  /// enforce rolling lockout windows (e.g., 5 attempts within 15 minutes).
  last_failed_login_at DateTime?
  
  /// Opaque token issued for password reset flows. Null when no reset is
  /// pending.
  password_reset_token String?
  
  /// Expiry timestamp for the password reset token.
  password_reset_expires_at DateTime?
  
  /// Timestamp after which previously issued refresh tokens are considered
  /// revoked. Set when password changes or admin revokes sessions to force
  /// re-authentication across devices.
  refresh_tokens_revoked_at DateTime?
  
  /// Whether multi-factor authentication is enabled for the account (opt-in).
  /// Defaults to false.
  mfa_enabled Boolean
  
  /// Encrypted or reference to MFA secret/seed for the account. Nullable when
  /// MFA is not enabled; secure storage and access controls required.
  mfa_secret String?
  
  /// Serialized, encrypted backup codes for MFA recovery; stored only when MFA
  /// is enabled.
  mfa_backup_codes String?
  
  /// Account creation timestamp.
  created_at DateTime
  
  /// Last account modification timestamp.
  updated_at DateTime
  
  /// Soft-delete timestamp; null when active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  todo_app_todouser_sessions todo_app_todouser_sessions[]
  todo_app_lists todo_app_lists[]
  todo_app_task_snapshots todo_app_task_snapshots[]
  todo_app_invitations_of_inviter_todouser_id todo_app_invitations[] @relation("todo_app_invitations_of_inviter_todouser_id")
  todo_app_invitations_of_invitee_todouser_id todo_app_invitations[] @relation("todo_app_invitations_of_invitee_todouser_id")
  todo_app_list_collaborators_of_todo_app_todouser_id todo_app_list_collaborators[] @relation("todo_app_list_collaborators_of_todo_app_todouser_id")
  todo_app_list_collaborators_of_added_by_todouser_id todo_app_list_collaborators[] @relation("todo_app_list_collaborators_of_added_by_todouser_id")
  todo_app_list_shares todo_app_list_shares[]
  todo_app_audit_logs todo_app_audit_logs[]
  todo_app_admin_actions todo_app_admin_actions[]
  todo_app_user_activity_logs todo_app_user_activity_logs[]
  
  @@unique([email])
  @@index([status, created_at])
  // spellchecker: ignore-next-line
  @@index([failed_login_attempts, last_failed_login_at], map: "todo_app_todouser_failed_login_attempts_last_failed_lo_43288b52")
}

