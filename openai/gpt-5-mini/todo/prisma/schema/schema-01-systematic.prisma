/// Global system configuration key-value pairs used to control
/// platform-level behavior (feature toggles, operational thresholds, and
/// public defaults). Settings are administrated by platform operators and
/// can be queried for runtime configuration. Does not duplicate domain
/// prefixes. Temporal fields provided for audit and soft-delete.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_system_settings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Canonical setting key (unique). Examples: "maintenance_mode",
  /// "default_list_visibility".
  key String
  
  /// Serialized setting value stored as string. Consumers are responsible for
  /// interpretation (boolean, JSON, numeric) based on the key.
  value String
  
  /// Human-friendly description explaining purpose and acceptable values for
  /// the setting. Useful for admin UIs and audit.
  description String?
  
  /// Whether this setting is visible to non-admin audiences (e.g., public
  /// telemetry or informational flags).
  is_public Boolean
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last modification timestamp.
  updated_at DateTime
  
  /// Soft-delete timestamp; null when active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  @@unique([key])
  @@index([is_public, created_at])
}

/// Feature flags used by the platform to gate functionality. Each flag has a
/// canonical key and rollout controls. Administrators can search,
/// enable/disable, and partially roll out flags. Descriptions support
/// full-text search for admin UX.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_feature_flags {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Canonical feature flag key (unique). Example: "new_onboarding_flow".
  key String
  
  /// Whether the feature flag is currently enabled (global on/off).
  enabled Boolean
  
  /// Optional staged rollout percentage (0-100) used by rollout systems to
  /// progressively enable features.
  rollout_percentage Int?
  
  /// Administrative description and notes for the feature flag; used in admin
  /// UIs and searchable by maintainers.
  description String?
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last modification timestamp.
  updated_at DateTime
  
  /// Soft-delete timestamp; null when active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  @@unique([key])
  @@index([enabled, rollout_percentage])
}

