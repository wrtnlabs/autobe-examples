/// Articles created by registered users including title, content, section
/// association, and timestamps. Each article belongs to a registered user
/// (author) and a section. Attachments, images, and tags are managed
/// separately.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_articles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Author of the article, references registered user. {@link
  /// discussion_board_registered_users.id}.
  registered_user_id String
  
  /// Section under which the article is published. {@link
  /// discussion_board_sections.id}.
  section_id String
  
  /// Title of the article, must be non-empty.
  title String
  
  /// Content of the article, full text.
  content String
  
  /// Timestamp when the article was created.
  created_at DateTime
  
  /// Timestamp of the last article update.
  updated_at DateTime
  
  /// Timestamp when the article was soft deleted; null if active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  author discussion_board_registered_users @relation(fields: [registered_user_id], references: [id], onDelete: Cascade)
  section discussion_board_sections @relation(fields: [section_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  images discussion_board_article_images[]
  tagMappings discussion_board_article_tag_mappings[]
  files discussion_board_article_files[]
  comments discussion_board_comments[]
  searchIndexes discussion_board_article_search_indexes[]
  articleTags discussion_board_article_tags[]
  
  //----
  // INDEXES
  //----
  @@unique([section_id, title])
  @@index([registered_user_id, created_at])
  @@index([section_id, created_at])
}

/// Images attached to articles with metadata and display order.
///
/// This table stores information about images uploaded and associated with
/// discussion board articles. It supports multiple images per article and
/// maintains display order for presentation purposes. Each image record has
/// creation, update, and soft delete timestamps.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_article_images {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Article to which this image is attached. {@link
  /// discussion_board_articles.id}
  discussion_board_article_id String
  
  /// URL or path of the image file attached to the article.
  image_url String
  
  /// Optional description or caption for the image.
  description String?
  
  /// Display order of the image within the article.
  display_order Int
  
  /// Timestamp when the image record was created.
  created_at DateTime
  
  /// Timestamp when the image record was last updated.
  updated_at DateTime
  
  /// Timestamp marking when the image record was soft deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, display_order], map: "discussion_board_article_images_discussion_board_artic_ed181826")
}

/// Junction table associating articles with multiple tags for flexible
/// categorization. Each record links one article to one tag, enabling
/// many-to-many relationships. Ensures no duplicate article-tag pairs for
/// data integrity.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_article_tag_mappings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the article's {@link discussion_board_articles.id}.
  discussion_board_article_id String
  
  /// Reference to the tag's {@link discussion_board_tags.id}.
  discussion_board_tag_id String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp; NULL if not deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  tag discussion_board_tags @relation(fields: [discussion_board_tag_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([discussion_board_tag_id], map: "discussion_board_article_tag_mappings_discussion_board_fdeff787")
  // spellchecker: ignore-next-line
  @@unique([discussion_board_article_id, discussion_board_tag_id], map: "discussion_board_article_tag_mappings_discussion_board_afdfd50a")
  @@index([created_at])
}

/// Record of promotions and demotions of administrators for audit and
/// management. Tracks which administrator had their grade changed, to what
/// grade, and when. Enables auditing of administrator grade history over
/// time.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_administrator_grade_changes {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The administrator whose grade was changed, referencing
  /// discussion_board_administrators.id.
  discussion_board_administrator_id String
  
  /// The grade assigned to the administrator in this record, referencing
  /// discussion_board_administrator_grades.id.
  discussion_board_administrator_grade_id String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Last record update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp; if set, record is considered deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  administrator discussion_board_administrators @relation(fields: [discussion_board_administrator_id], references: [id], onDelete: Cascade)
  grade discussion_board_administrator_grades @relation(fields: [discussion_board_administrator_grade_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([discussion_board_administrator_id, created_at], map: "discussion_board_administrator_grade_changes_discussio_13b5f26a")
  // spellchecker: ignore-next-line
  @@index([discussion_board_administrator_grade_id], map: "discussion_board_administrator_grade_changes_discussio_2fc01ac5")
}

/// Files attached to articles including metadata for download URLs, file
/// type, size, and display order. Each file belongs to a single article and
/// supports multiple files per article for management and retrieval.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_article_files {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The article to which this file is attached, referenced by
  /// discussion_board_articles.id.
  article_id String
  
  /// Name of the uploaded file including extension.
  file_name String
  
  /// MIME type of the file, e.g., 'application/pdf', 'image/png'.
  file_type String
  
  /// Size of the file in bytes.
  file_size Int
  
  /// URL for downloading the file.
  download_url String
  
  /// Order of file display among multiple files attached to the same article.
  display_order Int
  
  /// Timestamp when the file record was created.
  created_at DateTime
  
  /// Timestamp when the file record was last updated.
  updated_at DateTime
  
  /// Timestamp indicating soft deletion of the file record, if applicable.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  article discussion_board_articles @relation(fields: [article_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([article_id, display_order])
}