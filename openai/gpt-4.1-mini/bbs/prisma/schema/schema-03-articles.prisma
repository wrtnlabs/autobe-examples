/// Articles posted by members on the discussion board, containing a title
/// and markdown content. Includes timestamps for creation, updating, and
/// optional soft deletion. Serves as the main content entity users interact
/// with.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_articles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Title of the article, up to 200 characters.
  title String
  
  /// Markdown formatted body content of the article.
  content_markdown String
  
  /// Timestamp when the article was created.
  created_at DateTime
  
  /// Timestamp when the article was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp, null if the article is active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  discussion_board_attachments discussion_board_attachments[]
  
  @@index([created_at])
}

/// Attachments associated with discussion board articles. Supports images
/// and files linked securely to their parent article. Includes filename,
/// file type, URL/path, and timestamps. Serves as a subsidiary supporting
/// entity for richer article content.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_attachments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged article's {@link discussion_board_articles.id}.
  discussion_board_article_id String
  
  /// Original filename of the attachment.
  filename String
  
  /// MIME type or file type such as image, pdf, etc.
  file_type String
  
  /// URL or storage path of the attachment file.
  file_url String
  
  /// Timestamp when the attachment was created.
  created_at DateTime
  
  /// Timestamp when the attachment was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp, null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  discussionBoardArticle discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, created_at], map: "discussion_board_attachments_discussion_board_article__663ecfce")
}