/// Tags used by articles for categorization and filtering. Each tag has a
/// unique name and supports soft deletion and full-text search for efficient
/// tagging capabilities.
///
/// @namespace Search
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_tags {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique name of the tag used for categorizing articles.
  name String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp, if the tag is deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  articleTagMappings discussion_board_article_tag_mappings[]
  mvTagUsageStats discussion_board_mv_tag_usage_stats[]
  articleTags discussion_board_article_tags[]
  
  @@unique([name])
}

/// Searchable text index records for articles enabling efficient full-text
/// search. This table stores preprocessed and tokenized text content to
/// optimize search queries. Each record references an article and contains
/// indexed fields for title and body text, supporting rapid full-text search
/// operations.
///
/// @namespace Search
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_article_search_indexes {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced article's {@link discussion_board_articles.id}.
  discussion_board_article_id String
  
  /// Text content of the article's title indexed for search.
  title String
  
  /// Text content of the article's body indexed for search.
  body String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Last record update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp; null if not deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, created_at], map: "discussion_board_article_search_indexes_discussion_boa_ca728809")
}

/// Materialized view aggregating tag usage statistics to optimize search and
/// filtering performance in discussion board articles. Provides precomputed
/// counts of articles and comments per tag with refresh timestamps.
///
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_mv_tag_usage_stats {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// References the tag aggregated in this usage statistic. {@link
  /// discussion_board_tags.id}
  discussion_board_tag_id String
  
  /// Number of articles tagged with this tag.
  article_count Int
  
  /// Number of comments associated with articles tagged by this tag.
  comment_count Int
  
  /// Timestamp when this materialized view entry was last refreshed.
  refreshed_at DateTime
  
  //----
  // RELATIONS
  //----
  tag discussion_board_tags @relation(fields: [discussion_board_tag_id], references: [id], onDelete: Cascade)
  
  @@index([discussion_board_tag_id])
  @@index([article_count])
}

/// Many-to-many relationship between articles and tags enabling flexible
/// categorization and filtering of articles by tags. Connects each tag to
/// one or more articles and each article to multiple tags, facilitating
/// efficient searching and filtering.
///
/// @namespace Search
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_article_tags {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referencing article's unique identifier. The target article associated
  /// with this tag. {@link discussion_board_articles.id}
  discussion_board_article_id String
  
  /// Referencing tag's unique identifier. The associated tag for the article.
  /// {@link discussion_board_tags.id}
  discussion_board_tag_id String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp; null if not deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  tag discussion_board_tags @relation(fields: [discussion_board_tag_id], references: [id], onDelete: Cascade)
  
  @@index([discussion_board_tag_id])
  
  // spellchecker: ignore-next-line
  @@unique([discussion_board_article_id, discussion_board_tag_id], map: "discussion_board_article_tags_discussion_board_article_b5fcd131")
  @@index([created_at])
}