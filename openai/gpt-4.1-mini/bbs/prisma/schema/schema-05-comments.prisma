/// User-written comments linked to articles in the discussion board system.
/// Stores content, author reference, timestamps, and supports soft deletion.
/// Enables user and admin comment management compliant with business
/// requirements.
///
/// @namespace Comments
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_comments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged article's {@link discussion_board_articles.id}.
  discussion_board_article_id String
  
  /// Author registered user's {@link discussion_board_registered_users.id}.
  discussion_board_registered_user_id String
  
  /// Comment content text written by the user.
  content String
  
  /// Timestamp when the comment was created.
  created_at DateTime
  
  /// Timestamp when the comment was last updated.
  updated_at DateTime
  
  /// Timestamp when the comment was soft deleted, null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  author discussion_board_registered_users @relation(fields: [discussion_board_registered_user_id], references: [id], onDelete: Cascade)
  
  snapshots discussion_board_comment_snapshots[]
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, created_at], map: "discussion_board_comments_discussion_board_article_id__aa7deb51")
  // spellchecker: ignore-next-line
  @@index([discussion_board_registered_user_id, created_at], map: "discussion_board_comments_discussion_board_registered__3a6dfa5d")
}

/// Audit trail storing historical snapshots of user comments for audit,
/// versioning, and recovery purposes. Each snapshot retains the full state
/// of comment content, author information, and timestamps at a specific
/// point in time, ensuring traceability of changes. The table references the
/// original comment in discussion_board_comments and supports historical
/// browsing and rollback functionalities.
///
/// @namespace Comments
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_comment_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Original comment's discussion_board_comments.id.
  discussion_board_comment_id String
  
  /// Comment content snapshot at the time of recording.
  body String
  
  /// Snapshot creation timestamp.
  created_at DateTime
  
  /// Snapshot last update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp, if the snapshot is logically deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  comment discussion_board_comments @relation(fields: [discussion_board_comment_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_comment_id, created_at], map: "discussion_board_comment_snapshots_discussion_board_co_67d99e69")
}