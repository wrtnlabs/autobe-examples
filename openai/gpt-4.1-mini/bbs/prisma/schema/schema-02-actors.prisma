/// Members who are authenticated users authorized to create and manage
/// articles and comments within the discussion board system. Members have
/// personal credentials and are subject to soft deletion. This table stores
/// member identity, authentication credentials, and metadata.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_members {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique email address of the member used for authentication.
  email String
  
  /// Password hash for secure authentication of member accounts.
  password_hash String
  
  /// Date and time when the member account was created.
  created_at DateTime
  
  /// Date and time when the member account was last updated.
  updated_at DateTime
  
  /// Optional deletion timestamp for soft delete.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  discussion_board_member_sessions discussion_board_member_sessions[]
  
  @@unique([email])
}

/// Active sessions for members representing authenticated login instances.
/// Each session records connection details, access timestamps, and
/// expiration, supporting secure session management and auditing.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_member_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced member id owning this session. {@link
  /// discussion_board_members.id}
  discussion_board_member_id String
  
  /// IP address of the client initiating this session.
  ip String
  
  /// The connection URL when the session was started.
  href String
  
  /// The referrer URL for this session connection.
  referrer String
  
  /// Timestamp when this session was created.
  created_at DateTime
  
  /// Optional expiration timestamp of the session.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  member discussion_board_members @relation(fields: [discussion_board_member_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_id, created_at], map: "discussion_board_member_sessions_discussion_board_memb_336fc309")
}

