/// The core thematic categories under which articles are organized, with
/// unique names and descriptions. Sections provide an organizational
/// structure to group articles by topic and facilitate users in browsing
/// relevant content. Administrators manage section creation and
/// modification. This table stores section metadata such as the unique name
/// and detailed description along with timestamps for creation, update, and
/// soft deletion.
///
/// @namespace Sections
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_sections {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique name of the section.
  name String
  
  /// Detailed textual description of the section's purpose and scope.
  description String
  
  /// Timestamp when the section was created.
  created_at DateTime
  
  /// Timestamp when the section was last updated.
  updated_at DateTime
  
  /// Timestamp when the section was soft deleted, if applicable.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  adminLogs discussion_board_section_admin_logs[]
  articles discussion_board_articles[]
  
  @@unique([name])
}

/// Administrative logs recording creation, modification, and deletion
/// actions performed on discussion board sections by administrators. Each
/// record captures the administrator responsible, the section affected, the
/// type of action performed, timestamps for auditing, and optional notes for
/// additional context.
///
/// @namespace Sections
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_section_admin_logs {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Administrator who performed the action. {@link
  /// discussion_board_administrators.id}.
  administrator_id String
  
  /// Section on which the administrative action was performed. {@link
  /// discussion_board_sections.id}.
  section_id String
  
  /// Type of administrative action performed on the section, e.g., creation,
  /// modification, deletion.
  action_type String
  
  /// Optional text notes providing additional context about the action.
  note String?
  
  /// Timestamp when the admin action log was created.
  created_at DateTime
  
  /// Timestamp when the admin action log was last updated.
  updated_at DateTime
  
  /// Timestamp when the log was soft-deleted. Null if not deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  administrator discussion_board_administrators @relation(fields: [administrator_id], references: [id], onDelete: Cascade)
  section discussion_board_sections @relation(fields: [section_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([administrator_id, created_at], map: "discussion_board_section_admin_logs_administrator_id_c_f44d6870")
  @@index([section_id, created_at])
}