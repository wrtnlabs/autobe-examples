/// Authenticated user accounts who can login and manage their personal todo
/// items. Includes credentials and audit information. Uniquely identified by
/// UUID. Soft deletable for account deactivation.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_users {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User's unique email address for authentication and contact.
  email String
  
  /// Hashed password for secure authentication.
  password_hash String
  
  /// Timestamp when the user account was created.
  created_at DateTime
  
  /// Timestamp when the user account was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp to mark user deactivation.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  todo_user_sessions todo_user_sessions[]
  todo_todo_items todo_todo_items[]
  
  @@unique([email])
}

/// Sessions for authenticated users maintaining JWTs for access control and
/// expiration. Each session references an existing user and records
/// connection context like IP and referrer.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_user_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced user's {@link todo_users.id}.
  todo_user_id String
  
  /// IP address of the session client.
  ip String
  
  /// URL from which the session was established.
  href String
  
  /// Referrer URL of the session request.
  referrer String
  
  /// Timestamp when the session was created.
  created_at DateTime
  
  /// Timestamp when the session expires or ends.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  todoUser todo_users @relation(fields: [todo_user_id], references: [id], onDelete: Cascade)
  
  @@index([todo_user_id, created_at])
}