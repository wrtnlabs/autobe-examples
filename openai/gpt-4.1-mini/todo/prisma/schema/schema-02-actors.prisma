/// password hashes and contact emails.
///
/// Each user record contains a unique UUID primary key along with timestamps
/// for auditing purposes.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_list_users {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User email address used for authentication and communication.
  email String
  
  /// Hashed password for secure user authentication.
  password_hash String
  
  /// Timestamp when the user was created.
  created_at DateTime
  
  /// Timestamp when the user was last updated.
  updated_at DateTime
  
  /// Timestamp when the user was soft deleted, if applicable.
  deleted_at DateTime?
  
  //----
  // RELATIONS
