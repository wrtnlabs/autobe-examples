/// Guests who visit the Todo List application without registration.
///
/// This table stores basic guest visitor information for tracking anonymous
/// sessions and limited interaction capabilities.
/// Guests represent unregistered users visiting the platform with no
/// authentication requirements.
///
/// Each guest has a unique UUID primary key and temporal fields for creation
/// and updates.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_list_guests {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// IP address of the guest visitor for tracking purposes.
  visitor_ip String
  
  /// Timestamp when the guest record was created.
  created_at DateTime
  
  /// Timestamp when the guest record was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  todo_list_guest_sessions todo_list_guest_sessions[]
  
  @@index([visitor_ip, created_at])
}

/// Session records for guest visitors of the Todo List application.
///
/// Tracks anonymous sessions for guests, including connection context and
/// session lifecycle details.
///
/// Each session belongs to exactly one guest, enabling session-based
/// interaction tracking without authentication.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_list_guest_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the guest who owns this session. {@link todo_list_guests.id}.
  todo_list_guest_id String
  
  /// IP address of the session connection.
  ip String
  
  /// Connection URL for the session.
  href String
  
  /// Referrer URL for the session.
  referrer String
  
  /// Session creation time.
  created_at DateTime
  
  /// Session expiration time, null if session is currently active.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  guest todo_list_guests @relation(fields: [todo_list_guest_id], references: [id], onDelete: Cascade)
  
  @@index([todo_list_guest_id, created_at])
}

/// Registered users who can create, read, update, and delete their own todo
