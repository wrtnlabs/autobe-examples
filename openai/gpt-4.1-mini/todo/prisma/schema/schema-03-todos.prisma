  user multi_user_todo_users @relation(fields: [multi_user_todo_user_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  editHistories multi_user_todo_todo_edit_histories[]
  
  //----
  // INDEXES
  //----
  @@index([multi_user_todo_user_id, completed])
  @@index([multi_user_todo_user_id, created_at])
  @@index([multi_user_todo_user_id, start_date])
  @@index([multi_user_todo_user_id, due_date])
}

