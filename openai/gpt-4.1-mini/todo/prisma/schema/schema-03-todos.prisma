/// Todos created by users with titles, optional descriptions, start and due
/// dates, completion status, soft deletion status, and timestamps. Each todo
/// belongs to exactly one user represented by multi_user_todo_users. Soft
/// deletion allows trash management. Completion status is a simple boolean
/// toggle.
///
/// @namespace Todos
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model multi_user_todo_todos {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Owner user's {@link multi_user_todo_users.id}.
  multi_user_todo_user_id String
  
  /// Title of the todo item, required field.
  title String
  
  /// Optional detailed description of the todo item.
  description String?
  
  /// Optional start date for the todo.
  start_date DateTime?
  
  /// Optional due date for the todo.
  due_date DateTime?
  
  /// Completion status of the todo, true means done, false means not done.
  completed Boolean
  
  /// Timestamp when the todo was created.
  created_at DateTime
  
  /// Timestamp of the last update to the todo.
  updated_at DateTime
  
  /// Timestamp when the todo was deleted; null means not deleted (soft delete).
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
