/// Todo items entity storing user tasks with ownership and task details
/// including description, status, due date, and timestamps for creation,
/// update, and soft deletion. Each todo is owned by a unique user identified
/// by todo_users.id. This table supports independent CRUD operations for
/// todo items managed by authenticated users.
///
/// @namespace Todos
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_todo_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Owner user identifier referencing todo_users.id
  todo_user_id String
  
  /// Text description of the todo item, mandatory, max 255 characters.
  description String
  
  /// Status of the todo item, either 'pending' or 'completed'.
  status String
  
  /// Optional due date for task completion; if provided must not be in the
  /// past.
  due_date DateTime?
  
  /// Timestamp when the todo item was created.
  created_at DateTime
  
  /// Timestamp when the todo item was last updated.
  updated_at DateTime
  
  /// Timestamp when the todo item was soft deleted; null means active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  user todo_users @relation(fields: [todo_user_id], references: [id], onDelete: Cascade)
  
  @@index([todo_user_id, created_at])
}