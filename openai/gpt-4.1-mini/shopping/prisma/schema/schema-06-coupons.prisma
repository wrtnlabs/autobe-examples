/// Defines marketing coupons for the shopping mall platform.
///
/// Each coupon includes its unique code, discount information, validity
/// periods, and restrictions. Coupons are centrally managed to control
/// promotional offers and marketing campaigns.
///
/// This table stores raw coupon data without usage logs, supporting
/// creation, update, and deactivation. Soft deletion tracks removed coupons
/// while preserving history for auditing.
///
/// Uniqueness is enforced on coupon code for quick lookup during order
/// processing and validation.
///
/// @namespace Coupons
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_coupons {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Unique coupon code used by customers during checkout for discounts.
  code String
  
  /// Optional detailed description of the coupon's promotion and usage
  /// conditions.
  description String?
  
  /// Type of discount applied by the coupon (e.g., percentage, fixed amount).
  discount_type String
  
  /// Value of the discount. Represents percentage or fixed amount depending on
  /// discount type.
  discount_value Float
  
  /// Optional minimum order amount required to apply this coupon.
  minimum_order_amount Float?
  
  /// Optional cap on the maximum discount given by this coupon.
  maximum_discount_amount Float?
  
  /// Date and time when the coupon becomes valid and can be used.
  start_at DateTime
  
  /// Date and time after which the coupon expires and cannot be used.
  end_at DateTime
  
  /// Optional maximum number of total times this coupon can be redeemed across
  /// all customers.
  usage_limit Int?
  
  /// Current status of the coupon, indicating if it is active, expired, or
  /// disabled.
  status String
  
  /// Timestamp when the coupon was created.
  created_at DateTime
  
  /// Timestamp when the coupon was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp to indicate logical deletion without physical
  /// removal.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shopping_mall_coupon_redemptions shopping_mall_coupon_redemptions[]
  
  @@unique([code])
  @@index([status, start_at, end_at])
}

/// Records each redemption of a coupon by a customer on an order.
///
/// Tracks which customer redeemed which coupon, tied to a specific order,
/// with timestamps and redeemed discount amount.
///
/// This table supports audit trails and prevents reuse where restrictions
/// apply. Logical deletion is supported for maintaining data integrity and
/// compliance.
///
/// @namespace Coupons
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_coupon_redemptions {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Reference to the coupon being redeemed. {@link shopping_mall_coupons.id}.
  shopping_mall_coupon_id String
  
  /// Reference to the customer redeeming the coupon. {@link
  /// shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Reference to the order where the coupon was applied. {@link
  /// shopping_mall_orders.id}.
  shopping_mall_order_id String
  
  /// The actual discount amount applied during this redemption.
  redeemed_amount Float
  
  /// Timestamp when this coupon redemption occurred.
  redeemed_at DateTime
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp for logical removal of the redemption record.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  coupon shopping_mall_coupons @relation(fields: [shopping_mall_coupon_id], references: [id], onDelete: Cascade)
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_mall_coupon_id])
  @@index([shopping_mall_customer_id])
  @@index([shopping_mall_order_id])
  
  @@index([redeemed_at])
}