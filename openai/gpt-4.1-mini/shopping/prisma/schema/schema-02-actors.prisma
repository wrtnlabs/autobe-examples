/// Customer accounts registered on the shopping mall platform. Customers can
/// log in, manage personal profiles, shopping carts, orders, and reviews.
/// Each customer has unique authentication credentials and related sessions.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_customers {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique email address for customer login and communication.
  email String
  
  /// Hashed password for secure authentication.
  password_hash String
  
  /// Display name or nickname of the customer.
  nickname String
  
  /// Account creation timestamp.
  created_at DateTime
  
  /// Last profile update timestamp.
  updated_at DateTime
  
  /// Timestamp when the account is soft deleted, if applicable.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shopping_mall_customer_sessions shopping_mall_customer_sessions[]
  shopping_mall_shopping_carts shopping_mall_shopping_carts[]
  shopping_mall_wishlists shopping_mall_wishlists[]
  shopping_mall_orders shopping_mall_orders[]
  shopping_mall_product_reviews shopping_mall_product_reviews[]
  shopping_mall_order_cancellations shopping_mall_order_cancellations[]
  shopping_mall_refund_requests shopping_mall_refund_requests[]
  shopping_mall_return_shipments shopping_mall_return_shipments[]
  
  @@unique([email])
  @@index([created_at])
}

/// Authentication sessions for shopping mall customers. Each session
/// corresponds to a login instance for a customer acting in their security
/// context.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_customer_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged customer's {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// IP address from which the session originated.
  ip String
  
  /// URL where session was initiated.
  href String
  
  /// Referrer URL for the session start.
  referrer String
  
  /// Session creation timestamp.
  created_at DateTime
  
  /// Session expiration timestamp, if applicable.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  shoppingMallCustomer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  shopping_mall_shopping_carts shopping_mall_shopping_carts[]
  shopping_mall_wishlists shopping_mall_wishlists[]
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_customer_id, created_at], map: "shopping_mall_customer_sessions_shopping_mall_customer_adefa402")
}

