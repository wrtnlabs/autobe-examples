/// Represents shipments created by sellers to group order items for shipping
/// and tracking purposes. Each shipment is linked to one seller and can
/// contain multiple order items via a child junction table. Shipments track
/// lifecycle status and timestamps, supporting robust shipping management
/// within the e-commerce platform.
///
/// @namespace Shipping
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_shipments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The seller who created the shipment. {@link shopping_mall_sellers.id}
  seller_id String
  
  /// Current status of the shipment (e.g., pending, shipped, delivered,
  /// cancelled).
  status String
  
  /// Timestamp when the shipment was created.
  created_at DateTime
  
  /// Timestamp when the shipment was last updated.
  updated_at DateTime
  
  /// Timestamp when the shipment was soft deleted, if applicable.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  seller shopping_mall_sellers @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  shipmentItems shopping_mall_shipment_items[]
  shipmentOrderItems shopping_mall_shipment_order_items[]
  shipmentTrackings shopping_mall_shipment_trackings[]
  shipmentConfirmations shopping_mall_shipment_confirmations[]
  
  //----
  // INDEXES
  //----
  @@index([seller_id, created_at])
}

/// Junction table linking shipments to specific order items included in each
/// shipment. Enables grouping multiple order items under one shipment for
/// tracking and delivery management.
///
/// @namespace Shipping
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_shipment_order_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// References the shipment that includes the order items. {@link
  /// shopping_mall_shipments.id}
  shopping_mall_shipment_id String
  
  /// References the specific order item included in the shipment. {@link
  /// shopping_mall_order_items.id}
  shopping_mall_order_item_id String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp, if applicable.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  shipment shopping_mall_shipments @relation(fields: [shopping_mall_shipment_id], references: [id], onDelete: Cascade)
  orderItem shopping_mall_order_items @relation(fields: [shopping_mall_order_item_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([shopping_mall_order_item_id], map: "shopping_mall_shipment_order_items_shopping_mall_order_2757493a")
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_shipment_id, shopping_mall_order_item_id], map: "shopping_mall_shipment_order_items_shopping_mall_shipm_002a6a58")
}

/// Tracking details for shipments including the carrier name and tracking
/// number. Each record links to a shipment in shopping_mall_shipments and
/// stores the carrier's tracking code for shipment tracking purposes.
///
/// @namespace Shipping
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_shipment_trackings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Linked shipment's {@link shopping_mall_shipments.id}.
  shopping_mall_shipment_id String
  
  /// Name of the shipping carrier (e.g., USPS, FedEx, DHL).
  carrier_name String
  
  /// Tracking number provided by the shipping carrier for package tracking.
  tracking_number String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp; null if not deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  shipment shopping_mall_shipments @relation(fields: [shopping_mall_shipment_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([shopping_mall_shipment_id])
}

