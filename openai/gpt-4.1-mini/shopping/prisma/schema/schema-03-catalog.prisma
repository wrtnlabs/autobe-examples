/// Product entity representing items offered for sale in the shopping mall.
///
/// This table contains basic product information managed by sellers,
/// including title, description, category reference, and brand details. Each
/// product may have multiple variants (SKUs) represented in
/// shopping_mall_product_variants. Soft delete functionality is supported
/// via deleted_at. Products are linked to categories existing in the catalog
/// domain.
///
/// Consistent temporal tracking is maintained via created_at and updated_at
/// timestamps.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to product category. {@link shopping_mall_categories.id}.
  shopping_mall_category_id String
  
  /// Unique product code for business identification.
  code String
  
  /// Product title descriptive name.
  title String
  
  /// Detailed product description for customers.
  description String?
  
  /// Brand or manufacturer name.
  brand String?
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp; null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  category shopping_mall_categories @relation(fields: [shopping_mall_category_id], references: [id], onDelete: Cascade)
  
  shopping_mall_product_variants shopping_mall_product_variants[]
  shopping_mall_product_snapshots shopping_mall_product_snapshots[]
  shopping_mall_product_reviews shopping_mall_product_reviews[]
  
  @@unique([code])
  @@index([shopping_mall_category_id, created_at])
}

/// Represents distinct SKUs (product variants) with unique combinations of
/// attributes such as color, size, and options.
///
/// Each variant has its own inventory, pricing, and status independent of
/// the parent product. The variant references its parent product and
/// supports soft deletion. Detailed attributes allow for precise customer
/// selection and inventory management.
///
/// This model enables the platform to handle complex product variant
/// hierarchies consistently.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_variants {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to parent product. {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Unique SKU code per product variant.
  sku_code String
  
  /// Color attribute of the variant.
  color String?
  
  /// Size attribute of the variant.
  size String?
  
  /// Additional options (customizable features).
  option String?
  
  /// Price for this variant.
  price Float
  
  /// Current availability status (e.g., in stock, discontinued).
  status String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp; null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  shopping_mall_inventories shopping_mall_inventories[]
  shopping_mall_cart_items shopping_mall_cart_items[]
  shopping_mall_wishlist_items shopping_mall_wishlist_items[]
  shopping_mall_order_items shopping_mall_order_items[]
  
  @@unique([sku_code])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, status, created_at], map: "shopping_mall_product_variants_shopping_mall_product_i_6e805c66")
}

/// Inventory records tracking SKU stock levels and availability.
///
/// Each inventory entry is associated with a specific product variant (SKU)
/// and monitors stock quantities, reserved quantities, and restock dates.
/// Supports soft deletion and temporal tracking for audit purposes.
///
/// The inventory system is critical for enforcing stock constraints and
/// preventing overselling.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_inventories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to product variant. {@link shopping_mall_product_variants.id}.
  shopping_mall_product_variant_id String
  
  /// Total stock available.
  quantity Int
  
  /// Quantity reserved for pending orders.
  reserved_quantity Int
  
  /// Expected date of next restock.
  restock_date DateTime?
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp; null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  productVariant shopping_mall_product_variants @relation(fields: [shopping_mall_product_variant_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_variant_id, quantity], map: "shopping_mall_inventories_shopping_mall_product_varian_86de64ad")
}

/// Historical snapshots capturing product data at specific points in time
/// for audit and versioning.
///
/// Stores complete denormalized state of shopping mall products enabling
/// retrieval of past product details. Snapshots are append-only and
/// immutable, supporting audit trails and rollback functionality.
///
/// This table follows snapshot stance and does not support updates or
/// deletions.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to original product. {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Product code at snapshot moment.
  code String
  
  /// Product title at snapshot moment.
  title String
  
  /// Product description at snapshot moment.
  description String?
  
  /// Product brand at snapshot moment.
  brand String?
  
  /// Timestamp when snapshot was created.
  snapshot_at DateTime
  
  /// Record creation timestamp.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, snapshot_at], map: "shopping_mall_product_snapshots_shopping_mall_product__16a3b747")
}