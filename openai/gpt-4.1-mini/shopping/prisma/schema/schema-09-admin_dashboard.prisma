/// Records all actions performed by admin users on the platform for audit
/// and tracking purposes. It logs what operation was performed, when, and by
/// which admin user, aiding compliance and forensic analysis.
///
/// @namespace AdminDashboard
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_admin_activities {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Admin user performing the activity. {@link shopping_mall_admins.id}
  shopping_mall_admin_id String
  
  /// Description of the admin activity performed.
  activity String
  
  /// Activity timestamp when the action occurred.
  created_at DateTime
  
  /// Timestamp for the last update to the activity record.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  admin shopping_mall_admins @relation(fields: [shopping_mall_admin_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_admin_id, created_at], map: "shopping_mall_admin_activities_shopping_mall_admin_id__bbd53c83")
}

/// Tracks the approval status of products submitted by sellers. Records
/// which admin performed the approval, status updates, and timestamps for
/// moderation tracking and compliance verification.
///
/// @namespace AdminDashboard
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_approvals {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product being approved. {@link shopping_mall_products.id}
  shopping_mall_product_id String
  
  /// Admin user who approved or rejected the product. {@link
  /// shopping_mall_admins.id}
  shopping_mall_admin_id String
  
  /// Approval status (e.g., pending, approved, rejected).
  status String
  
  /// Reason for rejection or comments by the admin.
  reason String?
  
  /// Timestamp for when the approval record was created.
  created_at DateTime
  
  /// Timestamp for the last update to the approval record.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  admin shopping_mall_admins @relation(fields: [shopping_mall_admin_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_mall_admin_id])
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, status], map: "shopping_mall_product_approvals_shopping_mall_product__389f8f0b")
}

/// Manages user roles in the platform, detailing which user has what role
/// (e.g., admin, customer, seller) with timestamps for audit and role change
/// tracking.
///
/// @namespace AdminDashboard
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_user_roles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Identifier of the user the role is assigned to.
  user_id String
  
  /// Name of the role granted to the user (e.g., admin, seller, customer).
  role_name String
  
  /// Timestamp when the role was assigned.
  created_at DateTime
  
  /// Timestamp for the last update to this role assignment.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  @@unique([user_id, role_name])
  @@index([role_name])
}

/// Comprehensive audit logs for platform-wide actions and system events.
/// Supports forensic analysis, security audits, and operational monitoring
/// with detailed metadata and timestamps.
///
/// @namespace AdminDashboard
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_platform_audit_logs {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Admin user related to this audit event, if available. {@link
  /// shopping_mall_admins.id}
  shopping_mall_admin_id String?
  
  /// Type of the audit event, e.g., login, access, change.
  event_type String
  
  /// Detailed description of the event.
  event_description String
  
  /// Timestamp when the audit event was recorded.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  admin shopping_mall_admins? @relation(fields: [shopping_mall_admin_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_mall_admin_id])
  
  @@index([event_type, created_at])
}