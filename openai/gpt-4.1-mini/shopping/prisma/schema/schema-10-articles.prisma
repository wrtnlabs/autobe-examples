/// Articles posted in the shopping mall platform by registered users.
///
/// This model represents user-generated content allowing customers to
/// publish articles on various topics. Articles are organized by categories
/// and contain titles and text bodies.
///
/// Each article tracks creation, update, and soft deletion timestamps for
/// audit and moderation purposes.
///
/// Articles maintain relationships to customers and categories and support
/// moderation workflows through comment relationships.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_articles {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Reference to the customer who authored the article. {@link
  /// shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Reference to the category that the article belongs to. {@link
  /// shopping_mall_article_categories.id}.
  shopping_mall_article_category_id String
  
  /// The article's title summarizing the content.
  title String
  
  /// The main textual content of the article.
  body String
  
  /// Timestamp when the article was created.
  created_at DateTime
  
  /// Timestamp when the article was last updated.
  updated_at DateTime
  
  /// Timestamp when the article was soft-deleted; null if not deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  category shopping_mall_article_categories @relation(fields: [shopping_mall_article_category_id], references: [id], onDelete: Cascade)
  
  shopping_mall_article_comments shopping_mall_article_comments[]
  
  @@unique([shopping_mall_customer_id, title])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_article_category_id, created_at], map: "shopping_mall_articles_shopping_mall_article_category__eb499dbf")
}

/// Hierarchical categories to organize articles within the shopping mall
/// platform.
///
/// Categories can have parent-child relationships enabling nested structures.
/// Each category has a unique name within the platform.
///
/// The model supports creation, update, and soft deletion timestamps for
/// lifecycle management.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_article_categories {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Optional reference to the parent category. {@link
  /// shopping_mall_article_categories.id}.
  parent_id String?
  
  /// The category name, unique within the platform.
  name String
  
  /// Optional detailed description of the category.
  description String?
  
  /// Timestamp when the category was created.
  created_at DateTime
  
  /// Timestamp when the category was last updated.
  updated_at DateTime
  
  /// Timestamp when the category was soft-deleted; null if not deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  parent shopping_mall_article_categories? @relation("recursive", fields: [parent_id], references: [id], onDelete: Cascade)
  
  shopping_mall_articles shopping_mall_articles[]
  recursive shopping_mall_article_categories[] @relation("recursive")
  
  @@unique([name])
  @@index([parent_id])
}

/// User comments on articles within the shopping mall platform.
///
/// Comments enable customer interaction on articles and support moderation
/// workflows.
///
/// Each comment is linked to a customer, an article, and a specific customer
/// session to track the origin.
///
/// Comments include content, creation, update, and soft deletion timestamps.
///
/// Moderation and searchability are supported through indexing on content
/// fields.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_article_comments {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Reference to the customer who made the comment. {@link
  /// shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Reference to the article being commented on. {@link
  /// shopping_mall_articles.id}.
  shopping_mall_article_id String
  
  /// Reference to the customer session during which the comment was made.
  /// {@link shopping_mall_customer_sessions.id}.
  shopping_mall_customer_session_id String
  
  /// Comment textual content, supporting detailed feedback or discussion.
  body String
  
  /// Timestamp when the comment was created.
  created_at DateTime
  
  /// Timestamp when the comment was last updated.
  updated_at DateTime
  
  /// Timestamp when the comment was soft-deleted, null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  article shopping_mall_articles @relation(fields: [shopping_mall_article_id], references: [id], onDelete: Cascade)
  session shopping_mall_customer_sessions @relation(fields: [shopping_mall_customer_session_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_mall_customer_id])
  @@index([shopping_mall_article_id])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_customer_session_id], map: "shopping_mall_article_comments_shopping_mall_customer__243c03d7")
}