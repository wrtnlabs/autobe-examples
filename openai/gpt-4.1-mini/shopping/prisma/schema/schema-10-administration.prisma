/// Administrator requests to become administrators with explanation reasons
/// and approval status tracking.
/// Polymorphic actor ownership allows requests from customers or sellers to
/// be recorded uniformly.
/// Status tracks the approval workflow state.
/// Includes timestamps for auditing and soft delete support.
///
/// @namespace Administration
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_administrator_requests {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Type of actor who submitted the request, e.g., 'customer' or 'seller',
  /// indicating polymorphic ownership.
  actor_type String
  
  /// Reason provided by the requester explaining why they want to become an
  /// administrator.
  reason String
  
  /// Current approval status of the request - one of 'pending', 'approved', or
  /// 'rejected'.
  status String
  
  /// Timestamp when the request was created.
  created_at DateTime
  
  /// Timestamp when the request was last updated.
  updated_at DateTime
  
  /// Timestamp indicating when the request was softly deleted (null if not
  /// deleted).
  deleted_at DateTime?
  
  //----
  // INDEXES
  //----
  @@index([status])
  @@index([created_at])
}

