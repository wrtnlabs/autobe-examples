/// Shopping carts representing persistent customer or guest selections of
/// SKUs intended for purchase.
///
/// Each cart belongs to a customer, allowing multiple concurrent carts for
/// different sessions.
/// Carts persist across sessions and support soft deletion for audit purposes.
///
/// @namespace Carts
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_carts {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the owning customer. {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Reference to the specific customer session. {@link
  /// shopping_mall_customer_sessions.id}.
  shopping_mall_customer_session_id String?
  
  /// Timestamp when the cart was created.
  created_at DateTime
  
  /// Timestamp when the cart was last updated.
  updated_at DateTime
  
  /// Soft deletion timestamp; null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  customerSession shopping_mall_customer_sessions? @relation(fields: [shopping_mall_customer_session_id], references: [id], onDelete: Cascade)
  
  shopping_mall_cart_items shopping_mall_cart_items[]
  
  @@index([shopping_mall_customer_session_id])
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_customer_id, shopping_mall_customer_session_id], map: "shopping_mall_carts_shopping_mall_customer_id_shopping_2992cbd5")
  @@index([created_at, updated_at])
}

/// Individual items within a shopping cart representing specific product
/// SKUs selected by the customer.
///
/// Each item references one cart and one product variant. Quantity tracks
/// the amount desired.
/// This subsidiary table enables efficient many-to-one relationship from
/// items to carts.
///
/// @namespace Carts
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_cart_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the owning shopping cart. {@link shopping_mall_carts.id}.
  shopping_mall_cart_id String
  
  /// Reference to the selected product variant (SKU). {@link
  /// shopping_mall_product_variants.id}.
  shopping_mall_product_variant_id String
  
  /// Quantity of the SKU selected by the customer.
  quantity Int
  
  /// Timestamp when the cart item was created.
  created_at DateTime
  
  /// Timestamp when the cart item was last updated.
  updated_at DateTime
  
  /// Soft deletion timestamp; null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  cart shopping_mall_carts @relation(fields: [shopping_mall_cart_id], references: [id], onDelete: Cascade)
  productVariant shopping_mall_product_variants @relation(fields: [shopping_mall_product_variant_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_mall_cart_id])
  @@index([shopping_mall_product_variant_id])
  
  @@index([quantity])
}

