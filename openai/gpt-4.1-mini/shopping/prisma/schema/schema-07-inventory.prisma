/// Represents current inventory levels for each product SKU. Tracks
/// available quantity, stock status, and last updated timestamps. References
/// shopping_mall_product_skus to tie inventory data to specific variants.
/// Maintains data integrity with non-nullable foreign keys and consistent
/// temporal fields. Supports real-time inventory queries and stock
/// availability checks.
///
/// @namespace Inventory
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_sku_inventories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belongs to product SKU {@link shopping_mall_product_skus.id}.
  shopping_mall_product_sku_id String
  
  /// Current inventory quantity for this SKU. Cannot be negative.
  quantity Int
  
  /// Inventory stock status, e.g., 'in stock', 'out of stock', 'backordered'.
  stock_status String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp. Null if not deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  productSku shopping_mall_product_skus @relation(fields: [shopping_mall_product_sku_id], references: [id], onDelete: Cascade)
  
  @@unique([shopping_mall_product_sku_id])
  @@index([stock_status, updated_at])
}

/// Records all inventory stock adjustments for SKUs including additions,
/// subtractions, reservations, and releases. Each adjustment logs the SKU
/// affected, the quantity change, adjustment type, actor (customer, seller,
/// admin) responsible, and timestamps for audit and operational integrity.
/// Ensures that adjustments maintain accurate inventory states and provide
/// complete history for reconciliation.
///
/// @namespace Inventory
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_stock_adjustments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Inventory adjustment related to product SKU {@link
  /// shopping_mall_product_skus.id}.
  shopping_mall_product_sku_id String
  
  /// Type of adjustment: 'addition', 'subtraction', 'reservation', or
  /// 'release'.
  adjustment_type String
  
  /// Quantity adjusted; positive integer for additions/reservations, negative
  /// for subtractions.
  quantity Int
  
  /// Type of actor who made the adjustment: 'customer', 'seller', or 'admin'.
  actor_type String
  
  /// ID of the actor who performed adjustment. Reference depends on actor_type.
  actor_id String
  
  /// Timestamp when the adjustment was made.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  productSku shopping_mall_product_skus @relation(fields: [shopping_mall_product_sku_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_sku_id, created_at], map: "shopping_mall_stock_adjustments_shopping_mall_product__b6e33b35")
  @@index([actor_type, actor_id])
}

