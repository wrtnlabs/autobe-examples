/// Customer orders with aggregated details including total price, quantity,
/// payment status, and overall order state. Links to customers placing
/// orders and supports soft delete for historical record keeping.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_orders {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The customer who placed this order. {@link shopping_mall_customers.id}
  shopping_mall_customer_id String
  
  /// Unique order number for public reference and tracking.
  order_number String
  
  /// Total amount payable for the order.
  total_price Float
  
  /// Total quantity of all items in the order.
  total_quantity Int
  
  /// Overall status of the order: paid, shipped, delivered, cancelled,
  /// refunded, partially_completed.
  order_status String
  
  /// Timestamp when the order was created.
  created_at DateTime
  
  /// Timestamp when the order was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp allowing for historical record keeping.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  orderItemSnapshots shopping_mall_order_item_snapshots[]
  orderItems shopping_mall_order_items[]
  orderSnapshots shopping_mall_order_snapshots[]
  reviews shopping_mall_reviews[]
  
  //----
  // INDEXES
  //----
  @@unique([order_number])
  @@index([shopping_mall_customer_id, created_at])
}

