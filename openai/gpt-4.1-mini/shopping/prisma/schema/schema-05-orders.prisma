  @@index([shopping_mall_order_id, shopping_mall_product_variant_id], map: "shopping_mall_order_items_shopping_mall_order_id_shopp_d24d15be")
}

/// Payment records associated with orders.
///
/// Tracks payment method, status, amounts, and timestamps.
/// Payments are linked uniquely to orders ensuring one-to-one relationship.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_payments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Order associated with this payment. {@link shopping_mall_orders.id}.
  shopping_mall_order_id String
  
  /// Method of payment used by the customer (e.g., credit card, PayPal).
  payment_method String
  
  /// Status of the payment transaction.
  payment_status String
  
  /// Amount paid in this transaction.
  payment_amount Float
  
  /// External payment gateway transaction identifier.
  transaction_id String
  
  /// Timestamp of when the payment was processed.
  payment_date DateTime
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  
  @@unique([shopping_mall_order_id])
  
  @@unique([transaction_id])
  @@index([payment_status])
}

