  // COLUMNS
  //----
  /// Primary key of the order.
  id String @id
  
  /// Reference to the customer who placed the order. {@link
  /// shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Unique business order number for external reference.
  order_number String
  
  /// Current order status such as pending, processing, shipped, delivered,
  /// cancelled.
  status String
  
  /// Payment status indicating whether payment is pending, completed, or
  /// failed.
  payment_status String
  
  /// Total amount of the order including taxes, fees, and discounts.
  total_amount Float
  
