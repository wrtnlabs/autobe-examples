/// Order entities representing customer purchase transactions.
///
/// Stores key business data such as customer, seller, payment, and order
/// status with lifecycle timestamps.
/// Each order references the customer placing it and the seller fulfilling it.
/// Includes soft delete support to maintain audit trail integrity.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_orders {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who placed the order. {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Seller responsible for fulfillment. {@link shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Unique order reference number for business tracking.
  order_number String
  
  /// Current status of the order indicating lifecycle phase.
  order_status String
  
  /// Status of the payment associated with the order.
  payment_status String
  
  /// Total monetary amount of the order including taxes and shipping.
  total_amount Float
  
  /// Serialized shipping address at the time of order placement.
  shipping_address String
  
  /// Order creation timestamp.
  created_at DateTime
  
  /// Last update timestamp for the order.
  updated_at DateTime
  
  /// Optional soft delete timestamp to mark order as deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  
  shopping_mall_order_items shopping_mall_order_items[]
  shopping_mall_payments shopping_mall_payments?
  shopping_mall_shipments shopping_mall_shipments?
  shopping_mall_order_cancellations shopping_mall_order_cancellations?
  shopping_mall_refund_requests shopping_mall_refund_requests?
  
  @@index([shopping_mall_customer_id])
  
  @@unique([order_number])
  // spellchecker: ignore-next-line
  @@index([order_status, payment_status, shopping_mall_customer_id], map: "shopping_mall_orders_order_status_payment_status_shopp_3351366e")
  @@index([shopping_mall_seller_id])
}

