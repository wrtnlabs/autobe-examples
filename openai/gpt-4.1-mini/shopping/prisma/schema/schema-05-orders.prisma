///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_order_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced original order's shopping_mall_orders.id.
  shopping_mall_order_id String
  
  /// Timestamp when the snapshot was created.
  snapshot_at DateTime
  
  /// Current status of the order in this snapshot (e.g., paid, shipped,
  /// delivered).
  status String
  
  /// Total price of the order at snapshot time.
  total_price Float
  
  /// Denormalized customer name at snapshot time.
  customer_name String
  
  /// Denormalized customer email at snapshot time.
  customer_email String
  
  /// Denormalized shipping address in text form at snapshot time.
  shipping_address String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp; null if not deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([shopping_mall_order_id])
}

