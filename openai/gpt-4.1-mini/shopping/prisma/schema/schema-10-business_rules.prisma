/// Business rules enforcing platform-wide constraints, validation logic, and
/// compliance checkpoints. Each rule has a unique code and descriptive
/// metadata guiding system behavior and validation. Acts as a centralized
/// source for business rule definitions and aids in automated enforcement.
///
/// @namespace BusinessRules
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_business_rules {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique business rule identifier code.
  business_rule_code String
  
  /// Detailed textual explanation of the rule's intent, scope, and application
  /// context.
  description String
  
  /// Flag indicating whether the rule is active and enforced by the system.
  enabled Boolean
  
  /// JSON-encoded additional data for rule parameters, conditions, or complex
  /// configurations.
  metadata String?
  
  /// Timestamp when the business rule was created.
  created_at DateTime
  
  /// Timestamp of the last update to the business rule.
  updated_at DateTime
  
  /// Soft delete timestamp marking the rule as inactive without removal.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  @@unique([business_rule_code])
  @@index([enabled, created_at])
}

/// Comprehensive error logs capturing operational errors, system faults, and
/// exception traces occurring within the shoppingMall platform. Each log
/// entry records error codes, messages, severity, context metadata, and
/// timestamps for troubleshooting and audit purposes.
///
/// @namespace BusinessRules
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_error_logs {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// System-specific code identifying the type of error encountered.
  error_code String
  
  /// Detailed error message describing the issue encountered.
  message String
  
  /// Severity level of the error (e.g., INFO, WARNING, ERROR, CRITICAL).
  severity String
  
  /// JSON-encoded metadata capturing environmental/contextual details relevant
  /// to the error.
  context_metadata String?
  
  /// Timestamp when the error was logged.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  @@index([error_code, created_at])
}

/// Records of exception events for auditing and operational analysis,
/// encompassing uncaught exceptions and handled edge cases within the
/// system. Stores event codes, detailed messages, associated actor and
/// session references, metadata, and temporal information to aid root cause
/// analysis and compliance.
///
/// @namespace BusinessRules
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_exception_events {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique code representing the exception event type.
  event_code String
  
  /// Detailed description of the exception event.
  message String
  
  /// Type of actor involved in the event, e.g., customer, seller, admin.
  actor_type String
  
  /// Reference to the actor's unique identifier involved in the event.
  actor_id String?
  
  /// Reference to the session associated with the event, if applicable.
  session_id String?
  
  /// JSON-encoded supplementary data providing additional context or
  /// diagnostics.
  metadata String?
  
  /// Timestamp of when the exception event occurred.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  @@unique([event_code, created_at])
  @@index([actor_type, created_at])
}