/// Product categories organized hierarchically with parent-child
/// relationship supporting flexible nested categorization for products.
/// Enforces unique category names within the same hierarchy level to ensure
/// unambiguous navigation and filtering. Serves as the primary
/// classification mechanism for products within the shopping mall platform.
///
/// @namespace ProductCatalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent category's {@link shopping_mall_product_categories.id}. Nullable
  /// for top-level categories.
  parent_id String?
  
  /// Category name, unique among sibling categories to avoid conflicts.
  name String
  
  /// Detailed description of the category's purpose and content.
  description String?
  
  /// Category creation timestamp.
  created_at DateTime
  
  /// Category last update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp for the category.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  parent shopping_mall_product_categories? @relation("recursive", fields: [parent_id], references: [id], onDelete: Cascade)
  
  recursive shopping_mall_product_categories[] @relation("recursive")
  
  @@unique([parent_id, name])
  @@index([name])
}

/// Products listed within the shopping mall platform, each assigned to one
/// or more categories. Represents core commerce entities with detailed
/// attributes for descriptions, branding, and pricing. Maintains inventory
/// and variant relationships through SKUs. Enables sellers and admins to
/// manage product information independently.
///
/// @namespace ProductCatalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique business identifier code for the product.
  code String
  
  /// Product name with descriptive title.
  name String
  
  /// Detailed textual description of the product.
  description String?
  
  /// Brand or manufacturer name for the product.
  brand String?
  
  /// Product creation timestamp.
  created_at DateTime
  
  /// Product last updated timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp for the product.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shopping_mall_product_skus shopping_mall_product_skus[]
  shopping_mall_product_approvals shopping_mall_product_approvals[]
  
  @@unique([code])
  @@index([name])
}

/// Stock Keeping Units (SKU) representing distinct product variants defined
/// by combinations of attributes such as color, size, and other options.
/// Each SKU has a unique code and pricing information. Inventory tracking is
/// performed externally via other components. Related to a single product
/// and enables granular product management.
///
/// @namespace ProductCatalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_skus {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced product's {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Unique SKU code identifying the variant globally.
  sku_code String
  
  /// Price of this SKU variant.
  price Float
  
  /// JSON-encoded variant attributes such as color, size, and options.
  attributes_json String?
  
  /// SKU creation timestamp.
  created_at DateTime
  
  /// SKU last updated timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp for the SKU.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  shopping_mall_cart_items shopping_mall_cart_items[]
  shopping_mall_wishlist_items shopping_mall_wishlist_items[]
  shopping_mall_order_items shopping_mall_order_items[]
  shopping_mall_product_reviews shopping_mall_product_reviews[]
  shopping_mall_sku_inventories shopping_mall_sku_inventories?
  shopping_mall_stock_adjustments shopping_mall_stock_adjustments[]
  shopping_mall_low_stock_alerts shopping_mall_low_stock_alerts[]
  
  @@unique([sku_code])
  @@index([shopping_mall_product_id])
}

/// Materialized view optimized for full-text product and SKU search
/// operations. Contains denormalized and precomputed search fields for
/// efficient keyword and attribute-based querying. This table is read-only
/// and updated by background processes to reflect current product catalog
/// state.
///
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_search_index {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Related product's {@link shopping_mall_products.id}.
  product_id String
  
  /// Related SKU's {@link shopping_mall_product_skus.id}. Nullable if index
  /// entry relates only to product level.
  sku_id String?
  
  /// Concatenated searchable text for full-text search.
  search_text String
  
  /// Search index entry creation timestamp.
  created_at DateTime
  
  /// Search index entry last updated timestamp.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  @@index([product_id])
  @@index([sku_id])
}