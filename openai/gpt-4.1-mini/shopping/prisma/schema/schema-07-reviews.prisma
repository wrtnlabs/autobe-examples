/// Stores customer reviews for products including ratings and textual
/// feedback, linked to the corresponding order item and product variant to
/// ensure purchase verification. Each review belongs to a customer and
/// references the specific order item and product variant to verify purchase
/// validity. Supports soft delete with deleted_at field. Rating is an
/// integer from 1 to 5 stars; review text is optional.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_reviews {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reviewed customer who wrote this review. References customer's {@link
  /// shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Order item associated with this review to ensure purchase verification.
  /// References {@link shopping_mall_order_items.id}.
  shopping_mall_order_item_id String
  
  /// Product variant reviewed, linked to {@link
  /// shopping_mall_product_variants.id}.
  shopping_mall_product_variant_id String
  
  /// Star rating given by the customer, from 1 to 5.
  rating Int
  
  /// Optional textual content of the review.
  body String?
  
  /// Timestamp when the review was created.
  created_at DateTime
  
  /// Timestamp when the review was last updated.
  updated_at DateTime
  
  /// Timestamp when the review was soft deleted, if applicable.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  orderItem shopping_mall_order_items @relation(fields: [shopping_mall_order_item_id], references: [id], onDelete: Cascade)
  productVariant shopping_mall_product_variants @relation(fields: [shopping_mall_product_variant_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  reviewSnapshots shopping_mall_review_snapshots[]
  saleReviewVotes shopping_mall_sale_review_votes[]
  productReviewSnapshots shopping_mall_product_review_snapshots[]
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([shopping_mall_customer_id, created_at], map: "shopping_mall_product_reviews_shopping_mall_customer_i_71cc7be0")
  // spellchecker: ignore-next-line
  @@index([shopping_mall_order_item_id, created_at], map: "shopping_mall_product_reviews_shopping_mall_order_item_da680486")
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_variant_id, created_at], map: "shopping_mall_product_reviews_shopping_mall_product_va_ce8c695a")
}

/// Immutable snapshots of product reviews capturing prior review states for
/// audit and dispute resolution purposes. Each snapshot preserves the state
/// of a customer's review at a specific point in time, including rating,
/// textual content, and associations with order items and product variants.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_review_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced product review's {@link shopping_mall_product_reviews.id}.
  product_review_id String
  
  /// Referenced order item associated with the review {@link
  /// shopping_mall_order_items.id}.
  order_item_id String
  
  /// Referenced product variant associated with the review {@link
  /// shopping_mall_product_variants.id}.
  product_variant_id String
  
  /// Star rating given by the customer (1 to 5).
  rating Int
  
  /// Optional textual review content provided by the customer.
  body String?
  
  /// Timestamp when this snapshot was created.
  created_at DateTime
  
  /// Timestamp when this snapshot was last updated.
  updated_at DateTime
  
  /// Timestamp marking soft deletion (nullable).
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  productReview shopping_mall_product_reviews @relation(fields: [product_review_id], references: [id], onDelete: Cascade)
  orderItem shopping_mall_order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  productVariant shopping_mall_product_variants @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([order_item_id])
  @@index([product_variant_id])
  // spellchecker: ignore-next-line
  @@index([product_review_id, created_at], map: "shopping_mall_product_review_snapshots_product_review__56889806")
}