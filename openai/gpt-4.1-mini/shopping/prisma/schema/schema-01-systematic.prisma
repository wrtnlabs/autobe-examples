/// Channels represent the main entry points or marketplaces within the
/// e-commerce platform.
///
/// Each channel defines its unique code and display name, enabling clear
/// identification and management within the system.
///
/// Channels serve as organizational units that link to specific sections and
/// categories to structure the shopping experience.
///
/// Soft deletion is supported to retain historical records while allowing
/// content moderation and administrative control.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_channels {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique code identifying the channel, used for internal system references
  /// and API routing.
  code String
  
  /// Display name of the channel as presented to customers and administrators.
  name String
  
  /// Timestamp when the channel record was created.
  created_at DateTime
  
  /// Timestamp when the channel record was last updated.
  updated_at DateTime
  
  /// Timestamp when the channel record was soft deleted; null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shopping_mall_sections shopping_mall_sections[]
  shopping_mall_channel_categories shopping_mall_channel_categories[]
  shopping_mall_coins shopping_mall_coins[]
  
  @@unique([code])
}

/// Sections represent subdivisions or areas within a channel that group
/// related categories and products.
///
/// Each section belongs to a single channel and serves to organize offerings
/// logically for improved navigation and management.
///
/// Sections have unique codes within the system and support soft deletion
/// for administrative purposes.
///
/// They track creation and update timestamps to support auditing and
/// operational history.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_sections {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the channel to which this section belongs. {@link
  /// shopping_mall_channels.id}.
  shopping_mall_channel_id String
  
  /// Unique code identifying the section for internal use and API access.
  code String
  
  /// Display name of the section to show in the administrative interfaces and
  /// to customers.
  name String
  
  /// Timestamp when the section was created.
  created_at DateTime
  
  /// Timestamp when the section was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp; null when the section is active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  channel shopping_mall_channels @relation(fields: [shopping_mall_channel_id], references: [id], onDelete: Cascade)
  
  @@unique([code])
  @@index([shopping_mall_channel_id])
}

/// Channel categories link specific categories to channels, defining the
/// category organization within a particular channel context.
///
/// Each category linked to a channel may influence navigation, filtering,
/// and presentation of products within that channel.
///
/// This table supports soft deletion to allow removal without losing
/// historical relationships.
///
/// Timestamps track creation and update events for audit trails and system
/// operations.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_channel_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the shopping mall channel. {@link shopping_mall_channels.id}.
  shopping_mall_channel_id String
  
  /// Reference to product category associated with this channel category.
  /// {@link shopping_mall_product_categories.id}.
  shopping_mall_product_category_id String
  
  /// Timestamp when the channel category record was created.
  created_at DateTime
  
  /// Timestamp of last update to this record.
  updated_at DateTime
  
  /// Soft deletion timestamp; null means active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  channel shopping_mall_channels @relation(fields: [shopping_mall_channel_id], references: [id], onDelete: Cascade)
  productCategory shopping_mall_product_categories @relation(fields: [shopping_mall_product_category_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_mall_channel_id])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_category_id], map: "shopping_mall_channel_categories_shopping_mall_product_4c711dc8")
}

/// Configurations store key-value pairs representing system-wide settings
/// and preferences.
///
/// Each configuration entry has a unique key to prevent duplicates and
/// ensure unambiguous retrieval.
///
/// Configurations can be soft deleted to allow deactivation without data loss.
///
/// Timestamps for creation and updates are maintained for auditing and
/// change tracking.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_configurations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique identifier key for the configuration setting.
  key String
  
  /// Configuration value as a string. Interpretation is context-dependent.
  value String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Last modification timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp; null when configuration is active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  @@unique([key])
}