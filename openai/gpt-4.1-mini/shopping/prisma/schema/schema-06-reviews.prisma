/// Customer product reviews capturing ratings and textual feedback, linked
/// to products and customers, with moderation status and timestamps.
/// Supports audit trails and versioning of review data.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_reviews {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced product SKU. {@link shopping_mall_product_skus.id}.
  shopping_mall_product_sku_id String
  
  /// Customer who submitted the review. {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Order associated with this review to verify purchase. {@link
  /// shopping_mall_orders.id}.
  shopping_mall_order_id String
  
  /// Numeric rating from 1 to 5 representing customer satisfaction.
  rating Int
  
  /// Optional textual comments provided by customer (max 1000 chars).
  review_body String?
  
  /// Review moderation status such as 'pending', 'approved', or 'rejected'.
  moderation_status String
  
  /// Review creation timestamp.
  created_at DateTime
  
  /// Review last updated timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp for logical removal (null if active).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  productSku shopping_mall_product_skus @relation(fields: [shopping_mall_product_sku_id], references: [id], onDelete: Cascade)
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  
  shopping_mall_review_moderation_queues shopping_mall_review_moderation_queues[]
  
  @@index([shopping_mall_customer_id])
  @@index([shopping_mall_order_id])
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_sku_id, shopping_mall_customer_id], map: "shopping_mall_product_reviews_shopping_mall_product_sk_eaac6be3")
  @@index([moderation_status])
}

/// Active moderation queue holding reviews and related content flagged for
/// administrative review or automatic filtering. Enables tracking of review
/// status, moderator actions, and notes.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_review_moderation_queues {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Linked product review requiring moderation. {@link
  /// shopping_mall_product_reviews.id}.
  shopping_mall_product_review_id String
  
  /// Reason for review being flagged and sent to moderation.
  flagged_reason String
  
  /// Optional notes added by moderators during review.
  moderator_notes String?
  
  /// Moderation queue status such as 'pending', 'approved', 'rejected', or
  /// 'needs_changes'.
  status String
  
  /// Timestamp when the review was queued for moderation.
  created_at DateTime
  
  /// Timestamp of last moderation action update.
  updated_at DateTime
  
  /// Soft deletion timestamp to mark moderation queue rows as inactive.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  productReview shopping_mall_product_reviews @relation(fields: [shopping_mall_product_review_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_review_id], map: "shopping_mall_review_moderation_queues_shopping_mall_p_5696d1dd")
  
  @@index([status])
}

/// Profiles for sellers containing business and contact information,
/// supporting identity verification and profile management. Linked to
/// shopping_mall_sellers for authentication and authorization.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_seller_profiles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Linked seller identity. {@link shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Official store or business name of the seller.
  store_name String
  
  /// Government-issued business registration number for verification.
  business_registration_number String?
  
  /// Primary contact email for seller communications.
  contact_email String
  
  /// Contact phone number for seller support.
  contact_phone String?
  
  /// Description or biography of the seller's store.
  profile_description String?
  
  /// Timestamp of profile creation.
  created_at DateTime
  
  /// Timestamp of last profile update.
  updated_at DateTime
  
  /// Soft delete flag indicating profile removal.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  
  @@unique([shopping_mall_seller_id])
  
  @@unique([contact_email])
  @@index([store_name])
}