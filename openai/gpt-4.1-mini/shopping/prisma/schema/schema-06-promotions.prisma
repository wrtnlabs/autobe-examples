/// Coupon definitions for promotional campaigns.
///
/// Represents coupons issued by the shopping mall platform to provide
/// discounts or benefits to customers. Each coupon has unique code, type,
/// discount details and validity period. Coupons can be standalone or
/// associated with certain product categories or sellers.
///
/// Coupons support soft deletion to allow recovery and auditing.
///
/// @namespace Promotions
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_coupons {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Unique code identifying the coupon for redemption.
  code String
  
  /// Type of coupon, e.g., percentage discount, fixed amount, free shipping.
  type String
  
  /// Value of the discount applied when the coupon is used.
  discount_value Float
  
  /// Start date and time from which the coupon is valid.
  start_date DateTime
  
  /// End date and time until which the coupon is valid.
  end_date DateTime
  
  /// Timestamp when this coupon was created.
  created_at DateTime
  
  /// Timestamp when this coupon was last updated.
  updated_at DateTime
  
  /// Timestamp marking soft deletion of the coupon; null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shopping_mall_coupon_usages shopping_mall_coupon_usages[]
  
  @@unique([code])
  @@index([start_date, end_date])
}

/// Records each usage of coupons by customers.
///
/// Tracks coupon redemptions by customers, including associated customer and
/// session information, usage timestamp, and any order linkage. Ensures
/// auditability of coupon consumption and prevents abuse.
///
/// Supports soft deletion for historical correction and auditing.
///
/// @namespace Promotions
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_coupon_usages {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Reference to the coupon that was used. {@link shopping_mall_coupons.id}.
  shopping_mall_coupon_id String
  
  /// Reference to the customer who used the coupon. {@link
  /// shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Reference to the customer's session during coupon usage. {@link
  /// shopping_mall_customer_sessions.id}.
  shopping_mall_customer_session_id String
  
  /// Timestamp when the coupon usage occurred.
  used_at DateTime
  
  /// Associated order ID if coupon usage is linked to a specific order; null
  /// otherwise.
  order_id String?
  
  /// Timestamp when the usage record was created.
  created_at DateTime
  
  /// Timestamp when the usage record was last updated.
  updated_at DateTime
  
  /// Timestamp marking soft deletion of the usage; null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  coupon shopping_mall_coupons @relation(fields: [shopping_mall_coupon_id], references: [id], onDelete: Cascade)
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  customerSession shopping_mall_customer_sessions @relation(fields: [shopping_mall_customer_session_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_mall_customer_id])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_customer_session_id], map: "shopping_mall_coupon_usages_shopping_mall_customer_ses_852a0ad5")
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_coupon_id, shopping_mall_customer_id], map: "shopping_mall_coupon_usages_shopping_mall_coupon_id_sh_c4e7eb98")
}

/// Tracks customer mileage points for reward programs.
///
/// Stores mileage points accumulated by customers through purchases and
/// activities. Mileages can be redeemed for discounts or benefits. Supports
/// expiration tracking and audit trail.
///
/// Supports soft deletion for records management and auditing.
///
/// @namespace Promotions
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_mileages {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Reference to the customer owning the mileage. {@link
  /// shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Number of mileage points accumulated.
  points Int
  
  /// Optional expiration date for this mileage; null if no expiration.
  expiration_date DateTime?
  
  /// Timestamp when this mileage record was created.
  created_at DateTime
  
  /// Timestamp when this mileage record was last updated.
  updated_at DateTime
  
  /// Timestamp marking soft deletion; null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_mall_customer_id])
}

/// Tracks customer point balances for loyalty rewards.
///
/// Represents points credited to customers as part of loyalty or promotional
/// programs. Points can be redeemed or adjusted. Maintains audit trail and
/// soft deletion for management.
///
///
/// @namespace Promotions
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_points {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Reference to the customer owning these points. {@link
  /// shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Current point balance for the customer.
  balance Int
  
  /// Timestamp when this point record was created.
  created_at DateTime
  
  /// Timestamp when this point record was last updated.
  updated_at DateTime
  
  /// Timestamp marking soft deletion; null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_mall_customer_id])
}