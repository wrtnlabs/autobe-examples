  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the parent product. {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Unique SKU code used for inventory and order processing.
  sku_code String
  
  /// Sales price of this SKU variant.
  price Float
  
  /// Current inventory count for the SKU.
  inventory Int
  
  /// Indicates if the SKU is currently active and available for sale.
  is_active Boolean
  
  /// Timestamp when the SKU was created.
  created_at DateTime
  
  /// Timestamp when the SKU was last updated.
  updated_at DateTime
  
  /// Timestamp marking when the SKU was soft-deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  shopping_mall_sales_snapshots shopping_mall_sales_snapshots[]
  shopping_mall_cart_items shopping_mall_cart_items[]
  shopping_mall_wishlist_items shopping_mall_wishlist_items[]
  shopping_mall_order_items shopping_mall_order_items[]
  
  @@index([shopping_mall_product_id])
  
  @@unique([sku_code])
  // spellchecker: ignore-next-line
  @@index([is_active, shopping_mall_product_id], map: "shopping_mall_product_skus_is_active_shopping_mall_pro_dedf11a1")
}

