/// Immutable snapshots capturing product states at edit time including
/// embedded variant snapshots, preserving historical states. Each record
/// stores a complete snapshot of a product's data at a point in time for
/// audit and dispute resolution.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The original product's {@link shopping_mall_products.id} that this
  /// snapshot belongs to.
  shopping_mall_product_id String
  
  /// Snapshot of the product name at the time of this snapshot.
  name String
  
  /// Snapshot of the product description at the time of this snapshot.
  description String
  
  /// FK to the product's snapshot category {@link shopping_mall_categories.id}
  /// at snapshot time.
  category_id String
  
  /// Snapshot of the product's base price at the time of this snapshot.
  base_price Float
  
  /// Timestamp indicating when this snapshot record was logically deleted, if
  /// applicable.
  deleted_at DateTime?
  
  /// Timestamp when this snapshot was created.
  created_at DateTime
  
  /// Timestamp when this snapshot was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, created_at], map: "shopping_mall_product_snapshots_shopping_mall_product__cc038f1c")
}

