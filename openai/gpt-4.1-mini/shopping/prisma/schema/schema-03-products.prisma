/// Categories organizing products with optional single-level subcategories
/// for hierarchical browsing and filtering. Supports hierarchical
/// parent-child relationships for categories and subcategories.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent category's {@link shopping_mall_categories.id}. Nullable for
  /// top-level categories.
  parent_category_id String?
  
  /// Name of the category.
  name String
  
  /// Description of the category.
  description String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp. Null if not deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  parentCategory shopping_mall_categories? @relation("recursive", fields: [parent_category_id], references: [id], onDelete: Cascade)
  
  subcategories shopping_mall_categories[] @relation("recursive")
  
  @@unique([parent_category_id, name])
  @@index([parent_category_id])
}

/// Products created by sellers with details like name, description, base
/// price, belonging to specific product subcategories and sellers. Supports
/// soft deletion for safe removal without losing history.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The seller who owns this product. References shopping_mall_sellers.id.
  seller_id String
  
  /// The subcategory this product belongs to. References
  /// shopping_mall_product_subcategories.id.
  product_subcategory_id String
  
  /// The product's name identifying it in listings and searches.
  name String
  
  /// Detailed description of the product, explaining features and attributes.
  description String
  
  /// The base price before any variant overrides.
  base_price Float
  
  /// Timestamp when the product was created.
  created_at DateTime
  
  /// Timestamp when the product was last updated.
  updated_at DateTime
  
  /// Timestamp when the product was soft-deleted. Null means active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  seller shopping_mall_sellers @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  productSubcategory shopping_mall_product_subcategories @relation(fields: [product_subcategory_id], references: [id], onDelete: Cascade)
  
  productImages shopping_mall_product_images[]
  productVariants shopping_mall_product_variants[]
  snapshots shopping_mall_product_snapshots[]
  
  @@unique([seller_id, name])
  @@index([seller_id, created_at])
  @@index([product_subcategory_id])
}

