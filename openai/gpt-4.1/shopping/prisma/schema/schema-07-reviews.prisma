  @@index([shopping_mall_product_sku_id])
  @@index([shopping_mall_order_id])
  @@index([shopping_mall_product_rating_id])
  
  @@unique([shopping_mall_order_item_id])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, moderation_status], map: "shopping_mall_reviews_shopping_mall_product_id_moderat_a6f779bc")
  @@index([shopping_mall_customer_id, created_at])
