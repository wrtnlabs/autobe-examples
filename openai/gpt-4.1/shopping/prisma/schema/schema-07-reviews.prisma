/// Seller responses to customer reviews, visible alongside the original review.
///
/// Each response is created by the seller of the product reviewed, providing
/// clarification, acknowledgment, or additional information in response to
/// customer feedback. Each response is linked to the specific review and the
/// seller account.
///
/// Full traceability to session and seller is maintained for auditing. Only
/// one response is allowed per review; responses can be edited or withdrawn
/// by seller or admin. Moderation is supported via status and reason fields.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_review_responses {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Unique link to the review being responded to. One response per review.
  /// {@link shopping_mall_reviews.id}.
  shopping_mall_review_id String
  
  /// Seller who wrote the response. {@link shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Session during which the response was written. {@link
  /// shopping_mall_seller_sessions.id}.
  shopping_mall_seller_session_id String
  
  /// Textual response from seller. Minimum 10, maximum 1000 characters.
  body String
  
  /// Timestamp if seller withdraws or deletes their response.
  withdrawn_at DateTime?
  
  /// Current moderation status for the response.
  moderation_status String
  
  /// Optional reason for moderation action (rejection/flagging).
  moderation_reason String?
  
  /// When the response was created.
  created_at DateTime
  
  /// Last updated time.
  updated_at DateTime
  
  /// Soft delete marker (for admin/content removal).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  review shopping_mall_reviews @relation(fields: [shopping_mall_review_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  sellerSession shopping_mall_seller_sessions @relation(fields: [shopping_mall_seller_session_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_seller_session_id], map: "shopping_mall_review_responses_shopping_mall_seller_se_7cff3a07")
  
  @@unique([shopping_mall_review_id])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_seller_id, created_at], map: "shopping_mall_review_responses_shopping_mall_seller_id_e422490f")
}

/// Standalone product rating entity tied to a specific customer and product
/// SKU.
///
/// Stores the numeric (1–5 stars) rating value that a verified customer
/// assigns to a product SKU as part of their review. Enforces the rule that
/// each customer can rate each product SKU only once (per completed
/// purchase). Ratings are referenced in reviews for search and aggregation;
/// this separation allows display of rating stats even for unreviewed
/// purchases and efficient rating aggregation per product/SKU.
///
/// Audit trail includes customer and session for verification. Only allows
/// update by the original customer within the edit window.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_ratings {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Customer who provided the rating. {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Session when the rating was submitted. {@link
  /// shopping_mall_customer_sessions.id}.
  shopping_mall_customer_session_id String
  
  /// Product being rated. {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// SKU of the rated product. {@link shopping_mall_product_skus.id}.
  shopping_mall_product_sku_id String
  
  /// Order associated with this rating. {@link shopping_mall_orders.id}.
  shopping_mall_order_id String
  
  /// Specific order item this rating applies to. {@link
  /// shopping_mall_order_items.id}.
  shopping_mall_order_item_id String
  
  /// Numeric rating value (1–5 stars).
  value Int
  
  /// Timestamp of rating creation.
  created_at DateTime
  
  /// Last update time for rating.
  updated_at DateTime
  
  /// Soft delete marker (if rating is removed or replaced).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  customerSession shopping_mall_customer_sessions @relation(fields: [shopping_mall_customer_session_id], references: [id], onDelete: Cascade)
