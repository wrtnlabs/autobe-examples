/// Contains immutable records of all critical business and
/// security-sensitive operations performed on the platform. Each record
/// represents an atomic, auditable event, such as admin/seller/customer
/// actions, privilege escalations, or system overrides. Designed for
/// compliance and traceability across the system. Linked to the actor
/// performing the action when available. Used for regulatory reporting,
/// security investigations, and dispute handling.
///
/// @namespace AdminOps
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_audit_logs {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Admin actor performing the logged operation. {@link shopping_admins.id}.
  admin_id String?
  
  /// Seller actor affected by this action if relevant. {@link
  /// shopping_sellers.id}.
  seller_id String?
  
  /// Customer actor affected by this action if relevant. {@link
  /// shopping_customers.id}.
  customer_id String?
  
  /// Structured log category or domain (e.g., 'security', 'order', 'refund',
  /// 'inventory').
  category String
  
  /// Machine-readable code for the specific action (e.g.,
  /// 'ADMIN_SUSPEND_SELLER', 'ORDER_MANUAL_REFUND', 'PRIV_ESCALATION').
  event_type String
  
  /// IP address from which the operation originated, for traceability.
  ip String?
  
  /// Human-readable summary of the event, for audit reports or investigation.
  description String?
  
  /// Record creation timestamp (immutable atomic event recording).
  created_at DateTime
  
  /// Record update timestamp (immutable, but may indicate additional
  /// annotation).
  updated_at DateTime
  
  /// Soft delete marker if the log was removed from default query views.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  admin shopping_admins? @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  seller shopping_sellers? @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  customer shopping_customers? @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  
  @@index([admin_id, created_at])
  @@index([seller_id, created_at])
  @@index([customer_id, created_at])
}

/// Contains records of major administrative operations—such as admin
