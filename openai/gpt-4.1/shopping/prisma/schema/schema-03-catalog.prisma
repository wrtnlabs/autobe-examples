  // spellchecker: ignore-next-line
  @@unique([shopping_mall_product_id, shopping_mall_category_id], map: "shopping_mall_products_categories_shopping_mall_produc_4e72ec26")
  @@index([shopping_mall_category_id])
}

/// Individual SKU (Stock Keeping Unit) for a specific variant or option of a
/// catalog product.
///
/// Each SKU represents a unique variant of a product (e.g., color, size,
/// option combinations), with independent inventory, price, and status. SKUs
/// are linked to the parent product and to their attribute values (via
/// subsidiary mapping table). Inventory, per-SKU pricing, out-of-stock
/// flags, and barcode/business reference codes are managed here. SKUs are
/// included in search and filtering.
///
/// Audit, status, and soft delete fields support traceability, operation,
/// and moderation.
///
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_skus {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Parent catalog product for this SKU. References {@link
  /// shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Unique business SKU/barcode identifier within a product scope.
  sku_code String
  
  /// Sale price for this variant (overrides product default price if present).
  price Float
  
  /// Inventory units available for this SKU.
  stock Int
  
  /// Workflow status for SKU (e.g., active, out_of_stock, archived, draft).
  status String
  
  /// UTC timestamp for SKU creation.
  created_at DateTime
  
  /// UTC timestamp for last SKU change.
  updated_at DateTime
  
  /// Soft delete flag: null if active, set when archived/deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  shopping_mall_product_images shopping_mall_product_images[]
  shopping_mall_product_attribute_values shopping_mall_product_attribute_values[]
  shopping_mall_cart_items shopping_mall_cart_items[]
  shopping_mall_wishlist_items shopping_mall_wishlist_items[]
  shopping_mall_order_items shopping_mall_order_items[]
  shopping_mall_reviews shopping_mall_reviews[]
  shopping_mall_product_ratings shopping_mall_product_ratings[]
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_product_id, sku_code], map: "shopping_mall_product_skus_shopping_mall_product_id_sk_d9eb9aba")
  @@index([shopping_mall_product_id, status])
}

/// Image/media asset records associated with products or SKUs.
///
/// Each row stores a single image file or media asset for a specific product
/// or SKU. Images support position-based ordering (e.g., main image, gallery
/// order), alt text for accessibility, CDN/URI reference, and a label for
/// internal management. Can attach images directly to product or specific
/// SKU using foreign key, but never both at the same time (business logic
/// ensures this).
///
/// Audit fields and soft delete are included for digital asset lifecycle.
///
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_images {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Product that this image is associated with. Nullable if this is a
  /// SKU-specific image.
  shopping_mall_product_id String?
  
  /// SKU variant this image is associated with. Nullable if this is a
  /// product-level image.
  shopping_mall_product_sku_id String?
  
  /// CDN or publicly accessible URI for the image media.
  cdn_uri String
  
  /// Accessibility/text alternative for the image, shown on error/load fail.
  alt_text String?
  
  /// Image display position ordering for carousels/galleries. Lower values
  /// displayed first.
  position Int
  
  /// System/business management label (not shown to end users).
  label String?
  
  /// UTC timestamp for asset creation.
  created_at DateTime
  
  /// UTC timestamp for any update to asset.
  updated_at DateTime
  
  /// Soft delete marker: null if active, set when removed/archived.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products? @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  sku shopping_mall_product_skus? @relation(fields: [shopping_mall_product_sku_id], references: [id], onDelete: Cascade)
  
  @@unique([cdn_uri])
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_product_id, position], map: "shopping_mall_product_images_shopping_mall_product_id__c61fc426")
  @@index([shopping_mall_product_id])
  @@index([shopping_mall_product_sku_id])
}

