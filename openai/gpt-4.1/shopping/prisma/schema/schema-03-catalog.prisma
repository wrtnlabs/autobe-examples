/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_products_categories {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Mapped catalog product. References {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Assigned marketplace category. References {@link
  /// shopping_mall_categories.id}.
  shopping_mall_category_id String
  
  /// UTC timestamp for mapping creation.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
