/// Core catalog products available in the shopping mall platform. Each
/// product contains general product information (name, description, price,
/// main image, etc.) and is associated with a seller (FK to
/// shopping_sellers), categories, tags, and SKUs. Supports both published
/// (active) and draft/archived status, provides audit and soft delete
/// fields. Subject to category and tag assignments via subsidiary tables.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged seller's {@link shopping_sellers.id}.
  shopping_seller_id String
  
  /// Unique business code for the product, used for lookup or external
  /// referencing.
  code String
  
  /// Product display name shown to shoppers. Used for search and catalog
  /// display.
  name String
  
  /// Long description of the product for customer information and search
  /// indexing.
  description String
  
  /// URI to the primary display image associated with this product.
  main_image_uri String?
  
  /// Product status (e.g., draft, active, archived, under_review). Used in
  /// workflow.
  status String
  
  /// Business workflow status (e.g., in_review, approved, rejected).
  business_status String
  
  /// Creation timestamp for auditing.
  created_at DateTime
  
  /// Last updated timestamp for auditing.
  updated_at DateTime
  
  /// Soft-deleted timestamp. If not null, product is archived/not shown to
  /// shoppers.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  seller shopping_sellers @relation(fields: [shopping_seller_id], references: [id], onDelete: Cascade)
  
  shopping_product_snapshots shopping_product_snapshots[]
  shopping_product_images shopping_product_images[]
  shopping_skus shopping_skus[]
  shopping_product_attributes shopping_product_attributes[]
  shopping_category_product_assignments shopping_category_product_assignments[]
  shopping_product_tag_assignments shopping_product_tag_assignments[]
  shopping_review_rating_aggregates shopping_review_rating_aggregates[]
  shopping_policy_violations shopping_policy_violations[]
  
  @@unique([code])
  @@index([shopping_seller_id])
  @@index([status])
  @@index([created_at])
}

/// Historical snapshots of full product state for audit trail and change
/// history. Captures all product fields and foreign key references as they
/// were at the time of the snapshot. Used to reconstruct prior states,
/// enable moderation, or restore historical product versions. All edits to
/// shopping_products generate a snapshot entry.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_product_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product's {@link shopping_products.id}.
  shopping_product_id String
  
  /// Business code at time of snapshot.
  code String
  
  /// Name at time of snapshot.
  name String
  
  /// Long description at time of snapshot.
  description String
  
  /// Primary image at time of snapshot.
  main_image_uri String?
  
  /// Product status at time of snapshot.
  status String
  
  /// Business workflow status at time of snapshot.
  business_status String
  
  /// Snapshot creation timestamp.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  product shopping_products @relation(fields: [shopping_product_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_product_id])
  @@index([created_at])
}

/// Images associated with products for catalog display. Each image is linked
/// to a product and stores a URI reference. Allows multiple images per
/// product (up to 10 per business rules).
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_product_images {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product's {@link shopping_products.id}.
  shopping_product_id String
  
  /// URI pointing to an image file (JPEG/PNG, up to 5MB per upload).
  image_uri String
  
  /// Zero-based display order for product images.
  order_index Int?
  
  /// Upload/creation timestamp.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  product shopping_products @relation(fields: [shopping_product_id], references: [id], onDelete: Cascade)
  
  shopping_refund_attachments shopping_refund_attachments[]
  
  @@index([shopping_product_id, order_index])
}

/// Individual sellable SKU entities under a product. Each SKU represents a
/// unique combination of attribute values (variant), price, and inventory
/// reference. Linked to parent product, and optionally to inventory and
/// category. Carries pricing, in-stock state, and audit fields.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_skus {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product's {@link shopping_products.id}.
  shopping_product_id String
  
  /// Unique SKU business code (externally visible, globally unique).
  sku_code String
  
  /// Retail price for this SKU variant.
  price Float
  
  /// SKU enabled/disabled state. If false, not purchasable.
  is_active Boolean
  
  /// Optional barcode/UPC for scanning.
  barcode String?
  
  /// Business process status (e.g., in_stock, discontinued, archived).
  status String
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Updated timestamp.
  updated_at DateTime
  
  /// Soft-deleted timestamp (if set, SKU is archived).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_products @relation(fields: [shopping_product_id], references: [id], onDelete: Cascade)
  
  shopping_sku_variants shopping_sku_variants[]
  shopping_sku_images shopping_sku_images[]
  shopping_inventory shopping_inventory?
  shopping_inventory_adjustments shopping_inventory_adjustments[]
  shopping_inventory_alerts shopping_inventory_alerts[]
  shopping_cart_items shopping_cart_items[]
  shopping_guest_cart_items shopping_guest_cart_items[]
  shopping_wishlist_items shopping_wishlist_items[]
  shopping_order_lines shopping_order_lines[]
  shopping_reviews shopping_reviews[]
  shopping_review_rating_aggregates shopping_review_rating_aggregates?
  
  @@unique([sku_code])
  @@index([shopping_product_id])
  @@index([is_active])
}

/// Junction table mapping each SKU to its set of selected variant attribute
/// values. Supports up to 5 attribute variants per SKU (e.g., color, size,
/// material). M:N between SKU and attribute value, allowing rich filtering
/// and search.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_sku_variants {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent SKU's {@link shopping_skus.id}.
  shopping_sku_id String
  
  /// Associated attribute value's {@link shopping_attribute_values.id}.
  shopping_attribute_value_id String
  
  /// Order of this attribute among the variants for the SKU.
  order_index Int
  
  //----
  // RELATIONS
  //----
  sku shopping_skus @relation(fields: [shopping_sku_id], references: [id], onDelete: Cascade)
  attributeValue shopping_attribute_values @relation(fields: [shopping_attribute_value_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_attribute_value_id])
  
  // spellchecker: ignore-next-line
  @@unique([shopping_sku_id, shopping_attribute_value_id], map: "shopping_sku_variants_shopping_sku_id_shopping_attribu_d520f6b8")
}

/// Images assigned directly to a SKU (variant). Used to represent visual
/// attributes of a SKU (e.g., color swatch).
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_sku_images {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent SKU's {@link shopping_skus.id}.
  shopping_sku_id String
  
  /// URI of the SKU-specific image asset.
  image_uri String
  
  /// Upload timestamp.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  sku shopping_skus @relation(fields: [shopping_sku_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_sku_id])
}

/// Defines the possible attribute types used for product/SKU variants (e.g.,
/// Color, Size, Material). Managed by admins/sellers for flexible product
/// setup. Each dimension may apply to many products and values.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_attribute_dimensions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Business code for this attribute dimension (used for filtering, must be
  /// unique).
  dimension_code String
  
  /// Display name of the attribute dimension (e.g., Color, Size).
  name String
  
  /// Long description for this attribute dimension's purpose.
  description String
  
  /// Creation timestamp.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  shopping_attribute_values shopping_attribute_values[]
  
  @@unique([dimension_code])
}

/// Possible selectable values for each attribute dimension (e.g., Red, Blue
/// for Color). Each value is connected to its dimension and may be shared
/// among products. Enables SKU variant composition.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_attribute_values {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent attribute dimension's {@link shopping_attribute_dimensions.id}.
  shopping_attribute_dimension_id String
  
  /// Unique code for this attribute value (used in filtering, must be unique
  /// within the dimension).
  value_code String
  
  /// Display string (e.g., "Red", "Large", "Cotton").
  display_value String
  
  /// Sort order for this value among siblings.
  display_order Int?
  
  /// Creation timestamp.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  attributeDimension shopping_attribute_dimensions @relation(fields: [shopping_attribute_dimension_id], references: [id], onDelete: Cascade)
  
  shopping_sku_variants shopping_sku_variants[]
  shopping_product_attributes shopping_product_attributes[]
  
  // spellchecker: ignore-next-line
  @@unique([shopping_attribute_dimension_id, value_code], map: "shopping_attribute_values_shopping_attribute_dimension_d80d5234")
  @@index([shopping_attribute_dimension_id])
}

/// Junction table marking which attribute dimensions and values apply to a
/// given product (not variant-specific). Used to expose filtering and
/// faceted search features in the product catalog. M:N between
/// shopping_products and attribute values.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_product_attributes {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product's {@link shopping_products.id}.
  shopping_product_id String
  
  /// Assigned attribute value's {@link shopping_attribute_values.id}.
  shopping_attribute_value_id String
  
  //----
  // RELATIONS
  //----
  product shopping_products @relation(fields: [shopping_product_id], references: [id], onDelete: Cascade)
  attributeValue shopping_attribute_values @relation(fields: [shopping_attribute_value_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_attribute_value_id])
  
  // spellchecker: ignore-next-line
  @@unique([shopping_product_id, shopping_attribute_value_id], map: "shopping_product_attributes_shopping_product_id_shoppi_fc6ea71a")
}

/// Junction table assigning products to one or more categories. Many-to-many
/// mapping between products and shopping_categories. Used for catalog
/// display and filtering. Only leaf categories are valid assignments.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_category_product_assignments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Assigned product's {@link shopping_products.id}.
  shopping_product_id String
  
  /// Category's {@link shopping_categories.id}. Only leaf nodes allowed.
  shopping_category_id String
  
  //----
  // RELATIONS
  //----
  product shopping_products @relation(fields: [shopping_product_id], references: [id], onDelete: Cascade)
  category shopping_categories @relation(fields: [shopping_category_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_category_id])
  
  // spellchecker: ignore-next-line
  @@unique([shopping_product_id, shopping_category_id], map: "shopping_category_product_assignments_shopping_product_bafbb020")
}

/// Defines tags that can be applied to products for filtering and search
/// enhancement. Each tag is a free-form label managed by sellers or admins.
/// Tags can be assigned to multiple products through the tag assignment
/// table.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_product_tags {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Business code/slug for the tag (must be unique).
  tag_code String
  
  /// Displayed tag name (e.g., "Eco-Friendly").
  display_value String
  
  /// Description/purpose of this tag.
  description String
  
  /// Creation timestamp.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  shopping_product_tag_assignments shopping_product_tag_assignments[]
  
  @@unique([tag_code])
}

/// Junction table connecting products and tags (M:N). Enables sellers to
/// attach multiple tags to any product for catalog search and filter
/// operations.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_product_tag_assignments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Assigned product's {@link shopping_products.id}.
  shopping_product_id String
  
  /// Tag's {@link shopping_product_tags.id}.
  shopping_product_tag_id String
  
  //----
  // RELATIONS
  //----
  product shopping_products @relation(fields: [shopping_product_id], references: [id], onDelete: Cascade)
  tag shopping_product_tags @relation(fields: [shopping_product_tag_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_product_tag_id])
  
  // spellchecker: ignore-next-line
  @@unique([shopping_product_id, shopping_product_tag_id], map: "shopping_product_tag_assignments_shopping_product_id_s_672522b7")
}