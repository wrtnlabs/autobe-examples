/// Platform-wide key/value configuration entries for system-level settings
/// (URL, SMTP, feature flags, etc). These are needed for initialization,
/// seeding, and global runtime parameterization. Each config is uniquely
/// keyed and soft deletable for historical reference.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_system_configurations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique system configuration key (case-insensitive, e.g.
  /// 'core.smtp_server').
  config_key String
  
  /// Configuration value, serialized as text (JSON or plain values).
  config_value String
  
  /// Documentation of what this config controls.
  description String?
  
  /// Configuration creation timestamp.
  created_at DateTime
  
  /// Configuration last modification timestamp.
  updated_at DateTime
  
  /// Configuration deletion timestamp (soft delete).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  @@unique([config_key])
  @@index([created_at])
}

/// Global business policy and operational settings for the shopping
/// platform: currency, supported regions, tax policy, regulatory flags, etc.
/// Used for deployment-wide logic, onboarding, and migration. Only one row
/// per setting type/key is permitted. No coupling to business actors.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_business_settings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Business setting key (e.g., 'currency', 'country', 'tax_region').
  setting_key String
  
  /// Arbitrary string data for the setting value (could serialize as JSON for
  /// compound).
  setting_value String
  
  /// Description of this setting.
  description String?
  
  /// Row creation timestamp.
  created_at DateTime
  
  /// Row last update timestamp.
  updated_at DateTime
  
  /// Row deletion time (soft delete).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  @@unique([setting_key])
  @@index([created_at])
}

/// Centralized status code/enum definitions for use across the platform
/// (orders, reviews, payments, etc). Enables reference-integrity, decouples
/// code from hardcoded enums, and allows runtime editing of business states.
/// Soft deletable for historical tracking.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_status_enums {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Domain/entity scope for this status enum (such as 'order', 'review',
  /// 'payment').
  enum_domain String
  
  /// Exact status code (e.g., 'pending', 'paid', 'failed', case-insensitive).
  status_code String
  
  /// Human-readable label to display for this status in UIs.
  display_label String
  
  /// Ordering value for deterministic sequence in dropdowns or reports.
  sort_order Int
  
  /// Whether this status code is currently in active use (business logic
  /// toggle).
  is_active Boolean
  
  /// Comment or description for this enum value.
  description String?
  
  /// Time when the enum was created.
  created_at DateTime
  
  /// When this row was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp for enum deprecation.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  @@unique([enum_domain, status_code])
  @@index([enum_domain])
  @@index([is_active])
}

/// Root node definition for each independent category tree or taxonomy used
/// by the platform (e.g., shop main categories, secondary/auxiliary trees
/// for brands, etc). Not tied to actors or transactions. Implements unique
/// category tree code per taxonomy.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_category_trees {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique category tree code for this taxonomy (case-insensitive, e.g.,
  /// 'main', 'brand')
  tree_code String
  
  /// English/official display name for this category tree.
  tree_name String
  
  /// Business context for the category tree usage/role.
  description String?
  
  /// Tree creation timestamp.
  created_at DateTime
  
  /// Tree update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shopping_categories shopping_categories[]
  
  @@unique([tree_code])
  @@index([created_at])
}

/// One row per category node in any registered category tree. Supports
/// multi-level hierarchical structure via optional parent relationship. Used
/// only for classification and system-level grouping – never directly
/// coupled to transactions or business actors. Category code and tree ID
/// must be unique per tree.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged category tree's {@link shopping_category_trees.id} (required).
  category_tree_id String
  
  /// Parent category's {@link shopping_categories.id} (nullable for root).
  parent_id String?
  
  /// Unique code for this category node, lowercase, unique per tree (e.g.
  /// 'womens_dresses').
  category_code String
  
  /// Display name for this category node.
  category_name String
  
  /// Order among siblings for deterministic tree display.
  sort_order Int
  
  /// Optional category notes or usage documentation.
  description String?
  
  /// Category creation time.
  created_at DateTime
  
  /// Category update time.
  updated_at DateTime
  
  /// Category deletion (soft delete).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  categoryTree shopping_category_trees @relation(fields: [category_tree_id], references: [id], onDelete: Cascade)
  parent shopping_categories? @relation("recursive", fields: [parent_id], references: [id], onDelete: Cascade)
  
  recursive shopping_categories[] @relation("recursive")
  shopping_category_product_assignments shopping_category_product_assignments[]
  
  @@unique([category_tree_id, category_code])
  @@index([category_tree_id])
  @@index([parent_id])
}

/// System-wide append-only audit or operational logs. Used for tracking
/// system events, errors, administrative actions, migrations, or audit
/// trails. Not tied to user/business actor context. Full-text search enabled
/// for efficient diagnostics.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_system_logs {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Timestamp for when the log event was generated.
  event_time DateTime
  
  /// Severity or log level (e.g., 'info', 'warn', 'error', 'fatal').
  log_level String
  
  /// Type/category of log event (e.g., 'system_init', 'migration',
  /// 'admin_action').
  event_type String
  
  /// Origin/source of the event (module, subsystem, service name).
  event_source String
  
  /// Summary log message.
  message String
  
  /// Optional event details, stack trace, or contextual metadata (potentially
  /// JSON-encoded).
  details String?
  
  /// Log row creation time (for durability trace).
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  @@index([event_time])
  @@index([log_level])
  @@index([event_type])
}