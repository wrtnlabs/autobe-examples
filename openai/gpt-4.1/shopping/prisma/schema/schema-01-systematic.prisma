/// Platform-wide configuration entries managing system parameters, feature
/// flags, and constants.
///
/// Allows admin-only CRUD of key-value structured settings that control
/// feature toggles, global options, or business parameters for the entire
/// shopping mall backend. Heavily referenced by all modules, with audit and
/// soft deletion required for traceability.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_configurations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique configuration key name, used in service and API lookup.
  /// Recommended to namespace with prefixes by category or domain.
  config_key String
  
  /// String or JSON-serialized value. Raw storage; business logic interprets
  /// entry per config_key.
  config_value String
  
  /// Detailed explanation of the configuration's role and effect for admin
  /// reference.
  description String
  
  /// active, inactive, or deprecated—for admin gating and safe rollout/testing.
  status String
  
  /// Timestamp of row creation (audit trail).
  created_at DateTime
  
  /// Last mutation timestamp.
  updated_at DateTime
  
  /// Soft delete marker for removed/legacy entries.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  @@unique([config_key])
  @@index([status])
}

/// Product and navigation category taxonomy, supporting arbitrarily deep
/// nesting via self-referencing parent_id.
///
/// Each category row is used for user browsing, search filters, and system
/// reference. Parent categories have parent_id = null. Admins manage
/// category CRUD and soft delete for cross-domain stability.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Self-foreign key for category hierarchy—null for root categories.
  /// Cascades to build full tree structure.
  parent_id String?
  
  /// Unique category name, as seen in UIs and for API reference.
  name String
  
  /// Long-form description of purpose and coverage for admin/merchandiser
  /// context.
  description String
  
  /// Ordering for navigation and display; lower values first.
  sort_order Int
  
  /// active/inactive/deprecated for admin approval or programmatic use.
  status String
  
  /// Audit trail—creation moment.
  created_at DateTime
  
  /// Last admin/edit update.
  updated_at DateTime
  
  /// Soft delete for safe deactivation.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  parentCategory shopping_mall_categories? @relation("recursive", fields: [parent_id], references: [id], onDelete: Cascade)
  
  recursive shopping_mall_categories[] @relation("recursive")
  shopping_mall_products_categories shopping_mall_products_categories[]
  
  @@unique([name])
  @@index([parent_id, sort_order])
  @@index([status])
}

/// Registered external payment providers for all enabled checkout flows and
/// payment methods.
///
/// Defines all payment gateways/platforms (e.g., Stripe, Toss, PayPal)
/// integrated by admin and referenced in order/payment tables. Directly
/// managed by admins for status, audit, and usable methods in commerce
/// flows. CRUD enabled via admin tools; uses status and soft delete to
/// manage reconfiguration and deprecation safely. Uniquely keyed by
/// provider_name and provider_code.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_external_payment_providers {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Display name as shown in checkout UIs—unique for each provider.
  provider_name String
  
  /// System integration key/code—unique for backend mapping and API
  /// orchestration.
  provider_code String
  
  /// active/inactive/deprecated—controls available methods/platforms in UX.
  status String
  
  /// Legal/business context and integration notes for provider.
  description String
  
  /// Creation timestamp (for audit).
  created_at DateTime
  
  /// Last update (admin/edit context).
  updated_at DateTime
  
  /// Soft delete—row remains for historical audit/logging.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shopping_mall_payments shopping_mall_payments[]
  
  @@unique([provider_name])
  @@unique([provider_code])
  @@index([status])
}

/// Official platform registry for logistics/shipping partners in buyer and
/// seller flows.
///
/// All partners that can be used for order shipments, available for admin
/// CRUD and for use in shipment, order, or tracking-related tables via FKs.
/// Managed for status and audit; supports deprecation via soft delete but
/// keeps historical/inactive partners visible for audit and referencing
/// legacy data.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_shipping_partners {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Display name (UI/reference); unique.
  partner_name String
  
  /// Integration code for backend (system use); unique.
  partner_code String
  
  /// active/inactive/deprecated—admin only control.
  status String
  
  /// Business and operational info about the partner.
  description String
  
  /// Creation moment (audit).
  created_at DateTime
  
  /// Mutation/audit update time.
  updated_at DateTime
  
  /// Soft delete for legacy/decommissioned partners.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shopping_mall_order_shipments shopping_mall_order_shipments[]
  shopping_mall_shipments shopping_mall_shipments[]
  shopping_mall_return_requests shopping_mall_return_requests[]
  
  @@unique([partner_name])
  @@unique([partner_code])
  @@index([status])
}