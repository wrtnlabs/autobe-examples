/// Represents a single logical shipment process which may fulfill part or
/// all of a customer order. Contains courier allocation, main status, and
/// summary delivery data. Each shipment aggregates multiple packages and
/// references the originating order, allowing support for split shipments
/// and multi-carrier fulfillment. Business context: managed by admin or
/// warehouse ops; users/sellers view but do not edit. Relates to {@link
/// shopping_shipment_packages}.
///
/// @namespace Tracking
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_shipments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Originating order. {@link shopping_orders.id}.
  shopping_order_id String
  
  /// Owning seller/business for this shipment. {@link shopping_sellers.id}.
  shopping_seller_id String
  
  /// Unique shipment code for business/ops tracing (e.g. SHPT-2025-0001).
  code String
  
  /// Shipment lifecycle status (e.g. pending, packed, in_transit, delivered,
  /// canceled, returned).
  status String
  
  /// Allocated shipping/courier company (display name, e.g. FedEx, CJ대한통운).
  carrier_company String
  
  /// Specific courier service used (e.g. overnight/express/standard, if
  /// multi-option).
  carrier_service_type String?
  
  /// Planned dispatch/shipping datetime for warehouse logistics (nullable for
  /// ad-hoc).
  scheduled_dispatch_at DateTime?
  
  /// Actual shipment dispatch timestamp (for logistics/audit trail).
  dispatched_at DateTime?
  
  /// Final shipment delivered/courier scan timestamp (null until completed).
  delivered_at DateTime?
  
  /// If canceled, timestamp of shipment cancellation.
  canceled_at DateTime?
  
  /// Entity creation timestamp (UTC).
  created_at DateTime
  
  /// Entity last updated timestamp (UTC).
  updated_at DateTime
  
  /// Soft-delete timestamp; null unless deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  order shopping_orders @relation(fields: [shopping_order_id], references: [id], onDelete: Cascade)
  seller shopping_sellers @relation(fields: [shopping_seller_id], references: [id], onDelete: Cascade)
  
  shopping_shipment_packages shopping_shipment_packages[]
  
  @@unique([code])
  @@index([shopping_order_id, created_at])
  @@index([shopping_seller_id, status])
}

/// Physical package unit within a shipment. Each shipment may contain 1..n
/// packages, supporting split or consolidated packaging. Tracks package
/// dimensions, weight, carrier label, and fulfillment details. Used for
/// traceability, lost/damaged shipment handling, and external tracking
/// number assignment. Relates to {@link shopping_shipments} via shipment_id
/// and to {@link shopping_shipment_trackings}.
///
/// @namespace Tracking
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_shipment_packages {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent shipment this package belongs to. {@link shopping_shipments.id}.
  shopping_shipment_id String
  
  /// Sequence/order of the package within the parent shipment.
  sequence Int
  
  /// Carrier/warehouse-assigned package ID or label for internal ops.
  package_label String
  
  /// Courier-generated unique tracking number (external use).
  tracking_number String
  
  /// Weight in grams for carrier, shipping cost, and customs.
  package_weight_grams Float
  
  /// Length (cm) of package for shipper/courier specs.
  length_cm Float
  
  /// Width (cm) for fulfillment and shipper/courier specs.
  width_cm Float
  
  /// Height (cm) of package.
  height_cm Float
  
  /// Package status (e.g. pending, ready, shipped, in_transit, delivered,
  /// lost, damaged).
  status String
  
  /// If final, recorded delivery timestamp (external scan).
  delivered_at DateTime?
  
  /// If lost/undeliverable, recorded timestamp.
  lost_at DateTime?
  
  /// If carrier or warehouse logs as damaged during process, timestamp noted.
  damaged_at DateTime?
  
  /// Entity creation timestamp (UTC).
  created_at DateTime
  
  /// Last update UTC timestamp.
  updated_at DateTime
  
  /// Soft-delete timestamp, null unless deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shipment shopping_shipments @relation(fields: [shopping_shipment_id], references: [id], onDelete: Cascade)
  
  shopping_shipment_trackings shopping_shipment_trackings[]
  
  @@unique([tracking_number])
  @@unique([shopping_shipment_id, sequence])
  @@index([shopping_shipment_id, status])
}

/// Tracking instance for each package/courier. May exist for each
/// shipment_package if more than one carrier or external tracking source is
/// involved (e.g. handoff between domestic/international carriers). Used for
/// reconciliation of multiple tracking sources and complete audit trace.
/// Each is linked to a single package and may log API/scan info, last known
/// status, and expected/estimated delivery. Not managed directly by
/// end-users.
///
/// @namespace Tracking
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_shipment_trackings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent package this tracking instance is associated with. {@link
  /// shopping_shipment_packages.id}.
  shopping_shipment_package_id String
  
  /// Source of tracking data (e.g. courier_api, warehouse_scan,
  /// customer_report, manual); for logging provenance.
  tracking_source String
  
  /// Unique tracking reference provided by external carrier/courier API (if
  /// available).
  external_tracking_id String?
  
  /// Most recently reported status from this tracking instance (e.g.
  /// in_transit, delivered, delayed, exception, lost).
  status String
  
  /// Full text from latest tracking event/status message (raw message or
  /// system mapped).
  status_detail String?
  
  /// Timestamp of last update from carrier/API/scan or manual update.
  last_update_at DateTime
  
  /// Estimated delivery time, if provided by courier or computed by system.
  estimated_delivery_at DateTime?
  
  /// Row created UTC timestamp.
  created_at DateTime
  
  /// Last modification UTC timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  package shopping_shipment_packages @relation(fields: [shopping_shipment_package_id], references: [id], onDelete: Cascade)
  
  shopping_shipment_tracking_events shopping_shipment_tracking_events[]
  
  // spellchecker: ignore-next-line
  @@unique([shopping_shipment_package_id, tracking_source], map: "shopping_shipment_trackings_shopping_shipment_package__ca1464f1")
  @@index([tracking_source, last_update_at])
}

/// Immutable, append-only log of all significant tracking events for a
/// shipment package. Each event corresponds to a single timestamped scan,
/// status update, or tracker API callback—may include carrier codes,
/// location, raw event text, and associated URLs or external references.
/// Enables full audit trail and external integration troubleshooting.
/// Managed as an event log, not for direct CRUD except system ingestion.
///
/// @namespace Tracking
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_shipment_tracking_events {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Linked tracking instance (which is, in turn, linked to a package). {@link
  /// shopping_shipment_trackings.id}.
  shopping_shipment_tracking_id String
  
  /// Datetime of this tracking event (scan/callback/receipt/etc; not
  /// necessarily same as system ingested time).
  event_time DateTime
  
  /// Courier or platform event code (‘DELIVERED’, ‘IN_TRANSIT’,
  /// ‘OUT_FOR_DELIVERY’, etc), or custom code for system events.
  event_code String
  
  /// Event location (city, warehouse, or geo string); null if not supplied by
  /// source.
  location String?
  
  /// Raw status/description from external tracking event or API; full,
  /// unmapped text.
  raw_status String
  
  /// URL or reference provided by external tracker system (tracking link, scan
  /// ID, etc).
  external_ref String?
  
  /// UTC time when this event was ingested by the system (differs from
  /// event_time when delayed).
  ingested_at DateTime
  
  /// Row creation time (UTC).
  created_at DateTime
  
  /// Soft-delete flag/timestamp; event log is never hard-deleted, but
  /// deletions are tracked for audit.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  tracking shopping_shipment_trackings @relation(fields: [shopping_shipment_tracking_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([shopping_shipment_tracking_id, event_time, event_code], map: "shopping_shipment_tracking_events_shopping_shipment_tr_6be34b5a")
  // spellchecker: ignore-next-line
  @@index([shopping_shipment_tracking_id, event_time], map: "shopping_shipment_tracking_events_shopping_shipment_tr_ea96417f")
  @@index([event_code])
}