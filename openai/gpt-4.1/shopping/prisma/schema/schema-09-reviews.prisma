/// Main business entity representing a customer review for a specific SKU in
/// an order. Each review is uniquely associated with a customer, a SKU, and
/// an order line, ensuring eligibility rules are enforced. Review records
/// contain rating, text, and status/state fields. Key relationships: links
/// to customer, SKU, order line. Independent entity for full CRUD,
/// moderation, and audit tracking.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_reviews {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reviewer customer. {@link shopping_customers.id}
  shopping_customer_id String
  
  /// Reviewed SKU. {@link shopping_skus.id}
  shopping_sku_id String
  
  /// Order line this review corresponds to (enforces eligibility). {@link
  /// shopping_order_lines.id}
  shopping_order_line_id String
  
  /// Star rating value (1–5, required for aggregation)
  rating Int
  
  /// User review comment (10–2000 characters, required).
  comment String
  
  /// Current review state (visible, pending_moderation, removed, under_review,
  /// etc.). Business workflow uses values such as: 'visible', 'pending',
  /// 'removed', 'under_review'.
  state String
  
  /// Review creation timestamp.
  created_at DateTime
  
  /// Timestamp for most recent review modification.
  updated_at DateTime
  
  /// Soft delete marker for removed reviews (nullable).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_customers @relation(fields: [shopping_customer_id], references: [id], onDelete: Cascade)
  sku shopping_skus @relation(fields: [shopping_sku_id], references: [id], onDelete: Cascade)
  orderLine shopping_order_lines @relation(fields: [shopping_order_line_id], references: [id], onDelete: Cascade)
  
  shopping_review_attachments shopping_review_attachments[]
  shopping_review_moderations shopping_review_moderations[]
  shopping_review_abuse_reports shopping_review_abuse_reports[]
  
  @@unique([shopping_order_line_id])
  
  // spellchecker: ignore-next-line
  @@unique([shopping_customer_id, shopping_sku_id, shopping_order_line_id], map: "shopping_reviews_shopping_customer_id_shopping_sku_id__ce7fc611")
  @@index([shopping_sku_id, created_at])
  @@index([state])
}

/// Supporting entity for storing file, image, or video attachments belonging
/// to a single review. Attachment records reference reviews and store
/// metadata about the uploaded content. Managed only within the review API
/// context.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_review_attachments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent review. {@link shopping_reviews.id}
  shopping_review_id String
  
  /// Storage URI or URL for the attachment file.
  file_uri String
  
  /// Mime/media type of the attachment (e.g., image/png, video/mp4).
  file_type String
  
  /// Attachment file size in bytes.
  file_size Int
  
  /// Attachment creation timestamp.
  created_at DateTime
  
  /// Soft delete marker for the attachment (nullable).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  review shopping_reviews @relation(fields: [shopping_review_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_review_id, created_at])
}

/// Snapshot/audit trail entity recording all moderation or state transitions
/// for reviews. Each record logs an action (e.g., approved, removed,
/// restored), actor (admin), timestamp, and any rationale or comments.
/// Enables full moderation traceability.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_review_moderations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Target review. {@link shopping_reviews.id}
  shopping_review_id String
  
  /// Admin moderator who performed the action. {@link shopping_admins.id}
  moderator_admin_id String
  
  /// Type of moderation action (approved, removed, restored, flagged, edited,
  /// etc.).
  action String
  
  /// Moderator-provided reason or notes about the action taken.
  reason String?
  
  /// Timestamp this moderation action was performed.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  review shopping_reviews @relation(fields: [shopping_review_id], references: [id], onDelete: Cascade)
  moderatorAdmin shopping_admins @relation(fields: [moderator_admin_id], references: [id], onDelete: Cascade)
  
  @@index([moderator_admin_id])
  
  @@index([shopping_review_id, created_at])
}

/// Main entity for customer- or seller-initiated abuse reports against a
/// review. Independently created entity that logs the actor, review, type of
/// abuse, report comments, and audit timestamps. Enables report CRUD and
/// workflow review by admins.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_review_abuse_reports {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reported review. {@link shopping_reviews.id}
  shopping_review_id String
  
  /// Customer reporting the review. {@link shopping_customers.id}
  reporter_customer_id String
  
  /// Type/category of abuse reported (e.g., spam, hate_speech, off_topic,
  /// etc.).
  report_type String
  
  /// Optional textual explanation or evidence for the report.
  comment String?
  
  /// Abuse report state (open, processed, dismissed, etc.).
  state String
  
  /// Report creation timestamp.
  created_at DateTime
  
  /// Most recent report modification timestamp.
  updated_at DateTime
  
  /// Soft delete, null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  review shopping_reviews @relation(fields: [shopping_review_id], references: [id], onDelete: Cascade)
  reporterCustomer shopping_customers @relation(fields: [reporter_customer_id], references: [id], onDelete: Cascade)
  
  @@index([reporter_customer_id])
  
  @@index([shopping_review_id, created_at])
  @@index([state])
}

/// Materialized view table that stores denormalized pre-aggregated rating
/// and review statistics for each SKU and its parent product. Optimizes
/// product and SKU listing queries for average rating and review count. Not
/// directly modifiable by users.
///
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_review_rating_aggregates {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Target SKU. {@link shopping_skus.id}
  shopping_sku_id String
  
  /// Parent product for the SKU (for aggregate at product level). {@link
  /// shopping_products.id}
  shopping_product_id String
  
  /// Total number of reviews for this SKU.
  review_count Int
  
  /// Average star rating for this SKU (precalculated, one decimal precision).
  average_rating Float
  
  /// Total reviews for the parent product (aggregated from all SKUs).
  product_review_count Int
  
  /// Average rating for the product overall (across SKUs).
  product_average_rating Float
  
  /// Aggregation refresh timestamp for cache invalidation/business needs.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  sku shopping_skus @relation(fields: [shopping_sku_id], references: [id], onDelete: Cascade)
  product shopping_products @relation(fields: [shopping_product_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_product_id])
  
  @@unique([shopping_sku_id])
}