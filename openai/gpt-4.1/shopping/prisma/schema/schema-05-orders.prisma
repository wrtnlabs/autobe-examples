  /// New status after transition.
  to_status String
  
  /// Optional business or workflow comment entered by the actor or system.
  comment String?
  
  /// Timestamp of this status transition.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  adminActor shopping_mall_admins? @relation(fields: [actor_admin_id], references: [id], onDelete: Cascade)
  sellerActor shopping_mall_sellers? @relation(fields: [actor_seller_id], references: [id], onDelete: Cascade)
  customerActor shopping_mall_customers? @relation(fields: [actor_customer_id], references: [id], onDelete: Cascade)
  
  @@index([actor_admin_id])
  @@index([actor_seller_id])
  @@index([actor_customer_id])
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_order_id, created_at], map: "shopping_mall_order_status_histories_shopping_mall_ord_8dd665db")
}

