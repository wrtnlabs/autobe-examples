/// Represents the primary order entity for all purchases made on the platform.
///
/// Captures the high-level details of each order submitted by a customer,
/// including references to the customer placing the order, the shipping
/// address, and relevant payment and seller information. Orders serve as the
/// anchor for all associated items, shipments, status changes, and audit
/// logs. Multiple items and shipments may be related to one order,
/// reflecting multi-SKU, multi-seller, and split-shipment scenarios. This
/// model is independently managed and forms the primary lifecycle entity for
/// all order operations. All temporal fields support robust audit trails and
/// soft deletion as needed.
///
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_orders {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// References the purchasing customer. {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// The delivery address for this order. {@link shopping_mall_addresses.id}.
  shopping_mall_address_id String
  
  /// Main seller responsible for this order (single-seller context). {@link
  /// shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Platform-unique business order number, used for external references and
  /// customer support. Example: ORD202500001.
  order_number String
  
  /// Current platform order status: e.g., pending, paid, cancelled, shipped,
  /// delivered, refunded.
  status String
  
  /// Final order total amount including all items, taxes, shipping, and
  /// discounts if any.
  total_amount Float
  
  /// Currency code (ISO 4217). E.g., USD, KRW.
  currency String
  
  /// Order creation timestamp.
  created_at DateTime
  
  /// Last update timestamp for this order.
  updated_at DateTime
  
  /// Soft deletion timestamp; null if order is active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  address shopping_mall_addresses @relation(fields: [shopping_mall_address_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  
  shopping_mall_order_items shopping_mall_order_items[]
  shopping_mall_order_shipments shopping_mall_order_shipments[]
  shopping_mall_order_status_histories shopping_mall_order_status_histories[]
  shopping_mall_order_audit_logs shopping_mall_order_audit_logs[]
  shopping_mall_reviews shopping_mall_reviews[]
  shopping_mall_product_ratings shopping_mall_product_ratings[]
  shopping_mall_refund_requests shopping_mall_refund_requests[]
  shopping_mall_shipments shopping_mall_shipments[]
  shopping_mall_return_requests shopping_mall_return_requests[]
  
  @@index([shopping_mall_address_id])
  
  @@unique([order_number])
  @@index([shopping_mall_customer_id, created_at])
  @@index([status])
  @@index([shopping_mall_seller_id])
}

/// Stores the breakdown of each order into per-SKU, per-product items.
///
/// Each record represents a unique product/SKU that is part of a given
/// order, allowing complete normalization of order contents for inventory,
/// fulfillment, analytics, and post-order processing. This model enables
/// accurate tracking of quantities, price per SKU, refunds at item level,
/// and inventory movements. Items are grouped under their parent order but
/// retain individual references for fulfillment and shipment attachment.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_order_items {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Parent order to which this item belongs. {@link shopping_mall_orders.id}.
  shopping_mall_order_id String
  
  /// The ordered product. {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// The specific SKU (variant) purchased. {@link
  /// shopping_mall_product_skus.id}.
  shopping_mall_product_sku_id String
  
  /// Number of units of this SKU ordered.
  quantity Int
  
  /// Unit price at time of order for this SKU (discounts included, if any).
  unit_price Float
  
  /// Subtotal before order-level adjustments for this item (quantity ×
  /// unit_price).
  subtotal Float
  
  /// Currency code (ISO 4217). E.g., USD, KRW.
  currency String
  
  /// True if this item has been marked as delivered in fulfillment tracking.
  delivered Boolean
  
  /// True if this item has been refunded through returns/workflow.
  refunded Boolean
  
  /// Order item creation timestamp.
  created_at DateTime
  
  /// Order item last update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp; null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  sku shopping_mall_product_skus @relation(fields: [shopping_mall_product_sku_id], references: [id], onDelete: Cascade)
  
  shopping_mall_reviews shopping_mall_reviews[]
  shopping_mall_product_ratings shopping_mall_product_ratings[]
  shopping_mall_shipments shopping_mall_shipments[]
  shopping_mall_return_requests shopping_mall_return_requests[]
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_order_id, shopping_mall_product_sku_id], map: "shopping_mall_order_items_shopping_mall_order_id_shopp_2b0619a8")
  @@index([shopping_mall_product_id])
  @@index([shopping_mall_order_id])
  @@index([shopping_mall_product_sku_id])
}

/// Represents a shipment or fulfillment batch associated with one or more
/// items in an order.
///
/// Tracks the logistics information for each discrete shipment
/// event—supporting split orders, multi-package delivery, and real-time
/// tracking for both customers and sellers. Shipments reference the order,
/// designated shipping partner, external tracking information, shipped and
/// expected delivery dates, and status. This table enables precise
/// management of complex fulfillment and last-mile delivery workflows.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_order_shipments {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Order associated with this shipment. {@link shopping_mall_orders.id}.
  shopping_mall_order_id String
  
  /// Linked shipping partner. {@link shopping_mall_shipping_partners.id}.
  shopping_mall_shipping_partner_id String
  
  /// Shipping partner/tracking-provided unique tracking number for this
  /// shipment.
  tracking_number String
  
  /// Shipment status: e.g., pending, shipped, in_transit, delivered, returned.
  status String
  
  /// Date the shipment was handed to logistics partner; null if not yet
  /// shipped.
  ship_date DateTime?
  
  /// Expected or promised delivery date; may be null if unknown.
  expected_delivery_date DateTime?
  
  /// Timestamp of confirmed arrival; null if not delivered.
  delivered_at DateTime?
  
  /// Shipment creation timestamp.
  created_at DateTime
  
  /// Last update timestamp for this shipment.
  updated_at DateTime
  
  /// Soft deletion timestamp; null if shipment is active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  shippingPartner shopping_mall_shipping_partners @relation(fields: [shopping_mall_shipping_partner_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_shipping_partner_id], map: "shopping_mall_order_shipments_shopping_mall_shipping_p_ea2228a8")
  
  @@unique([tracking_number])
  @@index([shopping_mall_order_id])
  @@index([ship_date])
}

/// Historical log of all order status transitions and major business state
