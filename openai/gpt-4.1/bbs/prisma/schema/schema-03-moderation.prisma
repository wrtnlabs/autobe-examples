/// User-submitted abuse or inappropriate content report records. Each record
/// logs the reporting user, targeted content (article or comment), category
/// of abuse, detailed reason/explanation, current status (e.g., pending,
/// closed, rejected), and all required timestamps. Provides the basis for
/// administrative moderation workflow and compliance audits. Links only by
/// reference to users and content IDs—no content duplication.
///
/// @namespace Moderation
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_abuse_reports {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reporter user's {@link discussion_board_users.id}. Identifies the user
  /// who submitted the abuse report.
  reporter_user_id String
  
  /// Targeted article's {@link discussion_board_articles.id}. The article
  /// alleged for abuse, or null if the report concerns a comment only.
  target_article_id String?
  
  /// Targeted comment's {@link discussion_board_article_comments.id}. The
  /// comment alleged for abuse, or null if the report concerns an article
  /// only.
  target_comment_id String?
  
  /// Type/category of alleged abuse. Examples: 'spam', 'offensive',
  /// 'harassment', 'illegal', etc. Used for admin triage and reporting.
  abuse_category String
  
  /// Detailed explanation/reason for the report as written by the reporter.
  /// Used for admin context and audit. Full-text search enabled for this
  /// field.
  reason String
  
  /// Current report status. Examples: 'pending', 'in_review', 'closed',
  /// 'rejected'. Workflow state for moderation lifecycle.
  status String
  
  /// Timestamp of report submission. Used for triage order and audit trace.
  created_at DateTime
  
  /// Timestamp of last status update. Used for tracking processing progress.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  reporterUser discussion_board_users @relation(fields: [reporter_user_id], references: [id], onDelete: Cascade)
  targetArticle discussion_board_articles? @relation(fields: [target_article_id], references: [id], onDelete: Cascade)
  targetComment discussion_board_article_comments? @relation(fields: [target_comment_id], references: [id], onDelete: Cascade)
  
  discussion_board_moderation_actions discussion_board_moderation_actions[]
  
  @@index([target_article_id])
  @@index([target_comment_id])
  
  @@index([reporter_user_id, status])
  @@index([abuse_category])
  @@index([created_at])
}

/// Administrative moderation actions including edits, hides, and deletions.
/// Each record logs the moderated object (article or comment), the
/// responsible admin, the action performed, the reason/justification (full
/// text), affected content, timestamps, and references to original report if
/// applicable. Used for compliance and regulatory trace. Immutable after
/// creation except for audit notes.
///
/// @namespace Moderation
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_moderation_actions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Admin's {@link discussion_board_admins.id}. Identifies the administrator
  /// performing the moderation action.
  admin_id String
  
  /// Targeted article's {@link discussion_board_articles.id}. The article
  /// being moderated, or null if moderation concerns a comment only.
  target_article_id String?
  
  /// Targeted comment's {@link discussion_board_article_comments.id}. The
  /// comment being moderated, or null if moderation concerns an article only.
  target_comment_id String?
  
  /// Reference to abuse report {@link discussion_board_abuse_reports.id} if
  /// this action is in response to a prior user report. Null if direct
  /// moderation by admin.
  abuse_report_id String?
  
  /// Type of moderation action: 'edit', 'delete', 'hide', 'warn', etc.
  /// Business workflow enumeration.
  action_type String
  
  /// Full text of reason or justification for action (sysadmin/audit context).
  action_reason String
  
  /// Reference/summary of what data was affected by this action. May include a
  /// content hash, file reference, or summary string for audit trace.
  affected_data_ref String
  
  /// Timestamp of moderation action creation. Used for compliance trace and
  /// historical ordering.
  created_at DateTime
  
  /// Timestamp of last update or audit annotation.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  admin discussion_board_admins @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  targetArticle discussion_board_articles? @relation(fields: [target_article_id], references: [id], onDelete: Cascade)
  targetComment discussion_board_article_comments? @relation(fields: [target_comment_id], references: [id], onDelete: Cascade)
  abuseReport discussion_board_abuse_reports? @relation(fields: [abuse_report_id], references: [id], onDelete: Cascade)
  
  discussion_board_audit_logs discussion_board_audit_logs[]
  
  @@index([target_article_id])
  @@index([target_comment_id])
  @@index([abuse_report_id])
  
  @@index([admin_id, action_type])
  @@index([created_at])
}

/// Append-only compliance/audit trail for all critical moderation actions.
/// Immutable snapshot of moderation events for regulatory and incident
/// review. Stores actor/admin, referenced object, action type, event
/// details, and audit metadata. Not directly modifiable except by compliance
/// staff in regulatory recovery. Retains complete historical record for all
/// audits.
///
/// @namespace Moderation
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_audit_logs {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Admin's {@link discussion_board_admins.id}. Admin responsible for the
  /// action/event being audited.
  actor_admin_id String
  
  /// Target article {@link discussion_board_articles.id} if the audit event
  /// references an article, else null.
  target_article_id String?
  
  /// Target comment {@link discussion_board_article_comments.id} if the audit
  /// event references a comment, else null.
  target_comment_id String?
  
  /// Moderation action {@link discussion_board_moderation_actions.id} that
  /// this audit event corresponds to. Used for cross-traceability and
  /// integrity.
  moderation_action_id String
  
  /// Type of audit event (e.g., 'moderation_performed', 'compliance_override',
  /// 'manual_restore', etc.).
  audit_event_type String
  
  /// Free-text audit log detail or justification. May include policy
  /// references or case numbers.
  audit_details String
  
  /// Timestamp of audit event creation.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  actorAdmin discussion_board_admins @relation(fields: [actor_admin_id], references: [id], onDelete: Cascade)
  targetArticle discussion_board_articles? @relation(fields: [target_article_id], references: [id], onDelete: Cascade)
  targetComment discussion_board_article_comments? @relation(fields: [target_comment_id], references: [id], onDelete: Cascade)
  moderationAction discussion_board_moderation_actions @relation(fields: [moderation_action_id], references: [id], onDelete: Cascade)
  
  @@index([target_article_id])
  @@index([target_comment_id])
  @@index([moderation_action_id])
  
  @@index([actor_admin_id, audit_event_type])
  @@index([created_at])
}