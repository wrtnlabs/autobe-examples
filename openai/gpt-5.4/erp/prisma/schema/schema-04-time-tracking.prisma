  /// Timestamp when the submitted timesheet was approved or rejected.
  reviewed_at DateTime?
  
  /// Reason provided when a submitted timesheet is rejected. It must be
  /// present only for rejected workflow outcomes.
  rejection_reason String?
  
  /// Timestamp when this timesheet record was created.
  created_at DateTime
  
  /// Timestamp when this timesheet record was last updated.
  updated_at DateTime
  
