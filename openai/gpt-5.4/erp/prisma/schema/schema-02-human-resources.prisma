}

/// Organization-scoped role definitions used to classify employee authority
/// within a single tenant organization.
///
/// This table stores both built-in roles and custom roles for {@link
/// hrm_time_tracking_organizations}. It provides the canonical role identity
/// assigned to workforce records in {@link hrm_time_tracking_employees},
/// while the normalized permission set for each role is stored separately in
/// the existing {@link hrm_time_tracking_role_permissions} table. Built-in
/// roles distinguish platform-defined roles such as Owner, Manager, and
/// Employee from organization-defined custom roles.
///
/// @namespace HumanResources
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrm_time_tracking_roles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged organization's {@link hrm_time_tracking_organizations.id}.
  hrm_time_tracking_organization_id String
  
  /// Display name of the role within the organization, such as Owner, Manager,
  /// Employee, or a custom role name.
  name String
  
  /// Whether the role is a platform-provided built-in role rather than an
  /// organization-defined custom role.
  built_in Boolean
  
  /// When the role record was created.
  created_at DateTime
  
  /// When the role record was last updated.
  updated_at DateTime
  
  /// When the role record was soft deleted, if applicable.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  organization hrm_time_tracking_organizations @relation(fields: [hrm_time_tracking_organization_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  organizationInvitations hrm_time_tracking_organization_invitations[]
  permissions hrm_time_tracking_role_permissions[]
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([hrm_time_tracking_organization_id, name], map: "hrm_time_tracking_roles_hrm_time_tracking_organization_2bcab36d")
  // spellchecker: ignore-next-line
  @@index([hrm_time_tracking_organization_id, built_in], map: "hrm_time_tracking_roles_hrm_time_tracking_organization_32916cf8")
}

