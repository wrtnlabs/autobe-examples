/// Organization tenant records for the multi-tenant HRM and time-tracking
/// platform.
///
/// This table stores the core organization identity and settings used as the
/// parent scope for workforce administration, projects, time tracking,
/// reporting, and other organization-isolated business data. Each record
/// represents one independently operated tenant with its own operational
/// preferences such as display information, currency, timezone, and fiscal
/// calendar configuration.
///
/// Other organization-scoped tables reference this model as their parent
/// context, including {@link hrm_time_tracking_organization_invitations},
/// {@link hrm_time_tracking_roles}, {@link hrm_time_tracking_departments},
/// {@link hrm_time_tracking_employees}, {@link hrm_time_tracking_projects},
/// {@link hrm_time_tracking_timelogs}, and {@link
/// hrm_time_tracking_timesheets}. The table intentionally stores only atomic
/// tenant settings and avoids denormalized workflow or aggregate data.
///
/// @namespace HumanResources
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrm_time_tracking_organizations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Organization name shown throughout the workspace and used to identify the
  /// tenant to its members.
  name String
  
  /// Optional summary describing the organization's purpose, business context,
  /// or internal notes for presentation.
  description String?
  
  /// Optional URI of the organization's logo image used in workspace branding
  /// and visual identification.
  logo_uri String?
  
  /// Default currency code used by the organization for financial values and
  /// compensation display, such as USD, EUR, or KRW.
  currency_code String
  
  /// IANA timezone identifier that defines the organization's local operating
  /// time context, such as Asia/Seoul.
  timezone String
  
  /// Month number from 1 to 12 indicating when the organization's fiscal year
  /// starts.
  fiscal_start_month Int
  
  /// When the organization record was created.
  created_at DateTime
  
  /// When the organization record was last updated.
  updated_at DateTime
  
  /// When the organization was soft deleted. Null means the organization is
  /// active.
  deleted_at DateTime?
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  ownerSessions hrm_time_tracking_owner_sessions[]
  employeeSessions hrm_time_tracking_employee_sessions[]
  organizationInvitations hrm_time_tracking_organization_invitations[]
  roles hrm_time_tracking_roles[]
  departments hrm_time_tracking_departments[]
  projects hrm_time_tracking_projects[]
  timers hrm_time_tracking_timers[]
  timelogs hrm_time_tracking_timelogs[]
  timesheets hrm_time_tracking_timesheets[]
  activityLogs hrm_time_tracking_activity_logs[]
  reports hrm_time_tracking_reports[]
  weeklySummaries hrm_time_tracking_organization_weekly_summaries[]
  projectBudgetAlerts hrm_time_tracking_project_budget_alerts[]
  
  //----
  // INDEXES
  //----
  @@index([deleted_at])
}

/// Organization-scoped invitation records used to add an existing or future
/// user to an organization membership flow.
///
/// Each record represents one invitation sent to an email address for a
/// specific organization and optionally preselects the role that should be
/// assigned when the invitation is accepted. The table preserves invitation
/// lifecycle state such as pending, accepted, expired, or cancelled without
/// denormalizing organization or role data.
///
/// This model belongs to {@link hrm_time_tracking_organizations} and may
/// reference {@link hrm_time_tracking_roles} for the intended
/// organization-scoped role. It supports administrative invitation lists,
/// onboarding reconciliation by email, and audit-friendly lifecycle
/// timestamps.
///
/// @namespace HumanResources
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrm_time_tracking_organization_invitations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Target organization's {@link hrm_time_tracking_organizations.id}.
  hrm_time_tracking_organization_id String
  
  /// Intended organization role's {@link hrm_time_tracking_roles.id} to assign
  /// when the invitation is accepted.
  hrm_time_tracking_role_id String?
  
  /// Invitee email address used to match an existing account or a future
  /// signup.
  email String
  
  /// Invitation lifecycle status such as pending, accepted, expired, or
  /// cancelled.
  status String
  
  /// Optional invitation message or note shown to the invited person.
  message String?
  
  /// Timestamp when the invitation was issued to the email address.
  invited_at DateTime
  
  /// Timestamp when the invited user accepted the invitation.
  accepted_at DateTime?
  
  /// Timestamp when the invitation was resolved into a completed organization
  /// membership outcome.
  resolved_at DateTime?
  
  /// Timestamp when the invitation expires or was marked expired.
  expired_at DateTime?
  
  /// Timestamp when the invitation was cancelled by an administrator.
  cancelled_at DateTime?
  
  /// Timestamp when this record was created.
  created_at DateTime
  
  /// Timestamp when this record was last updated.
  updated_at DateTime
  
  /// Timestamp for soft deletion of this invitation record.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  organization hrm_time_tracking_organizations @relation(fields: [hrm_time_tracking_organization_id], references: [id], onDelete: Cascade)
  role hrm_time_tracking_roles? @relation(fields: [hrm_time_tracking_role_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([hrm_time_tracking_role_id], map: "hrm_time_tracking_organization_invitations_hrm_time_tr_0ab7922a")
  // spellchecker: ignore-next-line
