/// identity.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_members {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique email address used as the member's sign-in identity.
  email String
  
  /// Hashed password credential used to authenticate the member account.
  password_hash String
  
  /// Whether the member's email ownership has been verified for the account.
  email_verified Boolean
  
  /// When the member account was created.
  created_at DateTime
  
  /// When the member account was last updated.
  updated_at DateTime
  
  /// When the member account was soft-deleted, if applicable.
