/// Customer-facing profile data for a registered customer account.
///
/// This table stores the single active profile record associated with a
/// {@link shopping_mall_customers} account, separating editable presentation
/// data from authentication credentials. It contains the customer's display
/// name and phone number used in customer-facing account management.
///
/// The profile is modeled as a dependent one-to-one entity so the actor
/// table remains focused on identity and login concerns. Profile lifecycle
/// is isolated from order history and shipping snapshots, allowing customer
/// profile data to be deleted or soft-deleted without affecting preserved
/// transactional records.
///
/// @namespace Customer
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_customer_profiles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Owning customer account's {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Customer-facing display name shown in the account profile.
  display_name String
  
  /// Customer contact phone number stored in the profile.
  phone_number String
  
  /// When this profile record was created.
  created_at DateTime
  
  /// When this profile record was last updated.
  updated_at DateTime
  
  /// When this profile record was soft-deleted after customer account
  /// lifecycle actions.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@unique([shopping_mall_customer_id])
}

/// Saved shipping address book entries owned by individual customers.
