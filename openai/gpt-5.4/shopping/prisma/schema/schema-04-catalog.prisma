/// Seller-owned product listings that define the current sellable catalog
/// record for marketplace browsing and purchase preparation.
///
/// Each product stores the seller-controlled merchandise identity, current
/// category assignment, current base price, and lifecycle status used to
/// determine listing visibility and operational availability. The product is
/// the parent record for {@link shopping_mall_product_images}, {@link
/// shopping_mall_product_variants}, and {@link
/// shopping_mall_product_snapshots}, while search result enrichments such as
/// rating averages or price ranges are intentionally derived outside this
/// table to preserve normalization.
///
/// @namespace Catalog
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Owner seller account's {@link shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Current assigned category's {@link shopping_mall_categories.id}. Nullable
  /// when the product becomes uncategorized after category deletion.
  shopping_mall_category_id String?
  
  /// Current product name shown in catalog listings and detail pages.
  name String
  
  /// Current seller-provided product description shown on the detail page.
  description String
  
  /// Current base merchandise price before any variant-level price override is
  /// applied.
  base_price Float
  
  /// Current product lifecycle and listing state such as active, hidden, or
  /// deleted, used to enforce search visibility and purchase availability
  /// policies.
  status String
  
  /// When the product listing was first created.
  created_at DateTime
  
  /// When the current product record was last updated.
  updated_at DateTime
  
  /// When the product was soft-deleted from active listings while preserving
  /// historical references.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  category shopping_mall_categories? @relation(fields: [shopping_mall_category_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  images shopping_mall_product_images[]
  variants shopping_mall_product_variants[]
  snapshots shopping_mall_product_snapshots[]
  wishlistEntries shopping_mall_wishlist_entries[]
  cartItems shopping_mall_cart_items[]
  purchaseSnapshots shopping_mall_product_purchase_snapshots[]
  reviews shopping_mall_reviews[]
  
  //----
  // INDEXES
  //----
  @@index([shopping_mall_seller_id, created_at])
  @@index([shopping_mall_category_id, created_at])
}

