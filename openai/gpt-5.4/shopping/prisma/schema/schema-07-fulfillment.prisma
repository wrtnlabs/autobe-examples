/// Seller fulfillment packages that group one or more purchased order items
/// from the same seller within a single order for shipping and delivery.
///
/// Each shipment belongs to one {@link shopping_mall_orders} record and one
/// responsible {@link shopping_mall_sellers} record. Order items reference
/// the shipment from the order domain, allowing multiple same-seller items
/// to share one package without storing repeating item lists on the shipment
/// itself.
///
/// This table stores only shipment-level lifecycle facts such as when the
/// package was shipped, when it is expected to auto-transition to delivered
/// if the customer does not confirm receipt, and when delivery was
/// confirmed. Carrier and tracking identifiers are intentionally separated
/// into {@link shopping_mall_tracking_infos} as a dependent 1:1 entity to
/// keep the model normalized.
///
/// @namespace Fulfillment
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_shipments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The purchased order grouped by this shipment. {@link
  /// shopping_mall_orders.id}.
  shopping_mall_order_id String
  
  /// The seller responsible for fulfilling this shipment. {@link
  /// shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Timestamp when the seller created the shipment and the included order
  /// items became shipped.
  shipped_at DateTime
  
  /// Timestamp when this shipment was treated as delivered, either by customer
  /// confirmation or automatic completion after the waiting period.
  delivered_at DateTime?
  
  /// Timestamp when the shipment should automatically transition to delivered
  /// if the customer does not confirm receipt earlier.
  auto_deliver_at DateTime
  
  /// Timestamp when this shipment record was created.
  created_at DateTime
  
  /// Timestamp when this shipment record was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp for administrative removal without losing
  /// historical shipment references.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  orderItems shopping_mall_order_items[]
  trackingInfo shopping_mall_tracking_infos?
  
  //----
  // INDEXES
  //----
  @@index([shopping_mall_seller_id, shipped_at])
  @@index([shopping_mall_order_id, created_at])
  @@index([auto_deliver_at, delivered_at])
}

/// Carrier and tracking identifier details attached to a shipment.
///
/// This table stores the shipment-level transit reference data entered when
/// a seller creates a package for one or more order items. Customers and the
/// responsible seller use this information to monitor package transit for a
/// specific {@link shopping_mall_shipments} record.
///
/// The model is intentionally separated from {@link shopping_mall_shipments}
/// to preserve proper one-to-one dependent-entity normalization. It stores
/// only carrier-specific tracking data and does not duplicate seller, order,
/// or order-item attributes that are already available through the shipment
/// relationship.
///
/// @namespace Fulfillment
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_tracking_infos {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Tracked shipment's {@link shopping_mall_shipments.id}.
  shopping_mall_shipment_id String
  
  /// Name of the shipping carrier responsible for transporting the shipment.
  carrier_name String
  
  /// Carrier-issued tracking identifier used to trace the shipment in transit.
  tracking_number String
  
  /// Direct carrier tracking page URL for customer and seller transit lookup
  /// when available.
  tracking_url String?
  
  /// When this tracking information record was created.
  created_at DateTime
  
  /// When this tracking information record was last updated.
  updated_at DateTime
  
  /// When this tracking information record was soft deleted, if it has been
  /// removed from active use.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  shipment shopping_mall_shipments @relation(fields: [shopping_mall_shipment_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@unique([shopping_mall_shipment_id])
  @@unique([carrier_name, tracking_number])
}