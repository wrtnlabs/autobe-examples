/// exists separately from authentication credentials so profile data can be
/// managed without exposing login information, and it is linked one-to-one
/// with {@link todo_app_members} through a unique ownership relationship.
///
/// @namespace UserProfile
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_user_profiles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Owning member account for this private profile. References {@link
  /// todo_app_members.id}.
  todo_app_member_id String
  
  /// Private display name shown within the application for the owning member.
  display_name String
  
  /// When this profile record was created.
  created_at DateTime
  
  /// When this profile record was last updated.
  updated_at DateTime
  
  /// When this profile record was soft deleted. Null when active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  member todo_app_members @relation(fields: [todo_app_member_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@unique([todo_app_member_id])
}