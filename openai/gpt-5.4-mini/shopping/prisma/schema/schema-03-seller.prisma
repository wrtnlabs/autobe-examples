/// Merchant account record used for seller sign-in, approval tracking, and
/// seller account lifecycle management.
///
/// This table stores the seller's login identity and platform-controlled
/// lifecycle state, including approval outcome, suspension, and deletion
/// status. It is the owner table for the seller account boundary and
/// supports seller access control while related shop presentation data is
/// maintained in {@link mall_platform_seller_profiles}.
///
/// @namespace Seller
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model mall_platform_seller_accounts {
  //----
  // COLUMNS
  //----
  /// Primary key for the seller account.
  id String @id
  
  /// Unique email address used for seller login identity.
  email String
  
  /// Hashed password used for seller authentication.
  password_hash String
  
  /// Current seller approval state such as pending, approved, or rejected.
  approval_status String
  
  /// Reason provided when a seller approval request is rejected.
  rejection_reason String?
  
  /// Timestamp when the seller account was suspended, if applicable.
  suspended_at DateTime?
  
  /// Timestamp when the seller account was soft-deleted, if applicable.
  deleted_at DateTime?
  
  /// Timestamp when the seller account record was created.
  created_at DateTime
  
  /// Timestamp when the seller account record was last updated.
  updated_at DateTime
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  passwordResets mall_platform_seller_password_resets[]
  sellerProfile mall_platform_seller_profiles?
  products mall_platform_products[]
  
  //----
  // INDEXES
  //----
  @@unique([email])
  @@index([approval_status, created_at])
  @@index([suspended_at])
  @@index([deleted_at])
}

/// Public shop profile information for one seller account, including the
/// shop name, shop description, and logo image reference shown to customers.
///
/// This table stores only the live profile state owned by {@link
/// mall_platform_seller_accounts}. Historical edits are preserved in the
/// separate seller profile snapshot table owned by another component, so
/// this model remains focused on the current public-facing profile record.
///
/// @namespace Seller
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model mall_platform_seller_profiles {
  //----
  // COLUMNS
  //----
  /// Primary key for the seller profile record.
  id String @id
  
  /// Owner seller account's {@link mall_platform_seller_accounts.id}.
  seller_account_id String
  
  /// Public shop name displayed to customers.
  shop_name String
  
  /// Public shop description displayed on the seller profile page.
  shop_description String
  
  /// URI of the current shop logo image shown to customers.
  logo_image_uri String?
  
  /// Timestamp when the seller profile record was created.
  created_at DateTime
  
  /// Timestamp when the seller profile record was last updated.
  updated_at DateTime
  
  /// Timestamp when the seller profile record was soft deleted, if applicable.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  sellerAccount mall_platform_seller_accounts @relation(fields: [seller_account_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  sellerProfileSnapshots mall_platform_seller_profile_snapshots[]
  
  //----
  // INDEXES
  //----
  @@unique([seller_account_id])
}