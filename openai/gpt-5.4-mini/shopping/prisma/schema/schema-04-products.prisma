/// Canonical sellable product records for the marketplace catalog, including
/// seller ownership, category assignment, product identity, description, and
/// base pricing for browsing and search.
///
/// This table represents the root product entity only. Product images,
/// product variants, inventory history, and snapshots are managed in
/// separate tables owned by other components, so this model stores only the
/// product-level references needed for catalog operations and historical
/// reconstruction through related entities.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model mall_platform_products {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Seller's {@link mall_platform_seller_accounts.id}.
  seller_account_id String
  
  /// Category's {@link mall_platform_categories.id}.
  category_id String?
  
  /// Product display name used in listings and detail pages.
  name String
  
  /// Product description shown to customers on the detail page.
  description String
  
  /// Product base price used when variants do not override pricing and for
  /// catalog price presentation.
  base_price Float
  
  /// Timestamp when the product was created.
  created_at DateTime
  
  /// Timestamp when the product was last updated.
  updated_at DateTime
  
  /// Timestamp when the product was soft-deleted; null when active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  sellerAccount mall_platform_seller_accounts @relation(fields: [seller_account_id], references: [id], onDelete: Cascade)
  category mall_platform_categories? @relation(fields: [category_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  images mall_platform_product_images[]
  variants mall_platform_product_variants[]
  productImageSnapshots mall_platform_product_image_snapshots[]
  variantSnapshots mall_platform_product_variant_snapshots[]
  wishlistItems mall_platform_wishlist_items[]
  reviews mall_platform_reviews[]
  snapshots mall_platform_product_snapshots[]
  
  //----
  // INDEXES
  //----
  @@index([seller_account_id, created_at])
  @@index([category_id, created_at])
  @@index([created_at])
  @@index([base_price])
}