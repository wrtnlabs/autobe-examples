/// Stores the current active customer review for a purchased product. Each
/// review belongs to one customer account and one purchased order item, and
/// it is displayed on the product detail page while preserving only the live
/// review state in this table.
///
/// The table keeps the active rating, optional written content, and deletion
/// state for customer-authored feedback. Historical edits and moderation
/// history are preserved in {@link mall_platform_review_snapshots}, which is
/// managed separately.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model mall_platform_reviews {
  //----
  // COLUMNS
  //----
  /// Primary key for the review record.
  id String @id
  
  /// Customer account's {@link mall_platform_customers.id}.
  customer_id String
  
  /// Purchased order item's {@link mall_platform_order_items.id}.
  order_item_id String
  
  /// Reviewed product's {@link mall_platform_products.id}.
  product_id String
  
  /// Star rating from 1 to 5 inclusive.
  rating Int
  
  /// Optional written review text provided by the customer.
  content String?
  
  /// Timestamp when the review was created.
  created_at DateTime
  
  /// Timestamp when the review was last updated.
  updated_at DateTime
  
  /// Timestamp when the review was soft-deleted; null while active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer mall_platform_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  orderItem mall_platform_order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  product mall_platform_products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots mall_platform_review_snapshots[]
  
  //----
  // INDEXES
  //----
  @@unique([order_item_id])
  @@index([product_id, created_at])
  @@index([customer_id, created_at])
}

/// Immutable point-in-time snapshots of customer reviews for audit, edit
/// history, deletion preservation, and dispute resolution. Each row captures
/// the review state as it existed when a change occurred, including the
/// review content, rating, and moderation state, while preserving the
/// relationship to the source {@link mall_platform_reviews} and the owning
/// {@link mall_platform_customers}.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model mall_platform_review_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary key for the review snapshot record.
  id String @id
  
  /// Source review's {@link mall_platform_reviews.id}.
  mall_platform_review_id String
  
  /// Owning customer's {@link mall_platform_customers.id}.
  mall_platform_customer_id String
  
  /// Reason this snapshot was created, such as edit, deletion, or moderation
  /// change.
  snapshot_action String
  
  /// Preserved star rating at the time of the snapshot.
  rating Int
  
  /// Preserved review text content at the time of the snapshot.
  content String?
  
  /// Whether the source review was marked deleted at the time of the snapshot.
  is_deleted Boolean
  
  /// Timestamp when this immutable snapshot record was created.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  review mall_platform_reviews @relation(fields: [mall_platform_review_id], references: [id], onDelete: Cascade)
  customer mall_platform_customers @relation(fields: [mall_platform_customer_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([mall_platform_customer_id])
  // spellchecker: ignore-next-line
  @@unique([mall_platform_review_id, created_at], map: "mall_platform_review_snapshots_mall_platform_review_id_36de5aaf")
}