/// Customer-owned shopping cart header that groups cart lines and stores
/// checkout-preparation state for one customer account. The cart contains
/// only header-level ownership and lifecycle data; individual selected
/// variants, quantities, and line calculations are stored in {@link
/// mall_platform_cart_items}.
///
/// This table supports the active cart experience before checkout, including
/// one-cart-per-customer integrity and lifecycle tracking across updates and
/// soft deletion.
///
/// @namespace Carts
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model mall_platform_shopping_carts {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer account's {@link mall_platform_customers.id}.
  mall_platform_customer_id String
  
  /// When the cart record was created.
  created_at DateTime
  
  /// When the cart record was last updated.
  updated_at DateTime
  
  /// When the cart was soft-deleted, if applicable.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer mall_platform_customers @relation(fields: [mall_platform_customer_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  cartItems mall_platform_cart_items[]
  
  //----
  // INDEXES
  //----
  @@unique([mall_platform_customer_id])
  @@index([created_at])
}

/// Stores one selected product variant line inside a customer shopping cart.
///
