  availability_state String
  
  /// Timestamp when the cart item was created.
  created_at DateTime
  
  /// Timestamp when the cart item was last updated.
  updated_at DateTime
  
  /// Timestamp when the cart item was soft deleted, if applicable.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
