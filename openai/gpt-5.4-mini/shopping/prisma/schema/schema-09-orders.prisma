/// Stores one checkout result per customer, including the overall order
/// identity, status, totals, and preserved shipping destination for the
/// purchase.
///
/// This table represents the order header created after successful checkout.
/// It preserves the customer-owned purchase record and the shipping
/// destination that was selected at purchase time so historical orders
/// remain readable even if the customer later edits or deletes addresses.
/// Item-level purchase details, shipments, and snapshots are maintained in
/// their own component tables.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model mall_platform_orders {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer's {@link mall_platform_customers.id}.
  customer_id String
  
  /// Human-readable order number shown to the customer and support staff.
  order_number String
  
  /// Derived overall order status for history and browsing, such as paid,
  /// shipped, delivered, cancelled, refunded, or partially completed.
  status String
  
  /// Total order amount at the time of checkout, including all purchased items.
  total_amount Float
  
  /// Preserved shipping recipient name captured at checkout.
  recipient_name String
  
  /// Preserved shipping recipient phone number captured at checkout.
  recipient_phone String
  
  /// Preserved street address used for shipment destination.
  street_address String
  
  /// Preserved city used for shipment destination.
  city String
  
  /// Preserved state or province used for shipment destination.
  state_province String
  
  /// Preserved postal code used for shipment destination.
  postal_code String
  
  /// Preserved country used for shipment destination.
  country String
  
  /// Timestamp when the order was created.
  created_at DateTime
  
  /// Timestamp when the order was last updated.
  updated_at DateTime
  
  /// Soft-delete timestamp for retained historical order visibility, when
  /// applicable.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer mall_platform_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  orderItems mall_platform_order_items[]
  shipments mall_platform_shipments[]
  
  //----
  // INDEXES
  //----
  @@unique([order_number])
  @@index([customer_id, created_at])
  @@index([customer_id, status, created_at])
}

