/// Stores each customer review for a purchased product and order item.
///
/// The table keeps the active review record with its rating, optional text
/// content, and visibility state for soft deletion. It is linked to the
/// customer who wrote the review, the purchased product, and the
/// corresponding order item so review eligibility and ownership can be
/// validated without storing redundant product or seller data. Historical
/// edits and deleted-state history are preserved in {@link
/// shopping_mall_review_snapshots}, while this table represents the current
/// review state used for product detail pages, moderation, and newest-first
/// review listing.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_reviews {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Authoring customer's {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Reviewed product's {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Purchased order item's {@link shopping_mall_order_items.id} that
  /// qualified the review.
  shopping_mall_order_item_id String
  
  /// Star rating from 1 to 5 given by the customer.
  rating Int
  
  /// Optional review body written by the customer.
  content String?
  
  /// Timestamp when the review was created.
  created_at DateTime
  
  /// Timestamp when the review was last updated.
  updated_at DateTime
  
  /// Timestamp when the review was soft deleted, if it has been removed from
  /// active display.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  orderItem shopping_mall_order_items @relation(fields: [shopping_mall_order_item_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots shopping_mall_review_snapshots[]
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_order_item_id, shopping_mall_product_id, shopping_mall_customer_id], map: "shopping_mall_reviews_shopping_mall_order_item_id_shop_a234c08b")
  @@index([shopping_mall_product_id, created_at])
  @@index([shopping_mall_customer_id, created_at])
  @@index([shopping_mall_order_item_id])
}

/// Immutable historical snapshots of customer reviews. Each record preserves
/// the state of a review at a specific moment so edits and deletions can be
/// audited, moderated, and displayed for dispute resolution even after the
/// active review changes.
///
/// This table belongs to {@link shopping_mall_reviews} as append-only
/// history and must never be used as the live review record. It stores the
/// review content and metadata that can change over time, while the current
/// review state remains in the parent review table.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_review_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Historical snapshot of {@link shopping_mall_reviews.id}.
  review_id String
  
  /// Snapshot of the review star rating at the time this version was recorded.
  rating Int
  
  /// Snapshot of the review text content at the time this version was recorded.
  content String?
  
  /// Whether the review was marked deleted at the time this snapshot was
  /// created.
  is_deleted Boolean
  
  /// Timestamp when this snapshot record was created.
  created_at DateTime
  
  /// Timestamp when this snapshot record was logically deleted, if applicable.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  review shopping_mall_reviews @relation(fields: [review_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([review_id, created_at])
}