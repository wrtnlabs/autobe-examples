/// Seller-specific delivery packages that group one or more order items from
/// the same seller and store the shared carrier and tracking information for
/// those items.
///
/// A shipment represents a fulfillment unit created during delivery
/// processing. It keeps the shipping metadata at the package level, while
/// item membership is stored in the separate shipment-item junction table.
/// This design supports shared tracking, package-level delivery
/// confirmation, and history preservation for dispute resolution.
///
/// @namespace Shipping
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model mall_platform_shipments {
  //----
  // COLUMNS
  //----
  /// Primary key.
  id String @id
  
  /// Seller's {@link mall_platform_sellers.id}.
  mall_platform_seller_id String
  
  /// Order's {@link mall_platform_orders.id}.
  mall_platform_order_id String
  
  /// Shipping carrier name used for this shipment.
  carrier_name String
  
  /// Carrier tracking number for the shipment.
  tracking_number String
  
  /// Optional carrier tracking URL for customer visibility.
  tracking_url String?
  
  /// Current shipment status such as preparing, shipped, delivered, or
  /// cancelled.
  status String
  
  /// Timestamp when the shipment was handed to the carrier.
  shipped_at DateTime?
  
  /// Timestamp when the shipment was confirmed delivered.
  delivered_at DateTime?
  
  /// Timestamp when the shipment record was created.
  created_at DateTime
  
  /// Timestamp when the shipment record was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp for shipment records that are logically removed.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  seller mall_platform_sellers @relation(fields: [mall_platform_seller_id], references: [id], onDelete: Cascade)
  order mall_platform_orders @relation(fields: [mall_platform_order_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  shipmentItems mall_platform_shipment_items[]
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([tracking_number, mall_platform_seller_id], map: "mall_platform_shipments_tracking_number_mall_platform__6a3a4545")
  @@index([mall_platform_order_id, created_at])
  @@index([mall_platform_seller_id, created_at])
  @@index([status, created_at])
}

