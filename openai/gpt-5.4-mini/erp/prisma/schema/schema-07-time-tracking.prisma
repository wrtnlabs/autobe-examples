  /// Logged duration in minutes.
  duration_minutes Int
  
  /// Free-text description of the work performed.
  description String?
  
  /// Indicates whether the logged time is billable.
  billable Boolean
  
  /// Timestamp when the timelog was created.
  created_at DateTime
  
  /// Timestamp when the timelog was last updated.
  updated_at DateTime
  
  /// Timestamp when the timelog was soft deleted, if applicable.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
