/// Stores the currently running work session for an employee in the
/// time-tracking workflow. The record captures the live timer context,
/// including when it started and which project and optional task it is
/// attached to, until the timer is stopped or discarded. This table is
/// lifecycle-bound to the timer flow and supports the rule that an employee
/// can have at most one active timer at a time.
///
/// @namespace TimeTracking
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model erp_hrm_time_timers {
  //----
  // COLUMNS
  //----
  /// Primary key for the live timer session.
  id String @id
  
  /// The authenticated member account's {@link erp_hrm_time_members.id}.
  member_id String
  
  /// The organization-scoped employee's {@link erp_hrm_time_employees.id}.
  employee_id String
  
  /// The selected project's {@link erp_hrm_time_projects.id}.
  project_id String
  
  /// The optional task's {@link erp_hrm_time_tasks.id} when the timer is
  /// started or edited.
  task_id String?
  
  /// Timestamp when the timer started running.
  started_at DateTime
  
  /// Optional free-text note describing the work being performed while the
  /// timer runs.
  description String?
  
  /// Timestamp when this timer record was created.
  created_at DateTime
  
  /// Timestamp when this timer record was last updated.
  updated_at DateTime
  
  /// Timestamp when this timer record was soft deleted or discarded, if
  /// applicable.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  member erp_hrm_time_members @relation(fields: [member_id], references: [id], onDelete: Cascade)
  employee erp_hrm_time_employees @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  project erp_hrm_time_projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
  task erp_hrm_time_tasks? @relation(fields: [task_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@unique([employee_id])
  @@index([member_id, created_at])
  @@index([employee_id, created_at])
  @@index([project_id, created_at])
  @@index([task_id, created_at])
}

/// Weekly employee timesheets that collect timelogs and store submission and
