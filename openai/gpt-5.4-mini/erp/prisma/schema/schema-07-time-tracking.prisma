  //----
  // COLUMNS
  //----
  /// Primary key of the timelog record.
  id String @id
  
  /// Employee {@link erp_hrm_time_members.id} who owns and created the timelog.
  erp_hrm_time_member_id String
  
  /// Project {@link erp_hrm_time_projects.id} that the logged time belongs to.
  erp_hrm_time_project_id String
  
  /// Optional task {@link erp_hrm_time_tasks.id} associated with the logged
  /// time.
  erp_hrm_time_task_id String?
  
  /// Calendar date of the work that was logged.
