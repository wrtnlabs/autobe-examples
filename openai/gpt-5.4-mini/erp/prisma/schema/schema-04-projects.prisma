/// Projects owned by an organization, including status, schedule, budget,
/// and display metadata used for browsing and lifecycle management.
///
/// A project is the core work container for delivery planning inside one
/// organization. It stores the project identity, visual presentation,
/// lifecycle state, and schedule/budget metadata while keeping employee
/// assignment in the separate {@link hrm_time_tracking_project_memberships}
/// table.
///
/// The table enforces tenant isolation through the organization reference
/// and supports project browsing, filtering, and lifecycle operations such
/// as active, archived, and completed states. Deletion is soft by default
/// through deleted_at, while hard deletion rules are enforced by application
/// logic when related time entries still exist.
///
/// @namespace Projects
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrm_time_tracking_projects {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Organization that owns this project. References {@link
  /// hrm_time_tracking_organizations.id}.
  organization_id String
  
  /// Human-readable project name shown in lists and detail views.
  name String
  
  /// Optional project summary or scope notes.
  description String?
  
  /// Required display color used to visually identify the project in UI lists,
  /// calendars, and dashboards.
  color_code String
  
  /// Current lifecycle state of the project. Expected values are active,
  /// archived, and completed.
  status String
  
  /// Optional planned budget in hours used for progress and capacity reporting.
  budget_hours Float?
  
  /// Optional project start date used for scheduling and timeline views.
  start_date DateTime?
  
  /// Optional project end date used for scheduling and completion tracking.
  end_date DateTime?
  
  /// Timestamp when the project was created.
  created_at DateTime
  
  /// Timestamp when the project was last updated.
  updated_at DateTime
  
  /// Timestamp when the project was soft deleted. Null while active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  organization hrm_time_tracking_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  memberships hrm_time_tracking_project_memberships[]
  tasks hrm_time_tracking_tasks[]
  timelogs hrm_time_tracking_timelogs[]
  timerSessions hrm_time_tracking_timer_sessions[]
  
  //----
  // INDEXES
  //----
  @@unique([organization_id, name])
  @@index([organization_id, status])
  @@index([organization_id, created_at])
  @@index([organization_id, start_date])
  @@index([organization_id, end_date])
}

/// Employee-to-project assignment records that connect one employee to one
/// project and indicate whether the member is a regular participant or a
/// project lead.
///
/// This table is the normalized junction between {@link
/// hrm_time_tracking_employees} and {@link hrm_time_tracking_projects}. It
/// supports assigning an employee to multiple projects while preserving a
/// single membership row per project-employee pair. The membership role is
/// stored here because it depends on the specific project relationship, not
/// on the employee or project alone.
///
/// @namespace Projects
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrm_time_tracking_project_memberships {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Project that this membership belongs to. References {@link
  /// hrm_time_tracking_projects.id}.
  hrm_time_tracking_project_id String
  
  /// Employee assigned to the project. References {@link
  /// hrm_time_tracking_employees.id}.
  hrm_time_tracking_employee_id String
  
  /// Whether this employee has project-lead authority within the project
  /// membership.
  is_project_lead Boolean
  
  /// Timestamp when the membership record was created.
  created_at DateTime
  
  /// Timestamp when the membership record was last updated.
  updated_at DateTime
  
  /// Timestamp when the membership was soft-deleted, if it has been removed.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  project hrm_time_tracking_projects @relation(fields: [hrm_time_tracking_project_id], references: [id], onDelete: Cascade)
  employee hrm_time_tracking_employees @relation(fields: [hrm_time_tracking_employee_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([hrm_time_tracking_project_id, hrm_time_tracking_employee_id], map: "hrm_time_tracking_project_memberships_hrm_time_trackin_35667796")
  // spellchecker: ignore-next-line
  @@index([hrm_time_tracking_project_id, is_project_lead], map: "hrm_time_tracking_project_memberships_hrm_time_trackin_d3fb5d8d")
  // spellchecker: ignore-next-line
  @@index([hrm_time_tracking_employee_id, created_at], map: "hrm_time_tracking_project_memberships_hrm_time_trackin_f7f8c42b")
}

/// Work items that belong to a project and track delivery progress within
/// the project execution workflow.
///
/// This table stores the current state of each task, including its project
/// ownership, optional assignee, one-level parent hierarchy, status,
/// priority, estimate, and due date. Task status transitions are audited in
/// {@link hrm_time_tracking_task_histories}, while this table remains the
/// authoritative source for the task's present state.
///
/// @namespace Projects
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrm_time_tracking_tasks {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Owning project's {@link hrm_time_tracking_projects.id}. Every task
  /// belongs to exactly one project and inherits organization isolation
  /// through that project.
  hrm_time_tracking_project_id String
  
  /// Assigned employee's {@link hrm_time_tracking_employees.id}. The assignee
  /// must be a member of the same project, and this assignment is optional.
  hrm_time_tracking_employee_id String?
  
  /// Parent task's {@link hrm_time_tracking_tasks.id}. Used for one-level task
  /// nesting only; deeper recursive hierarchies are not permitted.
  parent_id String?
  
  /// Task title used for identification in project lists and task boards.
  title String
  
  /// Detailed task description and execution notes.
  description String?
  
  /// Current task workflow state such as open, in-progress, completed, or
  /// closed.
  status String
  
  /// Task urgency level used for scheduling and prioritization.
  priority String
  
  /// Estimated effort in hours for planning and workload forecasting.
  estimated_hours Float?
  
  /// Planned deadline for completing the task.
  due_date DateTime?
  
  /// Timestamp when the task record was created.
  created_at DateTime
  
  /// Timestamp when the task record was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp. A value indicates the task has been
  /// archived/deleted without physically removing history.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  project hrm_time_tracking_projects @relation(fields: [hrm_time_tracking_project_id], references: [id], onDelete: Cascade)
  assignee hrm_time_tracking_employees? @relation(fields: [hrm_time_tracking_employee_id], references: [id], onDelete: Cascade)
  parent hrm_time_tracking_tasks? @relation("recursive", fields: [parent_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  children hrm_time_tracking_tasks[] @relation("recursive")
  statusHistories hrm_time_tracking_task_histories[]
  timelogs hrm_time_tracking_timelogs[]
  timerSessions hrm_time_tracking_timer_sessions[]
  
  //----
  // INDEXES
  //----
  @@index([hrm_time_tracking_employee_id])
  @@index([parent_id])
  @@index([hrm_time_tracking_project_id, status])
  // spellchecker: ignore-next-line
  @@index([hrm_time_tracking_project_id, priority], map: "hrm_time_tracking_tasks_hrm_time_tracking_project_id_p_83649141")
  // spellchecker: ignore-next-line
  @@index([hrm_time_tracking_project_id, hrm_time_tracking_employee_id], map: "hrm_time_tracking_tasks_hrm_time_tracking_project_id_h_78cf01a4")
  // spellchecker: ignore-next-line
  @@index([hrm_time_tracking_project_id, parent_id], map: "hrm_time_tracking_tasks_hrm_time_tracking_project_id_p_7af2ae87")
  // spellchecker: ignore-next-line
  @@index([hrm_time_tracking_project_id, due_date], map: "hrm_time_tracking_tasks_hrm_time_tracking_project_id_d_3eaed1ad")
  @@index([created_at])
}

/// Immutable audit records that capture each change in a task's status.
///
/// Each row stores the task that changed, the previous status, the new
/// status, the moment the change occurred, and the member who performed the
/// change. This table preserves task state history for traceability,
/// reporting, and audit review and is intended to be append-only.
///
/// @namespace Projects
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrm_time_tracking_task_histories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The task whose status changed. {@link hrm_time_tracking_tasks.id}.
  hrm_time_tracking_task_id String
  
  /// The member who performed the status change. {@link
  /// hrm_time_tracking_members.id}.
  hrm_time_tracking_member_id String
  
  /// The task status before the change was applied.
  from_status String
  
  /// The task status after the change was applied.
  to_status String
  
  /// The exact timestamp when the status transition occurred.
  changed_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  task hrm_time_tracking_tasks @relation(fields: [hrm_time_tracking_task_id], references: [id], onDelete: Cascade)
  member hrm_time_tracking_members @relation(fields: [hrm_time_tracking_member_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([hrm_time_tracking_task_id, changed_at], map: "hrm_time_tracking_task_histories_hrm_time_tracking_tas_b5b58c20")
  // spellchecker: ignore-next-line
  @@index([hrm_time_tracking_member_id, changed_at], map: "hrm_time_tracking_task_histories_hrm_time_tracking_mem_708232af")
  @@index([to_status, changed_at])
}