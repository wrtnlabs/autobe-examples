  /// Belonged todo for which this snapshot captures the point-in-time state
  /// {@link todo_app_todos.id}.
  todo_app_todo_id String
  
  /// Todo title as it was at the time this snapshot was created.
  title String
  
  /// Optional todo description as it was at the time this snapshot was created.
  description String?
  
  /// Optional planned start date of the todo captured in this snapshot.
  start_date DateTime?
  
  /// Optional due date of the todo captured in this snapshot.
  due_date DateTime?
  
  /// Todo completion status captured in this snapshot (represents whether the
  /// todo was completed or not at that time).
  completion_status String
  
  /// Whether the todo was in the deleted/trash lifecycle state at the time
  /// this snapshot was taken.
  lifecycle_deleted Boolean
  
  /// Snapshot creation timestamp.
  created_at DateTime
  
  /// Snapshot last update timestamp (typically unchanged after creation).
  updated_at DateTime
  
  /// Soft delete timestamp for the snapshot record when it is removed from
  /// active history.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  todo todo_app_todos @relation(fields: [todo_app_todo_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([todo_app_todo_id, created_at])
}