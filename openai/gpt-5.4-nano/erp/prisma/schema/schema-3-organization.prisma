/// Stores each organization (tenant) identity and its configuration settings.
///
/// An organization is the tenant boundary for all HR and time tracking data.
/// This table holds the core organization profile used for onboarding,
/// context switching, and interpreting business time-related fields such as
/// timezone and fiscal/calendar framing.
///
/// It is the root parent of organization-scoped entities like employees,
/// departments, projects, timelogs, and reports in other components via
/// foreign keys.
///
/// @namespace Organization
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model erp_hrm_time_tracking_organizations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Human-friendly organization name shown in the application tenant context.
  name String
  
  /// Brief description of the organization for internal/contextual display
  /// purposes.
  description String
  
  /// Optional logo image URL for branding in the organization context selector.
  logo_url String?
  
  /// Currency code used for the organization’s financial framing (e.g., for
  /// payroll-related calculations or monetary displays).
  currency_code String
  
  /// IANA timezone identifier used to interpret date/time values within this
  /// organization (e.g., Asia/Seoul).
  timezone String
  
  /// The month number (1-12) that the organization uses as the start of its
  /// fiscal period.
  fiscal_start_month Int
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp. Null means the organization is active.
  deleted_at DateTime?
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  departments erp_hrm_time_tracking_departments[]
  contracts erp_hrm_time_tracking_contracts[]
  contractSnapshots erp_hrm_time_tracking_contract_snapshots[]
  projects erp_hrm_time_tracking_projects[]
  timelogs erp_hrm_time_tracking_timelogs[]
  timesheets erp_hrm_time_tracking_timesheets[]
  timerSessions erp_hrm_time_tracking_timer_sessions[]
  activityLogEntries erp_hrm_time_tracking_activity_log_entries[]
  activityLogEntrySnapshots erp_hrm_time_tracking_activity_log_entry_snapshots[]
  reportDefinitions erp_hrm_time_tracking_report_definitions[]
  
  //----
  // INDEXES
  //----
  @@unique([name])
  @@index([timezone, currency_code])
}

