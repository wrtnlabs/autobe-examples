/// Discussion board posts (articles) authored by users. Contains the title,
/// body, and lifecycle status with publication and edit timestamps. Each
/// post is created by a {@link civic_board_users} actor. Optionally links to
/// the authoring {@link civic_board_user_sessions} for audit context without
/// risking content deletion when sessions expire (nullable +
/// onDelete:SetNull). Comments ({@link civic_board_comments}) and
/// attachments ({@link civic_board_post_attachments}) reference this entity.
/// Visibility and moderation operate via status (Published/Hidden/Deleted)
/// and administrative records in {@link civic_board_moderation_actions}.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model civic_board_posts {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Author user's {@link civic_board_users.id}.
  civic_board_user_id String
  
  /// Authoring session's {@link civic_board_user_sessions.id}. Nullable and
  /// set null on session deletion to preserve content.
  civic_board_user_session_id String?
  
  /// Post title. Business limits: 1–120 characters, trimmed, non-whitespace.
  title String
  
  /// Post body text. Business limits: 1–20,000 characters, plain text with
  /// line breaks allowed.
  body String
  
  /// Lifecycle status of the post. Expected values: "Published", "Hidden", or
  /// "Deleted". Used to control visibility and commenting eligibility.
  status String
  
  /// Publication timestamp recorded when the post becomes publicly visible
  /// (Published).
  published_at DateTime
  
  /// Last content edit timestamp within the allowed edit window; null if never
  /// edited.
  edited_at DateTime?
  
  /// Creation timestamp (auditable).
  created_at DateTime
  
  /// Last update timestamp for this record (auditable).
  updated_at DateTime
  
  /// Soft deletion timestamp. Null when active; set when Deleted to support
  /// retention/purge policies.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  author civic_board_users @relation(fields: [civic_board_user_id], references: [id], onDelete: Cascade)
  authorSession civic_board_user_sessions? @relation(fields: [civic_board_user_session_id], references: [id], onDelete: Cascade)
  
  civic_board_post_attachments civic_board_post_attachments[]
  civic_board_comments civic_board_comments[]
  civic_board_report_of_posts civic_board_report_of_posts[]
  civic_board_post_reactions civic_board_post_reactions[]
  
  @@index([status, published_at])
  @@index([civic_board_user_id, created_at])
  @@index([civic_board_user_session_id, created_at])
  @@index([created_at])
}

/// File attachments associated with posts. Attachments inherit visibility
/// rules from their parent {@link civic_board_posts}. Each row stores
/// immutable file metadata and storage URI. Only posts (not comments) can
/// have attachments. Uploaded by a user through a session for auditability.
/// Session link is nullable and set null on deletion to avoid unintended
/// content loss.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model civic_board_post_attachments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent post's {@link civic_board_posts.id}.
  civic_board_post_id String
  
  /// Uploader user's {@link civic_board_users.id}.
  civic_board_user_id String
  
  /// Uploader session's {@link civic_board_user_sessions.id}. Nullable and set
  /// null on session deletion to preserve the attachment record.
  civic_board_user_session_id String?
  
  /// Storage URI pointing to the attached file object.
  uri String
  
  /// User-facing original filename after sanitization; used for display and
  /// duplicate prevention per post.
  original_filename String
  
  /// MIME type detected/accepted (e.g., image/jpeg, image/png, image/gif,
  /// application/pdf).
  content_type String
  
  /// File size in bytes; used to enforce per-file and per-post total limits in
  /// application logic.
  byte_size Int
  
  /// Image width in pixels if the attachment is an image; null for non-image
  /// types.
  image_width Int?
  
  /// Image height in pixels if the attachment is an image; null for non-image
  /// types.
  image_height Int?
  
  /// Attachment creation timestamp.
  created_at DateTime
  
  /// Attachment last update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp for retention/purge handling.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  post civic_board_posts @relation(fields: [civic_board_post_id], references: [id], onDelete: Cascade)
  uploader civic_board_users @relation(fields: [civic_board_user_id], references: [id], onDelete: Cascade)
  uploaderSession civic_board_user_sessions? @relation(fields: [civic_board_user_session_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([civic_board_post_id, original_filename], map: "civic_board_post_attachments_civic_board_post_id_origi_62f65da8")
  @@index([civic_board_post_id, created_at])
  // spellchecker: ignore-next-line
  @@index([content_type, civic_board_post_id], map: "civic_board_post_attachments_content_type_civic_board__e5372723")
  @@index([civic_board_user_id, created_at])
  // spellchecker: ignore-next-line
  @@index([civic_board_user_session_id, created_at], map: "civic_board_post_attachments_civic_board_user_session__67e7f3cb")
}

/// Plain-text comments on posts. Each comment belongs to a {@link
/// civic_board_posts} and is authored by a {@link civic_board_users}.
/// Optionally links the {@link civic_board_user_sessions} for audit context
/// without risking content deletion (nullable + onDelete:SetNull). Lifecycle
/// status governs visibility and moderation (Published/Hidden/Deleted).
/// Comments are listed oldest-first under a post and support cross-post
/// queries by author.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model civic_board_comments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Target post's {@link civic_board_posts.id}.
  civic_board_post_id String
  
  /// Author user's {@link civic_board_users.id}.
  civic_board_user_id String
  
  /// Authoring session's {@link civic_board_user_sessions.id}. Nullable and
  /// set null on session deletion to preserve the comment.
  civic_board_user_session_id String?
  
  /// Comment body text. Business limits: 1–2,000 characters (minimal scope);
  /// text-only (no attachments).
  body String
  
  /// Lifecycle status of the comment. Expected values: "Published", "Hidden",
  /// or "Deleted".
  status String
  
  /// Timestamp when the comment became publicly visible (Published).
  published_at DateTime
  
  /// Last edit timestamp within the 15-minute window; null if never edited.
  edited_at DateTime?
  
  /// Creation timestamp (auditable).
  created_at DateTime
  
  /// Last update timestamp for this record (auditable).
  updated_at DateTime
  
  /// Soft deletion timestamp for retention/purge policies.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  post civic_board_posts @relation(fields: [civic_board_post_id], references: [id], onDelete: Cascade)
  author civic_board_users @relation(fields: [civic_board_user_id], references: [id], onDelete: Cascade)
  authorSession civic_board_user_sessions? @relation(fields: [civic_board_user_session_id], references: [id], onDelete: Cascade)
  
  civic_board_report_of_comments civic_board_report_of_comments[]
  civic_board_comment_reactions civic_board_comment_reactions[]
  
  @@index([civic_board_post_id, created_at])
  @@index([civic_board_user_id, created_at])
  @@index([civic_board_user_session_id, created_at])
  @@index([status, created_at])
}