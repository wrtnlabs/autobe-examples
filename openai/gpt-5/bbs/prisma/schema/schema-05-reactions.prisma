/// Administrative policy controlling whether reactions are enabled and under
/// what constraints. This table allows feature toggling and guardrails such
/// as self-like prohibition and per-user rate limits. It is managed
/// independently by admins and referenced by application logic at runtime.
/// Does not denormalize any computed counters. Related entities: users
/// {@link civic_board_users} for ownership context if needed; targets are
/// {@link civic_board_posts} and {@link civic_board_comments}.
///
/// @namespace Reactions
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model civic_board_reaction_policies {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Human-readable policy code identifier (e.g., "default"). Used to select
  /// the active configuration.
  code String
  
  /// Whether reactions feature is globally enabled.
  enabled Boolean
  
  /// Whether reactions are permitted on posts.
  allow_on_posts Boolean
  
  /// Whether reactions are permitted on comments.
  allow_on_comments Boolean
  
  /// Whether self-like is permitted. Should remain false to satisfy product
  /// rules.
  allow_self_like Boolean
  
  /// Optional cap on the number of reactions a single user may add per
  /// calendar day. NULL means unlimited per this policy.
  max_reactions_per_user_per_day Int?
  
  /// Creation timestamp of this policy row.
  created_at DateTime
  
  /// Last update timestamp of this policy row.
  updated_at DateTime
  
  /// Soft deletion timestamp for deprecated or replaced policies. NULL means
  /// active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  @@unique([code])
  @@index([created_at])
}