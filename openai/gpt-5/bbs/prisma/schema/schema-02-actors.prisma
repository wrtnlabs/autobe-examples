  civic_board_password_reset_token_of_users civic_board_password_reset_token_of_users[]
  civic_board_posts civic_board_posts[]
  civic_board_post_attachments civic_board_post_attachments[]
  civic_board_comments civic_board_comments[]
  civic_board_report_of_posts civic_board_report_of_posts[]
  civic_board_report_of_comments civic_board_report_of_comments[]
  civic_board_post_reactions civic_board_post_reactions[]
  civic_board_comment_reactions civic_board_comment_reactions[]
  
  @@unique([email])
  @@index([created_at])
}

