/// Authenticating user accounts for the minimal todo service. Each user owns
/// personal todos in {@link todo_todos} (defined in another component).
/// Stores the unique login identifier and the password hash required for
/// authentication. Sessions are tracked in {@link todo_user_sessions}.
/// Business rules: unique email per user; account deletion is hard delete in
/// MVP; timestamps support ordering and audit expectations.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_users {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique login identifier for the user in email format. Used for
  /// authentication and account recovery flows (future).
  email String
  
  /// Secure password hash (never the plaintext password). Required for login
  /// verification.
  password_hash String
  
  /// Timestamp when the user account was created.
  created_at DateTime
  
  /// Timestamp when the user account was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  todo_audit_events todo_audit_events[]
  todo_user_sessions todo_user_sessions[]
  todo_todos todo_todos[]
  
  @@unique([email])
  @@index([created_at])
}

/// Authentication sessions established after successful login for {@link
/// todo_users}. Captures connection context (IP, URL, referrer), creation
/// time, and optional expiration. Managed exclusively by authentication
/// flows; supports many sessions per user. Composite index on (todo_user_id,
/// created_at) optimizes recent-session lookups.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_user_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Owning user’s {@link todo_users.id}.
  todo_user_id String
  
  /// IP address of the client establishing the session.
  ip String
  
  /// The request URL at session establishment.
  href String
  
  /// The referrer URL at session establishment.
  referrer String
  
  /// Session creation time.
  created_at DateTime
  
  /// Session end/invalidated time. Null means the session is currently active
  /// or expiry not yet recorded.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  user todo_users @relation(fields: [todo_user_id], references: [id], onDelete: Cascade)
  
  todo_audit_events todo_audit_events[]
  
  @@index([todo_user_id, created_at])
}