/// Core inventory tracking at the product variant level (SKU) with
/// multi-warehouse support. Tracks available stock quantities, reserved
/// amounts, and inventory status across warehouse locations while
/// maintaining real-time stock availability for the shopping mall platform.
///
/// @namespace Inventory
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_inventory_levels {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Variant's {@link shopping_mall_product_variants.id}.
  shopping_mall_product_variant_id String
  
  /// Warehouse's {@link shopping_mall_warehouses.id}.
  shopping_mall_warehouse_id String
  
  /// Number of units available for sale after accounting for reservations.
  available_quantity Int
  
  /// Number of units currently reserved in active shopping carts.
  reserved_quantity Int
  
  /// Threshold quantity that triggers low stock alerts.
  minimum_stock_level Int
  
  /// Maximum storage capacity for this variant in this warehouse. Used for
  /// warehouse planning and space optimization.
  maximum_stock_level Int?
  
  /// Inventory level at which automatic reorder should be triggered. Helps
  /// prevent stockouts through proactive replenishment.
  reorder_point Int?
  
  /// Timestamp of the last physical inventory count. Used for cycle counting
  /// and inventory accuracy management.
  last_counted_at DateTime?
  
  /// Current stock status: 'in_stock', 'low_stock', 'out_of_stock'.
  /// Automatically calculated based on available quantity relative to minimum
  /// stock level.
  stock_status String
  
  /// Record creation timestamp for audit trail.
  created_at DateTime
  
  /// Last update timestamp for inventory changes.
  updated_at DateTime
  
  /// Soft deletion timestamp. Used to handle warehouse closures or variant
  /// discontinuations.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  productVariant shopping_mall_product_variants @relation(fields: [shopping_mall_product_variant_id], references: [id], onDelete: Cascade)
  warehouse shopping_mall_warehouses @relation(fields: [shopping_mall_warehouse_id], references: [id], onDelete: Cascade)
  
  shopping_mall_stock_reservations shopping_mall_stock_reservations[]
  shopping_mall_stock_movements shopping_mall_stock_movements[]
  shopping_mall_inventory_alerts shopping_mall_inventory_alerts[]
  shopping_mall_inventory_snapshots shopping_mall_inventory_snapshots[]
  
  @@index([shopping_mall_warehouse_id])
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_product_variant_id, shopping_mall_warehouse_id], map: "shopping_mall_inventory_levels_shopping_mall_product_v_3764ca38")
  @@index([stock_status])
  @@index([available_quantity])
  @@index([last_counted_at])
}

/// Manages temporary inventory holds during the checkout process. Prevents
/// overselling by reserving stock for customers while they complete payment,
/// with automatic expiration based on configurable time limits.
///
/// @namespace Inventory
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_stock_reservations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Inventory level's {@link shopping_mall_inventory_levels.id}.
  shopping_mall_inventory_level_id String
  
  /// Customer session's {@link shopping_mall_customer_sessions.id}. Links
  /// reservation to specific shopping session.
  shopping_mall_customer_session_id String
  
  /// Number of units being reserved.
  quantity Int
  
  /// Reservation expiration timestamp. Reservations are automatically released
  /// after this time to prevent indefinite holds on inventory.
  expires_at DateTime
  
  /// Type of reservation: 'checkout' during payment process, 'transfer' for
  /// warehouse movements.
  reservation_type String
  
  /// Current reservation status: 'active', 'expired', 'released'.
  status String
  
  /// Reservation creation timestamp.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  inventoryLevel shopping_mall_inventory_levels @relation(fields: [shopping_mall_inventory_level_id], references: [id], onDelete: Cascade)
  customerSession shopping_mall_customer_sessions @relation(fields: [shopping_mall_customer_session_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_customer_session_id], map: "shopping_mall_stock_reservations_shopping_mall_custome_5dbef712")
  
  @@index([status])
  @@index([expires_at])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_inventory_level_id, status], map: "shopping_mall_stock_reservations_shopping_mall_invento_5fbe52a3")
}

/// Master data for warehouse locations and management. Centralizes warehouse
/// configuration including location, capacity, operational status, and
/// fulfillment capabilities for multi-location inventory management.
///
/// @namespace Inventory
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_warehouses {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique warehouse code (e.g., 'WH-USW-01', 'WH-UK-03'). Used for quick
  /// identification and internal routing.
  code String
  
  /// Human-readable warehouse name (e.g., 'West Coast Distribution Center').
  name String
  
  /// Primary address line for warehouse location.
  address_line1 String
  
  /// Secondary address information (suite, floor, building).
  address_line2 String?
  
  /// Warehouse city location.
  city String
  
  /// State or province for warehouse location.
  state_province String?
  
  /// Postal or ZIP code for warehouse location.
  postal_code String
  
  /// Country code where warehouse is located (ISO 3166-1 alpha-2).
  country String
  
  /// Timezone identifier for warehouse operations (e.g.,
  /// 'America/Los_Angeles').
  timezone String
  
  /// Operational status: 'active', 'inactive', 'under_maintenance'.
  status String
  
  /// Type of warehouse: 'distribution', 'fulfillment', 'returns',
  /// 'bulk_storage'.
  warehouse_type String
  
  /// Total warehouse capacity in square feet. Used for space planning and
  /// inventory optimization.
  capacity_sqft Int?
  
  /// JSON string with operating hours by day of week. Used for scheduling and
  /// delivery time calculations.
  operating_hours String?
  
  /// Primary contact email for warehouse operations and communications.
  contact_email String
  
  /// Primary contact phone number for warehouse operations.
  contact_phone String
  
  /// Whether this is a third-party logistics provider. Affects integration and
  /// operational protocols.
  is_3pl Boolean
  
  /// Warehouse creation timestamp.
  created_at DateTime
  
  /// Last update timestamp for warehouse information changes.
  updated_at DateTime
  
  /// Soft deletion timestamp. Used when warehouses are closed or consolidated.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shopping_mall_inventory_levels shopping_mall_inventory_levels[]
  
  @@unique([code])
  @@index([status])
  @@index([country, warehouse_type])
}

/// Complete audit trail for all inventory changes. Tracks every stock
/// adjustment, reservation, fulfillment, and transfer with detailed
/// transaction history for compliance and analysis purposes.
///
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_stock_movements {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Inventory level's {@link shopping_mall_inventory_levels.id}.
  shopping_mall_inventory_level_id String
  
  /// Type of stock movement: 'in' (stock receipt), 'out' (order fulfillment),
  /// 'reservation' (checkout hold), 'adjustment' (manual correction),
  /// 'transfer' (warehouse movement).
  movement_type String
  
  /// Quantity moved. Positive for incoming stock, negative for outgoing.
  quantity Int
  
  /// Type of reference document: 'order', 'return', 'adjustment', 'transfer',
  /// 'purchase_order'.
  reference_type String
  
  /// Reference to the related document (order ID, return ID, PO ID). Maintains
  /// audit trail connectivity.
  reference_id String?
  
  /// Human-readable explanation for the movement. Required for adjustments and
  /// transfers.
  reason_comment String?
  
  /// Unit cost for inventory valuation. Used for calculating inventory value
  /// changes during movements.
  unit_cost Float?
  
  /// Total cost impact. Automatically calculated as quantity * unit_cost when
  /// both are provided.
  total_cost Float?
  
  /// Actual date/time when the movement occurred. May differ from created_at
  /// for historical entries.
  movement_date DateTime
  
  //----
  // RELATIONS
  //----
  inventoryLevel shopping_mall_inventory_levels @relation(fields: [shopping_mall_inventory_level_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_inventory_level_id], map: "shopping_mall_stock_movements_shopping_mall_inventory__772b02e4")
  
  @@index([movement_type])
  @@index([reference_type, reference_id])
  @@index([movement_date])
}

/// Low stock notifications and threshold management. Configures alert rules
/// for inventory levels and manages notification workflow for stock
/// replenishment needs.
///
/// @namespace Inventory
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_inventory_alerts {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Inventory level's {@link shopping_mall_inventory_levels.id}.
  shopping_mall_inventory_level_id String
  
  /// Seller's {@link shopping_mall_sellers.id}. Links alert to responsible
  /// party for action.
  shopping_mall_seller_id String
  
  /// Type of alert: 'low_stock', 'out_of_stock', 'overstock', 'expiring'.
  alert_type String
  
  /// Quantity that triggers this alert. When inventory drops to this level,
  /// alert is generated.
  threshold_quantity Int
  
  /// Quantity at the time alert was generated. Snapshot for historical
  /// reference.
  current_quantity Int
  
  /// Alert priority: 'low', 'medium', 'high', 'critical'. Determines
  /// notification urgency and workflow.
  priority String
  
  /// Whether the alert condition is currently active. Used for notification
  /// status tracking.
  is_triggered Boolean
  
  /// When the alert was last triggered. Used for cooldown periods and
  /// frequency limiting.
  last_triggered_at DateTime?
  
  /// When the notification was sent to the seller. Prevents duplicate
  /// notifications for same condition.
  notification_sent_at DateTime?
  
  /// When the seller acknowledged the alert. Used for workflow management and
  /// response tracking.
  acknowledged_at DateTime?
  
  /// Comments from seller about how the alert was resolved. Required when
  /// acknowledging alerts.
  resolution_comment String?
  
  /// Alert creation timestamp.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  inventoryLevel shopping_mall_inventory_levels @relation(fields: [shopping_mall_inventory_level_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_inventory_level_id, alert_type], map: "shopping_mall_inventory_alerts_shopping_mall_inventory_e85375bd")
  @@index([is_triggered, priority])
  @@index([notification_sent_at])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_seller_id, is_triggered], map: "shopping_mall_inventory_alerts_shopping_mall_seller_id_70ebbce7")
}

/// Periodic captures of inventory states for reporting and analysis.
/// Provides historical inventory data for trend analysis, demand
/// forecasting, and stock level optimization.
///
/// @author AutoBE - https://github.com/wrtnlabs/autobe
