/// Primary order entity managing multi-seller transactions and customer
/// purchases across the marketplace platform. Coordinates complex order
/// lifecycle from placement through fulfillment while maintaining
/// comprehensive tracking for all stakeholders including customers, sellers,
/// and platform administrators.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_orders {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who placed the order. {@link shopping_mall_customer.id}
  shopping_customer_id String
  
  /// Session during which order was placed. {@link
  /// shopping_mall_customer_sessions.id}
  shopping_customer_session_id String?
  
  /// Guest user who placed the order. {@link shopping_mall_guest.id}
  shopping_guest_id String?
  
  /// Order number for customer reference and communication. Generated
  /// automatically using format ORD-YYYYMMDD-NNNNNN.
  order_number String
  
  /// Current status of the order indicating lifecycle stage. Values: pending,
  /// confirmed, processing, shipped, delivered, cancelled, refunded.
  status String
  
  /// Total amount of the order including all items, shipping, and fees.
  total_amount Float
  
  /// Currency code for the transaction following ISO 4217 standards.
  currency String
  
  /// Shipping address where order will be delivered to customer.
  shipping_address String
  
  /// Billing address for payment and invoice purposes.
  billing_address String
  
  /// Customer's phone number for delivery coordination.
  customer_phone String
  
  /// Additional delivery instructions or special requirements for courier.
  delivery_instructions String?
  
  /// Preferred delivery time or scheduling requests from customer.
  preferred_delivery_time String?
  
  /// Whether the order requires special handling or fragile item precautions
  /// during shipping.
  requires_special_handling Boolean
  
  /// Any internal notes or flags about the order for customer service or
  /// fulfillment teams.
  internal_notes String?
  
  /// Whether the order contains items from multiple sellers requiring
  /// coordinated fulfillment.
  contains_multiple_sellers Boolean
  
  /// Whether payment has been successfully completed and confirmed in system.
  payment_confirmed Boolean
  
  /// Customer's email confirmation that they will accept delivery or terms.
  customer_confirmation_received Boolean
  
  /// Timestamp when order was first placed by customer.
  created_at DateTime
  
  /// Timestamp when order status was last updated.
  updated_at DateTime
  
  /// Timestamp when order was cancelled if applicable.
  cancelled_at DateTime?
  
  /// Cancellation reason provided by customer or system for audit purposes.
  cancellation_reason String?
  
  /// Price lock expiration for items in multi-step checkout process.
  price_lock_expires_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_mall_customer @relation(fields: [shopping_customer_id], references: [id], onDelete: Cascade)
  customerSession shopping_mall_customer_sessions? @relation(fields: [shopping_customer_session_id], references: [id], onDelete: Cascade)
  guest shopping_mall_guest? @relation(fields: [shopping_guest_id], references: [id], onDelete: Cascade)
  
  shopping_mall_order_items shopping_mall_order_items[]
  shopping_mall_order_status_history shopping_mall_order_status_history[]
  shopping_mall_order_payments shopping_mall_order_payments[]
  shopping_mall_order_shipments shopping_mall_order_shipments[]
  shopping_mall_order_refunds shopping_mall_order_refunds[]
  shopping_mall_credit_transactions shopping_mall_credit_transactions[]
  shopping_mall_point_transactions shopping_mall_point_transactions[]
  shopping_mall_support_tickets shopping_mall_support_tickets[]
  shopping_mall_conversion_analytics shopping_mall_conversion_analytics[]
  
  @@index([shopping_customer_session_id])
  @@index([shopping_guest_id])
  
  @@unique([order_number])
  @@index([shopping_customer_id, created_at])
  @@index([status, updated_at])
  @@index([contains_multiple_sellers, status])
  @@index([payment_confirmed, status])
}

