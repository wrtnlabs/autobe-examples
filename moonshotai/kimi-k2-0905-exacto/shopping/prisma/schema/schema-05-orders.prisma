/// Core order management system for multi-vendor marketplace transactions.
///
/// Stores comprehensive order information including customer details, seller
/// relationships, payment statuses, and fulfillment tracking across the
/// entire marketplace ecosystem. Each order represents a complete
/// transaction that may contain items from multiple sellers, with the system
/// automatically managing order splitting and individual seller fulfillment
/// workflows.
///
/// Orders maintain complete audit trails of all status changes, payment
/// processing, and customer communications while supporting complex
/// scenarios like partial fulfillment, split shipments, and multi-currency
/// transactions.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_orders {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged customer's {@link shopping_mall_customers.id}
  shopping_customer_id String
  
  /// Belonged sale's {@link shopping_mall_sales.id}
  shopping_sale_id String
  
  /// Unique order identifier for customer reference
  code String
  
  /// Current order status: pending, processing, shipped, delivered, cancelled
  status String
  
  /// Business workflow status based on seller processing requirements
  business_status String
  
  /// Total order amount including all items and shipping costs
  price Float
  
  /// Order creation timestamp
  created_at DateTime
  
  /// Last modification timestamp
  updated_at DateTime
  
  /// Soft deletion timestamp for order lifecycle management
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_mall_customers @relation(fields: [shopping_customer_id], references: [id], onDelete: Cascade)
  sale shopping_mall_sales @relation(fields: [shopping_sale_id], references: [id], onDelete: Cascade)
  
  shopping_mall_order_items shopping_mall_order_items[]
  shopping_mall_order_snapshots shopping_mall_order_snapshots[]
  shopping_mall_order_fulfillments shopping_mall_order_fulfillments[]
  shopping_mall_coupon_usages shopping_mall_coupon_usages[]
  
  @@index([shopping_sale_id])
  
  @@unique([code])
  @@index([shopping_customer_id, created_at])
  @@index([status, created_at])
  @@index([business_status, created_at])
}

/// Individual items within marketplace orders providing detailed product,
/// pricing, and fulfillment tracking.
///
/// Each order item represents a specific product variant with associated
/// pricing, quantities, and fulfillment details. The system tracks
/// item-level status including inventory allocation, picking confirmation,
/// packing status, and shipping details while supporting partial fulfillment
/// scenarios.
///
/// The tracking system maintains comprehensive item journey records
/// including warehouse operations, carrier handoffs, delivery confirmations,
/// and return processing while linking to the specific seller responsible
/// for fulfillment.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_order_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged order's {@link shopping_mall_orders.id}
  shopping_mall_order_id String
  
  /// Belonged sale unit's {@link shopping_mall_sale_units.id}
  shopping_sale_unit_id String
  
  /// Belonged seller's {@link shopping_mall_sellers.id}
  shopping_seller_id String
  
  /// Display order within the order confirmation
  sequence Int
  
  /// Item price at time of purchase
  price Float
  
  /// Number of units ordered
  quantity Int
  
  /// Item fulfillment status: pending, allocated, packed, shipped, delivered
  status String
  
  /// When item was picked from inventory
  picked_at DateTime?
  
  /// When item was packed for shipment
  packed_at DateTime?
  
  /// When item was handed to carrier
  shipped_at DateTime?
  
  /// When carrier confirmed delivery
  delivered_at DateTime?
  
  /// Item creation timestamp
  created_at DateTime
  
  /// Last modification timestamp
  updated_at DateTime
  
  /// Soft deletion timestamp
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  saleUnit shopping_mall_sale_units @relation(fields: [shopping_sale_unit_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [shopping_seller_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_sale_unit_id])
  
  @@unique([shopping_mall_order_id, sequence])
  @@index([shopping_mall_order_id, status])
  @@index([shopping_seller_id, status])
}

/// Historical point-in-time captures of order state for audit trails and
/// compliance.
///
/// Order snapshots preserve the exact state of orders including prices,
/// items, seller information, and customer details at specific moments in
/// time. This enables accurate reconstruction of order history for dispute
/// resolution, compliance reporting, and business intelligence analysis.
///
/// The system creates snapshots at critical lifecycle events including order
/// creation, payment completion, shipment confirmation, delivery
/// confirmation, and order completion while maintaining all relevant data
/// for regulatory compliance and customer service requirements.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_order_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged order's {@link shopping_mall_orders.id}
  shopping_mall_order_id String
  
  /// Snapshot of order code at time of capture
  code String
  
  /// Snapshot of order status at time of capture
  status String
  
  /// Snapshot of business workflow status
  business_status String
  
  /// Snapshot of total order amount at capture time
  price Float
  
  /// Complete snapshot data as JSON preserving comprehensive order state
  content String
  
  /// Snapshot creation timestamp
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_order_id, created_at], map: "shopping_mall_order_snapshots_shopping_mall_order_id_c_07acd28a")
  @@index([status, created_at])
}

/// Order fulfillment coordination and tracking across multiple carriers and
/// shipping partners.
///
/// Order fulfillments manage the complex shipping logistics for marketplace
/// orders including carrier coordination, tracking number management,
/// delivery scheduling, and exception handling across multiple sellers and
/// shipping services.
///
/// The system supports sophisticated routing logic including optimal carrier
/// selection, shipment consolidation, delivery scheduling, and exception
/// management while maintaining real-time tracking visibility for all
/// stakeholders throughout the fulfillment process.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_order_fulfillments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged order's {@link shopping_mall_orders.id}
  shopping_mall_order_id String
  
  /// Belonged seller's {@link shopping_mall_sellers.id}
  shopping_seller_id String
  
  /// Belonged courier's {@link shopping_mall_couriers.id}
  shopping_courier_id String
  
  /// Carrier tracking number for package identification
  shipping_code String
  
  /// Shipping service level: Ground, Express, Overnight
  shipping_service String
  
  /// Actual shipping cost charged to customer
  shipping_cost Float
  
  /// Predicted delivery date based on carrier estimates
  estimated_delivery_at DateTime?
  
  /// When package was handed to carrier
  shipped_at DateTime?
  
  /// When carrier confirmed final delivery
  delivered_at DateTime?
  
  /// Fulfillment status: scheduled, in_transit, delivered, exception
  status String
  
  /// Real-time tracking information from carrier API
  tracking_data String?
  
  /// Fulfillment creation timestamp
  created_at DateTime
  
  /// Last modification timestamp
  updated_at DateTime
  
  /// Soft deletion timestamp
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [shopping_seller_id], references: [id], onDelete: Cascade)
  courier shopping_mall_couriers @relation(fields: [shopping_courier_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_seller_id])
  
  @@unique([shipping_code])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_order_id, shopping_seller_id], map: "shopping_mall_order_fulfillments_shopping_mall_order_i_afd121c7")
  @@index([shopping_courier_id, status])
}