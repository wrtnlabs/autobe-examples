/// Platform channel management defining different marketplace environments,
/// configurations, and business rules.
///
/// Channels represent distinct platform instances with unique settings,
/// policies, and user experiences. Each channel can have different
/// commission structures, supported countries, and operational
/// configurations while sharing the same underlying infrastructure.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_channels {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique channel identifier used for routing and configuration.
  code String
  
  /// Channel display name shown to users across the platform.
  name String
  
  /// Detailed description of channel purpose and business model.
  description String?
  
  /// Channel operational status: active, inactive, maintenance, suspended.
  status String
  
  /// Primary currency for transactions in this channel (ISO 4217 code).
  currency String
  
  /// Primary country code for this channel (ISO 3166-1 alpha-2).
  country_code String?
  
  /// Primary language for this channel (ISO 639-1).
  language String
  
  /// Default commission percentage charged by platform (0-100%).
  commission_rate Float
  
  /// Minimum order amount required for checkout in this channel.
  minimum_order_value Float
  
  /// Whether tax calculation is enabled for this channel.
  tax_enabled Boolean
  
  /// Channel creation timestamp.
  created_at DateTime
  
  /// Last modification timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shopping_mall_sections shopping_mall_sections[]
  shopping_mall_configurations shopping_mall_configurations[]
  shopping_mall_sales shopping_mall_sales[]
  
  @@unique([code])
  @@index([status])
  @@index([created_at])
}

/// Channel section organization providing hierarchical navigation and
/// content distribution within marketplace channels.
///
/// Sections organize content within channels through hierarchical
/// categorization, creating intuitive navigation for customers while
/// enabling flexible merchandising and content management strategies per
/// channel.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_sections {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Channel's {@link shopping_mall_channels.id}
  shopping_mall_channel_id String
  
  /// Unique section identifier within the channel.
  code String
  
  /// Section display name shown to users.
  name String
  
  /// Detailed description of section content and purpose.
  description String?
  
  /// Hierarchy level for nested sections (0 for top-level).
  level Int
  
  /// Parent section reference for nested hierarchies.
  parent_id String?
  
  /// Display order for sections within the same level.
  sort_order Int
  
  /// Section status: active, inactive, hidden.
  status String
  
  /// Whether section appears in featured navigation.
  is_featured Boolean
  
  /// Section creation timestamp.
  created_at DateTime
  
  /// Last modification timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  channel shopping_mall_channels @relation(fields: [shopping_mall_channel_id], references: [id], onDelete: Cascade)
  
  shopping_mall_sales shopping_mall_sales[]
  shopping_mall_articles shopping_mall_articles[]
  shopping_mall_bbs_posts shopping_mall_bbs_posts[]
  
  @@unique([shopping_mall_channel_id, code])
  @@index([shopping_mall_channel_id, parent_id])
  @@index([status])
  @@index([level, sort_order])
}

/// Platform-wide configuration management providing centralized settings and
/// parameters for system-wide functionality.
///
/// Configuration options control operational behavior, feature toggles,
/// security settings, and business rules that apply across all marketplace
/// channels and sections.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_configurations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Channel's {@link shopping_mall_channels.id} (nullable for global configs).
  shopping_mall_channel_id String?
  
  /// Configuration key (namespace.value format).
  key String
  
  /// Configuration value (string representing JSON, text, or data).
  value String
  
  /// Data type: string, number, boolean, json, text, file.
  type String
  
  /// Configuration purpose and usage description.
  description String?
  
  /// Configuration category: security, features, business, technical.
  category String
  
  /// Scope: global, channel, section, user.
  scope String
  
  /// Whether the value is encrypted at rest.
  is_encrypted Boolean
  
  /// Whether channel sections can override this setting.
  is_overridable Boolean
  
  /// Whether configuration appears in admin interfaces.
  is_visible Boolean
  
  /// JSON rules for value validation.
  validation_rules String?
  
  /// Configuration creation timestamp.
  created_at DateTime
  
  /// Last modification timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  channel shopping_mall_channels? @relation(fields: [shopping_mall_channel_id], references: [id], onDelete: Cascade)
  
  @@unique([key, shopping_mall_channel_id])
  @@index([category, scope])
  @@index([shopping_mall_channel_id])
  @@index([key])
  @@index([is_encrypted])
}