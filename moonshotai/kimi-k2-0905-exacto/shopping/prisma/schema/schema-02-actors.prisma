/// Customer accounts for the shopping mall platform. Customers are retail
/// users who browse products, make purchases, and manage their shopping
/// experience.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_customers {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer email address for account login and communications.
  email String
  
  /// Hashed password for secure authentication.
  password_hash String
  
  /// Customer's full name for shipping and personalization.
  full_name String
  
  /// Customer phone number for order notifications and verification.
  phone_number String?
  
  /// Whether the customer has verified their email address.
  email_verified Boolean
  
  /// Customer's preferred language for communications and interface.
  preferred_language String?
  
  /// Customer's preferred currency for pricing and transactions.
  preferred_currency String?
  
  /// Customer opt-in status for marketing communications.
  marketing_opt_in Boolean
  
  /// Account creation timestamp.
  created_at DateTime
  
  /// Last account modification timestamp.
  updated_at DateTime
  
  /// Account soft deletion timestamp.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shopping_mall_customer_sessions shopping_mall_customer_sessions[]
  shopping_mall_shopping_carts shopping_mall_shopping_carts[]
  shopping_mall_wishlists shopping_mall_wishlists[]
  shopping_mall_orders shopping_mall_orders[]
  shopping_mall_shipping_details shopping_mall_shipping_details[]
  shopping_mall_product_reviews shopping_mall_product_reviews[]
  shopping_mall_review_helpfulness shopping_mall_review_helpfulness[]
  shopping_mall_review_flags shopping_mall_review_flags[]
  
  @@unique([email])
  @@index([email_verified, created_at])
  @@index([preferred_language])
}

