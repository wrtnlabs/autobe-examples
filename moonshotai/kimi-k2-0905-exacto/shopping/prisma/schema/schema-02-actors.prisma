/// Authentication sessions for customer accounts. Tracks customer login
/// sessions for security monitoring and audit trails.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_customer_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to shopping_mall_customers.id
  shopping_mall_customer_id String
  
  /// IP address of the customer connection.
  ip String
  
  /// Connection URL or page being accessed.
  href String
  
  /// Referrer URL tracking the user source.
  referrer String
  
  /// Session creation timestamp.
  created_at DateTime
  
  /// Optional session expiration time.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  shopping_mall_stock_reservations shopping_mall_stock_reservations[]
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_customer_id, created_at], map: "shopping_mall_customer_sessions_shopping_mall_customer_adefa402")
}

