/// Customer product reviews providing social proof and feedback across the
/// marketplace platform.
///
/// This table stores authentic customer reviews for purchased products,
/// enabling prospective buyers to make informed decisions while providing
/// sellers with valuable feedback about their offerings. Each review
/// captures customer satisfaction through ratings, detailed feedback, and
/// optional media content.
///
/// Reviews undergo automated screening before publication and maintain
/// transparency through verification badges. The system supports review
/// updates and comprehensive moderation workflows to ensure content quality
/// and authenticity.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_product_reviews {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who wrote the review. {@link ecommerce_mall_customers.id}
  ecommerce_mall_customer_id String
  
  /// Product being reviewed. {@link ecommerce_mall_products.id}
  ecommerce_mall_product_id String
  
  /// Order containing the purchased product. {@link ecommerce_mall_orders.id}
  ecommerce_mall_order_id String
  
  /// Product rating from 1-5 stars indicating overall satisfaction level.
  rating Int
  
  /// Brief review title summarizing the customer's experience with the product.
  title String
  
  /// Detailed review text describing the customer's experience with the
  /// product.
  content String
  
  /// Indicates whether this review is from a verified purchaser of the product.
  verified_purchase Boolean
  
  /// Publication status indicating whether the review is visible to other
  /// customers.
  published Boolean
  
  /// Whether this review is featured prominently on the product page for
  /// marketing.
  featured Boolean
  
  /// Timestamp when the customer first submitted this review.
  created_at DateTime
  
  /// Timestamp when the customer last updated the review content.
  updated_at DateTime
  
  /// Soft deletion timestamp for removed reviews maintaining audit trail.
  deleted_at DateTime?
  
  /// Date when the customer's order was delivered before writing the review.
  delivery_date DateTime
  
  //----
  // RELATIONS
  //----
  customer ecommerce_mall_customers @relation(fields: [ecommerce_mall_customer_id], references: [id], onDelete: Cascade)
  product ecommerce_mall_products @relation(fields: [ecommerce_mall_product_id], references: [id], onDelete: Cascade)
  order ecommerce_mall_orders @relation(fields: [ecommerce_mall_order_id], references: [id], onDelete: Cascade)
  
  ecommerce_mall_review_moderration ecommerce_mall_review_moderration?
  ecommerce_mall_review_helpfulness ecommerce_mall_review_helpfulness[]
  
  @@index([ecommerce_mall_order_id])
  
  // spellchecker: ignore-next-line
  @@unique([ecommerce_mall_customer_id, ecommerce_mall_product_id], map: "ecommerce_mall_product_reviews_ecommerce_mall_customer_617670c5")
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_product_id, created_at], map: "ecommerce_mall_product_reviews_ecommerce_mall_product__e279979e")
  @@index([rating, created_at])
}

/// Product rating aggregation statistics for performance optimization and
/// analytics reporting across the platform.
///
/// This table maintains calculated rating statistics for products, sellers,
/// and platform-wide performance metrics. It provides efficient access to
/// rating summaries without requiring complex queries across individual
/// reviews, supporting real-time display of rating information and trend
/// analysis.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_review_ratings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product associated with these rating statistics. {@link
  /// ecommerce_mall_products.id}
  ecommerce_mall_product_id String?
  
  /// Seller associated with these rating statistics. {@link
  /// ecommerce_mall_sellers.id}
  ecommerce_mall_seller_id String?
  
  /// Calculated average rating (1-5) from all associated reviews for the
  /// period.
  average_rating Float
  
  /// Total number of review contributions for the rated entity.
  total_reviews Int
  
  /// Number of reviews from verified purchasers of the product or seller.
  verified_reviews Int
  
  /// Number of 1-star reviews contributing to the average calculation.
  one_star_count Int
  
  /// Number of 2-star reviews contributing to the average calculation.
  two_star_count Int
  
  /// Number of 3-star reviews contributing to the average calculation.
  three_star_count Int
  
  /// Number of 4-star reviews contributing to the average calculation.
  four_star_count Int
  
  /// Number of 5-star reviews contributing to the average calculation.
  five_star_count Int
  
  /// Time period for these statistics - daily, weekly, monthly, or all_time.
  rating_period String
  
  /// Start date and time for this rating period.
  period_start DateTime
  
  /// End date and time for this rating period.
  period_end DateTime
  
  /// Last timestamp when these statistics were recalculated from source
  /// reviews.
  last_updated DateTime
  
  //----
  // RELATIONS
  //----
  product ecommerce_mall_products? @relation(fields: [ecommerce_mall_product_id], references: [id], onDelete: Cascade)
  seller ecommerce_mall_sellers? @relation(fields: [ecommerce_mall_seller_id], references: [id], onDelete: Cascade)
  
  @@index([ecommerce_mall_seller_id])
  
  // spellchecker: ignore-next-line
  @@unique([ecommerce_mall_product_id, ecommerce_mall_seller_id, rating_period, period_start], map: "ecommerce_mall_review_ratings_ecommerce_mall_product_i_1062a3d1")
  @@index([average_rating, total_reviews])
  @@index([period_start, rating_period])
}

/// Review moderation workflow system for content quality assurance and
/// policy compliance across the platform marketplace.
///
/// This table tracks review moderation activities including automated
/// content screening, manual review processes, and administrative
/// interventions to maintain content quality standards. The system supports
/// moderator decisions, appeal processes, and maintains comprehensive audit
/// trails for all moderation activities.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_review_moderration {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product review being moderated. {@link ecommerce_mall_product_reviews.id}
  ecommerce_mall_product_review_id String
  
  /// Administrator who performed the moderation action. {@link
  /// ecommerce_mall_administrators.id}
  ecommerce_mall_administrator_id String
  
  /// Type of moderation - automated_screening, manual_review, or
  /// customer_appeal.
  moderation_type String
  
  /// Current moderation status - pending, approved, approved_with_edits,
  /// rejected.
  status String
  
  /// Detailed explanation of moderation decision and any policy violations
  /// found.
  reason String?
  
  /// Specific policy violations identified during the moderation process.
  violations String?
  
  /// Modified review content when approved with content edits for compliance.
  edited_content String?
  
  /// Deadline for submitting appeals to moderation decisions, typically 7 days.
  appeal_deadline DateTime?
  
  /// Reason provided by reviewer when appealing a moderation decision.
  appeal_reason String?
  
  /// Final outcome of the appeal process - approved, denied, or reversed.
  appeal_outcome String?
  
  /// Timestamp when the moderation process was initiated for the review.
  created_at DateTime
  
  /// Timestamp when the moderation decision was finalized and applied.
  resolved_at DateTime?
  
  //----
  // RELATIONS
  //----
  productReview ecommerce_mall_product_reviews @relation(fields: [ecommerce_mall_product_review_id], references: [id], onDelete: Cascade)
  administrator ecommerce_mall_administrators @relation(fields: [ecommerce_mall_administrator_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_administrator_id], map: "ecommerce_mall_review_moderration_ecommerce_mall_admin_5463a265")
  
  // spellchecker: ignore-next-line
  @@unique([ecommerce_mall_product_review_id], map: "ecommerce_mall_review_moderration_ecommerce_mall_produ_182fd295")
  @@index([status, created_at])
  // spellchecker: ignore-next-line
  @@index([moderation_type, created_at], map: "ecommerce_mall_review_moderration_moderation_type_crea_80eb76e4")
}

