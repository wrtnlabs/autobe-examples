/// Shopping cart management for customers in multi-vendor marketplace.
///
/// Maintains shopping cart state across sessions with proper ownership
/// tracking through polymorphic design. Supports both customer and guest
/// ownership while ensuring data integrity and audit trail capabilities.
///
/// The cart preserves product selections, quantities, and pricing snapshots
/// while coordinating inventory availability across multiple sellers. Each
/// cart maintains creator attribution through actor-specific subtype
/// entities enabling comprehensive tracking and recovery capabilities.
///
/// @namespace Carts
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_carts {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Actor type identifier (customer, guest) for cart ownership.
  actor_type String
  
  /// Unique cart identifier for customer reference and sharing.
  code String
  
  /// Cart status (active, abandoned, converted, expired) for lifecycle
  /// tracking.
  status String
  
  /// Cart expiration timestamp for automatic cleanup of inactive carts.
  expires_at DateTime?
  
  /// Timestamp when the cart was created.
  created_at DateTime
  
  /// Last modification timestamp for cart contents.
  updated_at DateTime
  
  /// Soft deletion timestamp for cart recovery and audit trails.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  actorType shopping_mall_guests @relation(fields: [actor_type], references: [id], onDelete: Cascade)
  
  shopping_mall_cart_items shopping_mall_cart_items[]
  shopping_mall_cart_of_customers shopping_mall_cart_of_customers?
  shopping_mall_cart_of_guests shopping_mall_cart_of_guests?
  
  @@index([actor_type])
  
  @@unique([code])
  @@index([status])
  @@index([expires_at])
  @@index([created_at])
}

/// Individual items within customer's shopping cart with comprehensive audit
/// tracking.
///
/// Represents each product selection in the cart including variant choices,
/// quantity preferences, pricing snapshots, and inventory tracking. The
/// system enables sophisticated inventory management with real-time
/// availability monitoring across multiple sellers.
///
/// Items maintain independent tracking for each seller in the cart with
/// comprehensive audit trail support enabling historical analysis of cart
/// contents, customer behavior patterns, and business intelligence insights
/// across the multi-vendor marketplace.
///
/// @namespace Carts
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_cart_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent cart's {@link shopping_mall_carts.id}. Each item belongs to
  /// exactly one cart.
  shopping_mall_cart_id String
  
  /// Selected product variant's {@link shopping_mall_sale_units.id}.
  /// Identifies specific variant (size, color, etc.).
  shopping_mall_sale_unit_id String?
  
  /// Number of units of this item in the cart for checkout processing.
  quantity Int
  
  /// Price per unit of this variant at cart addition time for pricing accuracy.
  unit_price Float
  
  /// Timestamp when this item was added to cart for audit trail.
  added_at DateTime
  
  /// Last modification timestamp for quantity or cart association.
  updated_at DateTime
  
  /// Soft deletion timestamp for item recovery and audit trails.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  cart shopping_mall_carts @relation(fields: [shopping_mall_cart_id], references: [id], onDelete: Cascade)
  saleUnit shopping_mall_sale_units? @relation(fields: [shopping_mall_sale_unit_id], references: [id], onDelete: Cascade)
  
  shopping_mall_cart_item_snapshots shopping_mall_cart_item_snapshots[]
  
  @@index([shopping_mall_cart_id, added_at])
  @@index([shopping_mall_sale_unit_id])
  @@index([deleted_at])
}

