/// Core product catalog representing items available for sale in the
/// marketplace.
///
/// Products form the foundation of the e-commerce catalog, representing
/// individual items that sellers can list for sale. Each product belongs to
/// a specific seller and category, with comprehensive metadata including
/// pricing, descriptions, and inventory tracking. Products support multiple
/// variants (different sizes, colors, configurations) and maintain complete
/// historical records through snapshots for audit trails and change
/// tracking.
///
/// Products serve as the central reference point for all marketplace
/// activities including search, discovery, recommendations, and order
/// fulfillment. The product catalog supports advanced features like SEO
/// optimization, promotional pricing, and multi-media content while
/// maintaining strict quality standards through approval workflows and
/// policy compliance checking.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The seller who owns this product. {@link shopping_mall_seller.id}
  shopping_mall_seller_id String
  
  /// Primary category for this product. {@link
  /// shopping_mall_product_categories.id}
  shopping_mall_product_category_id String
  
  /// Unique stock keeping unit identifier for this product.
  sku String
  
  /// Product name with clear, descriptive title for customer understanding.
  name String
  
  /// Comprehensive product description with features, benefits, and
  /// specifications.
  description String
  
  /// Current selling price of the product in the marketplace currency.
  price Float
  
  /// Original price for discount comparison and promotional display purposes.
  compare_at_price Float?
  
  /// Product cost for profit margin calculations and seller analytics.
  cost Float?
  
  /// Product status (active, draft, archived) controlling visibility in
  /// marketplace.
  status String
  
  /// Product condition (new, used, refurbished) for quality transparency.
  condition String
  
  /// Product weight in kilograms for shipping calculations and logistics.
  weight Float?
  
  /// Unit of measurement for product weight (kg, g, lb, oz).
  weight_unit String?
  
  /// Universal product code or barcode for inventory scanning.
  barcode String?
  
  /// Whether to track inventory levels for this product across all variants.
  track_quantity Boolean
  
  /// Whether to allow orders when inventory reaches zero.
  allow_backorder Boolean
  
  /// Whether this product requires physical shipping or is
  /// digital/downloadable.
  is_shipping_required Boolean
  
  /// Whether sales tax should be applied to this product.
  is_taxable Boolean
  
  /// SEO-optimized title for search engine visibility and ranking.
  seo_title String?
  
  /// SEO meta description for search engine results pages.
  seo_description String?
  
  /// Comma-separated tags for product discovery and categorization.
  tags String?
  
  /// URL of the primary product image for catalog display.
  featured_image String?
  
  /// Hashed password for seller product management access and security.
  password_hash String
  
  /// Timestamp when the product was first created in the catalog.
  created_at DateTime
  
  /// Timestamp of the most recent modification to product information.
  updated_at DateTime
  
  /// When the product became visible to customers in the marketplace.
  published_at DateTime?
  
  /// Soft deletion timestamp for catalog cleanup and audit purposes.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  seller shopping_mall_seller @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  category shopping_mall_product_categories @relation(fields: [shopping_mall_product_category_id], references: [id], onDelete: Cascade)
  
  shopping_mall_product_variants shopping_mall_product_variants[]
  shopping_mall_product_snapshots shopping_mall_product_snapshots[]
  shopping_mall_product_units shopping_mall_product_units[]
  shopping_mall_cart_items shopping_mall_cart_items[]
  shopping_mall_order_items shopping_mall_order_items[]
  shopping_mall_product_reviews shopping_mall_product_reviews[]
  
  @@unique([sku])
  @@unique([shopping_mall_seller_id, name])
  @@index([status, created_at])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_category_id, price], map: "shopping_mall_products_shopping_mall_product_category__644f4168")
  @@index([created_at])
}

/// Product variants representing different configurations of parent products.
///
/// Variants enable sellers to offer products with multiple options such as
/// different sizes, colors, materials, or configurations while maintaining a
/// single product listing for discoverability. Each variant has its own SKU,
/// inventory tracking, pricing adjustments, and unique attributes but
/// inherits core product information from the parent product.
///
/// Variant management is essential for supporting diverse product catalogs
/// including apparel with size/color combinations, electronics with
/// different specifications, and configurable products with selectable
/// features. The variant system maintains inventory accuracy, pricing
/// flexibility, and ordering convenience while preserving the unified
/// product identity.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_variants {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The parent product this variant belongs to. {@link
  /// shopping_mall_products.id}
  shopping_mall_product_id String
  
  /// Primary product unit defining the variant configuration. {@link
  /// shopping_mall_product_units.id}
  shopping_mall_product_unit_id String
  
  /// Unique SKU for this specific variant configuration.
  sku String
  
  /// Variant title showing selected options (e.g., 'Large, Blue').
  title String
  
  /// Price difference from base product price for this variant.
  price_adjustment Float
  
  /// Cost difference from base product cost for this variant.
  cost_adjustment Float?
  
  /// Weight difference from base product weight for shipping.
  weight_adjustment Float?
  
  /// Variant-specific barcode for inventory scanning.
  barcode String?
  
  /// URL of variant-specific product image showing configuration.
  image String?
  
  /// Current inventory level for this specific variant.
  inventory_quantity Int
  
  /// How to handle inventory when depleted (deny, continue).
  inventory_policy String
  
  /// Display order position within the product's variant list.
  position Int
  
  /// Whether this variant is available for sale.
  is_active Boolean
  
  /// When this variant was first created.
  created_at DateTime
  
  /// When this variant was last modified.
  updated_at DateTime
  
  /// Soft deletion timestamp for variant management.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  productUnit shopping_mall_product_units @relation(fields: [shopping_mall_product_unit_id], references: [id], onDelete: Cascade)
  
  shopping_mall_cart_items shopping_mall_cart_items[]
  shopping_mall_order_items shopping_mall_order_items[]
  shopping_mall_inventory_levels shopping_mall_inventory_levels?
  shopping_mall_inventory_movements shopping_mall_inventory_movements[]
  shopping_mall_inventory_alerts shopping_mall_inventory_alerts[]
  
  @@unique([sku])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, is_active], map: "shopping_mall_product_variants_shopping_mall_product_i_7ec56022")
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_unit_id], map: "shopping_mall_product_variants_shopping_mall_product_u_d06d5231")
  @@index([inventory_quantity, is_active])
  @@index([created_at])
}

/// Historical snapshots of product information for audit trails and version
/// control.
///
/// Product snapshots enable transparent tracking of catalog changes
/// including pricing modifications, description updates, image replacements,
/// and attribute adjustments over time. This comprehensive audit system
/// maintains complete historical records of product evolution while
/// supporting business intelligence, analytics, and regulatory compliance
/// requirements.
///
/// The snapshot system provides sellers with ability to track product
/// performance across different versions, analyze the impact of catalog
/// changes, and maintain accountability for pricing and content
/// modifications. Snapshots also enable customers to understand product
/// evolution and sellers to demonstrate transparency in their business
/// practices while supporting platform-level analytics and trend analysis.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The product this snapshot represents. {@link shopping_mall_products.id}
  shopping_mall_product_id String
  
  /// The seller who owned this product during this snapshot. {@link
  /// shopping_mall_seller.id}
  shopping_mall_seller_id String
  
  /// The category assigned to product during this snapshot. {@link
  /// shopping_mall_product_categories.id}
  shopping_mall_product_category_id String
  
  /// SKU of the product at the time this snapshot was created.
  sku String
  
  /// Product name during this snapshot period.
  name String
  
  /// Product description as it existed in this snapshot.
  description String
  
  /// Product price recorded in this historical snapshot.
  price Float
  
  /// Original price during this snapshot period.
  compare_at_price Float?
  
  /// Product cost at the time of snapshot.
  cost Float?
  
  /// Product status during the snapshot period.
  status String
  
  /// Product condition at the time of snapshot.
  condition String
  
  /// Product weight as recorded in this snapshot.
  weight Float?
  
  /// Weight unit used during this snapshot period.
  weight_unit String?
  
  /// Barcode recorded in this historical snapshot.
  barcode String?
  
  /// Whether inventory tracking was enabled during this period.
  track_quantity Boolean
  
  /// Whether backorders were allowed during this snapshot.
  allow_backorder Boolean
  
  /// Whether shipping requirement was set during this period.
  is_shipping_required Boolean
  
  /// Whether tax was applicable during this snapshot period.
  is_taxable Boolean
  
  /// SEO title that was active during this snapshot.
  seo_title String?
  
  /// SEO description recorded in this historical snapshot.
  seo_description String?
  
  /// Tags that were associated with product during this period.
  tags String?
  
  /// Featured image URL that was active during this snapshot.
  featured_image String?
  
  /// When this snapshot was created to record the product state.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  seller shopping_mall_seller @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  category shopping_mall_product_categories @relation(fields: [shopping_mall_product_category_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_category_id], map: "shopping_mall_product_snapshots_shopping_mall_product__a020eece")
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_product_id, created_at], map: "shopping_mall_product_snapshots_shopping_mall_product__36f83a82")
  // spellchecker: ignore-next-line
  @@index([shopping_mall_seller_id, created_at], map: "shopping_mall_product_snapshots_shopping_mall_seller_i_455ed290")
  @@index([created_at])
}

/// Hierarchical product categorization system for marketplace organization
/// and discovery.
///
/// Product categories provide the primary organizational structure for the
/// marketplace catalog, enabling customers to browse and discover products
/// efficiently while supporting sellers in proper product placement. The
/// hierarchical system allows for detailed categorization from broad
/// top-level categories to specific subcategories and specialized product
/// groups.
///
/// Categories serve as the foundation for search functionality, filtering
/// systems, recommendation algorithms, and merchandising strategies. They
/// enable drill-down navigation, cross-category browsing, and sophisticated
/// product discovery while maintaining catalog organization and supporting
/// catalog management operations across diverse product types and seller
/// inventories.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent category reference for hierarchical structure (null for root
  /// categories). {@link shopping_mall_product_categories.id}
  parent_id String?
  
  /// Unique category code for API and system reference.
  code String
  
  /// Category name displayed in navigation and search results.
  name String
  
  /// Detailed category description for customer information and SEO.
  description String?
  
  /// Category path showing hierarchy (e.g., 'Electronics/Computers/Laptops').
  path String
  
  /// Hierarchy level indicating depth in category tree (0 for root categories).
  level Int
  
  /// Display order within parent category or top-level category list.
  sort_order Int
  
  /// Whether this category is visible to customers in navigation.
  is_active Boolean
  
  /// Whether this category is featured prominently on the homepage.
  is_featured Boolean
  
  /// URL of category image for visual navigation and merchandising.
  image String?
  
  /// SEO-optimized title for search engine ranking and visibility.
  meta_title String?
  
  /// SEO meta description for search engine results pages.
  meta_description String?
  
  /// Comma-separated keywords for SEO optimization and search.
  meta_keywords String?
  
  /// When this category was created in the system.
  created_at DateTime
  
  /// When this category was last modified.
  updated_at DateTime
  
  /// Soft deletion timestamp for category cleanup and audit.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  parent shopping_mall_product_categories? @relation("recursive", fields: [parent_id], references: [id], onDelete: Cascade)
  
  shopping_mall_products shopping_mall_products[]
  shopping_mall_product_snapshots shopping_mall_product_snapshots[]
  recursive shopping_mall_product_categories[] @relation("recursive")
  
  @@unique([code])
  @@index([parent_id, is_active])
  @@index([path])
  @@index([level, sort_order])
  @@index([is_active, is_featured])
  @@index([created_at])
}

/// Product unit definitions enabling flexible product configuration and
/// variant creation.
///
/// Product units represent different aspects of product variation including
/// size, color, material, style, or any definable characteristic that
/// creates distinct product options. The unit system enables sellers to
/// create comprehensive product configurations while maintaining inventory
/// control and pricing flexibility for each variation type.
///
/// Units serve as the building blocks for product variants, allowing
/// customers to select specific product configurations that meet their
/// preferences while enabling sellers to manage different inventory levels,
/// pricing, and availability for each variation. The system supports
/// unlimited unit types and combinations to accommodate diverse product
/// catalogs and complex configuration requirements.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_units {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The product this unit configuration applies to. {@link
  /// shopping_mall_products.id}
  shopping_mall_product_id String
  
  /// Unit type name such as 'Size', 'Color', 'Material', or 'Style'.
  name String
  
  /// Unit category (size, color, material, style, custom) defining variation
  /// type.
  type String
  
  /// How to display unit options (dropdown, buttons, swatches, text input).
  display_style String
  
  /// Whether customers must select an option for this unit before purchase.
  is_required Boolean
  
  /// Whether customers can select multiple options for this unit.
  is_multiple Boolean
  
  /// Display order of this unit within product configuration interface.
  sort_order Int
  
  /// When this product unit was configured.
  created_at DateTime
  
  /// When this product unit configuration was last modified.
  updated_at DateTime
  
  /// Soft deletion timestamp for unit management and cleanup.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  shopping_mall_product_variants shopping_mall_product_variants[]
  shopping_mall_product_unit_options shopping_mall_product_unit_options[]
  shopping_mall_cart_items shopping_mall_cart_items[]
  
  @@unique([shopping_mall_product_id, name])
  @@index([shopping_mall_product_id, type])
  @@index([sort_order])
  @@index([created_at])
}

/// Individual options within product units allowing customers to select
/// specific variations.
///
/// Unit options represent the selectable values within each product unit,
/// enabling customers to choose specific variations such as 'Large' within a
/// Size unit, 'Blue' within a Color unit, or specific patterns within a
/// Style unit. Options provide the granular choices that define product
/// variants while supporting rich media content, inventory tracking, and
/// pricing flexibility.
///
/// The option system enables unlimited customization possibilities while
/// maintaining consistent user interfaces and inventory management
/// capabilities. Sellers can create comprehensive option sets that support
/// complex product configurations while providing customers with intuitive
/// selection experiences and clear visibility into available variations,
/// pricing differences, and availability status for each product
/// configuration.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_unit_options {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The product unit that contains this option. {@link
  /// shopping_mall_product_units.id}
  shopping_mall_product_unit_id String
  
  /// Option name displayed to customers (e.g., 'Large', 'Blue', 'Silk').
  name String
  
  /// Internal value used for variant matching and inventory tracking.
  value String
  
  /// Price adjustment when this option is selected for a variant.
  price_adjustment Float
  
  /// Weight adjustment when this option is selected for shipping calculations.
  weight_adjustment Float?
  
  /// Visual representation of this option (color swatch, size chart, etc.).
  image String?
  
  /// Hex color code for color options enabling swatch display.
  color_hex String?
  
  /// Display order within the unit option selection interface.
  position Int
  
  /// Whether this option is currently available for customer selection.
  is_available Boolean
  
  /// Whether this option should be pre-selected when customers first view the
  /// product.
  is_default Boolean
  
  /// When this unit option was created.
  created_at DateTime
  
  /// When this unit option was last modified.
  updated_at DateTime
  
  /// Soft deletion timestamp for option management and cleanup.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  productUnit shopping_mall_product_units @relation(fields: [shopping_mall_product_unit_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_product_unit_id, name], map: "shopping_mall_product_unit_options_shopping_mall_produ_09a86931")
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_unit_id, is_available], map: "shopping_mall_product_unit_options_shopping_mall_produ_c708218f")
  @@index([position])
  @@index([created_at])
}