/// Core product catalog entries in the marketplace enabling sellers to list
/// items for sale with comprehensive product information and multi-seller
/// support.
///
/// Products represent individual SKUs with detailed specifications, pricing,
/// and catalog information. Each sale entry can be managed by different
/// types of actors (customers, sellers) through a polymorphic ownership
/// pattern.
///
/// The system tracks product lifecycle from drafting through approval and
/// sale, maintaining comprehensive history through snapshot functionality
/// for analytics and compliance.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_sales {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The sales channel's {@link shopping_channels.id} where this product is
  /// listed.
  shopping_channel_id String
  
  /// The section's {@link shopping_sections.id} organizing this product.
  shopping_section_id String
  
  /// Unique product code used for catalog organization and search.
  code String
  
  /// Product display name for customer browsing and search results.
  name String
  
  /// Creator type: customer, seller, administrator indicating who can manage
  /// this product.
  actor_type String
  
  /// Detailed product description with specifications and features.
  content String
  
  /// Base price of the product excluding taxes and discounts.
  nominal_price Float
  
  /// Whether this product is visible to customers in search and categories.
  visible Boolean
  
  /// When this product was first made available for sale.
  opened_at DateTime?
  
  /// When this product was closed or discontinued from sale.
  closed_at DateTime?
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last modification timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp for historical preservation.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  channel shopping_mall_channels @relation(fields: [shopping_channel_id], references: [id], onDelete: Cascade)
  section shopping_mall_sections @relation(fields: [shopping_section_id], references: [id], onDelete: Cascade)
  
  shopping_mall_sale_snapshots shopping_mall_sale_snapshots[]
  shopping_mall_sale_units shopping_mall_sale_units[]
  shopping_mall_orders shopping_mall_orders[]
  shopping_mall_favorites shopping_mall_favorites[]
  shopping_mall_bookmarks shopping_mall_bookmarks[]
  
  @@unique([code])
  @@index([shopping_channel_id, visible])
  @@index([shopping_section_id, visible])
  @@index([actor_type])
  @@index([opened_at])
}

/// Historical snapshots capturing product state at specific moments for
/// audit trails and business analytics.
///
/// Sale snapshots record complete product information including pricing,
/// availability, and content state enabling comprehensive analysis of
/// product lifecycle changes. This supports seller performance analysis,
/// price tracking, and compliance auditing across the marketplace.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_sale_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced product sale's {@link shopping_mall_sales.id}.
  shopping_mall_sale_id String
  
  /// Snapshot version of the product code at moment of capture.
  code String
  
  /// Snapshot version of the product name at moment of capture.
  name String
  
  /// Snapshot version of the product content at moment of capture.
  content String
  
  /// Snapshot version of the product price at moment of capture.
  nominal_price Float
  
  /// Snapshot version of the product visibility at moment of capture.
  visible Boolean
  
  /// Snapshot creation timestamp.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  sale shopping_mall_sales @relation(fields: [shopping_mall_sale_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_sale_id, created_at], map: "shopping_mall_sale_snapshots_shopping_mall_sale_id_cre_36e298a1")
}

/// Product variant management providing inventory tracking for different
/// product options on the marketplace.
///
/// Sale units represent specific SKU-level products with individual
/// inventory counting, pricing, and management. Each unit belongs to a
/// parent sale product but maintains independent tracking for variants
/// (size, color, material).
///
/// The system enables precise inventory management, variant-specific
/// pricing, and comprehensive stock level monitoring across the multi-seller
/// catalog.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_sale_units {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product sale's {@link shopping_mall_sales.id}.
  shopping_mall_sale_id String
  
  /// Stock keeping unit identifier unique across the platform.
  sku String
  
  /// Variant-specific name for this particular product unit.
  name String
  
  /// Variant-specific description for this product unit.
  contents String
  
  /// Selling price including any variant-specific pricing adjustments.
  price Float
  
  /// Available inventory quantity for this specific unit.
  quantity Int
  
  /// Minimum stock level before restocking alerts.
  safety_stock Int
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last modification timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  sale shopping_mall_sales @relation(fields: [shopping_mall_sale_id], references: [id], onDelete: Cascade)
  
  shopping_mall_sale_unit_options shopping_mall_sale_unit_options[]
  shopping_mall_cart_items shopping_mall_cart_items[]
  shopping_mall_order_items shopping_mall_order_items[]
  
  @@unique([sku])
  @@index([shopping_mall_sale_id, sku])
  @@index([price])
  @@index([quantity])
}

/// Configurable options for product units enabling variant-specific features.
///
/// Sale unit options provide detailed configurability for product variants
/// including size, color, material, or other distinguishing characteristics.
/// These options enable precise inventory management and customer selection
/// for complex product configurations.
///
/// The system supports multiple option types per unit with value-based
/// configuration enabling sophisticated product matrix management across the
/// multi-seller catalog.
///
/// @namespace Sales
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_sale_unit_options {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent sale unit's {@link shopping_mall_sale_units.id}.
  shopping_mall_sale_unit_id String
  
  /// Option name for customer selection (Size, Color, Material).
  name String
  
  /// Option type category (select, checkbox, radio, text).
  type String
  
  /// Available option values for customer selection.
  values String
  
  /// Display order for option selection in customer interface.
  ordering Int
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last modification timestamp.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  saleUnit shopping_mall_sale_units @relation(fields: [shopping_mall_sale_unit_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_sale_unit_id, ordering], map: "shopping_mall_sale_unit_options_shopping_mall_sale_uni_22ddb995")
  @@index([name])
}