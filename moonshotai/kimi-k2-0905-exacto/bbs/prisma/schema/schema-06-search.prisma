/// Personal search history tracking for logged-in members.
///
/// Stores individual search queries performed by registered members,
/// enabling them to review their search history, find previously viewed
/// content, and maintain personal search patterns. Supports the requirement
/// for logged-in users to have personalized search history retention.
///
/// Search history entries are automatically created when members perform
/// searches and can be cleared by users at any time.
///
/// @namespace Search
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_discussion_search_history {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Member who performed the search. {@link economic_discussion_members.id}
  economic_discussion_member_id String
  
  /// Associated search query for reference. {@link
  /// economic_discussion_search_queries.id}
  economic_discussion_search_query_id String
  
  /// Actual search query text entered by the user.
  query_text String
  
  /// When this search was performed.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  member economic_discussion_members @relation(fields: [economic_discussion_member_id], references: [id], onDelete: Cascade)
  searchQuery economic_discussion_search_queries @relation(fields: [economic_discussion_search_query_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([economic_discussion_member_id, created_at], map: "economic_discussion_search_history_economic_discussion_a1f15706")
  // spellchecker: ignore-next-line
  @@index([economic_discussion_search_query_id], map: "economic_discussion_search_history_economic_discussion_69ce1254")
}

/// Master table for tracking all unique search queries across the platform.
///
/// Maintains a centralized list of individual search queries to avoid
/// duplication, track frequency, and enable analytics for understanding what
/// content and topics are most commonly searched by the community.
///
/// Each unique search query is stored once with frequency tracking, allowing
/// efficient aggregation of search patterns and popular content discovery.
///
/// @namespace Search
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_discussion_search_queries {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique search query text.
  query_text String
  
  /// Number of times this query has been used across all users.
  frequency Int
  
  /// Average result count for this query.
  results_count Int?
  
  /// Average position of clicked results. Helps measure search quality.
  average_click_position Float?
  
  /// Most recent time this query was executed.
  last_used_at DateTime
  
  /// When this query was first recorded.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  economic_discussion_search_history economic_discussion_search_history[]
  
  @@unique([query_text])
  @@index([frequency])
  @@index([last_used_at])
  @@index([results_count])
}