/// Image attachments for articles using polymorphic ownership pattern. Image
/// attachments support metadata extraction and image processing for display
/// optimization.
///
/// @namespace Attachments
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model politics_bbs_image_attachments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Main attachment entity's {@link politics_bbs_file_attachments.id}
  politics_bbs_attachment_id String
  
  /// Original filename of the uploaded image
  filename String
  
  /// Size of the image file in bytes. Maximum 5MB allowed
  file_size Int
  
  /// MIME type of the image
  mime_type String
  
  /// Storage path or URL reference to the image file
  file_path String
  
  /// Image width in pixels for display optimization
  width Int?
  
  /// Image height in pixels for display optimization
  height Int?
  
  /// Timestamp when the image was uploaded
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  attachment politics_bbs_file_attachments @relation(fields: [politics_bbs_attachment_id], references: [id], onDelete: Cascade)
  
  @@index([politics_bbs_attachment_id])
}

/// Document file attachments for articles supporting up to 10MB per file and
/// 5 files per article. Manages document uploads with format validation for
/// PDF, DOC, DOCX, and TXT formats.
///
/// @namespace Attachments
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model politics_bbs_file_attachments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Attached article's {@link politics_bbs_articles.id}.
  politics_bbs_article_id String
  
  /// Uploading member's {@link politics_bbs_members.id}.
  politics_bbs_member_id String
  
  /// Original filename of the uploaded document.
  filename String
  
  /// Size of the document file in bytes. Maximum 10MB allowed.
  file_size Int
  
  /// MIME type of the document (application/pdf, application/msword,
  /// application/vnd.openxmlformats-officedocument.wordprocessingml.document,
  /// text/plain).
  mime_type String
  
  /// Storage path or URL reference to the document file.
  file_path String
  
  /// Timestamp when the file was uploaded.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  article politics_bbs_articles @relation(fields: [politics_bbs_article_id], references: [id], onDelete: Cascade)
  member politics_bbs_members @relation(fields: [politics_bbs_member_id], references: [id], onDelete: Cascade)
  
  politics_bbs_image_attachments politics_bbs_image_attachments[]
  politics_bbs_attachment_of_visitors politics_bbs_attachment_of_visitors?
  politics_bbs_attachment_of_members politics_bbs_attachment_of_members?
  politics_bbs_attachment_of_moderators politics_bbs_attachment_of_moderators?
  
  @@index([politics_bbs_article_id])
  @@index([politics_bbs_member_id])
  @@index([created_at])
}

