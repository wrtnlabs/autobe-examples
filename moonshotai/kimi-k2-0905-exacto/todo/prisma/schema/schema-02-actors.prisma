/// Guest session tracking for temporary authentication. Each session
/// represents a guest user's current session with connection metadata for
/// audit purposes.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_guest_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The guest user's {@link todo_guests.id} who owns this session.
  todo_guest_id String
  
  /// IP address of the guest's connection.
  ip String
  
  /// Connection URL when the session was created.
  href String
  
  /// Referrer URL when the session was created.
  referrer String
  
  /// Timestamp when the session was created.
  created_at DateTime
  
  /// Timestamp when the guest session expires. Null if the session is still
  /// active.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  guest todo_guests @relation(fields: [todo_guest_id], references: [id], onDelete: Cascade)
  
  @@index([todo_guest_id, created_at])
}