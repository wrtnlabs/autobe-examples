///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_guests {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Timestamp when the guest access was created.
  created_at DateTime
  
  /// Timestamp when the guest access was last updated.
  updated_at DateTime
  
  /// Timestamp when the guest access was soft deleted. Null if the guest
  /// access is active.
