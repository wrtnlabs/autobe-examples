/// User accounts for authentication and task ownership.
///
/// Each user has their own private todo list and can only access tasks they
/// created. The user entity serves as the primary actor for task management
/// operations across the application.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_users {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User email address used for authentication. Must be unique across all
  /// users and follows RFC 5322 format.
  email String
  
  /// Hashed password for secure authentication. Meets security requirements of
  /// minimum 8 characters with letters and numbers.
  password_hash String
  
  /// Timestamp when the user account was created.
  created_at DateTime
  
  /// Timestamp when the user account was last modified.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  todo_app_user_sessions todo_app_user_sessions[]
  todo_app_tasks todo_app_tasks[]
  todo_app_task_snapshots todo_app_task_snapshots[]
  
  @@unique([email])
}

/// User session management for authentication tracking.
///
/// Sessions enable secure user authentication across multiple devices while
/// maintaining audit trails of login activity.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_user_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the user account this session belongs to. {@link
  /// todo_app_users.id}
  user_id String
  
  /// IP address of the user's connection for security tracking.
  ip String
  
  /// Connection URL where the session was established.
  href String
  
  /// Referrer URL that directed to the session creation.
  referrer String
  
  /// Timestamp when the session was created.
  created_at DateTime
  
  /// Timestamp when the session expires. Null if the session is currently
  /// active.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  user todo_app_users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([user_id, created_at])
}