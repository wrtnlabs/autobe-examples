/// Audit trail logging all significant actions performed by users within an
/// organization. Records who performed what action, when, and on which
/// entity. Supports compliance and security auditing requirements.
///
/// @namespace Activity
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model erp_hrm_activity_logs {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged organization's {@link erp_hrm_organizations.id}.
  organization_id String
  
  /// Member who performed the action's {@link erp_hrm_members.id}. Nullable
  /// when action performed by system or guest.
  actor_member_id String?
  
  /// Guest who performed the action's {@link erp_hrm_guests.id}. Nullable when
  /// action performed by member.
  actor_guest_id String?
  
  /// The type of action performed (e.g., 'create', 'update', 'delete',
  /// 'login', 'logout').
  action String
  
  /// The type of entity affected by the action (e.g., 'member', 'department',
  /// 'project', 'task').
  entity_type String
  
  /// The UUID of the specific entity affected by the action.
  entity_id String?
  
  /// IP address from which the action was performed.
  ip_address String?
  
  /// User agent string of the client that performed the action.
  user_agent String?
  
  /// Timestamp when the log entry was created.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  organization erp_hrm_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  actorMember erp_hrm_members? @relation(fields: [actor_member_id], references: [id], onDelete: Cascade)
  actorGuest erp_hrm_guests? @relation(fields: [actor_guest_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  details erp_hrm_activity_log_details[]
  
  //----
  // INDEXES
  //----
  @@index([organization_id, created_at])
  @@index([actor_member_id, created_at])
  @@index([actor_guest_id, created_at])
  @@index([entity_type, entity_id])
  @@index([action, created_at])
}

/// Normalized key-value pairs storing detailed metadata for activity log
/// entries. Supports flexible schema for different action types while
/// maintaining 1NF compliance by decomposing variable action details into
/// atomic key-value records rather than storing JSON. Common metadata
/// includes before/after values for status changes, rejection reasons for
/// timesheet reviews, and other contextual data that reconstructs full
/// circumstances of recorded actions.
///
/// @namespace Activity
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model erp_hrm_activity_log_details {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent activity log entry. {@link erp_hrm_activity_logs.id}
  activity_log_id String
  
  /// Metadata key identifying the type of detail being stored (e.g.,
  /// 'previous_status', 'new_status', 'rejection_reason', 'before_value',
  /// 'after_value').
  key String
  
  /// Metadata value associated with the key. Stores the actual contextual data
  /// such as status values, rejection reasons, or before/after states.
  value String?
  
  /// Timestamp when this detail record was created.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  activityLog erp_hrm_activity_logs @relation(fields: [activity_log_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@unique([activity_log_id, key])
  @@index([activity_log_id])
}