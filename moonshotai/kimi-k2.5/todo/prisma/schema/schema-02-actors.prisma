  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Member requesting password reset. {@link todo_app_members.id}
  todo_app_member_id String
  
  /// Cryptographically secure reset token sent to member's email.
  token String
  
  /// Token generation timestamp.
  created_at DateTime
  
  /// Token expiration timestamp. Set to 1 hour after creation.
  expired_at DateTime
  
  //----
  // RELATIONS
  //----
  member todo_app_members @relation(fields: [todo_app_member_id], references: [id], onDelete: Cascade)
  
  @@unique([todo_app_member_id])
  @@index([expired_at])
}

