/// Product categories with hierarchical structure supporting one level of
/// nesting (parent/subcategory relationship).
///
/// Categories organize products into browsable hierarchies for customer
/// navigation. Each category can optionally have a parent category, creating
/// a two-level hierarchy (top-level categories and subcategories).
/// Categories are managed exclusively by administrators.
///
/// When a category is deleted, products in that category become
/// uncategorized but remain in the system. The soft delete pattern preserves
/// category history for existing orders and audit purposes.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent category's {@link ecommerce_mall_categories.id}. Null for
  /// top-level categories.
  parent_id String?
  
  /// Category name displayed to customers. Must be unique within the same
  /// parent category.
  name String
  
  /// Optional category description for display purposes.
  description String?
  
  /// Timestamp when the category was created.
  created_at DateTime
  
  /// Timestamp when the category was last modified.
  updated_at DateTime
  
  /// Soft delete timestamp. Null if category is active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  parent ecommerce_mall_categories? @relation("recursive", fields: [parent_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  orderItemProductSnapshots ecommerce_mall_order_item_product_snapshots[]
  subcategories ecommerce_mall_categories[] @relation("recursive")
  products ecommerce_mall_products[]
  productSnapshots ecommerce_mall_product_snapshots[]
  
  //----
  // INDEXES
  //----
  @@unique([parent_id, name])
  @@index([created_at])
}

/// Main product listings in the e-commerce platform. Each product is owned
/// by a seller and categorized under a specific category. Products serve as
/// the foundation for the catalog, containing basic information like name,
/// description, and base price. The actual purchasable SKUs are managed
/// through child product variants. Products support soft deletion to
/// maintain referential integrity with historical orders while being
/// removable from active listings. Product changes are audited through
/// snapshot records for dispute resolution.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product owner seller's {@link ecommerce_mall_sellers.id}.
  seller_id String
  
  /// Product category's {@link ecommerce_mall_categories.id}.
  category_id String
  
  /// Product name displayed to customers.
  name String
  
  /// Detailed product description.
  description String
  
  /// Base price of the product. Variant-specific prices can override this.
  base_price Float
  
  /// When the product was created.
  created_at DateTime
  
  /// When the product was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp. Null if product is active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  seller ecommerce_mall_sellers @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  category ecommerce_mall_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  images ecommerce_mall_product_images[]
  variants ecommerce_mall_product_variants[]
  wishlistItems ecommerce_mall_wishlist_items[]
  orderItems ecommerce_mall_order_items[]
  reviews ecommerce_mall_reviews[]
  snapshots ecommerce_mall_product_snapshots[]
  
  //----
  // INDEXES
  //----
  @@index([seller_id, created_at])
  @@index([category_id])
}

/// Product images associated with products in the e-commerce platform.
///
/// Stores image URLs for each product with display ordering.
/// The first image in the order serves as the main product thumbnail.
/// Images can be reordered by updating the display_order field.
///
/// Images are managed through their parent product and do not support
/// independent operations.
/// Changes to images are included in product snapshots for audit trails.
///
/// {@link ecommerce_mall_products}
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_product_images {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged product's {@link ecommerce_mall_products.id}.
  product_id String
  
  /// URL to the uploaded product image file.
  image_url String
  
  /// Display ordering index for the image within the product. First image (0)
  /// serves as the main thumbnail.
  display_order Int
  
  /// Creation time of the record.
  created_at DateTime
  
  /// Last update time of the record.
  updated_at DateTime
  
  /// Deletion timestamp for soft delete. Null if the image is active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  product ecommerce_mall_products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@unique([product_id, display_order])
  @@index([product_id, created_at])
}

/// SKU-level product variants representing specific combinations of product
/// options. Each variant belongs to a product and has a unique SKU code
/// within that product. Variants can have optional price overrides. Stock
/// quantity is tracked separately via inventory_records. When variants are
/// deleted, they are soft-deleted to preserve order history. Individual
/// option values are stored in the normalized
/// ecommerce_mall_product_variant_options child table.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_product_variants {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged product's {@link ecommerce_mall_products.id}.
  product_id String
  
  /// Unique SKU code within the product. Combined with product_id for
  /// uniqueness constraint.
  sku_code String
  
  /// Optional variant-specific price that overrides the product's base price.
  /// Null when using product's base price.
  price Float?
  
  /// Timestamp when the variant was created.
  created_at DateTime
  
  /// Timestamp when the variant was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp. Null if active, set when variant is deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  product ecommerce_mall_products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  variantOptions ecommerce_mall_product_variant_options[]
  cartItems ecommerce_mall_cart_items[]
  inventoryRecords ecommerce_mall_inventory_records[]
  orderItems ecommerce_mall_order_items[]
  snapshots ecommerce_mall_product_variant_snapshots[]
  
  //----
  // INDEXES
  //----
  @@unique([product_id, sku_code])
  @@index([product_id, created_at])
}

/// Individual option value records for product variants, ensuring 1NF (First
/// Normal Form) compliance by decomposing variant options into atomic
/// key-value pairs.
///
/// Each row represents one option type and its corresponding value for a
/// specific product variant (e.g., option_name='Color', option_value='Red').
/// This normalization enables efficient querying by specific option types
/// (e.g., "find all variants with Color=Red") and eliminates JSON/array
/// storage within string fields.
///
/// Related entities:
/// - Belongs to {@link ecommerce_mall_product_variants} - each variant can
/// have multiple option records
/// - Used by {@link ecommerce_mall_cart_items} and {@link
/// ecommerce_mall_order_items} to identify specific variant selections
/// - Referenced in {@link ecommerce_mall_product_variant_snapshots} to
/// preserve option state at point-in-time
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_product_variant_options {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged product variant's {@link ecommerce_mall_product_variants.id}.
  /// Establishes which variant this option value belongs to.
  product_variant_id String
  
  /// The option type/key (e.g., 'Color', 'Size', 'Material'). Represents the
  /// classification dimension for this option value. Required field - every
  /// variant option must have a type name.
  option_name String
  
  /// The specific value for this option type (e.g., 'Red', 'Large', 'Cotton').
  /// Represents the concrete selection value within the option classification.
  /// Required field - every variant option must have a value.
  option_value String
  
  /// Record creation timestamp. Automatically set when the option value is
  /// first created.
  created_at DateTime
  
  /// Record last update timestamp. Automatically updated when the option value
  /// is modified.
  updated_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  productVariant ecommerce_mall_product_variants @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([product_variant_id, option_name], map: "ecommerce_mall_product_variant_options_product_variant_c838b71a")
}