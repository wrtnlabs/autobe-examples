  /// The article this history record belongs to. {@link
  /// discussion_board_articles.id}
  discussion_board_article_id String
  
  /// The user who authored the article at this point in time. {@link
  /// discussion_board_users.id}
  discussion_board_user_id String
  
  /// Snapshot of the article's title at the time this history record was
  /// created.
  title String
  
  /// Snapshot of the article's content body at the time this history record
  /// was created.
  content String
  
  /// Timestamp when this history record was created, which corresponds to when
  /// the article was modified.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  author discussion_board_users @relation(fields: [discussion_board_user_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, created_at], map: "discussion_board_article_histories_discussion_board_ar_65efc75d")
  // spellchecker: ignore-next-line
  @@index([discussion_board_user_id, created_at], map: "discussion_board_article_histories_discussion_board_us_cea5e5b1")
}

