  //----
  /// Primary Key.
  id String @id
  
  /// IP address used by the guest for tracking and rate limiting purposes.
  ip_address String?
  
  /// Browser user agent string for device and browser identification.
  user_agent String?
  
  /// Timestamp when the guest session was first recorded in the system.
  created_at DateTime
  
