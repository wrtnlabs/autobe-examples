/// Administrator requests submitted by users seeking admin privileges,
/// including reason text and status tracking.
///
/// @namespace Admins
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_admins_requests {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User who submitted the administrator request. {@link
  /// discussion_board_members.id}.
  member_id String
  
  /// Admin who processed the request. {@link discussion_board_admins.id}.
  admin_id String?
  
  /// Super admin who processed the request. {@link
  /// discussion_board_super_admins.id}.
  super_admin_id String?
  
  /// Text explanation provided by the user for their administrator request.
  reason String
  
  /// Current status of the request (pending/approved/rejected).
  status String
  
  /// Timestamp when the administrator request was submitted.
  created_at DateTime
  
  /// Timestamp when the request was processed (approved or rejected).
  approved_at DateTime?
  
  /// Timestamp of the last update to the request record.
  updated_at DateTime
  
  /// Timestamp for soft deletion of the request record.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  member discussion_board_members @relation(fields: [member_id], references: [id], onDelete: Cascade)
  admin discussion_board_admins? @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  superAdmin discussion_board_super_admins? @relation(fields: [super_admin_id], references: [id], onDelete: Cascade)
  
  @@index([admin_id])
  @@index([super_admin_id])
  
  @@index([member_id, status])
}

/// Admin role assignment with user references for regular admins and super
/// admins
///
/// @namespace Admins
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_admins_roles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The user who holds the admin role. {@link discussion_board_members.id},
  /// {@link discussion_board_admins.id}, or {@link
  /// discussion_board_super_admins.id}.
  user_id String
  
  /// The admin who granted this role (for promotion/demotion tracking). {@link
  /// discussion_board_super_admins.id}.
  granted_by_id String?
  
  /// The admin grade: 'regular' or 'super'.
  grade String
  
  //----
  // RELATIONS
  //----
  user discussion_board_members @relation(fields: [user_id], references: [id], onDelete: Cascade)
  grantedBy discussion_board_super_admins? @relation(fields: [granted_by_id], references: [id], onDelete: Cascade)
  
  admin discussion_board_admins?
  
  @@unique([user_id])
  @@unique([grade])
  @@index([granted_by_id])
}