/// Content sections for organizing articles. Sections provide categorical
/// organization for articles, enabling users to browse and filter content by
/// topic areas. Each section can have a name, description, and is managed by
/// administrators.
///
/// Key relationships:
/// - One-to-many with discussion_board_articles (articles belong to sections)
/// - Managed by administrators through the Systematic component
/// - No soft delete - sections are reorganized, not deleted
///
/// @namespace Content
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_sections {
  //----
  // COLUMNS
  //----
  /// Primary Key. UUID identifier for the section.
  id String @id
  
  /// Section name. Must be unique and descriptive. Used in navigation and URLs.
  name String
  
  /// Section description providing context about the section's purpose and
  /// content focus.
  description String?
  
  /// Timestamp when the section was created.
  created_at DateTime
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  articles discussion_board_articles[]
  
  //----
  // INDEXES
  //----
  @@unique([name])
  @@index([created_at])
}

/// Primary articles created by users for discussion topics in economic and
/// political domains. Articles belong to specific sections and can have
/// multiple attachments, tags, and comments. They support soft deletion for
/// audit trail purposes.
///
/// @namespace Content
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_articles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Author's {@link discussion_board_members.id}.
  author_id String
  
  /// Section's {@link discussion_board_sections.id}.
  section_id String
  
  /// Article title (required, 1-200 characters).
  title String
  
  /// Article content (required, text with no length limit).
  content String
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp (nullable if not deleted).
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  author discussion_board_members @relation(fields: [author_id], references: [id], onDelete: Cascade)
  section discussion_board_sections @relation(fields: [section_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  comments discussion_board_comments[]
  files discussion_board_article_files[]
  images discussion_board_article_images[]
  tags discussion_board_article_tags[]
  
  //----
  // INDEXES
  //----
  @@index([author_id, created_at])
  @@index([section_id, created_at])
  @@index([created_at])
}

/// Comments on articles for user discussion and engagement.
///
/// Each comment is associated with exactly one article and one author (member).
/// Comments support soft deletion with deleted_at timestamp. When an article
/// or user is deleted, all associated comments are automatically removed
/// (CASCADE). Comments are sorted chronologically (oldest first) when
/// displayed on article pages.
///
/// Relationships:
/// - Belongs to: article {@link discussion_board_articles.id}
/// - Belongs to: author {@link discussion_board_members.id}
/// - Has many: none (this is the leaf table in the hierarchy)
///
/// Index strategy: Plain indexes on article_id, author_id, and created_at
/// for efficient querying and chronological sorting.
///
/// @namespace Content
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_comments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Target article's {@link discussion_board_articles.id}. The comment
  /// belongs to this article. Cascade delete ensures all comments are removed
  /// when an article is deleted.
  article_id String
  
  /// Author member's {@link discussion_board_members.id}. The comment was
  /// created by this user. Cascade delete ensures all user comments are
  /// removed when an account is deleted.
  author_id String
  
  /// The text content of the comment. Required field containing the user's
  /// discussion response.
  content String
  
  /// Timestamp when the comment was originally created. Used for chronological
  /// sorting (oldest first).
  created_at DateTime
  
  /// Timestamp when the comment was last modified. Automatically updated on
  /// any content change.
  updated_at DateTime
  
  /// Timestamp when the comment was soft-deleted. Null indicates active
  /// comment. Used for audit trail while hiding content from users.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  article discussion_board_articles @relation(fields: [article_id], references: [id], onDelete: Cascade)
  author discussion_board_members @relation(fields: [author_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([article_id])
  @@index([author_id])
  @@index([created_at])
}