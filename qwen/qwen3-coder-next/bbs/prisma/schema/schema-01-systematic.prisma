/// System configuration parameters and settings for the discussion board
/// platform. Stores key-value pairs for system-wide configuration including
/// platform behavior, feature flags, and operational parameters.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_system_settings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique configuration key identifier.
  config_key String
  
  /// Configuration value as string representation.
  config_value String
  
  /// Detailed description of what this configuration parameter controls.
  description String?
  
  /// Configuration category for organization (e.g., 'general', 'features',
  /// 'security', 'performance').
  category String?
  
  /// Whether this configuration is currently active.
  is_enabled Boolean
  
  /// When this configuration was created.
  created_at DateTime
  
  /// When this configuration was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp for configuration history preservation.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  @@unique([config_key])
  @@index([category])
  @@index([is_enabled])
}

/// System audit logs for tracking configuration changes and system events
///
/// This table records all significant system events including configuration
/// changes, administrative actions, and important system activities. Each
/// log entry captures the event type, severity level, the actor responsible,
/// affected targets, and before/after values for audit trail purposes.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_system_logs {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Actor who performed the action. Reference to actor table based on
  /// actor_type. {@link discussion_board_members.id} when actor_type is
  /// 'member', {@link discussion_board_admins.id} when actor_type is 'admin',
  /// {@link discussion_board_super_admins.id} when actor_type is 'superAdmin',
  /// {@link discussion_board_guests.id} when actor_type is 'guest'.
  actor_id String?
  
  /// Session context when the action was performed. Reference to session table
  /// based on actor_type. {@link discussion_board_member_sessions.id} when
  /// actor_type is 'member', {@link discussion_board_admin_sessions.id} when
  /// actor_type is 'admin', {@link discussion_board_super_admin_sessions.id}
  /// when actor_type is 'superAdmin', {@link
  /// discussion_board_guest_sessions.id} when actor_type is 'guest'.
  actor_session_id String?
  
  /// Type of system event (e.g., 'CONFIG_UPDATE', 'ADMIN_PROMOTION',
  /// 'BAN_CREATED', 'DATA_EXPORT'). Standardized event codes for
  /// categorization.
  event_type String
  
  /// Severity level of the event: 'low', 'medium', 'high', 'critical'.
  /// Determines priority and notification requirements.
  severity String
  
  /// Detailed human-readable description of the system event including context
  /// and specific details.
  description String
  
  /// Type of target entity affected by the event (e.g., 'article', 'comment',
  /// 'section', 'user', 'configuration'). Used for routing and filtering.
  target_type String?
  
  /// ID of the target entity affected by the event. References the appropriate
  /// table based on target_type. Nullable for system-wide events.
  target_id String?
  
  /// JSON string containing the previous state of the target entity before the
  /// event. Used for audit trail and rollback capabilities.
  old_values String?
  
  /// JSON string containing the new state of the target entity after the
  /// event. Used for audit trail and change tracking.
  new_values String?
  
  /// IP address of the client where the action originated.
  ip_address String?
  
  /// User agent string from the client browser or application.
  user_agent String?
  
  /// Timestamp when the system log entry was created.
  created_at DateTime
  
  /// Timestamp when the system log entry was last updated.
  updated_at DateTime
  
  /// Timestamp for soft deletion of the log entry. Nullable - null means not
  /// deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  actor discussion_board_members? @relation(fields: [actor_id], references: [id], onDelete: Cascade)
  actorSession discussion_board_member_sessions? @relation(fields: [actor_session_id], references: [id], onDelete: Cascade)
  
  @@index([actor_session_id])
  
  // spellchecker: ignore-next-line
  @@unique([event_type, target_id, created_at], map: "discussion_board_system_logs_event_type_target_id_crea_3defa05d")
  @@index([event_type])
  @@index([severity])
  @@index([created_at])
  @@index([target_type, target_id])
  @@index([actor_id, created_at])
  @@index([actor_id, event_type, created_at])
}

/// System configuration history for rollback and audit purposes. Tracks
/// historical versions of system configuration with version numbers,
/// configuration data, admin references, and change timestamps for full
/// audit trail and rollback capability.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_system_config_histories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Administrator who made the configuration change. {@link
  /// discussion_board_admins.id}.
  admin_id String?
  
  /// Configuration version number for ordering and identification.
  version Int
  
  /// JSON data containing the complete configuration at this point in time.
  config_data String
  
  /// Description of why this configuration change was made.
  change_reason String?
  
  /// When this configuration snapshot was recorded.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  admin discussion_board_admins? @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  
  @@unique([version])
  // spellchecker: ignore-next-line
  @@index([admin_id, created_at], map: "discussion_board_system_config_histories_admin_id_crea_a00ca948")
  @@index([created_at])
}