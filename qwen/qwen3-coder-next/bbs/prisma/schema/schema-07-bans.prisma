/// Ban records with details about user bans including start/end times,
/// reasons, and administrative information.
///
/// @namespace Bans
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_bans_ban_records {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Target user's {@link discussion_board_members.id}.
  user_id String
  
  /// Administrating user's {@link discussion_board_admins.id}.
  admin_id String
  
  /// Reason text explaining why the user was banned.
  reason String
  
  /// Timestamp when the ban starts (typically the time of ban creation).
  start_time DateTime
  
  /// Timestamp when the ban ends (null for permanent bans).
  end_time DateTime?
  
  /// Timestamp when the ban record was created.
  created_at DateTime
  
  /// Timestamp when the ban record was last updated.
  updated_at DateTime
  
  /// Timestamp when the ban record was deleted (soft delete for audit trail).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  user discussion_board_members @relation(fields: [user_id], references: [id], onDelete: Cascade)
  admin discussion_board_admins @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  
  appeals discussion_board_bans_appeals[]
  
  @@unique([user_id, start_time])
  @@index([admin_id, created_at])
  @@index([end_time])
}

/// User appeals against ban decisions with status tracking and
/// administrative review. This table stores appeal records submitted by
/// banned users requesting review of their ban decision, along with
/// administrative processing information including approval/rejection
/// decisions and review notes.
///
/// @namespace Bans
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_bans_appeals {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced ban record's {@link discussion_board_bans_ban_records.id}.
  ban_record_id String
  
  /// Referenced user who submitted the appeal's {@link
  /// discussion_board_members.id}.
  user_id String
  
  /// Referenced administrator who reviewed the appeal's {@link
  /// discussion_board_admins.id}.
  reviewed_by_id String?
  
  /// User's explanation and justification for the appeal.
  appeal_reason String
  
  /// Current status of the appeal (pending/approved/rejected).
  status String
  
  /// Administrator's review notes and reasoning for the decision.
  review_notes String?
  
  /// Timestamp when the appeal was submitted.
  appeal_created_at DateTime
  
  /// Timestamp when the appeal was reviewed and decided.
  reviewed_at DateTime?
  
  //----
  // RELATIONS
  //----
  banRecord discussion_board_bans_ban_records @relation(fields: [ban_record_id], references: [id], onDelete: Cascade)
  user discussion_board_members @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reviewedBy discussion_board_admins? @relation(fields: [reviewed_by_id], references: [id], onDelete: Cascade)
  
  @@index([reviewed_by_id])
  
  @@index([ban_record_id])
  @@index([user_id])
  @@index([status])
  @@index([appeal_created_at])
  @@index([reviewed_at])
}

/// Audit logs for all ban-related administrative actions including creation,
