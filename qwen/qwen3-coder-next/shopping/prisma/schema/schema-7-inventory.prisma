/// Records all stock level changes for product variants. Each record
/// represents a quantity change (positive for restock/adjustment, negative
/// for order/cancellation/refund) with reason code and timestamp. Current
/// stock = sum of all records for variant.
///
/// @namespace Inventory
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_inventory_records {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product variant's {@link ecommerce_mall_product_variants.id}.
  variant_id String
  
  /// Quantity change amount (positive for restock/adjustment, negative for
  /// order/cancellation/refund).
  quantity_change Int
  
  /// Reason code: restock, order, adjustment, cancel, refund.
  reason String
  
  /// Optional reference ID for audit trail (e.g., order_id, shipment_id).
  reference_id String?
  
  /// Timestamp when inventory record was created.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  variant ecommerce_mall_product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([variant_id, created_at])
  @@index([reason])
}