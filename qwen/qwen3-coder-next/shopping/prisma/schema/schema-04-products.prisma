/// Product master data including name, description, category, base price,
/// and seller reference. Each product is owned by a seller and belongs to a
/// subcategory. Products can be active or inactive, with deletion support
/// through soft delete pattern.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Seller who owns this product. {@link shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Subcategory where this product is listed. {@link
  /// shopping_mall_subcategories.id}.
  shopping_mall_subcategory_id String?
  
  /// Product name displayed to customers.
  name String
  
  /// Detailed product description with specifications and features.
  description String
  
  /// Base price of the product in the smallest currency unit (cents).
  base_price Float
  
  /// Product availability status. Values: 'draft' (not published), 'active'
  /// (visible in catalog), 'inactive' (hidden from catalog), 'deleted' (soft
  /// delete).
  status String
  
  /// Timestamp when the product was created.
  created_at DateTime
  
  /// Timestamp when the product was last updated.
  updated_at DateTime
  
  /// Timestamp when the product was soft deleted (nullable if not deleted).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  subcategory shopping_mall_subcategories? @relation(fields: [shopping_mall_subcategory_id], references: [id], onDelete: Cascade)
  
  variants shopping_mall_product_variants[]
  images shopping_mall_product_images[]
  productSnapshots shopping_mall_product_snapshots[]
  wishlists shopping_mall_wishlists[]
  orderItems shopping_mall_order_items[]
  reviewSnapshots shopping_mall_review_snapshots[]
  reviewRating shopping_mall_product_review_ratings?
  
  @@index([shopping_mall_seller_id, status])
  @@index([shopping_mall_subcategory_id, status])
  @@index([base_price])
  @@index([created_at])
}

