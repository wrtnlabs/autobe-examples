/// Main product listings created by sellers. Each product belongs to a
/// seller and category, contains name and description, base price, and
/// availability status. Products support soft delete via deleted_at
/// timestamp. Product edits create separate snapshots for audit trail and
/// dispute resolution.
///
/// @namespace ProductManagement
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Seller who created this product. {@link ecommerce_mall_sellers.id}.
  seller_id String
  
  /// Category this product belongs to. {@link ecommerce_mall_categories.id}.
  category_id String
  
  /// Product name displayed to customers.
  name String
  
  /// Detailed product description displayed on product page.
  description String
  
  /// Base price of the product in currency units.
  base_price Float
  
  /// Whether this product is available for purchase.
  is_available Boolean
  
  /// Timestamp when this product was created.
  created_at DateTime
  
  /// Timestamp when this product was last updated.
  updated_at DateTime
  
  /// Timestamp when this product was soft deleted. Null means active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  seller ecommerce_mall_sellers @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  category ecommerce_mall_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  wishlistItems ecommerce_mall_wishlist_items[]
  reviews ecommerce_mall_reviews[]
  deletionRequests ecommerce_mall_product_deletions[]
  orderItems ecommerce_mall_order_items[]
  images ecommerce_mall_product_images[]
  variants ecommerce_mall_product_variants[]
  
  //----
  // INDEXES
  //----
  @@index([category_id])
  @@index([base_price])
  @@index([is_available])
  @@index([seller_id])
  @@index([created_at])
}

/// Multiple product images per product with ordering and main image
/// designation.
///
/// This table stores all images associated with a product. Each product can
/// have multiple images that are ordered by sort_order. The is_main flag
/// indicates which image serves as the thumbnail. Sellers can upload,
/// reorder, and delete images during product management. All image changes
/// are preserved in product snapshots created during product edits.
///
/// {@link ecommerce_mall_products.id}
///
/// @namespace ProductManagement
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_product_images {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product's {@link ecommerce_mall_products.id}.
  product_id String
  
  /// URL or path to the product image.
  image_url String
  
  /// Ordering of images within a product. Lower values appear first. Used for
  /// arranging images in the product gallery.
  sort_order Int
  
  /// Whether this image is the main thumbnail for the product.
  is_main Boolean
  
  /// When the image was uploaded.
  created_at DateTime
  
  /// When the image was last modified.
  updated_at DateTime
  
  /// When the image was soft-deleted (nullable if not deleted).
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  product ecommerce_mall_products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@unique([product_id, sort_order])
  @@index([product_id])
}

/// Product variant (SKU) records that represent specific option combinations
/// (e.g., 'color: red, size: large') for products. Each variant has a unique
/// SKU code, optional price override (falls back to product base price), and
/// current stock quantity. Stock is managed through separate inventory
/// records rather than direct updates. Deleted variants are preserved for
/// audit and historical order records.
///
/// @namespace ProductManagement
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_product_variants {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product that this variant belongs to. {@link ecommerce_mall_products.id}.
  product_id String
  
  /// Unique SKU code identifying this variant across all products.
  sku_code String
  
  /// Optional price override for this variant. If null, uses the product's
  /// base price.
  price_override Float?
  
  /// Current stock quantity for this variant. Calculated from sum of inventory
  /// records.
  stock_quantity Int
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp. Null if not deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  product ecommerce_mall_products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  cartItems ecommerce_mall_cart_items[]
  inventoryRecords ecommerce_mall_inventory_records[]
  orderItems ecommerce_mall_order_items[]
  options ecommerce_mall_product_variant_options[]
  
  //----
  // INDEXES
  //----
  @@unique([sku_code])
  @@unique([product_id, sku_code])
  @@index([product_id, created_at])
  @@index([sku_code, deleted_at])
}

