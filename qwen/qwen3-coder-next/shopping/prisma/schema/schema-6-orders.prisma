/// Main order entity representing customer purchases. Contains order-level
/// information including customer reference, shipping address, status
/// tracking, and total price calculation. Each order contains one or more
/// order items representing purchased products with their variants. The
/// order status is derived from the collective status of its order items.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_orders {
  //----
  // COLUMNS
  //----
  /// Primary Key. Unique identifier for the order.
  id String @id
  
  /// Customer who placed the order. {@link ecommerce_mall_customers.id}.
  customer_id String
  
  /// Shipping address used for this order. {@link ecommerce_mall_addresses.id}.
  shipping_address_id String
  
  /// Total price of the order calculated from all order items.
  total_price Float
  
  /// Order status derived from order item statuses: paid (all items paid),
  /// shipped (any item shipped, none delivered), delivered (all items
  /// delivered), cancelled (all items cancelled), refunded (all items
  /// refunded), partiallyCompleted (mixed states).
  order_status String
  
  /// Timestamp when the order was created.
  created_at DateTime
  
  /// Timestamp when the order was last updated.
  updated_at DateTime
  
  /// Optional timestamp for soft deletion.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer ecommerce_mall_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  shippingAddress ecommerce_mall_addresses @relation(fields: [shipping_address_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  orderOverrides ecommerce_mall_order_overrides[]
  orderItems ecommerce_mall_order_items[]
  shipments ecommerce_mall_shipments[]
  
  //----
  // INDEXES
  //----
  @@index([customer_id, created_at])
  @@index([order_status])
  @@index([shipping_address_id])
}

/// Order items represent purchased products with their snapshots at purchase
/// time. Each order item belongs to an order, references a product variant,
/// and captures the seller's profile at purchase time. Order items support
/// item-level status tracking and can be individually cancelled or refunded.
/// This table stores all snapshot data including product name, description,
/// variant options, and price to preserve historical state.
///
/// Key characteristics:
/// - Belongs to orders (one order has many order items)
/// - References products, variants, and sellers at purchase time
/// - Stores snapshot data: product name, description, variant options, price
/// - Supports item-level status: paid, shipped, delivered, cancelled, refunded
/// - Can be individually cancelled or refunded
/// - Linked to shipments via shipment_items junction table
/// - One-to-many relationship with cancellation and refund requests
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_order_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged order's {@link ecommerce_mall_orders.id}.
  order_id String
  
  /// Reference to product at purchase time {@link ecommerce_mall_products.id}.
  product_id String
  
  /// Reference to product variant at purchase time {@link
  /// ecommerce_mall_product_variants.id}.
  variant_id String
  
  /// Reference to seller profile at purchase time {@link
  /// ecommerce_mall_sellers.id}.
  seller_id String
  
  /// Number of units purchased, minimum 1.
  quantity Int
  
  /// Product name snapshot at purchase time.
  product_name String
  
  /// Product description snapshot at purchase time.
  product_description String
  
  /// Variant option values as JSON at purchase time.
  variant_options String
  
  /// Product price snapshot at purchase time.
  product_price Float
  
  /// Status of the order item: paid, shipped, delivered, cancelled, refunded.
  item_status String
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  order ecommerce_mall_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product ecommerce_mall_products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ecommerce_mall_product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  seller ecommerce_mall_sellers @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  cancellationRequest ecommerce_mall_cancellation_requests?
  refundRequests ecommerce_mall_refund_requests[]
  reviews ecommerce_mall_reviews[]
  orderOverrides ecommerce_mall_order_overrides[]
  shipmentItems ecommerce_mall_shipment_items[]
  
  //----
  // INDEXES
  //----
  @@index([order_id, item_status])
  @@index([product_id])
  @@index([variant_id, item_status])
  @@index([seller_id, item_status])
}

/// Shipment records group order items into physical packages for shipping.
/// Each shipment is created by sellers when they ship items, and includes
/// carrier name and tracking number for delivery tracking. Shipment items
/// reference the order items that are included in this shipment. Multiple
/// shipments can exist for a single order (from different sellers), and each
/// shipment contains one or more order items.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_shipments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The order that this shipment belongs to. A shipment always belongs to
  /// exactly one order. {@link ecommerce_mall_orders.id}.
  ecommerce_mall_order_id String
  
  /// The seller who created this shipment and is responsible for shipping the
  /// items. {@link ecommerce_mall_sellers.id}.
  ecommerce_mall_seller_id String
  
  /// Timestamp when the shipment record was created.
  created_at DateTime
  
  /// Timestamp when the shipment record was last updated.
  updated_at DateTime
  
  /// Optional timestamp for soft delete.
  deleted_at DateTime?
  
  /// Carrier name (e.g., 'Kuroneko Yamato', 'Yuunyu', 'CJ logistics').
  carrier_name String?
  
  /// Tracking number provided by the carrier for delivery tracking.
  tracking_number String?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  order ecommerce_mall_orders @relation(fields: [ecommerce_mall_order_id], references: [id], onDelete: Cascade)
  seller ecommerce_mall_sellers @relation(fields: [ecommerce_mall_seller_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  shipmentItems ecommerce_mall_shipment_items[]
  
  //----
  // INDEXES
  //----
  @@unique([tracking_number])
  @@index([carrier_name])
  @@index([ecommerce_mall_order_id, created_at])
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_seller_id, created_at], map: "ecommerce_mall_shipments_ecommerce_mall_seller_id_crea_af109285")
}

/// Junction table linking shipments to order items for shipment-item
/// relationships.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_shipment_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Shipment reference. {@link ecommerce_mall_shipments.id}.
  shipment_id String
  
  /// Order item reference. {@link ecommerce_mall_order_items.id}.
  order_item_id String
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  shipment ecommerce_mall_shipments @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  orderItem ecommerce_mall_order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([order_item_id])
  @@index([shipment_id, order_item_id])
}