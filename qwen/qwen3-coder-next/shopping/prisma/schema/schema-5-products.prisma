  category shopping_mall_categories @relation(fields: [shopping_mall_category_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  wishlists shopping_mall_customer_wishlists[]
  productImages shopping_mall_product_images[]
  variants shopping_mall_product_variants[]
  shoppingMallProductSnapshotsses shopping_mall_product_snapshots[]
  wishlistItems shopping_mall_wishlist_items[]
  productSnapshots shopping_mall_order_product_snapshots[]
  reviews shopping_mall_reviews[]
  
  //----
  // INDEXES
  //----
  @@unique([name])
  @@index([shopping_mall_seller_id])
  @@index([shopping_mall_category_id])
  @@index([is_deleted])
  @@index([base_price])
}

