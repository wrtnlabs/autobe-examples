  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  productSnapshot shopping_mall_product_snapshots @relation(fields: [product_snapshot_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([product_snapshot_id])
  @@index([sku_code])
  @@index([created_at])
  @@index([updated_at])
}

/// Product categories with hierarchical structure supporting one level of
/// nesting (parent-child relationships up to 2 levels). Categories form the
/// organizational backbone for product catalog browsing and navigation.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Category display name used in navigation and product listings.
  name String
  
  /// Optional category description providing additional context about the
  /// category's purpose.
  description String?
  
  /// Reference to parent category for hierarchical organization. Null for
  /// top-level categories.
  parent_category_id String?
  
  /// Timestamp when the category record was created.
  created_at DateTime
  
  /// Timestamp when the category record was last updated.
  updated_at DateTime
  
  /// Timestamp when the category record was soft-deleted. Null if not deleted.
  deleted_at DateTime?
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  sellerAssignments shopping_mall_seller_categories[]
  products shopping_mall_products[]
  productSnapshots shopping_mall_product_snapshots[]
  
  //----
  // INDEXES
  //----
  @@unique([name])
  @@index([parent_category_id])
  @@index([created_at])
}

/// Shopping cart items linking customers to product variants. Each record
/// represents a customer's selected quantity of a specific product variant
/// added to their shopping cart. The system combines quantities when the
/// same variant is added multiple times.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_cart_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who added this item to their cart. {@link
  /// shopping_mall_customers.id}.
  customer_id String
  
  /// Product variant selected by the customer. {@link
  /// shopping_mall_product_variants.id}.
  variant_id String
  
  /// Quantity of the product variant added to the cart. Must be a positive
  /// integer.
  quantity Int
  
  /// Timestamp when this item was added to the cart.
  added_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer shopping_mall_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  variant shopping_mall_product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@unique([customer_id, variant_id])
  @@index([customer_id])
  @@index([variant_id])
}

