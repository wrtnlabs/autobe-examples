  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product snapshot's {@link shopping_mall_product_snapshots.id}.
  product_snapshot_id String
  
  /// SKU code of the variant at time of snapshot.
  sku_code String
  
  /// JSON string containing variant option values (e.g.,
  /// {"color":"red","size":"L"}).
  option_values_json String
  
  /// Variant-specific price override at time of snapshot (null if using base
  /// price).
  price_override Float?
  
  /// Stock quantity of variant at time of snapshot.
  stock_quantity Int
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
