/// Product variants with SKU codes, pricing overrides, and stock quantities.
/// Each variant represents a specific configuration of options (e.g., 'Red /
/// Large') for its parent product. The option values are stored in a
/// separate child table to ensure 1NF compliance.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_variants {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product this variant belongs to. {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Unique Stock Keeping Unit code identifying this variant.
  sku_code String
  
  /// Optional price override specific to this variant. If null, uses product
  /// base price.
  price_override Float?
  
  /// Current stock quantity calculated from inventory history records.
  stock_quantity Int
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  shoppingMallShoppingCartItems shopping_mall_shopping_carts[]
  cartItems shopping_mall_cart_items[]
  optionValues shopping_mall_product_variant_option_values[]
  inventoryHistories shopping_mall_inventory_histories[]
  stock shopping_mall_variant_stocks?
  
  //----
  // INDEXES
  //----
  @@unique([sku_code])
  @@index([shopping_mall_product_id])
}

