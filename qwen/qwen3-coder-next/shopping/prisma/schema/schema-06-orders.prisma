  /// The seller who responds to the cancellation request. {@link
  /// shopping_mall_sellers.id}.
  seller_id String
  
  /// Current status of the cancellation request (pending/approved/rejected).
  status String
  
  /// Customer-provided reason for requesting cancellation.
  reason String?
  
  /// Seller-provided reason when approving or rejecting the request.
