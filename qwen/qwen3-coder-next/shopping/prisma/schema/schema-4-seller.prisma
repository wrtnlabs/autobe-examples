/// name, description, logo URL, approval status) at the moment of edit for
/// audit trail and dispute resolution. Used for historical tracking of shop
/// profile changes and reviewing profile state at time of order or dispute.
///
/// @namespace Seller
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_shop_profile_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged seller's {@link ecommerce_mall_sellers.id}.
  ecommerce_mall_seller_id String
  
  /// Seller profile state at time of edit snapshot {@link
  /// ecommerce_mall_shop_profiles.id}.
  ecommerce_mall_shop_profile_id String
  
  /// Timestamp when this snapshot was created (snapshot point-in-time).
  created_at DateTime
  
  /// Timestamp when this snapshot was last updated.
  updated_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  seller ecommerce_mall_sellers @relation(fields: [ecommerce_mall_seller_id], references: [id], onDelete: Cascade)
  profile ecommerce_mall_shop_profiles @relation(fields: [ecommerce_mall_shop_profile_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([ecommerce_mall_shop_profile_id, created_at], map: "ecommerce_mall_shop_profile_snapshots_ecommerce_mall_s_71a26b95")
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_seller_id, created_at], map: "ecommerce_mall_shop_profile_snapshots_ecommerce_mall_s_d57d9548")
}