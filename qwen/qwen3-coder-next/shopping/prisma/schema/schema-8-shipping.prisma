/// Main shipment records with tracking information from sellers
///
/// @namespace Shipping
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_shipments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the order this shipment belongs to. {@link
  /// shopping_mall_orders.id}.
  shopping_mall_order_id String
  
  /// Reference to the seller who created this shipment. {@link
  /// shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Unique tracking number provided by the carrier
  tracking_number String
  
  /// Name of the shipping carrier (e.g., "FedEx", "DHL", "Korea Express")
  tracking_carrier String
  
  /// Current status of the shipment (pending, in_transit, delivered, cancelled)
  status String
  
  /// Timestamp when the seller shipped the items
  shipped_at DateTime
  
  /// Timestamp when the customer manually confirmed delivery
  customer_confirmed_at DateTime?
  
  /// Timestamp when delivery was automatically confirmed after 14 days
  auto_confirmed_at DateTime?
  
  /// Timestamp when the shipment was cancelled (if applicable)
  cancelled_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  order shopping_mall_orders @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  deliveryConfirmations shopping_mall_order_delivery_confirmations[]
  items shopping_mall_shipment_items[]
  statusLogs shopping_mall_shipment_status_logs[]
  autoConfirmations shopping_mall_delivery_auto_confirmations[]
  
  //----
  // INDEXES
  //----
  @@index([shopping_mall_order_id, status])
  @@index([shopping_mall_seller_id, status])
}

/// Linkage between shipments and order items being shipped. This junction
/// table enables tracking which specific order items are included in each
/// shipment, supporting partial shipments and multi-seller order scenarios
/// where different items ship separately.
///
/// @namespace Shipping
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_shipment_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged shipment's {@link shopping_mall_shipments.id}. The shipment that
  /// contains this order item.
  shopping_mall_shipment_id String
  
  /// Belonged order item's {@link shopping_mall_order_items.id}. The order
  /// item being shipped in this shipment.
  shopping_mall_order_item_id String
  
  /// When this shipment item linkage was created.
  created_at DateTime
  
  /// When this shipment item linkage was last updated.
  updated_at DateTime
  
  /// When this shipment item linkage was soft deleted (nullable if not
  /// deleted).
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  shipment shopping_mall_shipments @relation(fields: [shopping_mall_shipment_id], references: [id], onDelete: Cascade)
  orderItem shopping_mall_order_items @relation(fields: [shopping_mall_order_item_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([shopping_mall_order_item_id])
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_shipment_id, shopping_mall_order_item_id], map: "shopping_mall_shipment_items_shopping_mall_shipment_id_99ee1951")
}

/// Tracks delivery status history for each shipment with timestamp and
/// status changes. This table maintains a complete audit trail of all status
/// transitions that a shipment undergoes during its lifecycle, from initial
/// creation through final delivery or cancellation. Each status change
/// creates a new log entry with the timestamp, status value, and optional
/// notes from the system or administrator.
///
/// @namespace Shipping
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_shipment_status_logs {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Shipment's {@link shopping_mall_shipments.id}. The shipment that this
  /// status log belongs to.
  shopping_mall_shipment_id String
  
  /// Current status of the shipment. Values: pending (waiting for processing),
  /// shipped (out for delivery), in_transit (moving between facilities),
  /// out_for_delivery (final delivery attempt), delivered (successfully
  /// delivered), cancelled (shipment cancelled).
  status String
  
  /// Detailed status message or notes explaining the status change. Can
  /// include carrier notes, delivery attempt results, or administrative
  /// comments.
  status_message String?
  
  /// Timestamp when this status was recorded.
  status_at DateTime
  
  /// When this status log record was created in the system.
  created_at DateTime
  
  /// When this status log record was last updated. For append-only audit
  /// records, this may remain null as status logs are typically not modified
  /// after creation.
  updated_at DateTime?
  
  /// Soft delete timestamp for compliance and audit purposes. Status logs are
  /// typically preserved for audit trail even when associated shipments are
  /// soft-deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  shipment shopping_mall_shipments @relation(fields: [shopping_mall_shipment_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([shopping_mall_shipment_id, status_at], map: "shopping_mall_shipment_status_logs_shopping_mall_shipm_74f4b45e")
  // spellchecker: ignore-next-line
  @@index([shopping_mall_shipment_id, status], map: "shopping_mall_shipment_status_logs_shopping_mall_shipm_3a882a89")
  @@index([status_at])
}

/// Records automatic delivery confirmation events when customers don't
/// manually confirm within 14 days. This table captures system-initiated
/// status changes that occur when shipping deliveries are not confirmed by
/// customers within the specified timeframe, ensuring delivery records
/// remain complete for audit purposes.
///
/// @namespace Shipping
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_delivery_auto_confirmations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Shipment's {@link shopping_mall_shipments.id}.
  shopping_mall_shipment_id String
  
  /// Timestamp when the delivery was automatically confirmed (14 days after
  /// shipment).
  confirmed_at DateTime
  
  /// Identifier for the automated process that confirmed the delivery.
  auto_confirmed_by String
  
  /// When this automatic confirmation record was created.
  created_at DateTime
  
  /// When this automatic confirmation record was last updated.
  updated_at DateTime
  
  /// Optional soft delete timestamp for audit trail preservation.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  shipment shopping_mall_shipments @relation(fields: [shopping_mall_shipment_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([shopping_mall_shipment_id], map: "shopping_mall_delivery_auto_confirmations_shopping_mal_621ed68b")
  @@index([confirmed_at])
}

/// Shipping carrier integration configuration table that stores API
/// credentials, endpoints, and connection settings for external shipping
/// partners. This table enables the platform to connect with multiple
/// shipping carriers (such as FedEx, UPS, DHL) and manage their integration
/// configurations for automated shipping label generation, tracking, and
/// delivery notifications.
///
/// @namespace Shipping
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_shipping_carriers {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique code identifier for the carrier (e.g., 'fedex', 'ups', 'dhl',
  /// 'usps'). Used internally to reference the carrier in other tables.
  code String
  
  /// Display name of the shipping carrier shown to customers and
  /// administrators (e.g., 'FedEx', 'United Parcel Service', 'DHL Express').
  name String
  
  /// Base URL endpoint for the carrier's API (e.g.,
  /// 'https://api.fedex.com/ws').
  api_endpoint String
  
  /// API authentication key or username provided by the carrier for secure API
  /// access.
  api_key String
  
  /// API secret or password used for authentication with the carrier's API.
  api_secret String
  
  /// Account number assigned by the carrier for billing and tracking purposes.
  account_number String?
  
  /// Indicates if this carrier is currently enabled for use in the platform.
  is_enabled Boolean
  
  /// The date and time when this carrier configuration was created.
  created_at DateTime
  
  /// The date and time when this carrier configuration was last updated.
  updated_at DateTime
  
  /// Optional date and time when this carrier configuration was disabled or
  /// archived (soft delete).
  deleted_at DateTime?
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  configs shopping_mall_shipping_carrier_configs[]
  
  //----
  // INDEXES
  //----
  @@unique([code])
  @@index([is_enabled])
  @@index([created_at])
}

