/// Product categories with hierarchical structure supporting one-level
/// subcategory nesting. Categories are used to organize products for
/// browsing and filtering.
///
/// @namespace Categories
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent category reference for hierarchical structure. Nullable for
  /// top-level categories.
  parent_category_id String?
  
  /// Category name (required, unique).
  name String
  
  /// Category description (optional).
  description String?
  
  /// Timestamp when category was created.
  created_at DateTime
  
  /// Timestamp when category was last updated.
  updated_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  parentCategory ecommerce_mall_categories? @relation("recursive", fields: [parent_category_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  childCategories ecommerce_mall_categories[] @relation("recursive")
  snapshots ecommerce_mall_category_snapshots[]
  products ecommerce_mall_products[]
  
  //----
  // INDEXES
  //----
  @@unique([name])
  @@index([parent_category_id])
}

/// Audit trail for category edits. Records the category name and description
/// at the time of each edit, enabling historical review and dispute
/// resolution. Snapshots are immutable and cannot be deleted. Each record
/// preserves the category state (name, description) before and after
/// changes.
///
/// @namespace Categories
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_category_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Category that was changed. {@link ecommerce_mall_categories.id}.
  category_id String
  
  /// Administrator who performed the edit. {@link ecommerce_mall_admins.id}.
  admin_id String?
  
  /// Type of edit that triggered the snapshot (edit).
  snapshot_type String
  
  /// Category name before the edit.
  before_name String
  
  /// Category description before the edit.
  before_description String
  
  /// Category name after the edit.
  after_name String
  
  /// Category description after the edit.
  after_description String
  
  /// Timestamp when the snapshot was created (when the edit occurred).
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  category ecommerce_mall_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  admin ecommerce_mall_admins? @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([admin_id])
  @@index([category_id, created_at])
}