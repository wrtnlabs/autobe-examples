/// Customer reviews with ratings and text content for products
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_reviews {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged order item's {@link shopping_mall_order_items.id}
  shopping_mall_order_item_id String
  
  /// Belonged product's {@link shopping_mall_products.id}
  shopping_mall_product_id String
  
  /// Customer who wrote this review's {@link shopping_mall_customers.id}
  shopping_mall_customer_id String
  
  /// Rating score from 1 to 5 stars
  rating Int
  
  /// Review text content provided by customer (optional)
  text_content String?
  
  /// Soft delete flag for reviews
  is_deleted Boolean
  
  /// Timestamp when the review was deleted (soft delete)
  deleted_at DateTime?
  
  /// Timestamp when the review was created
  created_at DateTime
  
  /// Timestamp when the review was last updated
  updated_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  orderItem shopping_mall_order_items @relation(fields: [shopping_mall_order_item_id], references: [id], onDelete: Cascade)
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots shopping_mall_review_snapshots[]
  votes shopping_mall_review_votes[]
  
  //----
  // INDEXES
  //----
  @@unique([shopping_mall_order_item_id])
  @@index([shopping_mall_product_id, created_at])
  @@index([shopping_mall_customer_id, created_at])
}

/// Historical snapshots of review edits for audit trail and dispute
/// resolution. Each review edit creates a new snapshot preserving the rating
/// and text content at that point in time.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_review_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged review's {@link shopping_mall_reviews.id}. References the
  /// original review that this snapshot captures.
  shopping_mall_review_id String
  
  /// Rating value (1 to 5 stars) at the time of this snapshot.
  rating Int
  
  /// Review text content at the time of this snapshot. Empty string when no
  /// text was provided.
  text_content String
  
  /// Timestamp when this snapshot was created (review edit time).
  created_at DateTime
  
  /// Timestamp when this snapshot record was created in the database.
  record_created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  review shopping_mall_reviews @relation(fields: [shopping_mall_review_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([shopping_mall_review_id, created_at], map: "shopping_mall_review_snapshots_shopping_mall_review_id_8f74bdf1")
}

/// Customer review helpfulness votes from other users for quality assessment
/// and review ranking.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_review_votes {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reviewer who voted on the review. {@link shopping_mall_customers.id}.
  customer_id String
  
  /// Target review that received the vote. {@link shopping_mall_reviews.id}.
  review_id String
  
  /// Whether the vote indicates the review was helpful.
  was_helpful Boolean
  
  /// Timestamp when the vote was recorded.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer shopping_mall_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  review shopping_mall_reviews @relation(fields: [review_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@unique([customer_id, review_id])
  @@index([review_id])
  @@index([customer_id, created_at])
}