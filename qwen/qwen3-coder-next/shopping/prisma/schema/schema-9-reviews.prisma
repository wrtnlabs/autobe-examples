/// usefulness.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_review_helpfulness_votes {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The review being voted on. {@link ecommerce_mall_reviews.id}.
  review_id String
  
  /// The customer who cast the helpfulness vote. {@link
  /// ecommerce_mall_customers.id}.
  customer_id String
  
  /// When the helpfulness vote was cast.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  review ecommerce_mall_reviews @relation(fields: [review_id], references: [id], onDelete: Cascade)
  customer ecommerce_mall_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([customer_id, review_id], map: "ecommerce_mall_review_helpfulness_votes_customer_id_re_4e2f365b")
  // spellchecker: ignore-next-line
  @@index([review_id, created_at], map: "ecommerce_mall_review_helpfulness_votes_review_id_crea_137962c3")
}

/// Optional images uploaded with reviews to provide visual context or
/// evidence. Each review can have multiple images with sort order and
/// timestamps. Images are automatically deleted when the associated review
/// is deleted.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_review_images {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Review that this image belongs to. {@link ecommerce_mall_reviews.id}.
  ecommerce_mall_review_id String
  
  /// URL of the uploaded review image.
  image_url String
  
  /// Order of this image relative to other images for the same review. Lower
  /// numbers appear first.
  sort_order Int
  
  /// When this image was uploaded.
  created_at DateTime
  
  /// When this image was last modified.
  updated_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
