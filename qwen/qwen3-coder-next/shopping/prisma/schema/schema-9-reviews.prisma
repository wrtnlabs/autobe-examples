/// Customer reviews for products with rating (1-5 stars) and optional text
/// content. Each review is owned by a customer and associated with a
/// specific product and order item. Reviews can be edited (creating
/// snapshots) or deleted (preserved in snapshots).
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_reviews {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who wrote the review. {@link ecommerce_mall_customers.id}.
  customer_id String
  
  /// Product being reviewed. {@link ecommerce_mall_products.id}.
  product_id String
  
  /// Order item proof of purchase. {@link ecommerce_mall_order_items.id}.
  order_item_id String
  
  /// Customer rating (1-5 stars, required).
  rating Int
  
  /// Optional review text content.
  text_content String?
  
  /// Review creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp. Nullable for active reviews.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer ecommerce_mall_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  product ecommerce_mall_products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  orderItem ecommerce_mall_order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots ecommerce_mall_review_snapshots[]
  helpfulnessVotes ecommerce_mall_review_helpfulness_votes[]
  images ecommerce_mall_review_images[]
  
  //----
  // INDEXES
  //----
  @@index([order_item_id])
  @@index([customer_id, created_at])
  @@index([product_id, created_at])
}

/// Historical snapshots of reviews for audit trail and dispute resolution.
/// Created whenever a review is edited or updated. Snapshots are immutable
/// and preserve the review state (rating, text) at that point in time.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_review_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the original review that this snapshot captures. {@link
  /// ecommerce_mall_reviews.id}.
  ecommerce_mall_review_id String
  
  /// Rating value from 1 to 5 stars given by the customer.
  rating Int
  
  /// Optional text content of the review. Can be null if customer didn't
  /// provide text.
  text_content String?
  
  /// Type of snapshot: 'edit' for review edits or 'deleted' for reviews marked
  /// for deletion. Identifies the business event that triggered this snapshot.
  snapshot_type String
  
  /// Timestamp when this snapshot was created (immutable).
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  review ecommerce_mall_reviews @relation(fields: [ecommerce_mall_review_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([ecommerce_mall_review_id, created_at], map: "ecommerce_mall_review_snapshots_ecommerce_mall_review__d71d2e83")
}

