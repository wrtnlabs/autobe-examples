/// Tasks belonging to projects with status, priority, assignment, and
/// optional parent task. Tasks are created by project leads or users with
/// project:manage permission and can be assigned to project members. Status
/// changes are tracked in hrm_tracker_task_histories. Subtasks are supported
/// with one level of nesting through the parent task relationship.
///
/// @namespace Project
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrm_tracker_tasks {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Project this task belongs to. {@link hrm_tracker_projects.id}.
  project_id String
  
  /// Employee assigned to this task (must be project member). {@link
  /// hrm_tracker_employees.id}.
  assigned_employee_id String?
  
  /// Parent task for subtasks (one level nesting only). {@link
  /// hrm_tracker_tasks.id}.
  parent_task_id String?
  
  /// Task title (required).
  title String
  
  /// Task description with details.
  description String?
  
  /// Task status: open, in-progress, completed, or closed.
  status String
  
  /// Task priority: low, medium, high, or urgent.
  priority String
  
  /// Estimated hours to complete this task.
  estimated_hours Float?
  
  /// Task due date.
  due_date DateTime?
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp (nullable means not deleted).
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  project hrm_tracker_projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assignedEmployee hrm_tracker_employees? @relation(fields: [assigned_employee_id], references: [id], onDelete: Cascade)
  parentTask hrm_tracker_tasks? @relation("recursive", fields: [parent_task_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  subtasks hrm_tracker_tasks[] @relation("recursive")
  taskHistories hrm_tracker_task_histories[]
  timelogs hrm_tracker_timelogs[]
  timers hrm_tracker_timers[]
  
  //----
  // INDEXES
  //----
  @@index([project_id])
  @@index([assigned_employee_id])
  @@index([parent_task_id])
  @@index([status])
  @@index([priority])
}

/// Records status change history for tasks with timestamp, actor, and
