/// Projects owned by organizations with name, color, status, budget, and
/// dates. Projects serve as containers for tasks and project members.
/// Organization-scoped for multi-tenancy with soft delete support.
/// Archived/completed projects preserve existing timelogs.
///
/// @namespace Project
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrm_tracker_projects {
  //----
  // COLUMNS
  //----
  /// Primary Key. UUID identifier for the project record.
  id String @id
  
  /// Organization's {@link hrm_tracker_organizations.id}. Project belongs to
  /// this organization for multi-tenancy isolation.
  hrm_tracker_organization_id String
  
  /// Project name (required). Max 255 characters.
  name String
  
  /// Project description (optional). Can contain detailed project information
  /// in markdown format.
  description String?
  
  /// Color code for UI visualization (required). Hex format (e.g., '#FF5733').
  color String
  
  /// Project status (required). Values: 'active', 'archived', 'completed'.
  status String
  
  /// Total budgeted hours for the project (optional). Used for budget tracking
  /// and variance analysis.
  budget_hours Float?
  
  /// Project start date (optional). When the project is scheduled to begin.
  start_date DateTime?
  
  /// Project end date (optional). When the project is scheduled to be
  /// completed.
  end_date DateTime?
  
  /// Creation timestamp.
  created_at DateTime
  
  /// Last update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp. Null if not deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  organization hrm_tracker_organizations @relation(fields: [hrm_tracker_organization_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  projectMembers hrm_tracker_project_members[]
  tasks hrm_tracker_tasks[]
  timelogs hrm_tracker_timelogs[]
  timers hrm_tracker_timers[]
  
  //----
  // INDEXES
  //----
  @@index([hrm_tracker_organization_id, status])
  @@index([status])
  @@index([deleted_at])
}

