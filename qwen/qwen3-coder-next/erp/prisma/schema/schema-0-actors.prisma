/// Guest identification records with device-based fingerprinting.
///
/// Guests are unauthenticated users who can access the system before signing
/// up. They are identified by device fingerprint and have no organization
/// context or role. When guests sign up and join an organization, they
/// become members.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrm_tracker_guests {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique device identifier for guest identification.
  device_fingerprint String
  
  /// Email address for authentication (set during signup).
  email String?
  
  /// Encrypted password for authentication.
  password_hash String?
  
  /// Timestamp when the guest record was created.
  created_at DateTime
  
  /// Timestamp when the guest record was last updated.
  updated_at DateTime
  
  /// Timestamp when the guest account was deleted (soft delete).
  deleted_at DateTime?
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  hrmtrackerguestss hrm_tracker_guest_sessions[]
  activityLogs hrm_tracker_activity_logs[]
  
  //----
  // INDEXES
  //----
  @@unique([email])
  @@index([device_fingerprint])
}

