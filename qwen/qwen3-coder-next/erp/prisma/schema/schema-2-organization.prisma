/// Main organization entity with settings, ownership, and multi-tenancy
/// context. Each organization is owned by exactly one member and can have
/// multiple employees, projects, departments, and contracts.
///
/// @namespace Organization
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrm_tracker_organizations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Organization owner member's {@link hrm_tracker_members.id}.
  owner_member_id String
  
  /// Organization name.
  name String
  
  /// Organization description.
  description String?
  
  /// Logo image URL/URI.
  logo_image_uri String?
  
  /// Organization currency code (e.g., USD, EUR, KRW).
  currency String
  
  /// Organization timezone (e.g., Asia/Seoul, America/New_York).
  timezone String
  
  /// Fiscal year start month (1-12).
  fiscal_start_month Int
  
  /// Organization status (active, archived, deleted).
  status String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Record deletion timestamp for soft delete.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  ownedOrganization hrm_tracker_members @relation(fields: [owner_member_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  systemConfigs hrm_tracker_system_configs[]
  pendingInvitations hrm_tracker_pending_invitations[]
  employees hrm_tracker_employees[]
  roles hrm_tracker_roles[]
  departments hrm_tracker_departments[]
  employeeHistories hrm_tracker_employee_histories[]
  projects hrm_tracker_projects[]
  taskHistories hrm_tracker_task_histories[]
  timelogs hrm_tracker_timelogs[]
  timesheets hrm_tracker_timesheets[]
  employeeContracts hrm_tracker_employee_contracts[]
  timers hrm_tracker_timers[]
  
  //----
  // INDEXES
  //----
  @@unique([name])
  @@unique([owner_member_id])
  @@index([created_at])
  @@index([status])
  @@index([deleted_at])
  @@index([owner_member_id, created_at])
}

/// Pending invitations for employee onboarding before user signup. Each
/// invitation is associated with an organization and an email address.
///
/// @namespace Organization
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrm_tracker_pending_invitations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Target organization that sent the invitation.
  organization_id String
  
  /// Member who sent the invitation.
  invited_by_member_id String?
  
  /// Session context when the invitation was sent.
  invited_by_member_session_id String?
  
  /// Email address of the invited person. Must be unique within the
  /// organization.
  email String
  
  /// Optional message included in the invitation email.
  message String?
  
  /// Role name to assign to the invited employee (e.g., 'Manager', 'Employee').
  role_name String?
  
  /// Department name to assign to the invited employee (optional).
  department_name String?
  
  /// Timestamp when the invitation was sent.
  invited_at DateTime?
  
  /// Timestamp when the invitation was resolved (user signed up and became
  /// employee).
  resolved_at DateTime?
  
  /// Invitation status: 'pending', 'accepted', 'expired', or 'cancelled'.
  /// Default is 'pending'.
  status String
  
  /// Unique token for invitation link. Used for verification when user signs
  /// up.
  token String
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  organization hrm_tracker_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  invitedByMember hrm_tracker_members? @relation(fields: [invited_by_member_id], references: [id], onDelete: Cascade)
  invitedByMemberSession hrm_tracker_member_sessions? @relation(fields: [invited_by_member_session_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([invited_by_member_session_id], map: "hrm_tracker_pending_invitations_invited_by_member_sess_bf775cf3")
  @@unique([organization_id, email])
  @@unique([token])
  @@index([organization_id, status])
  @@index([email])
  // spellchecker: ignore-next-line
  @@index([invited_by_member_id, invited_at], map: "hrm_tracker_pending_invitations_invited_by_member_id_i_f06ebc88")
  @@index([invited_at])
}

/// Organization configuration settings including fiscal start month,
/// currency, timezone, and other organizational preferences.
///
/// @namespace Organization
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrm_tracker_organization_settings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Fiscal year start month (1-12). Required for financial reporting and
  /// budgeting.
  fiscal_start_month Int
  
  /// Organization's currency code (ISO 4217). Examples: USD, EUR, KRW.
  currency String
  
  /// Organization's timezone (IANA timezone name). Examples: Asia/Seoul,
  /// America/New_York.
  timezone String
  
  /// Display name of the organization for this settings context.
  name String
  
  /// URL to the organization's logo image.
  logo_url String?
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
}