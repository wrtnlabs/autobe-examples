/// Main todo item records with title, description, dates, and completion
/// status. Each todo belongs to exactly one user (todo_app_users) and can
/// have zero or one associated edit history records and trash entries.
/// Supports the complete Todo lifecycle from creation through editing,
/// completion, soft deletion, and permanent deletion.
///
/// @namespace Todo
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_todos {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Owner user's {@link todo_app_users.id}. The user who created and owns
  /// this todo item.
  todo_app_user_id String
  
  /// Timestamp when the todo item was created.
  created_at DateTime
  
  /// Timestamp when the todo item was last updated.
  updated_at DateTime
  
  /// Timestamp when the todo item was soft-deleted. Nullable indicates active
  /// todo.
  deleted_at DateTime?
  
  /// Title of the todo item. Required field, cannot be empty.
  title String
  
  /// Detailed description of the todo item. Optional field, can be empty.
  description String?
  
  /// Optional start date for the todo item. Indicates when work on this task
  /// should begin.
  start_date DateTime?
  
  /// Optional due date for the todo item. Indicates when this task should be
  /// completed.
  due_date DateTime?
  
  /// Completion status flag. True indicates the todo is completed, false
  /// indicates active/incomplete.
  is_completed Boolean
  
  //----
  // RELATIONS
  //----
  user todo_app_users @relation(fields: [todo_app_user_id], references: [id], onDelete: Cascade)
  
  editHistories todo_app_todo_edit_histories[]
  trashEntry todo_app_todo_trashes?
  
  @@index([todo_app_user_id, created_at])
  @@index([todo_app_user_id, is_completed, created_at])
  @@index([todo_app_user_id, due_date])
  @@index([todo_app_user_id, deleted_at])
  @@index([todo_app_user_id, start_date])
}

/// Edit history entries tracking all changes made to todo items. Captures
/// the state of todo fields (title, description, start_date, due_date) at
/// the time of each edit, allowing reconstruction of todo item evolution
/// over time.
///
/// This is a subsidiary entity managed through parent todo items. Each edit
/// creates a history entry that permanently records the previous values
/// before the change, supporting complete audit trails for todo item
/// modifications.
///
/// @namespace Todo
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_todo_edit_histories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced todo item's {@link todo_app_todos.id}.
  todo_id String
  
  /// Editing user's {@link todo_app_users.id}.
  user_id String
  
  /// Todo title value before the edit.
  title_before String?
  
  /// Todo description value before the edit.
  description_before String?
  
  /// Todo start date value before the edit.
  start_date_before DateTime?
  
  /// Todo due date value before the edit.
  due_date_before DateTime?
  
  /// Creation timestamp of this history entry.
  created_at DateTime
  
  /// Last update timestamp of this history entry.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  todo todo_app_todos @relation(fields: [todo_id], references: [id], onDelete: Cascade)
  user todo_app_users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([user_id])
  
  @@index([todo_id, created_at])
}

/// Trash management records for soft-deleted todo items with restoration
/// capability.
///
/// This table captures the state of todo items when they are soft-deleted by
/// users. It maintains
/// a complete snapshot of the todo at the time of deletion, allowing for
/// restoration if needed
/// before permanent deletion occurs. The table tracks which user performed
/// the deletion and
/// provides audit trail through system audit references.
///
/// Key features:
/// - Stores todo state at time of soft deletion
/// - Enables todo restoration to active state
/// - Supports permanent deletion workflow
/// - Maintains audit trail of deletion events
/// - Links to user and session for accountability
///
/// @namespace Todo
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_todo_trashes {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the soft-deleted todo item {@link todo_app_todos.id}.
  todo_id String
  
  /// User who performed the soft delete {@link todo_app_users.id}.
  user_id String
  
  /// User session during deletion {@link todo_app_user_sessions.id}.
  user_session_id String?
  
  /// System audit reference for deletion event {@link
  /// todo_app_system_audits.id}.
  system_audit_id String?
  
  /// Todo title at time of deletion.
  title String
  
  /// Todo description at time of deletion.
  description String?
  
  /// Todo start date at time of deletion (nullable if not set).
  start_date DateTime?
  
  /// Todo due date at time of deletion (nullable if not set).
  due_date DateTime?
  
  /// Timestamp when the todo was soft-deleted to trash.
  deleted_at DateTime
  
  //----
  // RELATIONS
  //----
  todo todo_app_todos @relation(fields: [todo_id], references: [id], onDelete: Cascade)
  user todo_app_users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  userSession todo_app_user_sessions? @relation(fields: [user_session_id], references: [id], onDelete: Cascade)
  systemAudit todo_app_system_audits? @relation(fields: [system_audit_id], references: [id], onDelete: Cascade)
  
  @@index([user_session_id])
  @@index([system_audit_id])
  
  @@unique([todo_id])
  @@index([user_id])
  @@index([deleted_at])
}