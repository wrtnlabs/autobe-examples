  updated_at DateTime
  
  /// Deletion timestamp for soft delete
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  user todo_app_users @relation(fields: [todo_app_user_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@unique([todo_app_user_id])
  // spellchecker: ignore-next-line
  @@index([todo_app_user_id, created_at], map: "todo_app_user_email_verifications_todo_app_user_id_cre_6206786e")
}