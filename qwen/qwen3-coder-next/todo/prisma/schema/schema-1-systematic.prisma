/// Main user table with email/password authentication credentials. Each user
/// can have one profile, multiple todos, multiple sessions, password reset
/// tokens, and email verification tokens. This is the core actor entity for
/// the authentication system.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_users {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique email address for user identification and authentication.
  email String
  
  /// Securely hashed password using bcrypt algorithm.
  password_hash String
  
  /// Timestamp when the user account was created.
  created_at DateTime
  
  /// Timestamp when the user account was last updated.
  updated_at DateTime
  
  /// Timestamp when the user account was soft-deleted. Null if active.
  /// Supports trash management workflow for account deletion with recovery
  /// possibility.
  deleted_at DateTime?
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  sessions todo_app_user_sessions[]
  passwordResets todo_app_user_password_resets[]
  emailVerifications todo_app_user_email_verifications[]
  todos todo_app_todos[]
  
  //----
  // INDEXES
  //----
  @@index([email])
}

/// JWT session tokens with access and refresh token support. Each session
/// represents a logged-in state for a user with connection metadata and
/// expiration tracking.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_user_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Owner user's {@link todo_app_users.id}.
  todo_app_user_id String
  
  /// Client IP address when session was created.
  ip String
  
  /// Page URL (href) when session was created.
  href String
  
  /// Referrer URL when session was created.
  referrer String?
  
  /// Session creation timestamp.
  created_at DateTime
  
  /// Session expiration timestamp. Sessions beyond this time are invalid.
  expired_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  user todo_app_users @relation(fields: [todo_app_user_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([todo_app_user_id, created_at])
}

/// Password reset tokens with expiration for password recovery
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_user_password_resets {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reset request user {@link todo_app_users.id}.
  todo_app_user_id String
  
  /// Password reset token for verification.
  token String
  
  /// Token expiration timestamp. Reset requests older than this are invalid.
  expired_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  user todo_app_users @relation(fields: [todo_app_user_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@unique([token])
  @@index([todo_app_user_id])
}

/// Email verification tokens for account verification workflows
///
