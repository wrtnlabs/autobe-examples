  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique identifier for the guest's device/browser session.
  device_id String
  
  /// IP address of the guest at session creation.
  ip String
  
  /// Browser user agent string for device identification.
  user_agent String?
  
  /// Timestamp when the guest account was created.
  created_at DateTime
  
  /// Timestamp when the guest account was last updated.
