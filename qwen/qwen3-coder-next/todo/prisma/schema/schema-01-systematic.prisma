/// System audit log entries for tracking important system events such as
/// authentication attempts, security events, and configuration changes. This
/// table provides comprehensive audit trails for security monitoring and
/// compliance requirements.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_system_audits {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User who triggered the audit event. {@link todo_app_users.id}.
  todo_app_user_id String?
  
  /// Category of the audit event (login, logout, password_change,
  /// security_alert, system_config_change, etc.).
  event_type String
  
  /// IP address from which the event originated.
  ip_address String
  
  /// Browser or client user agent string.
  user_agent String?
  
  /// Additional event details in JSON format (e.g., login success/failure
  /// reason, config changes details).
  event_metadata String?
  
  /// Timestamp when the audit event occurred.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  user todo_app_users? @relation(fields: [todo_app_user_id], references: [id], onDelete: Cascade)
  
  todoTrashes todo_app_todo_trashes[]
  
  @@index([todo_app_user_id, created_at])
  @@index([event_type, created_at])
  @@index([ip_address, created_at])
}

/// System configuration settings and parameters for application-wide
/// configuration management.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_system_settings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique configuration key identifier (e.g., 'app.name',
  /// 'features.enabled').
  key String
  
  /// Configuration value stored as string for flexibility (supports JSON for
  /// complex values).
  value String
  
  /// Human-readable description of what this configuration setting controls.
  description String?
  
  /// Flag indicating whether the value field contains JSON-formatted data.
  is_json Boolean
  
  /// Timestamp when this configuration was created.
  created_at DateTime
  
  /// Timestamp when this configuration was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  @@unique([key])
  @@index([created_at])
}