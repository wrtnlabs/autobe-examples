/// Single-level comments on articles enabling discussion threads. Each
/// comment belongs to exactly one article and is authored by one member.
/// Comments are displayed in chronological order (oldest first) and support
/// edit/delete operations by owners and administrators. Cascade deletion
/// occurs when parent articles are deleted.
///
/// @namespace Comments
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_comments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent article's {@link discussion_board_articles.id}. Comments cannot
  /// exist without an article.
  discussion_board_article_id String
  
  /// Author member's {@link discussion_board_members.id}. Only registered
  /// members can post comments.
  discussion_board_member_id String
  
  /// Comment text content. Required field with minimum and maximum length
  /// constraints per validation rules.
  content String
  
  /// Timestamp when the comment was initially created. Used for chronological
  /// sorting (oldest first).
  created_at DateTime
  
  /// Timestamp when the comment was last modified. Updated on each edit
  /// operation.
  updated_at DateTime
  
  /// Timestamp when the comment was soft deleted. Null indicates active
  /// comment. Set on owner deletion, admin deletion, or cascade from article
  /// deletion.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  member discussion_board_members @relation(fields: [discussion_board_member_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots discussion_board_comment_snapshots[]
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, created_at], map: "discussion_board_comments_discussion_board_article_id__aa7deb51")
  @@index([discussion_board_member_id])
}

/// Point-in-time snapshots of comments for audit trail. Captures comment
/// state at each edit to preserve edit history and enable content moderation
/// review. Each snapshot record is immutable and append-only, creating a
/// complete historical record of comment modifications.
///
/// @namespace Comments
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_comment_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent comment's {@link discussion_board_comments.id}. References the
  /// comment this snapshot belongs to.
  discussion_board_comment_id String
  
  /// Author member's {@link discussion_board_members.id} at snapshot time.
  /// Denormalized for historical accuracy.
  discussion_board_member_id String
  
  /// Parent article's {@link discussion_board_articles.id} at snapshot time.
  /// Denormalized for historical accuracy.
  discussion_board_article_id String
  
  /// Comment content at snapshot time. Preserves the exact text as it appeared
  /// when this snapshot was created.
  content String
  
  /// Timestamp when this snapshot was created. Records the exact moment of the
  /// edit or state capture.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  comment discussion_board_comments @relation(fields: [discussion_board_comment_id], references: [id], onDelete: Cascade)
  member discussion_board_members @relation(fields: [discussion_board_member_id], references: [id], onDelete: Cascade)
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([discussion_board_comment_id, created_at], map: "discussion_board_comment_snapshots_discussion_board_co_67d99e69")
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_id], map: "discussion_board_comment_snapshots_discussion_board_me_cd7c9291")
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id], map: "discussion_board_comment_snapshots_discussion_board_ar_5928f758")
}