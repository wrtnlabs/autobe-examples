  hrm_platform_project_id String
  
  /// Role within the project, either 'member' or 'project-lead'. Project-leads
  /// can manage tasks within their project while regular members cannot.
  role String
  
  /// Timestamp when the project membership was created.
  created_at DateTime
  
  /// Timestamp when the project membership was last updated.
  updated_at DateTime
  
