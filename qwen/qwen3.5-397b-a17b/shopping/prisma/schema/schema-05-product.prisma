  /// image. Subsequent images follow in order. This ordering is preserved in
  /// the snapshot to maintain accurate historical representation.
  display_order Int
  
  /// Timestamp when this snapshot image record was created.
  ///
  /// Records the exact time when the product snapshot was created, preserving
  /// when this image configuration existed. This field is immutable and cannot
  /// be modified after creation.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  productSnapshot shopping_mall_product_snapshots @relation(fields: [shopping_mall_product_snapshot_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_snapshot_id, display_order], map: "shopping_mall_product_snapshot_images_shopping_mall_pr_128f0d5c")
}