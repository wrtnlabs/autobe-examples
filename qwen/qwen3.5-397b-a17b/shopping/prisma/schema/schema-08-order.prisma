  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  orderItems shopping_mall_order_items[]
  
  //----
  // INDEXES
  //----
  @@index([shopping_mall_order_id])
  @@index([shopping_mall_seller_id])
  @@index([shipped_at])
}

