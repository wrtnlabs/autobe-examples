/// Customer profile information extending basic authentication with display
/// name and phone number. Each customer has exactly one profile linked to
/// their identity in {@link shopping_mall_customers}. Profile data is
/// editable by the customer and changes are tracked in {@link
/// shopping_mall_customer_profile_snapshots} for audit trail.
///
/// @namespace actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_customer_profiles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer's {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Customer's public display name shown in orders, reviews, and profile
  /// pages.
  display_name String
  
  /// Customer's contact phone number for order notifications and support.
  phone_number String
  
  /// Timestamp when the profile was created.
  created_at DateTime
  
  /// Timestamp when the profile was last updated.
  updated_at DateTime
  
  /// Timestamp when the profile was soft deleted, null if active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots shopping_mall_customer_profile_snapshots[]
  
  //----
  // INDEXES
  //----
  @@unique([shopping_mall_customer_id])
}

