  /// URL of the product image stored in cloud storage or CDN.
  image_url String
  
  /// Display order of the image within the product's image gallery. Lower
  /// numbers appear first.
  display_order Int
  
  /// Timestamp when the product image was created.
  created_at DateTime
  
  /// Timestamp when the product image was last updated.
  updated_at DateTime
  
  /// Timestamp when the product image was soft deleted. Null if active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, display_order], map: "shopping_mall_product_images_shopping_mall_product_id__1e493e13")
}

/// Product variants representing different configurations (SKU) of a
