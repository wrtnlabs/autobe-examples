  id String @id
  
  /// Belonged product's {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Unique stock keeping unit code identifying this specific variant
  /// configuration.
  sku_code String
  
  /// Optional price override for this variant. If null, the product's base
  /// price is used.
  price Float?
  
  /// Current available stock quantity for this variant.
  stock_quantity Int
  
  /// Whether this variant has been soft deleted and should be hidden from
  /// catalog.
  deleted Boolean
  
  /// Timestamp when this variant was first created.
  created_at DateTime
  
  /// Timestamp when this variant was last updated.
  updated_at DateTime
  
  /// Timestamp when this variant was soft deleted. Null if not deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots shopping_mall_product_variant_snapshots[]
  options shopping_mall_product_variant_options[]
  inventoryRecords shopping_mall_inventory_records[]
  cartItems shopping_mall_cart_items[]
  orderItems shopping_mall_order_items[]
  
  //----
  // INDEXES
  //----
  @@unique([sku_code])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, deleted], map: "shopping_mall_product_variants_shopping_mall_product_i_a34d841a")
}

/// Immutable point-in-time captures of product state referenced by order
/// items for historical accuracy. Each snapshot preserves the product's
/// name, description, category, and base price at the moment of creation,
/// ensuring order history remains accurate even if the original product is
/// modified or deleted. Snapshots are created when products are edited and
/// are never modified or deleted. Contains multiple {@link
/// shopping_mall_product_snapshot_images} and referenced by {@link
/// shopping_mall_order_items}.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product's {@link shopping_mall_products.id} that this snapshot
  /// captures.
  shopping_mall_product_id String
  
  /// Category's {@link shopping_mall_categories.id} at the time of snapshot
  /// creation.
  shopping_mall_category_id String
  
  /// Seller's {@link shopping_mall_sellers.id} who created this snapshot.
  shopping_mall_seller_id String
  
  /// Product name captured at snapshot time.
  name String
  
  /// Product description captured at snapshot time.
  description String
  
  /// Product base price captured at snapshot time.
  base_price Float
  
  /// Timestamp when the snapshot was created, capturing the product state at
  /// this moment.
  snapshot_at DateTime
  
  /// Record creation timestamp.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  category shopping_mall_categories @relation(fields: [shopping_mall_category_id], references: [id], onDelete: Cascade)
  snapshotBy shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  images shopping_mall_product_snapshot_images[]
  variantSnapshots shopping_mall_product_variant_snapshots[]
  orderItems shopping_mall_order_items[]
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, snapshot_at], map: "shopping_mall_product_snapshots_shopping_mall_product__16a3b747")
  @@index([shopping_mall_category_id])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_seller_id, snapshot_at], map: "shopping_mall_product_snapshots_shopping_mall_seller_i_4d899b5d")
}

