/// Normalized child table storing product variant option key-value pairs to
/// maintain First Normal Form (1NF) compliance. Each row represents a single
/// option attribute (e.g., color=Red, size=Large) for a product variant.
/// This design enables efficient querying and indexing of individual option
/// values without parsing JSON.
///
/// Belongs to {@link shopping_mall_product_variants} and is managed through
/// the parent variant's lifecycle. Multiple options can exist for a single
/// variant, but each option key must be unique per variant to prevent
/// conflicting definitions.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_variant_options {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged product variant's {@link shopping_mall_product_variants.id}.
  shopping_mall_product_variant_id String
  
  /// Option attribute name such as color, size, material, or other variant
  /// distinguishing characteristics.
  key String
  
  /// Option attribute value such as Red, Large, Cotton, or the specific value
  /// for the option key.
  value String
  
  /// Timestamp when this option record was created.
  created_at DateTime
  
  /// Timestamp when this option record was last updated.
  updated_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  variant shopping_mall_product_variants @relation(fields: [shopping_mall_product_variant_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_product_variant_id, key], map: "shopping_mall_product_variant_options_shopping_mall_pr_23282872")
}