/// Customer reviews with ratings for purchased products. Each review links a
/// customer to a product they purchased through a specific order. Enforces
/// one review per product per order constraint. Reviews can be edited
/// (creating snapshots) and soft-deleted while preserving historical data
/// for dispute resolution.
///
/// @namespace reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_reviews {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Review author's {@link shopping_mall_customers.id}.
  customer_id String
  
  /// Reviewed product's {@link shopping_mall_products.id}.
  product_id String
  
  /// Purchase order's {@link shopping_mall_orders.id} containing the reviewed
  /// product.
  order_id String
  
  /// Star rating from 1 to 5 stars.
  rating Int
  
  /// Optional review text content describing customer experience.
  content String?
  
  /// Timestamp when the review was first created.
  created_at DateTime
  
  /// Timestamp when the review was last modified.
  updated_at DateTime
  
  /// Timestamp when the review was soft-deleted, null if active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer shopping_mall_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  product shopping_mall_products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  order shopping_mall_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots shopping_mall_review_snapshots[]
  
  //----
  // INDEXES
  //----
  @@index([order_id])
  @@unique([customer_id, product_id, order_id])
  @@index([product_id, created_at])
  @@index([customer_id, created_at])
}

/// Immutable snapshots preserving previous rating and text content when
/// reviews are edited. Each snapshot captures the complete state of a review
/// at a point in time for audit trail and dispute resolution. References
/// {@link shopping_mall_reviews} for the current review state.
///
/// @namespace reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_review_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Review's {@link shopping_mall_reviews.id}.
  shopping_mall_review_id String
  
  /// Review rating from 1 to 5 stars at the time of snapshot.
  rating Int
  
  /// Optional review text content at the time of snapshot.
  content String?
  
  /// Timestamp when this snapshot was created.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  review shopping_mall_reviews @relation(fields: [shopping_mall_review_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([shopping_mall_review_id, created_at], map: "shopping_mall_review_snapshots_shopping_mall_review_id_8f74bdf1")
}