/// Product classification categories with one-level hierarchical nesting
/// (categories and subcategories). Administrators create and manage
/// categories; customers browse them for product discovery. Top-level
/// categories have null parent_id; subcategories reference their parent
/// category.
///
/// @namespace categories
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent category's {@link shopping_mall_categories.id}. Null for top-level
  /// categories.
  parent_id String?
  
  /// Category name for display and navigation.
  name String
  
  /// Category description explaining the product classification.
  description String
  
  /// Timestamp when the category was created.
  created_at DateTime
  
  /// Timestamp when the category was last modified.
  updated_at DateTime
  
  /// Timestamp when the category was soft deleted. Null if active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  parent shopping_mall_categories? @relation("recursive", fields: [parent_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  children shopping_mall_categories[] @relation("recursive")
  snapshots shopping_mall_category_snapshots[]
  products shopping_mall_products[]
  productSnapshots shopping_mall_product_snapshots[]
  
  //----
  // INDEXES
  //----
  @@index([parent_id])
}

