  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged customer's {@link shopping_mall_customers.id}. Each customer has
  /// exactly one active cart.
  shopping_customer_id String
  
  /// Cart creation timestamp.
  created_at DateTime
  
  /// Last modification timestamp, updated when cart items change or cart is
