  shopping_mall_order_id String
  
  /// Purchased product's {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Purchased variant's {@link shopping_mall_product_variants.id}.
  shopping_mall_product_variant_id String
  
  /// Selling seller's {@link shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Number of units purchased for this variant.
  quantity Int
  
  /// Unit price at time of purchase, snapshotted to preserve transaction state.
  price Float
  
  /// Individual item status: paid, shipped, delivered, cancelled, or refunded.
  status String
  
  /// Timestamp when the order item was created.
  created_at DateTime
  
  /// Timestamp when the order item was last updated.
  updated_at DateTime
  
  /// Timestamp when the order item was soft deleted, null if active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
