/// Core product listings in the shopping mall catalog. Each product
/// represents an item for sale with a name, description, category
/// classification, and base price. Products are owned by sellers who create
/// and manage them. Products can have multiple variants (SKUs) representing
/// different option combinations, multiple images for display, and maintain
/// an immutable snapshot history of all modifications for dispute
/// resolution. When deleted, products are hidden from search and category
/// listings but snapshots and historical order data are preserved.
///
/// @namespace products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Seller's {@link shopping_mall_sellers.id}.
  seller_id String
  
  /// Category's {@link shopping_mall_categories.id}.
  category_id String
  
  /// Product name displayed to customers.
  name String
  
  /// Detailed product description with specifications and features.
  description String
  
  /// Base price of the product in the platform's currency. Individual variants
  /// may override this price.
  base_price Float
  
  /// Timestamp when the product was first created.
  created_at DateTime
  
  /// Timestamp when the product was last modified.
  updated_at DateTime
  
  /// Timestamp when the product was soft-deleted. Null if active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  seller shopping_mall_sellers @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  category shopping_mall_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  variants shopping_mall_product_variants[]
  optionDefinitions shopping_mall_product_option_definitions[]
  images shopping_mall_product_images[]
  snapshots shopping_mall_product_snapshots[]
  wishlistedBies shopping_mall_wishlist_items[]
  orderItems shopping_mall_order_items[]
  reviews shopping_mall_reviews[]
  
  //----
  // INDEXES
  //----
  @@index([category_id, deleted_at])
  @@index([seller_id, deleted_at])
}

