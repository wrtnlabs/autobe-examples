/// Seller-specific product listings for managing and tracking product
/// catalog items. Each product is linked to a single seller and tracks the
/// product's metadata and status from the seller's perspective.
///
/// @namespace SellerPortal
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_seller_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Seller's ID. {@link shopping_mall_sellers.id}.
  seller_id String
  
  /// Product ID from main product catalog. {@link shopping_mall_products.id}.
  product_id String
  
  /// Seller-specific product title that appears on the marketplace.
  title String
  
  /// Seller-managed description of the product.
  description String?
  
  /// Base price of the product in USD from the seller's perspective.
  base_price Float
  
  /// Indicates whether the product listing is active for customers to view.
  active_status Boolean
  
  /// Creation timestamp for the seller product listing.
  created_at DateTime
  
  /// Last update timestamp for the seller product listing.
  updated_at DateTime
  
  /// Soft delete timestamp, null when active (for soft delete capability).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  seller shopping_mall_sellers @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  product shopping_mall_products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  
  shopping_mall_seller_inventories shopping_mall_seller_inventories[]
  shopping_mall_seller_sales_reports shopping_mall_seller_sales_reports[]
  
  @@unique([product_id])
  @@index([seller_id, created_at])
}

/// Seller-specific SKU-level inventory tracking for managing stock of
/// product variants. Each entry represents inventory count for a specific
/// variant of a product listed by the seller, linked to the main product
/// variants table.
///
/// @namespace SellerPortal
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_seller_inventories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Seller product ID. {@link shopping_mall_seller_products.id}.
  seller_product_id String
  
  /// Product variant ID from main product catalog. {@link
  /// shopping_mall_product_variants.id}.
  product_variant_id String
  
  /// Seller-specific SKU code for the product variant, following SKU format
  /// pattern: {product_code}-{variant_id}.
  sku String
  
  /// Current available stock quantity for this SKU.
  quantity Int
  
  /// Inventory threshold below which low stock notifications are triggered.
  min_alert_threshold Int?
  
  /// Creation timestamp for this inventory entry.
  created_at DateTime
  
  /// Last update timestamp for this inventory entry.
  updated_at DateTime
  
  /// Soft delete timestamp, null when active (for soft delete capability).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  sellerProduct shopping_mall_seller_products @relation(fields: [seller_product_id], references: [id], onDelete: Cascade)
  productVariant shopping_mall_product_variants @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([seller_product_id, product_variant_id], map: "shopping_mall_seller_inventories_seller_product_id_pro_64c06d79")
  // spellchecker: ignore-next-line
  @@index([seller_product_id, created_at], map: "shopping_mall_seller_inventories_seller_product_id_cre_72becb9b")
  // spellchecker: ignore-next-line
  @@index([product_variant_id, created_at], map: "shopping_mall_seller_inventories_product_variant_id_cr_f7ca8abb")
}

/// Seller-specific sales analytics for tracking product performance. Each
/// report contains aggregated sales metrics for a seller's products over
/// specific time periods from the seller's perspective.
///
/// @namespace SellerPortal
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_seller_sales_reports {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Seller product ID. {@link shopping_mall_seller_products.id}.
  seller_product_id String
  
  /// Start date for the sales report period.
  report_period_start DateTime
  
  /// End date for the sales report period.
  report_period_end DateTime
  
  /// Total revenue generated from this product during the report period.
  total_revenue Float
  
  /// Total units of product sold during the report period.
  total_units_sold Int
  
  /// Average customer rating for this product during the report period.
  average_rating Float?
  
  /// Creation timestamp for this sales report entry.
  created_at DateTime
  
  /// Last update timestamp for this sales report entry.
  updated_at DateTime
  
  /// Soft delete timestamp, null when active (for soft delete capability).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  sellerProduct shopping_mall_seller_products @relation(fields: [seller_product_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([seller_product_id, report_period_start, report_period_end], map: "shopping_mall_seller_sales_reports_seller_product_id_r_46a2da4c")
  // spellchecker: ignore-next-line
  @@index([seller_product_id, report_period_start], map: "shopping_mall_seller_sales_reports_seller_product_id_r_0e5db7c6")
}