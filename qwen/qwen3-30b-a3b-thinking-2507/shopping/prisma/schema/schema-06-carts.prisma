/// Main cart container for customer shopping sessions, storing active cart
/// instances with creation timestamps and user association.
///
/// This table represents the central shopping cart instance that customers
/// actively manage during their shopping journey. The cart tracks all items
/// added to it, current cart status, and user context. Multiple carts are
/// possible per customer, with each representing a separate shopping
/// session.
///
/// Relationship with ecommerce_customers: Each cart belongs to exactly one
/// customer account, enabling user-specific cart management and session
/// tracking.
///
/// @namespace Carts
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_carts {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The customer who owns this cart. {@link ecommerce_customers.id}.
  ecommerce_customer_id String
  
  /// Timestamp when the cart was first created.
  created_at DateTime
  
  /// Timestamp when the cart was last modified.
  updated_at DateTime
  
  /// Timestamp when the cart was soft-deleted. Null indicates active cart.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer ecommerce_customers @relation(fields: [ecommerce_customer_id], references: [id], onDelete: Cascade)
  
  items ecommerce_cart_items[]
  snapshots ecommerce_cart_snapshots[]
  
  @@index([ecommerce_customer_id])
}

/// Cart line items containing product variants, quantities, and prices at
/// time of addition for each shopping session.
///
/// - Each cart item represents a product variant added to a customer's cart
/// at a specific price point.
/// - price_at_addition stores the price at time of addition (historical
/// accuracy for pricing changes).
/// - Foreign key to ecommerce_carts for cart context.
/// - Foreign key to ecommerce_product_variants for product relationship.
///
/// @namespace Carts
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_cart_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Cart containing this item. {@link ecommerce_carts.id}.
  ecommerce_carts_id String
  
  /// Product variant associated with this cart item. {@link
  /// ecommerce_product_variants.id}.
  ecommerce_product_variants_id String
  
  /// Quantity of the product variant in the cart.
  quantity Int
  
  /// Price of the product variant at time of addition (for historical
  /// accuracy).
  price_at_addition Float
  
  /// Timestamp when cart item was created.
  created_at DateTime
  
  /// Timestamp when cart item was last updated.
  updated_at DateTime
  
  /// Timestamp when cart item was marked as deleted (soft delete).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  cart ecommerce_carts @relation(fields: [ecommerce_carts_id], references: [id], onDelete: Cascade)
  variant ecommerce_product_variants @relation(fields: [ecommerce_product_variants_id], references: [id], onDelete: Cascade)
  
  @@index([ecommerce_carts_id])
  @@index([ecommerce_product_variants_id])
}

/// Point-in-time snapshots of cart state changes to maintain audit history
/// of item additions, removals, and quantity modifications.
///
/// Captures the complete state of a shopping cart at the moment when it was
/// modified, including customer information, cart status, and all item
/// quantities. Enables historical analysis, rollback of cart modifications,
/// and audit trails for system debugging.
///
/// @namespace Carts
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_cart_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Cart record this snapshot belongs to. {@link ecommerce_carts.id}.
  ecommerce_cart_id String
  
  /// Timestamp when this cart snapshot was created (recorded by system).
  created_at DateTime
  
  /// Timestamp when this cart snapshot was last updated (same as created_at
  /// for snapshots).
  updated_at DateTime
  
  /// Timestamp when this cart snapshot was deleted (if deleted, used for soft
  /// deletion).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  cart ecommerce_carts @relation(fields: [ecommerce_cart_id], references: [id], onDelete: Cascade)
  
  @@index([ecommerce_cart_id, created_at])
}