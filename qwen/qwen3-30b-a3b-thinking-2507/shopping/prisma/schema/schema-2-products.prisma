/// Core product listings with name, description, category ID, and base
/// price. Products are declared by sellers and visible to customers. Each
/// product belongs to a single category (with subcategories supported
/// through the categories hierarchy).
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Category this product belongs to. {@link ecommerce_categories.id}
  category_id String
  
  /// Product name (minimum 5 characters).
  name String
  
  /// Product description (minimum 10 characters).
  description String
  
  /// Base price of the product (minimum $0.01).
  base_price Float
  
  /// Timestamp of product creation.
  created_at DateTime
  
  /// Timestamp of last product update.
  updated_at DateTime
  
  /// Timestamp of product deletion (soft delete).
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  category ecommerce_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots ecommerce_product_snapshots[]
  variants ecommerce_product_variants[]
  images ecommerce_product_images[]
  categoryLinks ecommerce_product_category_links[]
  
  //----
  // INDEXES
  //----
  @@index([category_id])
}

/// Product snapshots for change history tracking.
///
/// Contains immutable historical state of product records including all fields.
/// Captures full state at the time of product editing for audit and dispute
/// resolution.
/// Snapshots are retained permanently regardless of product deletion.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_product_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product being snapped. {@link ecommerce_products.id}.
  ecommerce_product_id String
  
  /// Name of the product at snapshot time.
  name String
  
  /// Description of the product at snapshot time.
  description String
  
  /// Category ID of the product at snapshot time. {@link
  /// ecommerce_categories.id}.
  category_id String
  
  /// Base price of the product at snapshot time.
  base_price Float
  
  /// When this snapshot was created.
  created_at DateTime
  
  /// When this snapshot was last updated (should be same as created_at for
  /// immutable snapshot).
  updated_at DateTime
  
  /// When this snapshot was logically deleted for audit purposes (never used).
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  product ecommerce_products @relation(fields: [ecommerce_product_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([ecommerce_product_id, created_at])
}

