/// Main order records with order details, status, and customer reference.
/// Each order represents a collection of purchased items from one or more
/// sellers, created after successful payment to reflect accurate purchase
/// history. Status is computed from individual order items' statuses (paid,
/// shipped, delivered, cancelled, refunded, partially completed) and stored
/// for quick business reporting.
///
/// - Works with ecommerce_order_items for item-level details
/// - References ecommerce_customers for customer identity
/// - References ecommerce_customer_addresses for shipping locations
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_orders {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who placed the order. {@link ecommerce_customers.id}.
  customer_id String
  
  /// Shipping address for this order. {@link ecommerce_customer_addresses.id}.
  shipping_address_id String
  
  /// Current order status based on item statuses (paid, shipped, delivered,
  /// cancelled, refunded, partially completed).
  status String
  
  /// Total amount for the entire order, including item costs but excluding tax
  /// or shipping fees.
  total_amount Float
  
  /// Timestamp when the order was created (after payment succeeded).
  created_at DateTime
  
  /// Timestamp when the order status or details were last updated.
  updated_at DateTime
  
  /// Timestamp when the order was marked for deletion (soft delete).
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer ecommerce_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  shippingAddress ecommerce_customer_addresses @relation(fields: [shipping_address_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  orderItems ecommerce_order_items[]
  shipments ecommerce_shipments[]
  snapshots ecommerce_order_snapshots[]
  
  //----
  // INDEXES
  //----
  @@index([customer_id])
  @@index([shipping_address_id])
  @@index([created_at, customer_id])
  @@index([status])
}

/// Represents individual product variants purchased within orders, including
/// the exact purchase price, quantity, and current status of the item.
/// Tracks the relationship to the parent order, the specific product variant
/// sold, and the lifecycle status from payment through delivery or
/// cancellation. Follows the Snapshot Principle for all status transitions
/// and price records.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_order_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The parent order that contains this item. {@link ecommerce_orders.id}
  order_id String
  
  /// The product variant sold in this order item. {@link
  /// ecommerce_product_variants.id}
  variant_id String
  
  /// Number of units purchased of this variant.
  quantity Int
  
  /// Price per unit at the time of purchase, including any variant-specific
  /// price overrides.
  price Float
  
  /// Current status of the item in the order lifecycle: paid, shipped,
  /// delivered, cancelled, or refunded.
  status String
  
  /// Timestamp when the order item was created (time of order placement).
  created_at DateTime
  
  /// Timestamp of the last change to the order item (status update, quantity
  /// change).
  updated_at DateTime
  
  /// Timestamp when the order item was soft-deleted (null for active items).
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  order ecommerce_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  variant ecommerce_product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  orderItems ecommerce_shipment_items[]
  cancellationRequests ecommerce_cancellation_requests[]
  refundRequests ecommerce_refund_requests[]
  
  //----
  // INDEXES
  //----
  @@index([variant_id])
  @@unique([order_id, variant_id])
  @@index([status])
}

/// Shipping packages representing physical deliveries with tracking
/// information. Each shipment is associated with specific order items from
/// the same seller and contains tracking data for customers to monitor
/// delivery status.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_shipments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the order this shipment belongs to. {@link
  /// ecommerce_orders.id.
  ecommerce_order_id String
  
  /// Name of the shipping carrier (e.g., 'USPS', 'DHL', 'FedEx').
  carrier_name String
  
  /// Shipping tracking number provided by carrier. Unique per shipment.
  tracking_number String
  
  /// Current shipping status. Values: 'pending', 'in_progress', 'shipped',
  /// 'delivered', 'cancelled'.
  status String
  
  /// Date and time when the shipment was sent by the seller.
  shipment_date DateTime
  
  /// Estimated date and time when the shipment will be delivered.
  expected_delivery_date DateTime
  
  /// Timestamp when the shipment record was created.
  created_at DateTime
  
  /// Timestamp when the shipment record was last updated.
  updated_at DateTime
  
  /// Timestamp when the shipment record was soft-deleted (if applicable).
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  order ecommerce_orders @relation(fields: [ecommerce_order_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  shipmentItems ecommerce_shipment_items[]
  
  //----
  // INDEXES
  //----
  @@index([ecommerce_order_id])
  @@unique([carrier_name, tracking_number])
  @@index([status, shipment_date])
}

/// Association between order items and their shipment packages.
///
/// This junction table records the mapping between order items and
/// shipments. An order item can be part of only one shipment (1:N
/// relationship), and a shipment can contain multiple order items from the
/// same seller.
///
/// Junction table ensures proper shipment grouping and ordering during
/// shipping operations.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_shipment_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The shipment the order item is associated with. {@link
  /// ecommerce_shipments.id}.
  shipment_id String
  
  /// The order item associated with this shipment. {@link
  /// ecommerce_order_items.id}.
  order_item_id String
  
  /// Timestamp when the association was created.
  created_at DateTime
  
  /// Timestamp when the association was last updated.
  updated_at DateTime
  
  /// Timestamp when the association was logically deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  shipment ecommerce_shipments @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  orderItem ecommerce_order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([order_item_id])
  @@unique([shipment_id, order_item_id])
}

/// Immutable historical records of order changes for audit and dispute
/// resolution.
///
/// This table captures a point-in-time state of each order during
/// modifications, preserving all relevant order fields including status,
/// total price, and customer reference. Snapshots are appended automatically
/// when order state changes occur, allowing complete audit trails of order
/// status transitions throughout the system lifecycle. All historical order
/// states are preserved indefinitely for legal compliance, dispute
/// resolution, and customer support.
///
/// Note: This table records the state of the order at the time of
/// modification, with each snapshot corresponding to a specific change
/// event. To get the current order state, use the ecommerce_orders table.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_order_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Order entity that was modified. {@link ecommerce_orders.id}.
  ecommerce_order_id String
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  order ecommerce_orders @relation(fields: [ecommerce_order_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([ecommerce_order_id])
}

/// Customer requests to cancel specific order items before shipping. Each
/// request requires seller approval or rejection and includes a cancellation
/// reason. This table is managed through order item operations, not directly
/// by customers.
///
/// - Each request corresponds to a single order item (order_item_id)
/// - Status transitions: pending → approved/rejected
/// - Reason field stores customer-specified cancellation justification
/// (optional)
/// - Snapshots track state changes via order item lifecycle management
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_cancellation_requests {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged order item's {@link ecommerce_order_items.id.
  order_item_id String
  
  /// Customer-specified cancellation reason. Optional field for user-provided
  /// justification.
  reason String?
  
  /// Current cancellation request status (pending/approved/rejected). Valid
  /// values: pending, approved, rejected.
  status String
  
  /// Timestamp when cancellation request was submitted.
  created_at DateTime
  
  /// Timestamp when cancellation request status was last updated.
  updated_at DateTime
  
  /// Timestamp when cancellation request was soft-deleted. Nullable for soft
  /// delete.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  orderItem ecommerce_order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([order_item_id])
}

/// Customer refund requests for delivered order items within the 7-day window.
///
/// This table captures all customer refund requests for items that have been
/// delivered. Each request includes a reason for the refund and its current
/// status (pending, approved, rejected). The refund request process requires
/// that the item has a status of 'delivered' (as per Order Status), and the
/// request must be submitted within 7 days of delivery.
///
/// The table has relationships to order items (via order_item_id) and
/// customers (via customer_id), allowing for efficient querying by both
/// customers and sellers. Snapshots are created for refund request status
/// changes, recorded in the ecommerce_refund_request_snapshots table which
/// is part of the Order component.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_refund_requests {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced order item. {@link ecommerce_order_items.id}
  order_item_id String
  
  /// Customer who requested the refund. {@link ecommerce_customers.id}
  customer_id String
  
  /// Reason for the refund request (text provided by customer).
  reason String
  
  /// Current status of the refund request (pending, approved, rejected).
  status String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp. Null means not deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  orderItem ecommerce_order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  customer ecommerce_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([order_item_id])
  @@index([customer_id])
}