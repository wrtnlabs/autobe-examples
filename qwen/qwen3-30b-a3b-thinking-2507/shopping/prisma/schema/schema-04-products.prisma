  /// The name of the variant option (e.g., 'color', 'size').
  option_key String
  
  /// The specific value for the option (e.g., 'red', 'large').
  option_value String
  
  /// Timestamp when the product variant option was created.
  created_at DateTime
  
  /// Timestamp when the product variant option was last updated.
  updated_at DateTime
  
  /// Timestamp when the product variant option was soft deleted (null if not
  /// deleted).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  variant shopping_mall_product_variants @relation(fields: [shopping_mall_product_variant_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_variant_id], map: "shopping_mall_product_variant_options_shopping_mall_pr_cd6e89c8")
}