model shopping_mall_product_images {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Associated product's {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// URL to the product image file. Must be a valid public URL.
  url String
  
  /// Timestamp when the image was uploaded to the system.
  upload_timestamp DateTime
  
  /// Image file format (e.g., jpg, png, gif).
  image_format String
  
  /// Image width in pixels.
  image_width Int
  
  /// Image height in pixels.
  image_height Int
  
  /// Alternative text for accessibility and image description.
