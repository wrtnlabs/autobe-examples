/// Shipping carriers used for order fulfillment with API integration details
/// for shipping carriers like UPS, FedEx, and DHL.
///
/// @namespace OrderManagement
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_shipping_carriers {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Name of the shipping carrier (e.g., 'UPS', 'FedEx').
  name String
  
  /// API endpoint URL for carrier integration.
  api_endpoint String
  
  /// Whether this carrier is currently available for shipping.
  enabled Boolean
  
  /// Priority order for carrier selection (lower number = higher priority).
  priority Int
  
  /// Timestamp when carrier was added to system.
  created_at DateTime
  
  /// Timestamp when carrier information was last modified.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  shopping_mall_order_payments shopping_mall_order_payments[]
  shopping_mall_shipping shopping_mall_shipping[]
  shopping_mall_tracking_updates shopping_mall_tracking_updates[]
  
  @@unique([name])
  @@index([enabled, priority])
}

/// Real-time tracking updates for shipped orders with status changes from
/// carriers.
///
/// @namespace OrderManagement
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_tracking_updates {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Shipping carrier's {@link shopping_mall_shipping_carriers.id}.
  shipping_carrier_id String
  
  /// Current shipping status (e.g., 'In Transit', 'Delivered').
  status String
  
  /// Current location of package in transit.
  location String
  
  /// Timestamp when tracking status was updated by carrier.
  timestamp DateTime
  
  /// Carrier-specific tracking number for identifying package.
  tracking_number String
  
  /// Timestamp when tracking update was recorded in system.
  created_at DateTime
  
  /// Timestamp when tracking update information was last modified.
  updated_at DateTime
  
  /// Timestamp when tracking update was logically deleted (soft delete).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  carrier shopping_mall_shipping_carriers @relation(fields: [shipping_carrier_id], references: [id], onDelete: Cascade)
  
  @@unique([tracking_number])
  // spellchecker: ignore-next-line
  @@index([shipping_carrier_id, timestamp], map: "shopping_mall_tracking_updates_shipping_carrier_id_tim_5d1aff23")
}

/// Refund processing records for orders with amount, reason, and status
/// tracking.
///
/// @namespace OrderManagement
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_refunds {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Order related to the refund {@link shopping_mall_orders.id}.
  order_id String
  
  /// Refund amount in USD.
  amount Float
  
  /// Reason for refund request (e.g., 'Customer request', 'Product defect').
  reason String
  
  /// Current refund status (e.g., 'pending', 'approved', 'rejected').
  status String
  
  /// Timestamp when refund request was initiated.
  created_at DateTime
  
  /// Timestamp when refund status was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  order shopping_mall_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  
  @@index([order_id, created_at])
}