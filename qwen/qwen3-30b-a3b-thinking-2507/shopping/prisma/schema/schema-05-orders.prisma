/// Main order header records including customer reference, order date, total
/// amount (computed on query), and overall status derived from item
/// statuses. Represents the core business entity for order management,
/// requiring independent CRUD operations.
///
/// - Linked to customers (ecommerce_customers) as owner
/// - Status transitions validated by business rules (pending → processing →
/// shipped → delivered)
/// - Order date and customer reference enable efficient querying for reports
/// and user history
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_orders {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Order owner's identity. {@link ecommerce_customers.id}.
  ecommerce_customers_id String
  
  /// Date and time when order was placed.
  order_date DateTime
  
  /// Current order processing status. Valid values: pending, processing,
  /// shipped, delivered, cancelled.
  status String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last modification timestamp.
  updated_at DateTime
  
  /// Soft delete timestamp.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer ecommerce_customers @relation(fields: [ecommerce_customers_id], references: [id], onDelete: Cascade)
  
  items ecommerce_order_items[]
  shipments ecommerce_shipments[]
  cancellationRequests ecommerce_cancellation_requests[]
  refundRequests ecommerce_refund_requests[]
  
  @@index([ecommerce_customers_id, order_date])
}

/// Represents individual line items within orders, capturing historical
/// product variant details at the time of purchase. Each order line item
/// corresponds to a single variant of a product, including quantity,
/// purchase price, and current status. This table maintains the relationship
/// between orders and product variants, supporting order modification,
/// tracking, and status updates through the ordering lifecycle. Follows
/// Snapshot Principle to preserve historical state of each line item as it
/// transitions between statuses.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_order_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The order this line item belongs to.
  ecommerce_order_id String
  
  /// The product variant this line item references.
  product_variant_id String
  
  /// Number of this variant purchased in the order.
  quantity Int
  
  /// Price of the variant at the time of purchase, preserving historical value.
  price_at_purchase Float
  
  /// Current status of the line item in the order lifecycle (placed,
  /// processing, shipped, delivered, cancelled, refunded).
  status String
  
  /// Timestamp when this line item was created.
  created_at DateTime
  
  /// Timestamp when this line item was last updated.
  updated_at DateTime
  
  /// Timestamp of logical deletion (if applicable).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  order ecommerce_orders @relation(fields: [ecommerce_order_id], references: [id], onDelete: Cascade)
  productVariant ecommerce_product_variants @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)
  
  @@index([ecommerce_order_id])
  @@index([product_variant_id])
}

/// Tracks shipping carrier and tracking information for grouped items from
/// same seller per order. This table allows customers to view shipping
/// status and tracking details for their orders.
///
/// Key business context:
/// - Represents the actual shipping event for items from the same seller
/// within an order
/// - Supports shipment tracking through carrier and tracking number
/// - Captures shipping date and delivery estimates for customer experience
/// - Maintains shipment status for order status tracking
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_shipments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The order to which this shipment belongs. {@link ecommerce_orders.id}.
  ecommerce_order_id String
  
  /// Shipping carrier name (e.g., 'FedEx', 'DHL', 'USPS').
  carrier String
  
  /// The tracking number provided by the shipping carrier.
  tracking_number String
  
  /// The date and time when the shipment was sent out.
  shipping_date DateTime
  
  /// The estimated date when the shipment will be delivered.
  estimated_delivery_date DateTime?
  
  /// The actual date when the shipment was delivered (if known).
  actual_delivery_date DateTime?
  
  /// Current status of the shipping (e.g., 'shipped', 'in transit',
  /// 'delivered', 'out for delivery').
  status String
  
  /// Timestamp when the shipment record was created.
  created_at DateTime
  
  /// Timestamp when the shipment record was last updated.
  updated_at DateTime
  
  /// Timestamp when the shipment was marked for deletion (soft delete).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  order ecommerce_orders @relation(fields: [ecommerce_order_id], references: [id], onDelete: Cascade)
  
  @@unique([tracking_number])
  @@index([ecommerce_order_id, shipping_date])
}

/// Customer cancellation requests with status, reason, and timestamp. Allows
/// customers to request cancellation of orders with specific reasons and
/// track the status through approval workflow.
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_cancellation_requests {
  //----
  // COLUMNS
  //----
  /// The primary key identifier for the cancellation request.
  id String @id
  
  /// The order for which the cancellation was requested. {@link
  /// ecommerce_orders.id}.
  order_id String
  
  /// The customer who requested the cancellation. {@link
  /// ecommerce_customers.id}.
  customer_id String
  
  /// The current status of the cancellation request (one of: pending,
  /// approved, rejected, completed).
  status String
  
  /// The reason given by the customer for requesting the cancellation.
  reason String?
  
  /// Timestamp when the cancellation request was created.
  created_at DateTime
  
  /// Timestamp when the cancellation request was last updated.
  updated_at DateTime
  
  /// Timestamp when the cancellation request was marked for deletion (soft
  /// delete).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  order ecommerce_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  customer ecommerce_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  
  @@index([order_id])
  @@index([customer_id])
}

/// Customer refund requests with status, reason, and timestamp. Managed as a
/// subsidiary entity through order processing workflows. Each request is
/// linked to an order via foreign key and reflects refund status (pending,
/// approved, rejected).
///
/// Key relationships:
/// - Connected to parent order through ecommerce_orders
/// - Status field tracks refund processing state
/// - Timestamped operations for audit trail
///
/// @namespace Orders
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_refund_requests {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Order this refund request is associated with. {@link ecommerce_orders.id}.
  ecommerce_order_id String
  
  /// Current refund status (pending, approved, rejected).
  status String
  
  /// Reason for requesting refund with justification.
  reason String
  
  /// Timestamp when refund request was created.
  created_at DateTime
  
  /// Timestamp when refund request was last updated.
  updated_at DateTime
  
  /// Timestamp when refund request was deleted (for soft deletion).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  order ecommerce_orders @relation(fields: [ecommerce_order_id], references: [id], onDelete: Cascade)
  
  @@index([ecommerce_order_id])
  
  @@index([status])
}