/// Main product catalog entry with title, description, price, and category
/// reference. This is the primary business entity representing a product
/// offering to customers.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product's primary category {@link shopping_mall_product_categories.id}.
  shopping_mall_product_category_id String
  
  /// Product title for user display (max 100 characters).
  title String
  
  /// Product description (max 2000 characters).
  description String
  
  /// Base price in USD for product creation ($9.99-$999.99).
  base_price Float
  
  /// Timestamp when product was created.
  created_at DateTime
  
  /// Timestamp when product was last updated.
  updated_at DateTime
  
  /// Timestamp when product was soft deleted (null if active).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  category shopping_mall_product_categories @relation(fields: [shopping_mall_product_category_id], references: [id], onDelete: Cascade)
  
  shopping_mall_product_variants shopping_mall_product_variants[]
  shopping_mall_product_reviews shopping_mall_product_reviews[]
  shopping_mall_product_images shopping_mall_product_images[]
  shopping_mall_seller_products shopping_mall_seller_products[]
  shopping_mall_admin_product_overview shopping_mall_admin_product_overview[]
  mv_shopping_mall_admin_product_overview mv_shopping_mall_admin_product_overview[]
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_category_id, created_at], map: "shopping_mall_products_shopping_mall_product_category__6be91f3e")
}

/// Product variants with color, size, SKU, and inventory tracking. Each
/// variant represents a specific combination (e.g., 'Blue S') with its own
/// inventory level.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_variants {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product this variant belongs to {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Unique SKU for variant (format: COLOR-SIZE).
  sku String
  
  /// Product color variant (e.g., 'Red', 'Blue').
  color String
  
  /// Product size variant (e.g., 'S', 'M', 'L').
  size String
  
  /// Price difference for variant ($5.00 max).
  price_adjustment Float?
  
  /// Current inventory count for this specific variant.
  inventory_count Int
  
  /// Timestamp when variant was created.
  created_at DateTime
  
  /// Timestamp when variant was last updated.
  updated_at DateTime
  
  /// Timestamp when variant was soft deleted (null if active).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  shopping_mall_cart_items shopping_mall_cart_items[]
  shopping_mall_wishlist_items shopping_mall_wishlist_items[]
  shopping_mall_order_items shopping_mall_order_items[]
  shopping_mall_seller_inventories shopping_mall_seller_inventories[]
  
  @@unique([sku])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, created_at], map: "shopping_mall_product_variants_shopping_mall_product_i_8fcece9d")
}

/// Hierarchical category system for product organization. Includes root
/// categories and subcategories. Maximum 3-level hierarchy enforced.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent category if this is a subcategory {@link
  /// shopping_mall_product_categories.id}.
  parent_id String?
  
  /// Category name (max 50 characters).
  name String
  
  /// Category description (max 200 characters).
  description String?
  
  /// Hierarchy level (1 = root, 2 = subcategory, 3 = sub-subcategory).
  level Int
  
  /// Timestamp when category was created.
  created_at DateTime
  
  /// Timestamp when category was last updated.
  updated_at DateTime
  
  /// Timestamp when category was soft deleted (null if active).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  parent shopping_mall_product_categories? @relation("recursive", fields: [parent_id], references: [id], onDelete: Cascade)
  
  shopping_mall_products shopping_mall_products[]
  recursive shopping_mall_product_categories[] @relation("recursive")
  
  @@unique([name, level])
  @@index([parent_id, level])
}

/// Customer reviews for products. Each review has a content string and
/// timestamp. Reviews can be submitted after order completion.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
