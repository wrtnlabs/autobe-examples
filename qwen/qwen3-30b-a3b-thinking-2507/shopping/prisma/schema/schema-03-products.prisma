  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product being reviewed {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Customer who wrote the review {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Review text (20-500 characters).
  content String
  
  /// Timestamp when review was created.
  created_at DateTime
  
  /// Timestamp when review was last updated.
  updated_at DateTime
  
  /// Timestamp when review was soft deleted (null if active).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  shopping_mall_review_ratings shopping_mall_review_ratings[]
  
  @@index([shopping_mall_customer_id])
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, created_at], map: "shopping_mall_product_reviews_shopping_mall_product_id_20a1ef06")
}

