/// Represents individual to-do items with their title and completion status.
///
/// @namespace Todo
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_todos {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The to-do item title, required for each item.
  title String
  
  /// Whether the to-do item has been completed (true) or not (false).
  completed Boolean
  
  /// The timestamp when the to-do item was created.
  created_at DateTime
  
  /// The timestamp when the to-do item was last updated.
  updated_at DateTime
  
  /// The timestamp when the to-do item was deleted (soft delete).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  @@index([created_at])
}