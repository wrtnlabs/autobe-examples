/// Audit log of all todos' edit history, capturing field changes including
/// title, description, start date, and due date. Each history entry
/// references the corresponding todo and stores the timestamp of the edit.
/// Maintains temporal data including creation and update times, with
/// optional soft deletion support for the history entry itself.
///
/// @namespace Todo
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_histories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The todo this history entry belongs to. {@link todo_app_todos.id}
  todos_id String
  
  /// The timestamp of when the edit event occurred.
  timestamp DateTime
  
  /// Previous value of the title field before edit.
  title String?
  
  /// Previous value of the description field before edit.
  description String?
  
  /// Previous value of the start date field before edit.
  start_date DateTime?
  
  /// Previous value of the due date field before edit.
  due_date DateTime?
  
  /// Timestamp when the history entry was created.
  created_at DateTime
  
  /// Timestamp of the last update to the history entry.
  updated_at DateTime
  
  /// Timestamp when the history entry was soft-deleted (if applicable).
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  todo todo_app_todos @relation(fields: [todos_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([todos_id])
}

/// User-owned todo records with title, status, dates, and soft-delete tracking.
///
/// This table represents the core business entity for todo management,
/// allowing users to create, filter, sort, and manage their todos with full
/// soft-delete support. All todos are bound to a single user via user_id
/// foreign key. The table maintains historical state through soft-deletion
/// and is intended for independent CRUD operations via API endpoints.
///
/// @namespace Todo
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_todos {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Owner user's {@link todo_app_users.id}.
  user_id String
  
  /// Todo title (up to 150 characters)
  title String
  
  /// Todo description (optional)
  description String?
  
  /// Start date for the todo
  start_date DateTime?
  
  /// Due date for the todo
  due_date DateTime?
  
  /// Completion status (default false)
  is_complete Boolean
  
  /// Record creation timestamp
  created_at DateTime
  
  /// Record last update timestamp
  updated_at DateTime
  
  /// Soft delete timestamp (null for active records)
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  user todo_app_users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  histories todo_app_histories[]
  
  //----
  // INDEXES
  //----
  @@index([user_id])
  @@index([created_at])
  @@index([is_complete])
}