/// Core todo items that users create, view, edit, and manage. Includes
/// required title, optional description, start date, due date, completion
/// status, and soft delete tracking. Each todo item belongs to a single user
/// account with strict user-data isolation enforced.
///
/// @namespace Todos
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_todos {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belongs to the user's account via {@link todo_users.id}.
  todo_user_id String
  
  /// Title of the todo item. Minimum 1 character required.
  title String
  
  /// Optional description of the todo item.
  description String?
  
  /// Start date for the todo item.
  start_date DateTime?
  
  /// Due date for completing the todo item.
  due_date DateTime?
  
  /// Completion status. Defaults to false on creation.
  is_completed Boolean
  
  /// Timestamp of when the todo item was created.
  created_at DateTime
  
  /// Timestamp of the last update to the todo item.
  updated_at DateTime
  
  /// Timestamp of soft deletion. Nullable for active items.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  user todo_users @relation(fields: [todo_user_id], references: [id], onDelete: Cascade)
  
  histories todo_histories[]
  
  @@index([todo_user_id])
}

/// Detailed record of all field modifications including timestamps, previous
/// values, and new values for each todo edit. Each history entry captures
/// atomic changes to title, description, start date, and due date fields
/// when a todo is modified.
///
/// @namespace Todos
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_histories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Related todo item's ID.
  todo_id String
  
  /// Timestamp when the edit was recorded.
  created_at DateTime
  
  /// Timestamp of the last update to the history record (should match
  /// created_at for immutability).
  updated_at DateTime
  
  /// Previous title value before edit. Null if title was not changed.
  prev_title String?
  
  /// New title value after edit. Null if title was not changed.
  new_title String?
  
  /// Previous description value before edit. Null if description was not
  /// changed.
  prev_description String?
  
  /// New description value after edit. Null if description was not changed.
  new_description String?
  
  /// Previous start date value before edit. Null if start date was not changed.
  prev_start_date DateTime?
  
  /// New start date value after edit. Null if start date was not changed.
  new_start_date DateTime?
  
  /// Previous due date value before edit. Null if due date was not changed.
  prev_due_date DateTime?
  
  /// New due date value after edit. Null if due date was not changed.
  new_due_date DateTime?
  
  //----
  // RELATIONS
  //----
  todo todo_todos @relation(fields: [todo_id], references: [id], onDelete: Cascade)
  
  @@index([todo_id, created_at])
}