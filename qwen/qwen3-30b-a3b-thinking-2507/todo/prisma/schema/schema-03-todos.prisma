/// Main table for storing all user todo items with required title, optional
/// description, start and due dates, and completion status.
///
/// Each todo item belongs to a single user and is initially created with
/// incomplete status by default. The table supports soft deletion to allow
/// trashing items without permanent removal.
///
/// Todos can be searched across all items regardless of parent context,
/// supporting independent user management and API operations.
///
/// @namespace Todos
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_todos {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Owner's {@link todo_users.id}.
  todo_users_id String
  
  /// Title of the todo item. Required for creation, cannot be blank.
  title String
  
  /// Optional description of the todo item. Can be left empty or empty string.
  description String?
  
  /// Optional start date for the todo item. Can be left empty if not
  /// applicable.
  start_date DateTime?
  
  /// Optional due date for the todo item. Can be left empty if not applicable.
  due_date DateTime?
  
  /// Completion status of the todo item. New items are created with false
  /// (incomplete) by default.
  completed Boolean
  
  /// Timestamp of when the todo item was created.
  created_at DateTime
  
  /// Timestamp of when the todo item was last updated.
  updated_at DateTime
  
  /// Timestamp of when the todo item was marked for deletion (soft delete).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  user todo_users @relation(fields: [todo_users_id], references: [id], onDelete: Cascade)
  
  histories todo_histories[]
  
  @@index([todo_users_id, created_at])
}

/// Tracks all edit history entries for todos including previous and new
/// values for title, description, and date fields.
///
/// The history records are automatically created whenever a todo item is
/// modified, capturing the previous and new values for all editable fields.
/// History entries are stored permanently until the associated todo item is
/// permanently deleted. Note that history entries are managed automatically
/// and users cannot directly interact with or modify history records.
///
/// @namespace Todos
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_histories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The main todo item that was edited. {@link todo_todos.id}
  todo_todo_id String
  
  /// Title value before the edit. Set to null if this was the first title set.
  previous_title String?
  
  /// Title value after the edit.
  new_title String
  
  /// Description value before the edit. Set to null if this was the first
  /// description set.
  previous_description String?
  
  /// Description value after the edit.
  new_description String
  
  /// Previous start date before the edit. Null if this was the first start
  /// date.
  previous_start_date DateTime?
  
  /// New start date after the edit.
  new_start_date DateTime
  
  /// Previous due date before the edit. Null if this was the first due date.
  previous_due_date DateTime?
  
  /// New due date after the edit.
  new_due_date DateTime
  
  /// Timestamp of when the history entry was created.
  created_at DateTime
  
  /// Timestamp of when the history entry was last updated. This field is
  /// typically the same as created_at for history entries.
  updated_at DateTime
  
  /// Optional timestamp for soft deletion. History entries are only
  /// soft-deleted when the parent todo is permanently deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  todo todo_todos @relation(fields: [todo_todo_id], references: [id], onDelete: Cascade)
  
  @@index([todo_todo_id, created_at])
}