  article discussion_board_articles @relation(fields: [discussion_board_articles_id], references: [id], onDelete: Cascade)
  submitter discussion_board_members @relation(fields: [discussion_board_members_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_members_id], map: "discussion_board_moderation_queue_discussion_board_mem_420cde04")
  
  @@index([status, submitted_at])
  // spellchecker: ignore-next-line
  @@index([discussion_board_articles_id], map: "discussion_board_moderation_queue_discussion_board_art_d11ef66e")
}

/// Records all moderator actions on articles including approvals, rejections
/// with required reasons, and timestamps for all moderation activities.
///
/// Stores each moderation action with its status (approved, rejected,
/// pending), rejection reason (when applicable), and timestamps. Each action
/// references an article in the Discussion Articles component for context.
/// Supports audit trails and historical analysis through complete recording
/// of all moderation decisions, including reasons for rejections.
///
/// The reason field is required when the status is 'rejected' but optional
/// for other statuses. Soft deletion capabilities allow for content recovery
/// without data loss.
///
/// @namespace Moderation
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_moderation_actions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The article that was moderated. {@link discussion_board_articles.id.
  discussion_board_article_id String
  
  /// Moderation action status. Valid values: approved, rejected, pending.
  status String
  
  /// Reason for rejection. Required when status is 'rejected'. Optional for
  /// other statuses.
  reason String?
  
  /// Timestamp when the moderation action was created.
  created_at DateTime
  
  /// Timestamp when the moderation action was last updated.
  updated_at DateTime
  
  /// Timestamp when the moderation action was soft-deleted. Null indicates
  /// active status.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, created_at], map: "discussion_board_moderation_actions_discussion_board_a_edb172a2")
}