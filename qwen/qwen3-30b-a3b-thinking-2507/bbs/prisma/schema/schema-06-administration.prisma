/// Tracks user requests to become administrators with status, reason, and
/// timestamps. Each user can submit only one active request (pending) at a
/// time. Requires user context and approval status tracking for
/// administrative workflows.
///
/// @namespace Administration
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economy_politics_board_administrator_requests {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User who submitted the request. {@link economy_politics_board_users.id.
  users_id String
  
  /// Current status of the request (pending, approved, rejected).
  status String
  
  /// Reason provided by the user requesting administrator privileges.
  reason String
  
  /// Timestamp when the request was submitted.
  created_at DateTime
  
  /// Timestamp of the last modification to the request.
  updated_at DateTime
  
  /// Timestamp when the request was marked as deleted.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  requestor economy_politics_board_users @relation(fields: [users_id], references: [id], onDelete: Cascade)
  
  @@unique([users_id])
}

/// Records user bans with details, reasons, duration and admin
/// justification. Banned users cannot login to the platform. Each ban entry
/// tracks the reason and optional expiration date.
///
/// - Ban reasons require minimum 10 characters
/// - Expiration dates may be indefinite (NULL)
/// - Linked to both user and admin tables
///
/// @namespace Administration
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economy_politics_board_user_bans {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User being banned's {@link economy_politics_board_users.id}.
  user_id String
  
  /// Admin who imposed the ban's {@link economy_politics_board_admins.id}.
  admin_id String
  
  /// Reason for ban (min 10 characters).
  reason String
  
  /// Start date/time of ban.
  start_at DateTime
  
  /// Expiration date/time of ban (optional for indefinite bans).
  expire_at DateTime?
  
  /// When the ban record was created.
  created_at DateTime
  
  /// When the ban record was last updated.
  updated_at DateTime
  
  /// When the ban was logically deleted (soft delete).
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  bannedUser economy_politics_board_users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  admin economy_politics_board_admins @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  
  @@index([user_id, start_at])
  @@index([admin_id, start_at])
  @@index([expire_at, deleted_at])
}