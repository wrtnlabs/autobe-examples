/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economy_politics_board_articles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Section this article belongs to. {@link
  /// economy_politics_board_sections.id}
  section_id String
  
  /// Author of this article (user identity). {@link
  /// economy_politics_board_users.id}
  author_id String
  
  /// Article title (minimum 5 characters).
  title String
  
  /// Article content (minimum 50 characters).
