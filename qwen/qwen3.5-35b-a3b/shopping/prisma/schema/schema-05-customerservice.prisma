/// @namespace CustomerService
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_refund_requests {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced order item's {@link ecommerce_mall_order_items.id}.
  order_item_id String
  
  /// Customer's reason for requesting the refund.
  reason String
  
  /// Current status of the refund request: pending, approved, or rejected.
  request_status String
  
  /// 7-day deadline after delivery when refund request expires (calculated
  /// from orderItem's delivery confirmation).
  time_limit DateTime?
  
  /// Timestamp when the refund request was created.
  created_at DateTime
  
  /// Timestamp of the last update to this refund request.
  updated_at DateTime
  
  /// Soft delete timestamp for audit trail.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  orderItem ecommerce_mall_order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  statusSnapshots ecommerce_mall_order_item_snapshots[]
  
  //----
  // INDEXES
  //----
  @@unique([order_item_id])
  @@index([request_status])
  @@index([created_at])
  @@index([order_item_id, created_at])
}

/// Customer product reviews with star ratings and optional text content.
/// Reviews are created by customers after purchasing and receiving products,
/// and can be edited with snapshots preserved for audit trails.
///
/// This table represents the primary review entity where customers express
