  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer's {@link ecommerce_mall_customers.id} who wrote this review.
  customer_id String
  
  /// Product's {@link ecommerce_mall_products.id} being reviewed.
  product_id String
  
  /// Star rating from 1 to 5, where 1 is lowest and 5 is highest satisfaction.
