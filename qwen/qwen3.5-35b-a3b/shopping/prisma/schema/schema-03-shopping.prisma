/// Customer wishlists tracking products saved for future purchase
/// consideration.
///
/// This table implements the Wishlist concept from the domain model,
/// establishing a many-to-many relationship between customers and products.
/// Each record represents a customer's decision to bookmark a product for
/// potential future purchase.
///
/// Key behaviors:
/// - Customers can add or remove products from their wishlist independently
/// - Products remain in wishlist even if out of stock (section 643 allows
/// out-of-stock products)
/// - Automatic cleanup occurs when products are deleted (section 639:
/// Deleted Product Auto-Removal)
/// - One customer can wishlist the same product only once (enforced by
/// unique constraint)
///
/// Related entities:
/// - {@link ecommerce_mall_customers} - customers who own wishlists
/// - {@link ecommerce_mall_products} - products saved for future consideration
///
/// @namespace Shopping
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_wishlists {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer's {@link ecommerce_mall_customers.id} who owns this wishlist
  /// entry
  ecommerce_mall_customer_id String
  
  /// Product's {@link ecommerce_mall_products.id} saved in wishlist
  ecommerce_mall_product_id String
  
  /// When the product was added to the customer's wishlist
  created_at DateTime
  
  /// Last update timestamp (used for caching optimization)
  updated_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer ecommerce_mall_customers @relation(fields: [ecommerce_mall_customer_id], references: [id], onDelete: Cascade)
  product ecommerce_mall_products @relation(fields: [ecommerce_mall_product_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([ecommerce_mall_customer_id, ecommerce_mall_product_id], map: "ecommerce_mall_wishlists_ecommerce_mall_customer_id_ec_bf3151ec")
  @@index([ecommerce_mall_customer_id])
  @@index([ecommerce_mall_product_id])
}

/// Shopping cart metadata tracking per-customer cart sessions. This table
/// represents the cart container that holds CartItems for a customer. Each
/// cart session is associated with a specific customer and tracks
/// creation/update timestamps for session management. The cart itself does
/// not store variant quantities or prices—those are stored in the related
/// CartItems table. Multiple carts per customer are supported to enable
/// session tracking across different devices or time periods.
///
/// @namespace Shopping
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_shopping_carts {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged customer's {@link ecommerce_mall_customers.id}.
  customer_id String
  
  /// Cart session creation timestamp.
  created_at DateTime
  
  /// Last cart modification timestamp.
  updated_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer ecommerce_mall_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  cartItems ecommerce_mall_cart_items[]
  
  //----
  // INDEXES
  //----
  @@index([customer_id, created_at])
}

/// Individual cart line items tracking variant quantities and prices at
/// addition time.
///
/// This is a subsidiary entity that represents a single product variant
/// selected by a customer in their shopping cart session. Each cart item
/// records the quantity of variants chosen and captures the price at the
/// time of addition to ensure consistent pricing during checkout.
///
/// The table supports the shopping workflow where customers can browse
/// products, select specific variants (with options like size, color, etc.),
/// adjust quantities, and remove items before completing their purchase.
/// Cart items are transient business data that can be modified or deleted at
/// any point before checkout.
///
/// **Key Relationships:**
///
/// - Belongs to a {@link ecommerce_mall_shopping_carts} cart session (1:N
/// relationship)
/// - References a specific {@link ecommerce_mall_product_variants} variant
/// with unique SKU
/// - The variant's current stock level is validated at cart addition time
/// but the cart item tracks the price at that moment
///
/// **Behavioral Notes:**
///
/// - Prices are captured at addition time, not calculated dynamically, to
/// ensure customers see consistent pricing throughout their cart session
/// - Composite unique constraint on (cart_id, variant_id) prevents adding
/// the same variant multiple times to the same cart
/// - Cart items are soft-deleted when removed from cart, preserving audit trail
/// - No independent CRUD endpoints - all operations occur through the parent
/// cart entity
///
/// @namespace Shopping
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_cart_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Shopping cart's {@link ecommerce_mall_shopping_carts.id}. References the
  /// customer's active cart session.
  cart_id String
  
  /// Product variant's {@link ecommerce_mall_product_variants.id}. References
  /// the specific variant (option combination) selected for the cart item.
  variant_id String
  
  /// Quantity of this variant in the cart. Must be at least 1.
  quantity Int
  
  /// Price per unit at time of cart addition. Captured to ensure consistent
  /// checkout pricing.
  price Float
  
  /// Timestamp when this cart item was added to the cart.
  created_at DateTime
  
  /// Timestamp of the last modification to this cart item.
  updated_at DateTime
  
  /// Soft delete timestamp when cart item is removed. NULL if active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  cart ecommerce_mall_shopping_carts @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  variant ecommerce_mall_product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@unique([cart_id, variant_id])
  @@index([cart_id, created_at])
  @@index([variant_id])
}