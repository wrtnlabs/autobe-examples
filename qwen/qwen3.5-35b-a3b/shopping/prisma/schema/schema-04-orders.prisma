  after_data String
  
  /// Optional reason for the change when provided by the actor.
  change_reason String?
  
  /// Timestamp when this snapshot was created.
  created_at DateTime
  
  /// Timestamp when this snapshot was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp for data retention and archival.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  orderItem ecommerce_mall_order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([order_item_id, created_at], map: "ecommerce_mall_order_item_snapshots_order_item_id_crea_ce456eaa")
}