/// Customer shipping addresses for order delivery and fulfillment.
///
/// Each customer can have multiple shipping addresses, with at most one
/// default address designated for regular deliveries. Addresses store
/// recipient information (name and phone), complete street address details
/// (street, city, state), and are referenced by Orders during checkout.
///
/// Key relationships:
/// - Belongs to {@link ecommerce_mall_customers} - one customer has many
/// addresses
/// - Referenced by {@link ecommerce_mall_orders} during order placement
/// - Snapshot history tracked in {@link ecommerce_mall_address_snapshots}
/// for audit trail
///
/// Business rules:
/// - Each customer may designate one address as default for convenience
/// - Addresses are soft-deleted to preserve order history integrity
/// - Recipient phone number required for delivery contact
///
/// @namespace Addresses
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_addresses {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who owns this address. {@link ecommerce_mall_customers.id}
  ecommerce_mall_customer_id String
  
  /// Name of the person who will receive the delivery at this address.
  /// Required for shipping labels and delivery notifications.
  recipient_name String
  
  /// Phone number of the recipient for delivery contact and notifications. May
  /// include country code.
  recipient_phone String
  
  /// Street address including building number and street name. May include
  /// apartment/suite number.
  street String
  
  /// City or municipality where the address is located.
  city String
  
  /// State, province, or region where the address is located.
  state String
  
  /// Whether this is the customer's default address. Only one address per
  /// customer can be marked as default. Default addresses are pre-selected
  /// during checkout for convenience.
  is_default Boolean
  
  /// Timestamp when this address record was created.
  created_at DateTime
  
  /// Timestamp when this address record was last modified.
  updated_at DateTime
  
  /// Timestamp when this address was soft-deleted. Null if address is active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer ecommerce_mall_customers @relation(fields: [ecommerce_mall_customer_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  orders ecommerce_mall_orders[]
  snapshots ecommerce_mall_address_snapshots[]
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([ecommerce_mall_customer_id, is_default], map: "ecommerce_mall_addresses_ecommerce_mall_customer_id_is_c4955a2f")
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_customer_id, created_at], map: "ecommerce_mall_addresses_ecommerce_mall_customer_id_cr_9c8b72a6")
  @@index([ecommerce_mall_customer_id, city])
}

/// Point-in-time snapshots of customer shipping addresses for audit trail
/// and historical reference.
///
/// This table captures immutable snapshots of address state changes,
/// providing an audit trail for dispute resolution, order fulfillment
/// verification, and historical analysis. Each snapshot records the complete
/// address state at the time of creation or modification.
///
/// **Key relationships**:
/// - Belongs to {@link ecommerce_mall_addresses} - References the original
/// address record that was snapshot
/// - Business context: Used to verify address state at order creation time
/// for dispute resolution
/// - Immutable: Snapshots are append-only and never modified
///
/// **Snapshot architecture**:
/// - Denormalized: Contains all address fields for historical completeness
/// - Read-only: Cannot be updated after creation
/// - Audit trail: Enables tracking of address changes over time
///
/// @namespace Addresses
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_address_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Original address's {@link ecommerce_mall_addresses.id}.
  address_id String
  
  /// Customer's {@link ecommerce_mall_customers.id}.
  customer_id String
  
  /// Name of the recipient at the delivery address.
  recipient_name String
  
  /// Phone number of the recipient at this address.
  recipient_phone String
  
  /// Street address (line 1) for delivery.
  street_address String
  
  /// City or municipality name.
  city String
  
  /// State or province name.
  state String
  
  /// Postal or ZIP code.
  zip_code String
  
  /// Whether this was the customer's default address at snapshot time.
  is_default Boolean
  
  /// Timestamp when this snapshot was created.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  address ecommerce_mall_addresses @relation(fields: [address_id], references: [id], onDelete: Cascade)
  customer ecommerce_mall_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([address_id, created_at])
  @@index([customer_id])
}