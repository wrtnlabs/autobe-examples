  variant ecommerce_mall_product_variants @relation(fields: [ecommerce_mall_product_variant_id], references: [id], onDelete: Cascade)
  product ecommerce_mall_products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_product_variant_id, created_at], map: "ecommerce_mall_product_variant_snapshots_ecommerce_mal_5e4e7b44")
  @@index([product_id])
  @@index([created_at])
}