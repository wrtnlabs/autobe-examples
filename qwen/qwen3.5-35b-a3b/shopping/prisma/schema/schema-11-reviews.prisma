/// Customer product reviews with ratings and text content.
///
/// Reviews represent customer feedback on purchased products, enabling
/// social proof and product quality assessment. Each review is tied to a
/// specific customer (author), product (subject), and order (verification
/// proof for verified purchase status).
///
/// Customers can create, edit, and delete their own reviews. Reviews support
/// helpfulness voting via ecommerce_mall_review_helpfulness_votes table.
/// Review content can be searched across the platform for product discovery.
///
/// Relationships:
/// - Belongs to {@link ecommerce_mall_customers.id} (customer who wrote review)
/// - Belongs to {@link ecommerce_mall_products.id} (product being reviewed)
/// - Belongs to {@link ecommerce_mall_orders.id} (proof of purchase for
/// verification)
/// - Has many {@link ecommerce_mall_review_helpfulness_votes.id}
/// (helpfulness votes)
/// - Has many {@link ecommerce_mall_review_snapshots.id} (audit trail)
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_reviews {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who wrote this review. {@link ecommerce_mall_customers.id}
  customer_id String
  
  /// Product being reviewed. {@link ecommerce_mall_products.id}
  product_id String
  
  /// Order containing this product (proof of purchase). {@link
  /// ecommerce_mall_orders.id}
  order_id String
  
  /// Rating from 1 to 5 stars (1 = worst, 5 = best)
  rating Int
  
  /// Optional review title or summary
  title String?
  
  /// Review text content describing customer experience
  body String
  
  /// Whether this review is from a verified purchase (order was completed)
  is_verified_purchase Boolean
  
  /// Review creation timestamp
  created_at DateTime
  
  /// Last review modification timestamp
  updated_at DateTime
  
  /// Review deletion timestamp (soft delete for moderation)
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer ecommerce_mall_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  product ecommerce_mall_products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  order ecommerce_mall_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  helpfulnessVotes ecommerce_mall_review_helpfulness_votes[]
  snapshots ecommerce_mall_review_snapshots[]
  
  //----
  // INDEXES
  //----
  @@unique([customer_id, product_id])
  @@index([product_id, rating])
  @@index([customer_id, created_at])
  @@index([order_id])
}

/// Customer votes indicating whether a review was helpful for quality
/// assessment and sorting.
///
/// This table tracks helpfulness votes from customers on individual reviews,
/// enabling the platform to:
/// - Calculate helpfulness scores for review sorting
/// - Assess review quality through community feedback
/// - Prevent duplicate votes from the same customer on the same review
///
/// Key relationships:
/// - {@link ecommerce_mall_customers.id} - The customer casting the
/// helpfulness vote
/// - {@link ecommerce_mall_reviews.id} - The review being evaluated for
/// helpfulness
///
/// Business rules:
/// - Each customer can vote ONCE per review (enforced by unique constraint
/// on customer_id + review_id)
/// - Votes are boolean (helpful/not helpful) for simplicity in aggregation
/// - Soft delete enabled for data recovery when needed
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_review_helpfulness_votes {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who cast the helpfulness vote. {@link
  /// ecommerce_mall_customers.id}
  ecommerce_mall_customer_id String
  
  /// Review being evaluated for helpfulness. {@link ecommerce_mall_reviews.id}
  ecommerce_mall_review_id String
  
  /// Whether the review was helpful (true) or not helpful (false).
  helpfulness Boolean
  
  /// Timestamp when the helpfulness vote was cast.
  created_at DateTime
  
  /// Timestamp of the last update to this helpfulness vote.
  updated_at DateTime
  
  /// Soft delete timestamp for data recovery.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer ecommerce_mall_customers @relation(fields: [ecommerce_mall_customer_id], references: [id], onDelete: Cascade)
  review ecommerce_mall_reviews @relation(fields: [ecommerce_mall_review_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([ecommerce_mall_customer_id, ecommerce_mall_review_id], map: "ecommerce_mall_review_helpfulness_votes_ecommerce_mall_a9926d23")
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_review_id, helpfulness], map: "ecommerce_mall_review_helpfulness_votes_ecommerce_mall_a2bba0cf")
}

/// Immutable audit trail snapshots of review state changes for historical
/// tracking and dispute resolution.
///
/// Captures point-in-time states when reviews are created, modified, or have
/// their helpfulness votes updated. Each snapshot records the complete state
/// of the review at that moment, enabling historical verification and
/// dispute resolution.
///
/// Related entities: {@link ecommerce_mall_reviews}, {@link
/// ecommerce_mall_customers}
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_review_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced review's {@link ecommerce_mall_reviews.id}. This foreign key
  /// links the snapshot to the specific review it documents.
  ecommerce_mall_review_id String
  
  /// Customer's {@link ecommerce_mall_customers.id} who wrote or modified this
  /// review. This foreign key identifies the actor associated with this
  /// snapshot.
  customer_id String
  
  /// Type of actor who triggered this snapshot (e.g., 'customer', 'system',
  /// 'moderator'). Used for audit trail purposes.
  changed_by_type String
  
  /// UUID of the actor who triggered this snapshot change. If changed_by_type
  /// is 'system', this may be null.
  changed_by_id String?
  
  /// Type of change captured (e.g., 'created', 'modified',
  /// 'helpfulness_updated', 'deleted'). Categorizes the snapshot for efficient
  /// querying.
  snapshot_type String
  
  /// JSON string containing the previous state of the review before this
  /// change. Stores null for initial creation snapshots.
  old_data String?
  
  /// JSON string containing the complete review state after this change.
  /// Required for all snapshots.
  new_data String
  
  /// Timestamp when this snapshot was created, representing the point-in-time
  /// state captured.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  review ecommerce_mall_reviews @relation(fields: [ecommerce_mall_review_id], references: [id], onDelete: Cascade)
  customer ecommerce_mall_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_review_id, created_at], map: "ecommerce_mall_review_snapshots_ecommerce_mall_review__47db8772")
  @@index([customer_id, created_at])
  @@index([snapshot_type])
}