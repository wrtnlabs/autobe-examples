/// Tracks all stock movements for product variants including quantity
/// changes, reasons, and timestamps. This table provides an immutable audit
/// trail of inventory changes triggered by restocking, sales, returns,
/// cancellations, and manual adjustments.
///
/// Each record represents a single stock movement event with the
/// quantity_change field indicating whether stock increased (positive) or
/// decreased (negative). The reason field categorizes the type of movement
/// (RESTOCK, SALE, RETURN, CANCELLATION, ADJUSTMENT, etc.) and the type
/// field distinguishes between incoming, outgoing, or adjustment
/// transactions.
///
/// This table references the product variant that the movement applies to
/// via ecommerce_mall_product_variant_id, and optionally links to related
/// orders, cancellation requests, or refund requests when the stock movement
/// is triggered by those transactions. The remaining_quantity field
/// preserves the inventory level after each movement for historical
/// reference.
///
/// Relationships:
/// - Belongs to {@link ecommerce_mall_product_variants} - the product
/// variant being tracked
/// - Optionally references {@link ecommerce_mall_orders} - when stock is
/// sold/reserved for orders
/// - Optionally references {@link ecommerce_mall_cancellation_requests} -
/// when stock is restored due to cancellations
/// - Optionally references {@link ecommerce_mall_refund_requests} - when
/// stock is restored due to refunds
/// - Referenced by {@link ecommerce_mall_inventory_snapshots} - for
/// point-in-time audit trails
///
/// @namespace Inventory
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_inventory_records {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product variant being tracked. {@link ecommerce_mall_product_variants.id}.
  ecommerce_mall_product_variant_id String
  
  /// Optional reference to order when stock movement is triggered by order.
  /// {@link ecommerce_mall_orders.id}.
  ecommerce_mall_order_id String?
  
  /// Optional reference to cancellation request when stock is restored. {@link
  /// ecommerce_mall_cancellation_requests.id}.
  ecommerce_mall_cancellation_request_id String?
  
  /// Optional reference to refund request when stock is restored. {@link
  /// ecommerce_mall_refund_requests.id}.
  ecommerce_mall_refund_request_id String?
  
  /// Quantity change for this stock movement. Positive for incoming stock
  /// (restocks, returns), negative for outgoing stock (sales, cancellations).
  quantity_change Int
  
  /// Inventory quantity remaining after this stock movement.
  remaining_quantity Int
  
  /// Categorization of the stock movement reason (RESTOCK, SALE, RETURN,
  /// CANCELLATION, ADJUSTMENT, DAMAGE, LOSS, etc.).
  reason String
  
  /// Transaction type classification (INCOMING, OUTGOING, ADJUSTMENT).
  type String
  
  /// Optional additional context or notes about this stock movement.
  description String?
  
  /// Timestamp when this inventory record was created.
  created_at DateTime
  
  /// Timestamp when this inventory record was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp for data preservation.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  variant ecommerce_mall_product_variants @relation(fields: [ecommerce_mall_product_variant_id], references: [id], onDelete: Cascade)
  order ecommerce_mall_orders? @relation(fields: [ecommerce_mall_order_id], references: [id], onDelete: Cascade)
  cancellationRequest ecommerce_mall_cancellation_requests? @relation(fields: [ecommerce_mall_cancellation_request_id], references: [id], onDelete: Cascade)
  refundRequest ecommerce_mall_refund_requests? @relation(fields: [ecommerce_mall_refund_request_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots ecommerce_mall_inventory_snapshots[]
  
  //----
  // INDEXES
  //----
  @@index([ecommerce_mall_order_id])
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_cancellation_request_id], map: "ecommerce_mall_inventory_records_ecommerce_mall_cancel_e1b7d5bd")
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_refund_request_id], map: "ecommerce_mall_inventory_records_ecommerce_mall_refund_a3837fc8")
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_product_variant_id, created_at], map: "ecommerce_mall_inventory_records_ecommerce_mall_produc_19d25df6")
}

/// Point-in-time snapshots of inventory records for audit and rollback
/// capabilities.
///
/// This snapshot table captures the state of inventory records at specific
/// moments in time, enabling audit trails, historical analysis, and rollback
/// operations. Each snapshot represents a complete state of an inventory
/// record including variant reference, quantity, reserved quantity, reason,
/// and notes.
///
/// Key relationships:
/// - {@link ecommerce_mall_inventory_records} - Parent table storing current
/// inventory record state
/// - {@link ecommerce_mall_product_variants} - Referenced via denormalized
/// variant_id for historical tracking
///
/// Behavioral notes:
/// - Append-only table - once created, snapshots are never modified or deleted
/// - Denormalized structure for efficient historical queries without joins
/// - Each inventory record can have multiple snapshots over its lifetime
/// - Used for dispute resolution, stock reconciliation, and compliance auditing
///
/// @namespace Inventory
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_inventory_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced inventory record's {@link ecommerce_mall_inventory_records.id}.
  inventory_record_id String
  
  /// Denormalized product variant ID at time of snapshot for historical
  /// tracking without joins.
  variant_id String
  
  /// Stock quantity at time of snapshot.
  quantity Int
  
  /// Reserved stock quantity at time of snapshot.
  reserved_quantity Int
  
  /// Reason code for the inventory change (e.g., RESTOCK, ORDER_DEDUCTION,
  /// REFUND_RESTORATION).
  reason String?
  
  /// Additional notes or context for the inventory change.
  notes String?
  
  /// Timestamp when this snapshot was created.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  inventoryRecord ecommerce_mall_inventory_records @relation(fields: [inventory_record_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([inventory_record_id])
  @@index([created_at])
}