  // spellchecker: ignore-next-line
  @@index([hrm_platform_timesheet_id, deleted_at], map: "hrm_platform_timesheet_timelogs_hrm_platform_timesheet_6f2b1b8b")
  // spellchecker: ignore-next-line
  @@index([hrm_platform_timelog_id, deleted_at], map: "hrm_platform_timesheet_timelogs_hrm_platform_timelog_i_f55a3791")
}

