/// Centralized audit trail capturing all significant system actions per
/// organization.
///
/// This table serves as the system-wide event log for compliance and
/// debugging. Each entry records an action performed by a user within an
/// organization context, including:
///
/// - Employee lifecycle events: invited, deactivated, reactivated
/// - Contract events: created, edited
/// - Project events: created, archived, completed, deleted
/// - Task events: status changed
/// - Timesheet events: submitted, approved, rejected
/// - Role events: assigned, changed
///
/// Users with org:manage permission can view the full activity log for their
/// organization.
///
/// {@link hrms_organizations} - Each log entry belongs to exactly one
/// organization.
/// {@link hrms_members} - Records which user performed the action.
/// {@link hrms_employees} - Referenced for employee-related actions.
/// {@link hrms_projects} - Referenced for project-related actions.
/// {@link hrms_tasks} - Referenced for task-related actions.
/// {@link hrms_timesheets} - Referenced for timesheet-related actions.
/// {@link hrms_organization_roles} - Referenced for role-related actions.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrms_activity_logs {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Organization that this activity belongs to. {@link hrms_organizations.id}
  organization_id String
  
  /// User who performed the action. {@link hrms_members.id}
  performed_by_id String
  
  /// Type of action performed. Values: 'employee.invited',
  /// 'employee.deactivated', 'employee.reactivated', 'contract.created',
  /// 'contract.edited', 'project.created', 'project.archived',
  /// 'project.completed', 'project.deleted', 'task.status_changed',
  /// 'timesheet.submitted', 'timesheet.approved', 'timesheet.rejected',
  /// 'role.assigned', 'role.changed'.
  action_type String
  
  /// Type of entity that was affected. Values: 'employee', 'contract',
  /// 'project', 'task', 'timesheet', 'role', 'user'.
  target_entity String
  
  /// ID of the target entity (nullable if action doesn't target a specific
  /// entity).
  target_id String?
  
  /// Additional details about the action (e.g., field changes, reasons).
  details String?
  
  /// Timestamp when the action was performed.
  created_at DateTime
  
  /// Timestamp when the record was last updated.
  updated_at DateTime
  
  /// Soft delete timestamp (nullable means not deleted).
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  organization hrms_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  performedBy hrms_members @relation(fields: [performed_by_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([organization_id, created_at])
  @@index([action_type])
  @@index([performed_by_id, created_at])
}