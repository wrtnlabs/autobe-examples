  /// Reference to the {@link hrms_tasks.id} that had its status changed.
  hrms_task_id String
  
  /// Reference to the {@link hrms_members.id} who made the status change.
  hrms_member_id String
  
  /// The previous status value before the change (open, in-progress,
  /// completed, closed).
  old_status String
  
  /// The new status value after the change (open, in-progress, completed,
  /// closed).
  new_status String
  
  /// Timestamp when the status change occurred.
  created_at DateTime
  
  /// Last update timestamp for soft delete tracking.
  updated_at DateTime
  
  /// Soft delete timestamp (nullable, null means active).
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  task hrms_tasks @relation(fields: [hrms_task_id], references: [id], onDelete: Cascade)
  member hrms_members @relation(fields: [hrms_member_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([hrms_task_id, created_at])
  @@index([hrms_member_id])
  @@index([created_at])
}