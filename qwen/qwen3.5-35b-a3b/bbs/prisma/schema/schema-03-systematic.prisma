  reviewedByAdmin economic_political_board_administrator_roles? @relation("economic_political_board_administrator_requests_of_rev_5c00ff53", fields: [reviewed_by_admin_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([user_id, created_at], map: "economic_political_board_administrator_requests_user_i_6976a84c")
  @@index([status])
