  actorCitizen political_forum_citizens? @relation(fields: [actor_citizen_id], references: [id], onDelete: Cascade)
  actorModerator political_forum_moderators? @relation(fields: [actor_moderator_id], references: [id], onDelete: Cascade)
  
  @@index([created_at])
