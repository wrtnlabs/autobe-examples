  political_forum_post_id String
  
  /// Reference to the allowed file type category (e.g., image/jpeg,
  /// application/pdf). {@link political_forum_attachment_types.id}
  political_forum_attachment_type_id String
  
  /// The original filename provided by the user during upload. Preserved
