/// Stores profile information and authentication details for regular users
/// of the discussion board.
///
/// Represents citizens who can register, create posts, submit comments, and
/// upload attachments. Each citizen has a unique email and encrypted
/// password for secure authentication. This entity is linked to their active
/// sessions via the citizen_sessions table.
///
/// Citizens are primary actors - they independently manage their account,
/// view their posted content, and interact with other users. Soft deletion
/// is supported to maintain audit trails during account deactivation or
/// moderation actions.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_citizen {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique email address for authentication and notification. Must be
  /// validated and verified.
  email String
  
  /// Securely hashed password using Argon2 or bcrypt. Never stored in plain
  /// text.
  password_hash String
  
  /// Timestamp when the citizen account was created.
  created_at DateTime
  
  /// Timestamp of the last update to citizen profile or authentication data.
  updated_at DateTime
  
  /// Soft delete timestamp; if set, account is deactivated but preserved for
  /// audit.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  discussion_board_authentication_logs discussion_board_authentication_logs[]
  discussion_board_activity_logs discussion_board_activity_logs[]
  discussion_board_citizen_sessions discussion_board_citizen_sessions[]
  discussion_board_articles discussion_board_articles[]
  discussion_board_article_reports discussion_board_article_reports[]
  discussion_board_article_comments discussion_board_article_comments[]
  discussion_board_article_status_logs discussion_board_article_status_logs[]
  discussion_board_comments discussion_board_comments[]
  discussion_board_comment_replies discussion_board_comment_replies[]
  discussion_board_comment_votes discussion_board_comment_votes[]
  discussion_board_attachment_images discussion_board_attachment_images[]
  discussion_board_reports discussion_board_reports[]
  discussion_board_warnings discussion_board_warnings[]
  discussion_board_suspensions discussion_board_suspensions[]
  discussion_board_bans discussion_board_bans[]
  discussion_board_appeals discussion_board_appeals[]
  discussion_board_citizen_violations discussion_board_citizen_violations[]
  discussion_board_citizen_trust_scores discussion_board_citizen_trust_scores?
  discussion_board_citizen_suspensions discussion_board_citizen_suspensions[]
  discussion_board_notification_preferences discussion_board_notification_preferences[]
  discussion_board_audit_events discussion_board_audit_events[]
  discussion_board_compliance_records discussion_board_compliance_records[]
  
  @@unique([email])
  @@index([created_at])
  @@index([deleted_at])
}

/// Tracks authentication sessions for discussion board citizens, including
/// session tokens and expiration.
///
/// Each session represents a user's active connection to the application.
/// Sessions are automatically created upon successful authentication and
/// invalidated upon logout or expiration. This table supports security
/// auditing by tracking IP addresses, connection URLs, and referrer
/// information for each session.
///
/// Sessions are managed by authentication flows and do not require direct
/// user interaction. They provide critical audit trails for investigating
/// suspicious activity and verifying user identity attribution.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_citizen_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Citizen's {@link discussion_board_citizen.id}.
  citizen_id String
  
  /// IP address from which the session was initiated.
  ip String
  
  /// URL of the connection that established this session.
  href String
  
  /// Referrer URL that led the user to initiate this session.
  referrer String
  
  /// Timestamp when this session was created.
  created_at DateTime
  
  /// Timestamp when this session expires or is invalidated. Null indicates
  /// session is still active.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  citizen discussion_board_citizen @relation(fields: [citizen_id], references: [id], onDelete: Cascade)
  
  @@index([citizen_id, created_at])
}

/// Privileged account information for moderators who manage content and user
/// reports.
///
/// Stores credentials and authentication details for users with elevated
/// permissions to review, edit, or remove content.
/// This table exists independently of the main user table to provide
/// specialized access controls for moderation roles.
/// Each moderator account has unique authentication credentials and cannot
/// be a regular citizen account.
/// Soft deletion is supported to maintain audit trails while allowing
/// temporary deactivation of moderator privileges.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_moderator {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the primary user account in the Systematic component. {@link
  /// discussion_board_users.id}.
  discussion_board_user_id String
  
  /// Unique email address used for authentication and communication. Must be
  /// distinct from citizen accounts.
  email String
  
  /// Hashed password for secure authentication. Never store plain text
  /// passwords.
  password_hash String
  
  /// Timestamp when the moderator account was created.
  created_at DateTime
  
  /// Timestamp of the last update to the moderator account metadata.
  updated_at DateTime
  
  /// Timestamp when the moderator account was deactivated (soft delete). Null
  /// indicates active account.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  user discussion_board_users @relation(fields: [discussion_board_user_id], references: [id], onDelete: Cascade)
  
  discussion_board_moderation_logs discussion_board_moderation_logs[]
  discussion_board_authentication_logs discussion_board_authentication_logs[]
  discussion_board_activity_logs discussion_board_activity_logs[]
  discussion_board_moderator_sessions discussion_board_moderator_sessions[]
  discussion_board_article_publication_log discussion_board_article_publication_log[]
  discussion_board_comment_mod_actions discussion_board_comment_mod_actions[]
  discussion_board_reports discussion_board_reports[]
  discussion_board_moderation_actions discussion_board_moderation_actions[]
  discussion_board_bans discussion_board_bans[]
  discussion_board_appeals discussion_board_appeals[]
  discussion_board_moderator_actions discussion_board_moderator_actions[]
  discussion_board_notification_preferences discussion_board_notification_preferences[]
  discussion_board_audit_events discussion_board_audit_events[]
  discussion_board_compliance_records discussion_board_compliance_records[]
  
  @@unique([email])
  @@unique([discussion_board_user_id])
  @@index([created_at])
  @@index([deleted_at])
}

/// Authentication sessions for moderators with elevated access privileges.
///
/// Tracks active and expired sessions for moderator accounts, enabling audit
/// tracing of moderator authentication events and connection contexts. Each
/// session is associated with a single moderator and captures IP address,
/// connection URL, and referrer information.
///
/// Sessions are managed automatically by the identity system and are not
/// directly created or manipulated by users. They serve as operational logs
/// for security monitoring and compliance tracking, with expired sessions
/// automatically cleaned up by system processes.
///
/// No personal authentication data is stored here; moderator identity is
/// referenced via the foreign key to the moderator table.
///
/// @namespace Actors
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_moderator_sessions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The moderator account this session belongs to. {@link
  /// discussion_board_moderator.id}.
  moderator_id String
  
  /// IP address from which the session was initiated.
  ip String
  
  /// The URL of the connection endpoint (e.g., the page or API route accessed).
  href String
  
  /// The referrer URL that led to this session.
  referrer String
  
  /// Timestamp when the session was created.
  created_at DateTime
  
  /// Timestamp when the session expired. Null indicates an active session.
  expired_at DateTime?
  
  //----
  // RELATIONS
  //----
  moderator discussion_board_moderator @relation(fields: [moderator_id], references: [id], onDelete: Cascade)
  
  @@index([moderator_id, created_at])
}