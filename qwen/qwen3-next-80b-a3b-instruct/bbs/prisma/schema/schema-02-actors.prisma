  //----
  /// Primary Key.
  id String @id
  
  /// The user's {@link economic_forum_users.id} who owns this session.
  user_id String
  
  /// The IP address used to establish this session.
  ip String
  
  /// The URL of the connection that established this session.
  href String
  
  /// The referrer URL that led to this session establishment.
  referrer String
  
  /// The timestamp when this session was created.
  created_at DateTime
  
  /// The timestamp when this session will expire. Always set to 24 hours after
  /// created_at. Not nullable to enforce security policy.
