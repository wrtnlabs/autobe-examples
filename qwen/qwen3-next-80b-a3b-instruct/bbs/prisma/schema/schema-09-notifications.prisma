  read_at DateTime
  
  /// When this read status record was initially created in the system.
  created_at DateTime
  
  /// When this read status record was last updated (e.g., when status changed
  /// or was reconfirmed).
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  notificationRecord discussion_board_notification_records @relation(fields: [discussion_board_notification_record_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([discussion_board_notification_record_id, user_id], map: "discussion_board_notification_read_status_discussion_b_cffbd35f")
  // spellchecker: ignore-next-line
  @@index([user_id, created_at], map: "discussion_board_notification_read_status_user_id_crea_a8c4a8df")
  @@index([user_id, read_at])
}

/// Records notification events triggered by user actions such as replies,
/// reports, moderator actions, and appeal outcomes.
///
/// Captures business-critical notifications that users receive when their
/// content is interacted with or modified by others. These events must be
/// independently managed by users in a notification center UI, enabling
/// filtering by type (e.g., 'all moderator actions affecting me') and
/// marking as read/unread regardless of the source entity.
///
/// The notification event is decoupled from its source (post, comment,
/// etc.), allowing independent lifecycle management without affecting the
/// original content. Each record points to a specific recipient (user) and
/// has a type defining the triggering action, with targeted foreign keys to
/// ensure referential integrity to the triggering entity.
///
/// Soft delete is supported to allow users to clear notification history
/// while preserving audit trail for compliance.
///
/// @namespace Notifications
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_notification_records {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The user who receives this notification. {@link
  /// discussion_board_users.id}.
  recipient_id String
  
  /// The post that triggered this notification (e.g., reply to post). {@link
  /// discussion_board_posts.id}.
  target_post_id String?
  
  /// The comment that triggered this notification (e.g., reply to comment).
  /// {@link discussion_board_comments.id}.
  target_comment_id String?
  
  /// The report on content that triggered this notification (e.g., report
  /// processed). {@link discussion_board_reports.id}.
  target_report_id String?
  
  /// The moderation action that triggered this notification (e.g., post
  /// hidden). {@link discussion_board_moderation_actions.id}.
  target_moderation_action_id String?
  
  /// The appeal that triggered this notification (e.g., appeal resolved).
  /// {@link discussion_board_appeals.id}.
  target_appeal_id String?
  
  /// Type of notification event. Valid values: 'comment_reply', 'post_report',
  /// 'moderation_action', 'appeal_outcome'. Indicates the business action that
  /// triggered this notification.
  notification_type String
  
  /// JSON-encoded additional context or data specific to the notification
  /// type. May include sender ID, reason, action details, or custom metadata.
  /// Use only for variable data that doesn't warrant dedicated fields.
  metadata String?
  
  /// Timestamp when the notification event was created and queued for delivery.
  created_at DateTime
  
  /// Timestamp of the last update to this notification record (e.g., when
  /// marked as read).
  updated_at DateTime
  
  /// Timestamp when this notification was soft-deleted by the recipient. Null
  /// if still active.
  deleted_at DateTime?
  
  /// Indicates whether the recipient has viewed this notification. False when
  /// created, true when marked as read in the notification center.
  is_read Boolean
  
  //----
  // RELATIONS
  //----
  recipient discussion_board_users @relation(fields: [recipient_id], references: [id], onDelete: Cascade)
  targetPost discussion_board_posts? @relation(fields: [target_post_id], references: [id], onDelete: Cascade)
  targetComment discussion_board_comments? @relation(fields: [target_comment_id], references: [id], onDelete: Cascade)
  targetReport discussion_board_reports? @relation(fields: [target_report_id], references: [id], onDelete: Cascade)
  targetModerationAction discussion_board_moderation_actions? @relation(fields: [target_moderation_action_id], references: [id], onDelete: Cascade)
  targetAppeal discussion_board_appeals? @relation(fields: [target_appeal_id], references: [id], onDelete: Cascade)
  
  discussion_board_notification_delivery_logs discussion_board_notification_delivery_logs[]
  discussion_board_notification_read_status discussion_board_notification_read_status[]
  
  @@index([target_post_id])
  @@index([target_comment_id])
  @@index([target_report_id])
  // spellchecker: ignore-next-line
  @@index([target_moderation_action_id], map: "discussion_board_notification_records_target_moderatio_63d1f8ea")
  @@index([target_appeal_id])
  
  // spellchecker: ignore-next-line
  @@index([recipient_id, created_at], map: "discussion_board_notification_records_recipient_id_cre_127a107a")
  @@index([recipient_id, is_read])
  // spellchecker: ignore-next-line
  @@index([recipient_id, notification_type, created_at], map: "discussion_board_notification_records_recipient_id_not_d14bf52e")
  // spellchecker: ignore-next-line
  @@index([notification_type, target_post_id], map: "discussion_board_notification_records_notification_typ_250fb984")
