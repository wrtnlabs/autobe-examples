/// Records reports submitted by citizens against specific political forum
/// posts. Each report captures the reporting citizen, the post being
/// reported, the reason for the report, and its current moderation status.
/// This table is independent and allows moderators to efficiently review and
/// filter all reported posts across the system without needing to load the
/// parent post content. Each report can be independently queried, sorted,
/// and archived. Linked to political_forum_posts.id and
/// political_forum_citizens.id.
///
/// @namespace Reports
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model political_forum_post_reports {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The post being reported. {@link political_forum_posts.id}
  political_forum_post_id String
  
  /// The citizen who submitted the report. {@link political_forum_citizens.id}
  political_forum_citizen_id String
  
  /// Status of the report. Values: pending, reviewed, dismissed, escalated.
  status String
  
  /// The reason or explanation provided by the citizen for why they are
  /// reporting this post. Should contain at least 10 characters.
  reason String
  
  /// Timestamp of when the report was submitted.
  created_at DateTime
  
  /// Timestamp of the last update to the report status or reason.
  updated_at DateTime
  
  /// Soft delete timestamp. If null, the report is active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  post political_forum_posts @relation(fields: [political_forum_post_id], references: [id], onDelete: Cascade)
  citizen political_forum_citizens @relation(fields: [political_forum_citizen_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([political_forum_post_id, political_forum_citizen_id], map: "political_forum_post_reports_political_forum_post_id_p_ade2e732")
  @@index([political_forum_citizen_id])
  @@index([political_forum_post_id])
  @@index([status])
  @@index([created_at])
}

