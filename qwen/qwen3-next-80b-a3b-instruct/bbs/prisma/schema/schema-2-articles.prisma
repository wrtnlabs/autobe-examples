  updated_at DateTime
  
  /// Soft delete timestamp. Null if not deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  articleSnapshot economic_board_article_snapshots @relation(fields: [economic_board_article_snapshot_id], references: [id], onDelete: Cascade)
  tag economic_board_tags @relation(fields: [economic_board_tag_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([economic_board_tag_id])
  // spellchecker: ignore-next-line
  @@unique([economic_board_article_snapshot_id, economic_board_tag_id], map: "economic_board_article_snapshot_tags_economic_board_ar_52ac10b4")
}

