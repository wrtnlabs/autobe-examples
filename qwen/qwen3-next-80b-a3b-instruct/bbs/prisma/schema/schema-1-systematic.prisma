/// Main actor table for standard users. Stores email, password_hash,
/// display_name, bio, and account status. Email is unique and required. All
/// citizens have is_admin=false and is_super_admin=false.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_board_citizens {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// User's email address for authentication. Must be unique across the system.
  email String
  
  /// BCrypt hash of the user's password. Never stored in plain text.
  password_hash String
  
  /// Public-facing name displayed on articles and comments. Can be changed by
  /// user.
  display_name String?
  
  /// Optional short biography or introduction about the user.
  bio String?
  
  /// Flag indicating if the account has been banned. When true, user cannot
  /// log in and all sessions are revoked.
  is_banned Boolean
  
  /// Reason provided by administrator for banning this user. Must be at least
  /// 10 characters when is_banned is true.
  ban_reason String?
  
  /// Timestamp when the user account was created. Set once and never changed.
  created_at DateTime
  
  /// Timestamp of the last modification to the user profile. Updated on
  /// display_name, bio, or password changes.
  updated_at DateTime
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  citizenSessions economic_board_citizen_sessions[]
  passwordResets economic_board_citizen_password_resets[]
  emailVerifications economic_board_citizen_email_verifications[]
  auditTargets economic_board_administrator_audit_logs[]
  articles economic_board_articles[]
  comments economic_board_comments[]
  articleViews economic_board_article_views[]
  
  //----
  // INDEXES
  //----
  @@unique([email])
  @@index([is_banned, created_at])
}

/// Main actor table for standard administrators (not super administrators).
/// Stores email, password hash, account status, and admin-specific fields.
/// This table is exclusively for users promoted to administrator role but
/// not super administrator. It has its own session, password reset, and
/// audit trail records. All super administrators are stored in a separate
/// table, economic_board_super_administrators, following the actor
/// separation principle.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model economic_board_administrators {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Unique email address for authentication. Must be verified before login.
  email String
  
  /// BCrypt-hashed password. Never stored in plain text.
  password_hash String
  
  /// Public display name shown on articles and comments. Can be modified by
  /// user.
  display_name String?
  
  /// Optional self-description briefly explaining the user's expertise or
  /// interest.
  bio String?
  
  /// If true, user is banned and cannot authenticate. True by default when
  /// banned.
  is_banned Boolean
  
  /// Reason provided by the banning administrator. Required when is_banned is
  /// true.
  ban_reason String?
  
  /// Status of the administrator promotion request from citizen: pending,
  /// approved, or rejected.
  admin_request_status String
  
  /// The reason provided by the citizen when requesting promotion to
  /// administrator.
  admin_request_reason String?
  
  /// Timestamp when the administrator account was created.
  created_at DateTime
  
  /// Timestamp when the administrator record was last updated.
  updated_at DateTime
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  administratorSessions economic_board_administrator_sessions[]
  sessions economic_board_super_administrator_sessions[]
  auditLogs economic_board_administrator_audit_logs[]
  passwordResets economic_board_administrator_password_resets[]
  superAdministratorPasswordResets economic_board_super_administrator_password_resets[]
  sectionSnapshots economic_board_section_snapshots[]
  
  //----
  // INDEXES
  //----
  @@unique([email])
  @@index([is_banned, created_at])
  // spellchecker: ignore-next-line
  @@index([admin_request_status, created_at], map: "economic_board_administrators_admin_request_status_cre_b56b9f22")
}

