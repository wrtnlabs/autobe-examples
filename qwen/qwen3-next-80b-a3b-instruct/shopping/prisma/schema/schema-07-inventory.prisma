/// Core inventory units tracking available stock for each product variant.
///
/// Represents the current available quantity of each product variant in the
/// warehouse. This is the authoritative source for stock availability during
/// checkout.
///
/// Each record corresponds to one unique product variant. The quantity field
/// reflects the actual available stock after all reservations and
/// allocations have been accounted for.
///
/// This table is the primary source for inventory availability checks during
/// order processing and should be accessed using atomic operations to
/// prevent race conditions.
///
/// Maintains the canonical stock count that is updated by
/// inventory_transactions.
///
/// @link shopping_mall_product_variants.id
///
/// @namespace Inventory
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_inventory_units {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the product variant this inventory unit tracks. {@link
  /// shopping_mall_product_variants.id}.
  product_variant_id String
  
  /// Seller who owns this inventory. {@link shopping_mall_sellers.id}.
  seller_id String
  
  /// Current available stock quantity for this product variant. Must be >= 0.
  quantity Int
  
  /// Minimum stock level that triggers an alert. When stock falls below this
  /// threshold, inventory_alerts are created.
  min_stock_threshold Int
  
  /// Timestamp of the last inventory update. Used for cache invalidation and
  /// sync processes.
  last_updated DateTime
  
  /// When this inventory record was first created in the system.
  created_at DateTime
  
  /// When this inventory record was last modified.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  productVariant shopping_mall_product_variants @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  
  shopping_mall_inventory_reservations shopping_mall_inventory_reservations[]
  shopping_mall_inventory_transactions_of_inventory_unit_id shopping_mall_inventory_transactions[] @relation("shopping_mall_inventory_transactions_of_inventory_unit_id")
  shopping_mall_inventory_transactions_of_source_adjustment_id shopping_mall_inventory_transactions[] @relation("shopping_mall_inventory_transactions_of_source_adjustment_id")
  shopping_mall_inventory_alerts shopping_mall_inventory_alerts?
  
  @@unique([product_variant_id])
  @@index([seller_id])
  @@index([quantity])
  @@index([last_updated])
}

/// Temporary reservations of inventory units for pending orders.
///
/// Represents quantities of products that have been reserved for pending
/// orders but not yet confirmed as purchased. This table prevents
/// overselling by locking inventory during the checkout process.
///
/// Each reservation has a finite lifetime (typically 15 minutes) and is
/// automatically released if the payment doesn't complete. Reservations are
/// released when the order is canceled or after timeout.
///
/// This table links to order_items to track which specific order is
/// responsible for the reservation.
///
/// @link shopping_mall_order_items.id
///
/// @namespace Inventory
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_inventory_reservations {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The inventory unit this reservation applies to. {@link
  /// shopping_mall_inventory_units.id}.
  inventory_unit_id String
  
  /// The order item that created this reservation. {@link
  /// shopping_mall_order_items.id}.
  order_item_id String
  
  /// Number of items reserved. Must be > 0.
  quantity Int
  
  /// When this reservation will automatically expire if not converted to a
  /// purchase. After this time, the reservation is canceled and inventory is
  /// released.
  expires_at DateTime
  
  /// When this reservation was created.
  created_at DateTime
  
  /// When this reservation was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  inventoryUnit shopping_mall_inventory_units @relation(fields: [inventory_unit_id], references: [id], onDelete: Cascade)
  orderItem shopping_mall_order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  
  @@unique([order_item_id])
  @@index([inventory_unit_id])
  @@index([expires_at])
}

/// Audit trail of all inventory changes.
///
/// Provides a complete, immutable history of every inventory adjustment,
/// including reservations, allocations, returns, and corrections. This table
/// supports forensic analysis and reconciliation.
///
/// Each transaction represents a single atomic change to inventory quantity
/// and links to the source of that change (order, return, manual
/// adjustment).
///
/// This table is critical for financial audit compliance and inventory
/// reconciliation. It is append-only; records are never modified or deleted.
///
/// @link shopping_mall_order_items.id
/// @link shopping_mall_order_returns.id
/// @link shopping_mall_order_shipping.id
///
/// @namespace Inventory
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_inventory_transactions {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The inventory unit this transaction affected. {@link
  /// shopping_mall_inventory_units.id}.
  inventory_unit_id String
  
  /// The order item that triggered this transaction (if applicable). {@link
  /// shopping_mall_order_items.id}.
  source_order_item_id String?
  
  /// The return that triggered this transaction (if applicable). {@link
  /// shopping_mall_order_returns.id}.
  source_return_id String?
  
  /// The manual adjustment record that caused this transaction (if applicable).
  source_adjustment_id String?
  
  /// Seller associated with this transaction. {@link shopping_mall_sellers.id}.
  seller_id String
  
  /// Type of transaction. Valid values: 'reserved', 'allocated', 'released',
  /// 'returned', 'adjusted'.
  type String
  
  /// Change in quantity. Positive for increases (returns, adjustments),
  /// negative for decreases (reservations, allocations).
  quantity_change Int
  
  /// Quantity of inventory after this transaction was applied. Used for audit
  /// replay and reconciliation.
  quantity_after Int
  
  /// Additional context about this transaction (e.g., reason for adjustment,
  /// source system). Max 500 characters.
  notes String?
  
  /// When this transaction was recorded in the system. This is immutable.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  inventoryUnit shopping_mall_inventory_units @relation("shopping_mall_inventory_transactions_of_inventory_unit_id", fields: [inventory_unit_id], references: [id], onDelete: Cascade)
  sourceOrderItem shopping_mall_order_items? @relation(fields: [source_order_item_id], references: [id], onDelete: Cascade)
  sourceReturn shopping_mall_order_returns? @relation(fields: [source_return_id], references: [id], onDelete: Cascade)
  sourceAdjustment shopping_mall_inventory_units? @relation("shopping_mall_inventory_transactions_of_source_adjustment_id", fields: [source_adjustment_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  
  @@index([source_adjustment_id])
  
  @@index([inventory_unit_id])
  @@index([source_order_item_id])
  @@index([source_return_id])
  @@index([seller_id])
  @@index([type])
  @@index([created_at])
}

/// Notifications for inventory threshold breaches.
///
/// Tracks alerts generated when inventory levels fall below the configured
/// min_stock_threshold. These alerts trigger notifications to sellers and
/// may initiate automated reorder processes.
///
/// An alert is created when inventory_units.quantity drops below
/// min_stock_threshold and is cleared when inventory increases beyond
/// threshold.
///
/// This table provides historical visibility into stock issues and helps
/// identify products with recurring low inventory problems.
///
/// @link shopping_mall_product_variants.id
/// @link shopping_mall_inventory_units.id
///
/// @namespace Inventory
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_inventory_alerts {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The inventory unit that generated this alert. {@link
  /// shopping_mall_inventory_units.id}.
  inventory_unit_id String
  
  /// Seller owner of the inventory unit that triggered the alert. {@link
  /// shopping_mall_sellers.id}.
  seller_id String
  
  /// Type of alert. Valid values: 'low_stock', 'critical_stock',
  /// 'back_in_stock'.
  alert_type String
  
  /// Stock threshold that triggered this alert.
  threshold Int
  
  /// Current stock quantity when this alert was triggered.
  current_stock Int
  
  /// When this alert was generated.
  alerted_at DateTime
  
  /// When this alert was cleared (if cleared). Null if still active.
  cleared_at DateTime?
  
  /// Current status of the alert: 'active' or 'cleared'.
  status String
  
  //----
  // RELATIONS
  //----
  inventoryUnit shopping_mall_inventory_units @relation(fields: [inventory_unit_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  
  @@unique([inventory_unit_id])
  @@index([seller_id])
  @@index([alert_type])
  @@index([status])
  @@index([alerted_at])
}