/// Hierarchical product category structure that organizes all products in
/// the marketplace.
///
/// Defines the complete category taxonomy used to classify products.
/// Categories support nesting (parent-child relationships) to create deep
/// hierarchies.
///
/// Used by shopping_mall_products, shopping_mall_product_categories to
/// determine product categorization and navigation.
///
/// This table creates the authoritative category structure referenced
/// throughout the system, linked by category_id in product category
/// mappings.
///
/// @namespace Systematic
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent category in the hierarchy. Referencing the same
  /// shopping_mall_categories.id for nested categories. Null for top-level
  /// categories.
  parent_category_id String?
  
  /// Display name of the category (e.g., 'Electronics', 'Books > Fiction').
  name String
  
  /// URL-friendly identifier for this category (e.g., 'electronics',
  /// 'books-fiction').
  slug String
  
  /// Detailed description of the category and what products belong in it.
  description String?
  
  /// Whether this category is currently active and visible to customers.
  is_active Boolean
  
  /// Order in which this category should be displayed in UI lists. Lower
  /// numbers appear first.
  display_order Int
  
  /// Timestamp when this category was created.
  created_at DateTime
  
  /// Timestamp when this category was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  parentCategory shopping_mall_categories? @relation("recursive", fields: [parent_category_id], references: [id], onDelete: Cascade)
  
  recursive shopping_mall_categories[] @relation("recursive")
  shopping_mall_product_categories shopping_mall_product_categories[]
  
  @@unique([slug])
  @@unique([parent_category_id, name])
  @@index([parent_category_id])
  @@index([is_active])
  @@index([display_order])
  @@index([created_at])
}

