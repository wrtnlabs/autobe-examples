  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The shipment being confirmed. {@link shopping_mall_shipments.id}.
  shipment_id String
  
  /// Type of delivery confirmation. Must be either 'customer' or 'system'.
  confirmation_type String
  
  /// Timestamp when delivery was confirmed - either by customer action or
  /// system auto-trigger. This is the moment the status changed to delivered.
  confirmed_at DateTime
  
  /// When this record was created. Always equal to confirmed_at.
  created_at DateTime
  
  /// Timestamp of the last update to this record. This table should never be
  /// updated, so this field is maintained for consistency.
  updated_at DateTime
  
  /// Soft delete flag. This table should never be deleted, as it represents an
  /// immutable historical audit record. Set to null.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shipment shopping_mall_shipments @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shipment_id, confirmed_at], map: "shopping_mall_delivery_confirmations_shipment_id_confi_ce04b57e")
}