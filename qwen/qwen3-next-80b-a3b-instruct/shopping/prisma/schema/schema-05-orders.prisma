  /// Shipping method selected for this order. {@link
  /// shopping_mall_shipping_methods.id}.
  shopping_mall_shipping_method_id String
  
  /// Recipient's first name for delivery. Required for shipping.
  first_name String
  
  /// Recipient's last name for delivery. Required for shipping.
  last_name String
  
  /// Primary street address line for delivery.
  address_line1 String
  
  /// Secondary address line (apartment, suite, etc.). Optional.
  address_line2 String?
  
  /// City for delivery address.
  city String
  
  /// State, province, or region for delivery address.
  state String
  
  /// Postal or ZIP code for delivery address.
  postal_code String
  
  /// Country code for delivery address (ISO 3166-1 alpha-2 standard).
  country String
  
  /// Contact phone number for delivery carrier.
  phone String
  
  /// Carrier company name (e.g., FedEx, UPS, Korea Post).
  carrier String?
  
  /// Tracking number provided by carrier. Populated when order is marked as
