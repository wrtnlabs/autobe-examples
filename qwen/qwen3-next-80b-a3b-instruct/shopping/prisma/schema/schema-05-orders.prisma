  shippingMethod shopping_mall_shipping_methods? @relation(fields: [shopping_mall_shipping_method_id], references: [id], onDelete: Cascade)
  
  shopping_mall_order_items shopping_mall_order_items[]
  shopping_mall_order_payments shopping_mall_order_payments?
  shopping_mall_order_shipping shopping_mall_order_shipping?
  shopping_mall_order_returns shopping_mall_order_returns[]
  shopping_mall_order_status_history shopping_mall_order_status_history[]
  shopping_mall_coupon_redemptions shopping_mall_coupon_redemptions[]
  shopping_mall_loyalty_point_transactions shopping_mall_loyalty_point_transactions[]
  
  @@index([shopping_mall_payment_method_id])
  @@index([shopping_mall_shipping_method_id])
  
  @@unique([order_number])
