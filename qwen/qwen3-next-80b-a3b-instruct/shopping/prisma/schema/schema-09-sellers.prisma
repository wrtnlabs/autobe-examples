  shopping_mall_seller_bank_account_id String
  
  /// Payout status: requested, processing, completed, failed, canceled.
  status String
  
  /// Total payout amount in local currency before platform fees.
  amount Float
  
  /// Platform's service fee deducted from payout amount.
  platform_fee Float
  
  /// Net amount credited to seller's bank account (amount - platform_fee).
  net_amount Float
  
  /// Currency of the payout (ISO 4217 code).
  currency String
  
  /// Identifier for the batch of payouts processed together in the payment
  /// gateway.
  batch_id String?
  
  /// Timestamp when funds were successfully transferred to the bank account.
  paid_at DateTime?
  
  /// Timestamp when the payout request was initiated.
  created_at DateTime
  
  /// Timestamp when the payout status was last updated.
  updated_at DateTime
  
  /// Timestamp when the payout was soft-deleted by admin action.
