/// Core seller identity and business profile information.
///
/// Represents the main entity that stores the seller's personalized
/// information including business name, description, logo, and contact
/// details. Each seller has exactly one profile that serves as their public
/// presence on the marketplace. Profiles are continuously updated by sellers
/// and contain both public-facing and administrative data.
///
/// Profiles are linked to applications during onboarding and to bank
/// accounts for financial operations. Profile information controls
/// storefront appearance and determines which seller-related features are
/// available. Profile updates are audited for security and compliance.
///
/// @namespace Sellers
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_seller_profiles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Original customer account from which seller status was granted {@link
  /// shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Public-facing name of the seller's business.
  business_name String
  
  /// Detailed description of the seller's business, products, and values.
  /// Limited to 500 characters.
  business_description String
  
  /// Secure URL to the seller's logo image file in object storage.
  logo_url String?
  
  /// Business contact email for customer inquiries.
  contact_email String
  
  /// Business contact phone number.
  contact_phone String?
  
  /// Legal business address matching government verification documents.
  business_address String
  
  /// Seller account status: active, inactive, suspended, terminated.
  status String
  
  /// Composite performance rating based on customer feedback, shipping speed,
  /// and dispute rates.
  performance_score Float
  
  /// Timestamp when the seller profile was activated.
  created_at DateTime
  
  /// Timestamp when the seller profile was last updated.
  updated_at DateTime
  
  /// Timestamp when the seller profile was soft-deleted by admin action.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  shopping_mall_product_review_replies shopping_mall_product_review_replies[]
  shopping_mall_seller_bank_accounts shopping_mall_seller_bank_accounts[]
  shopping_mall_seller_settings shopping_mall_seller_settings?
  shopping_mall_seller_payouts shopping_mall_seller_payouts[]
  shopping_mall_seller_sales_reports shopping_mall_seller_sales_reports?
  
  @@unique([shopping_mall_customer_id])
  @@unique([business_name])
  @@index([status])
  @@index([performance_score])
  @@index([created_at])
