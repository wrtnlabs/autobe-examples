  created_at DateTime
  
  /// Timestamp when the image metadata was last modified (e.g., image order
  /// changed).
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  sale shopping_mall_sales @relation(fields: [shopping_mall_sale_id], references: [id], onDelete: Cascade)
  
  @@index([shopping_mall_sale_id, image_order])
  @@index([shopping_mall_sale_id, created_at])
}

