  // spellchecker: ignore-next-line
  @@unique([shopping_mall_seller_id, shopping_mall_product_id], map: "shopping_mall_sales_shopping_mall_seller_id_shopping_m_c9dcf7aa")
  @@unique([shopping_mall_seller_id, name])
  @@index([shopping_mall_seller_id])
  @@index([created_at])
  @@index([updated_at])
  @@index([is_deleted])
