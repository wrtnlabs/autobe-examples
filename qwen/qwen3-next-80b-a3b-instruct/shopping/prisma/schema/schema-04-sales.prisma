  category shopping_mall_sections @relation(fields: [shopping_mall_category_id], references: [id], onDelete: Cascade)
  
  promotions shopping_mall_sale_promotions[]
  images shopping_mall_sale_images[]
  specifications shopping_mall_sale_specifications[]
  favoritedBies shopping_mall_sale_favorites[]
