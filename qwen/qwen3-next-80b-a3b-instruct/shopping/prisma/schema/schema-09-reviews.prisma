  /// Reference to the seller who authored this reply. {@link
  /// shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Optional short title for the seller's response. Typically used for
  /// summary or attention-grabbing phrases.
  title String?
  
  /// Core message content of the seller's reply. Limited to 2000 characters to
  /// ensure concise, professional responses.
  body String
  
  /// Timestamp when the seller's reply was created.
  created_at DateTime
  
  /// Timestamp when the seller's reply was last modified. Used for auditing
  /// and displaying "last updated" information.
  updated_at DateTime
  
  /// Timestamp when this reply was soft-deleted, typically by moderation. NULL
  /// means reply is active and visible.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  review shopping_mall_reviews @relation(fields: [shopping_mall_review_id], references: [id], onDelete: Cascade)
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_review_id, created_at], map: "shopping_mall_review_replies_shopping_mall_review_id_c_af9c9a28")
  // spellchecker: ignore-next-line
  @@index([shopping_mall_seller_id, created_at], map: "shopping_mall_review_replies_shopping_mall_seller_id_c_8ea57c89")
  // spellchecker: ignore-next-line
  @@index([shopping_mall_review_id, deleted_at], map: "shopping_mall_review_replies_shopping_mall_review_id_d_5292a2df")
}