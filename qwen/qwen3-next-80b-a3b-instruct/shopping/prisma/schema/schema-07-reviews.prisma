/// is a supporting entity that exists only as children of review reports.
/// {@link shopping_mall_review_reports.id} for parent report.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_review_report_reasons {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The report this reason belongs to. {@link
  /// shopping_mall_review_reports.id}.
  shopping_mall_review_report_id String
  
  /// Predefined reason for report: 'spam', 'inappropriate_content',
  /// 'false_information', 'other'.
  reason String
  
  /// Detailed description of the reported issue (if reason is 'other').
  /// Optional.
  description String?
  
  //----
  // RELATIONS
  //----
  shoppingMallReviewReport shopping_mall_review_reports @relation(fields: [shopping_mall_review_report_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@index([shopping_mall_review_report_id], map: "shopping_mall_review_report_reasons_shopping_mall_revi_f926a290")
  @@index([reason])
}

/// Helpful/not-helpful votes from customers on reviews. Each customer can
/// vote once per review. This is a supporting entity used for ranking review
/// quality and does not represent an independently managed entity. {@link
/// shopping_mall_reviews.id} for reviewed content. {@link
/// shopping_mall_customers.id} for voter.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_review_votes {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The review that received this vote. {@link shopping_mall_reviews.id}.
  shopping_mall_review_id String
  
  /// The customer who cast this vote. {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// True if vote is 'Helpful', false if 'Not Helpful'.
  is_helpful Boolean
  
  /// Timestamp when the vote was cast.
  created_at DateTime
  
  /// Timestamp when the vote was updated (if changed).
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  shoppingMallReview shopping_mall_reviews @relation(fields: [shopping_mall_review_id], references: [id], onDelete: Cascade)
  shoppingMallCustomer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_review_id, shopping_mall_customer_id], map: "shopping_mall_review_votes_shopping_mall_review_id_sho_8d6e07a3")
  @@index([shopping_mall_review_id])
  @@index([shopping_mall_customer_id])
  @@index([is_helpful])
  @@index([created_at])
}