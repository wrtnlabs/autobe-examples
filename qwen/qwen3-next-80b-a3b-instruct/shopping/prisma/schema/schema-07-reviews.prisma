/// Core review entity representing customer feedback on products. A review
/// is only allowed after order delivery. Verified purchase status is
/// determined by existence of a related order. Includes review content and
/// basic metadata. {@link shopping_mall_orders.id} for verified purchase
/// verification. {@link shopping_mall_products.id} for product reference.
/// {@link shopping_mall_customers.id} for reviewer.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_reviews {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Order that was completed and enabled this review. {@link
  /// shopping_mall_orders.id}. Required for verified purchase assessment.
  shopping_mall_order_id String?
  
  /// Product that the review is about. {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Customer who wrote the review. {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Short title of the review (max 100 characters).
  title String?
  
  /// Main review text content (max 2000 characters). Must be at least 10
  /// characters.
  body String
  
  /// Timestamp when the review was created.
  created_at DateTime
  
  /// Timestamp when the review was last updated.
  updated_at DateTime
  
  /// Timestamp when the review was soft-deleted. Null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shoppingMallOrder shopping_mall_orders? @relation(fields: [shopping_mall_order_id], references: [id], onDelete: Cascade)
  shoppingMallProduct shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  shoppingMallCustomer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  shopping_mall_review_ratings shopping_mall_review_ratings?
  shopping_mall_review_responses shopping_mall_review_responses?
  shopping_mall_review_reports shopping_mall_review_reports[]
  shopping_mall_review_votes shopping_mall_review_votes[]
  
  @@index([shopping_mall_order_id])
  
  @@index([shopping_mall_product_id, created_at])
  @@index([shopping_mall_customer_id])
}

/// Numeric rating scores (1-5 stars) associated with reviews. Each review
/// has exactly one rating. This entity is managed through its parent review
/// and does not require independent API endpoints. {@link
/// shopping_mall_reviews.id} for review reference.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_review_ratings {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The review this rating belongs to. {@link shopping_mall_reviews.id}.
  shopping_mall_review_id String
  
  /// Rating score from 1 to 5. Must be an integer between 1 and 5 inclusive.
  score Int
  
  /// Timestamp when the rating was recorded.
  created_at DateTime
  
  /// Timestamp when the rating was last updated.
  updated_at DateTime
  
  //----
  // RELATIONS
  //----
  shoppingMallReview shopping_mall_reviews @relation(fields: [shopping_mall_review_id], references: [id], onDelete: Cascade)
  
  @@unique([shopping_mall_review_id])
  @@index([score])
  @@index([created_at])
}

/// Seller responses to customer reviews. Each review can have one response
/// per seller. Seller responses are editable for only 7 days after posting.
/// This is a supporting entity managed exclusively through its parent
/// review. {@link shopping_mall_reviews.id} for parent review. {@link
/// shopping_mall_sellers.id} for seller author.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_review_responses {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The review that this response answers. {@link shopping_mall_reviews.id}.
  shopping_mall_review_id String
  
  /// The seller who wrote this response. {@link shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Response content from seller (max 1000 characters).
  body String
  
  /// Timestamp when the response was posted.
  created_at DateTime
  
  /// Timestamp when the response was last updated.
  updated_at DateTime
  
  /// Timestamp when the response was soft-deleted. Null if active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  shoppingMallReview shopping_mall_reviews @relation(fields: [shopping_mall_review_id], references: [id], onDelete: Cascade)
  shoppingMallSeller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  
  @@unique([shopping_mall_review_id])
  @@index([shopping_mall_seller_id])
  @@index([created_at])
}

/// Reports filed by customers to flag inappropriate or problematic reviews.
/// Each report is associated with one specific review and one reporter. Used
/// for moderation workflow. This is a system-maintained entity supporting
/// moderation and does not have independent user management. {@link
/// shopping_mall_reviews.id} for reported review. {@link
/// shopping_mall_customers.id} for reporter.
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_review_reports {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The review that has been reported. {@link shopping_mall_reviews.id}.
  shopping_mall_review_id String
  
  /// The customer who filed this report. {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Timestamp when the report was filed.
  created_at DateTime
  
  /// Report status: 'pending', 'flagged', 'approved', 'rejected'.
  status String
  
  /// Internal notes from admin for report handling. Optional.
  admin_notes String?
  
  //----
  // RELATIONS
  //----
  shoppingMallReview shopping_mall_reviews @relation(fields: [shopping_mall_review_id], references: [id], onDelete: Cascade)
  shoppingMallCustomer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  shopping_mall_review_report_reasons shopping_mall_review_report_reasons[]
  
  @@index([shopping_mall_review_id, status])
  @@index([shopping_mall_customer_id])
  @@index([created_at])
}

/// Reason codes for review reports. Each report can have multiple reasons.
