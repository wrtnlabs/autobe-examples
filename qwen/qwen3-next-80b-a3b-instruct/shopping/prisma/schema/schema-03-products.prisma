/// Main product catalog entries representing distinct product offerings.
///
/// Each product represents a unique item available for sale with its
/// defining attributes like title, description, price, and category.
/// Products are created and managed by sellers and serve as the parent
/// entity for product variants (SKUs). Products can be published or archived
/// based on seller status and compliance.
///
/// When a product is published, it becomes visible to customers for browsing
/// and purchasing. Archived products remain in the system for historical
/// tracking and audit purposes but are not visible to customers. Products
/// are linked to categories and tags for improved discoverability and
/// search.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Owner seller. {@link shopping_mall_sellers.id}.
  shopping_mall_seller_id String
  
  /// Tax classification category. {@link shopping_mall_tax_categories.id}.
  shopping_mall_tax_category_id String
  
  /// Product title displayed to customers. Must be 3-100 characters.
  title String
  
  /// Detailed product description visible to customers. Minimum 20 characters,
  /// maximum 2000 characters.
  description String
  
  /// Base price of the product in USD. Minimum $0.01, maximum $5000.00.
  price Float
  
  /// Product availability status. Valid values: 'draft', 'published',
  /// 'archived'. Determines visibility to customers.
  status String
  
  /// Timestamp when the product was created. Always recorded.
  created_at DateTime
  
  /// Timestamp of the last product update. Always updated on any modification.
  updated_at DateTime
  
  /// Timestamp when the product was marked for deletion. Indicates soft delete
  /// status. Null means product is active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  seller shopping_mall_sellers @relation(fields: [shopping_mall_seller_id], references: [id], onDelete: Cascade)
  taxCategory shopping_mall_tax_categories @relation(fields: [shopping_mall_tax_category_id], references: [id], onDelete: Cascade)
  
  shopping_mall_product_variants shopping_mall_product_variants[]
  shopping_mall_product_images shopping_mall_product_images[]
  shopping_mall_product_tags_products shopping_mall_product_tags_products[]
  shopping_mall_product_categories shopping_mall_product_categories[]
  shopping_mall_reviews shopping_mall_reviews[]
  shopping_mall_data_change_logs shopping_mall_data_change_logs[]
  
  @@index([shopping_mall_tax_category_id])
  
  @@unique([shopping_mall_seller_id, title])
  @@index([status])
  @@index([shopping_mall_seller_id, created_at])
  @@index([price])
}

/// Product variants (SKUs) that represent distinct inventory items with
/// unique pricing and stock levels.
///
/// Each variant represents a specific configuration of a main product with
/// different attributes such as color, size, or style. Variants are
/// independent entities with their own pricing and inventory management,
/// allowing for precise stock control and personalized pricing.
///
/// Variants are always linked to a single parent product and cannot exist
/// without one. They enable the platform to handle complex products with
/// multiple options while maintaining accurate inventory and pricing data
/// for each configuration.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_variants {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product this variant belongs to. {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Unique Stock Keeping Unit identifier for this variant. Must be globally
  /// unique across all products and variants.
  sku String
  
  /// Variant-specific title that describes the configuration (e.g., 'Red, Size
  /// M').
  title String
  
  /// Specific price for this variant. Can differ from parent product base
  /// price.
  price Float
  
  /// Current available stock quantity for this variant. Must be 0 or greater.
  inventory_count Int
  
  /// JSON-formatted string containing variant attributes (e.g., {"color":
  /// "red", "size": "M"}). Used for filtering and display.
  attributes String
  
  /// Timestamp when the variant was created. Always recorded.
  created_at DateTime
  
  /// Timestamp of the last variant update. Always updated on any modification.
  updated_at DateTime
  
  /// Timestamp when the variant was marked for deletion. Indicates soft delete
  /// status. Null means variant is active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  
  shopping_mall_product_images shopping_mall_product_images[]
  shopping_mall_cart_items shopping_mall_cart_items[]
  shopping_mall_wishlist_items shopping_mall_wishlist_items[]
  shopping_mall_order_items shopping_mall_order_items[]
  shopping_mall_inventory_units shopping_mall_inventory_units?
  
  @@unique([sku])
  @@unique([shopping_mall_product_id, sku])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id, inventory_count], map: "shopping_mall_product_variants_shopping_mall_product_i_6ad2277c")
}

/// Product image files associated with products and variants.
///
/// Stores image metadata and file references for all visual content
/// associated with products. Each product may have multiple images, and each
/// image is linked to either a product or variant. Images are managed
/// through their parent entity and only exist in relation to a product.
///
/// Image files are referenced by URL or path, but actual file storage is
/// handled externally. This model ensures each image is properly attributed
/// and can be retrieved efficiently for display in product listings and
/// detail pages.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_images {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product this image belongs to. {@link shopping_mall_products.id}.
  shopping_mall_product_id String?
  
  /// Parent variant this image belongs to. {@link
  /// shopping_mall_product_variants.id}.
  shopping_mall_product_variant_id String?
  
  /// Public URL path to the image file. Must be a valid URI format.
  image_url String
  
  /// Alternative text description for accessibility and SEO purposes.
  alt_text String?
  
  /// Display order priority for viewing. Lower numbers display first. Must be
  /// 0 or greater.
  sort_order Int
  
  /// Flag indicating if this is the primary image for the product or variant.
  /// Only one per product/variant can be primary.
  is_primary Boolean
  
  /// Timestamp when the image was added to the product or variant.
  created_at DateTime
  
  /// Timestamp of the last update to the image record. Always updated on any
  /// modification.
  updated_at DateTime
  
  /// Timestamp when the image record was marked for deletion. Indicates soft
  /// delete status. Null means image is active.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products? @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  variant shopping_mall_product_variants? @relation(fields: [shopping_mall_product_variant_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_product_id, is_primary], map: "shopping_mall_product_images_shopping_mall_product_id__c9f2dc21")
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_product_variant_id, is_primary], map: "shopping_mall_product_images_shopping_mall_product_var_1364c257")
  @@index([shopping_mall_product_id])
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_variant_id], map: "shopping_mall_product_images_shopping_mall_product_var_b99b425a")
  @@index([sort_order])
}

/// Junction table for many-to-many relationship between products and tags.
///
/// Enables flexible tagging system where products can have multiple tags and
/// tags can be applied to multiple products. This table creates the link
/// between product catalog entries and their textual tags for improved
/// search, filtering, and categorization.
///
/// Tags are defined in the shopping_mall_product_tags table and represent
/// keywords or categories that help customers discover products. This
/// junction table allows for dynamic tagging without requiring schema
/// changes and supports complex queries on product attributes.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_tags_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product associated with this tag. {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Tag applied to this product. {@link shopping_mall_product_tags.id}.
  shopping_mall_product_tag_id String
  
  /// Timestamp when the tag was applied to the product.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  tag shopping_mall_product_tags @relation(fields: [shopping_mall_product_tag_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_product_id, shopping_mall_product_tag_id], map: "shopping_mall_product_tags_products_shopping_mall_prod_41e45d1e")
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_id], map: "shopping_mall_product_tags_products_shopping_mall_prod_9cf289e1")
  // spellchecker: ignore-next-line
  @@index([shopping_mall_product_tag_id], map: "shopping_mall_product_tags_products_shopping_mall_prod_f6655af3")
}

/// Junction table linking products to categories through a many-to-many
/// relationship.
///
/// Enables products to belong to multiple categories (e.g., a product can be
/// both 'Electronics' and 'Gifts'). Category hierarchy is managed in
/// shopping_mall_categories table, and this junction table defines the
/// association between products and their categories.
///
/// This approach allows flexible product categorization without duplicating
/// data and enables comprehensive category-based navigation and filtering in
/// the product catalog.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_product_categories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product associated with this category. {@link shopping_mall_products.id}.
  shopping_mall_product_id String
  
  /// Category this product belongs to. {@link shopping_mall_categories.id}.
  shopping_mall_category_id String
  
  /// Timestamp when the product was assigned to this category.
  created_at DateTime
  
  //----
  // RELATIONS
  //----
  product shopping_mall_products @relation(fields: [shopping_mall_product_id], references: [id], onDelete: Cascade)
  category shopping_mall_categories @relation(fields: [shopping_mall_category_id], references: [id], onDelete: Cascade)
  
  // spellchecker: ignore-next-line
  @@unique([shopping_mall_product_id, shopping_mall_category_id], map: "shopping_mall_product_categories_shopping_mall_product_b5030199")
  @@index([shopping_mall_product_id])
  @@index([shopping_mall_category_id])
}