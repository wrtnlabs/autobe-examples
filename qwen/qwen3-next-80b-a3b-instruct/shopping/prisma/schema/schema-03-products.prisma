  recursive shopping_mall_categories[] @relation("recursive")
  shopping_mall_products shopping_mall_products[]
  shopping_mall_product_secondary_categories shopping_mall_product_secondary_categories[]
  
  @@unique([parent_id, name])
  @@index([parent_id, ordering])
  @@index([name])
}

