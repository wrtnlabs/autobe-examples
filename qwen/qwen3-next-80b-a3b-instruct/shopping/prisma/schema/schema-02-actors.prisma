  id String @id
  
  /// Reference to the customer account that owns this session. {@link
  /// shopping_mall_customers.id}
  customer_id String
  
  /// Client IP address from which the session was initiated.
  ip String
  
  /// URL of the page where the session was initiated.
  href String
  
  /// Referrer URL that led the customer to the platform.
  referrer String
  
  /// Timestamp when this session was created and authenticated.
