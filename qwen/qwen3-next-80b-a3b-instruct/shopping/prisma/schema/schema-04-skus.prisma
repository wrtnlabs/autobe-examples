  shopping_mall_sku_inventory shopping_mall_sku_inventory?
  shopping_mall_cart_items shopping_mall_cart_items[]
  shopping_mall_wishlist_items shopping_mall_wishlist_items[]
  shopping_mall_order_items shopping_mall_order_items[]
  shopping_mall_inventory shopping_mall_inventory?
  shopping_mall_inventory_alerts shopping_mall_inventory_alerts?
  shopping_mall_inventory_audits shopping_mall_inventory_audits[]
  shopping_mall_inventory_deltas shopping_mall_inventory_deltas[]
  
  @@index([shopping_mall_product_id])
  @@index([created_at])
}

