  /// Type of alert triggered ('low_stock_5_percent' or 'low_stock_1_percent').
  alert_type String
  
  /// Name of the product associated with the affected variant.
  product_name String
  
  /// JSON string representing the variant attributes (e.g.,
  /// {"color":"red","size":"large"}).
  variant_attributes String
  
  /// Timestamp when this inventory threshold was breached and the alert was
