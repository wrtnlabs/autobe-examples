  notified_at DateTime?
  
  /// Timestamp when this alert record was created.
  created_at DateTime
  
  /// Timestamp when this alert record was last updated.
  updated_at DateTime
  
  /// Timestamp when this alert record was logically deleted (soft delete).
  /// Null indicates active record.
  deleted_at DateTime?
  
  //----
  // RELATIONS
  //----
  variant shopping_mall_product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  seller shopping_mall_seller @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  
  @@unique([variant_id])
  @@index([seller_id])
  @@index([triggered_at])
  @@index([alert_type])
  @@index([resolved_at])
}