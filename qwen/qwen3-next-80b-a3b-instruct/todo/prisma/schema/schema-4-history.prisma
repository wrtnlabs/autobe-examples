/// Stores historical record of every edit made to a todo item. Each entry
/// captures the before and after values of changed fields (title,
/// description, startDate, dueDate) along with the precise timestamp of the
/// edit. All history entries are owned exclusively by the todo they
/// reference and are never visible to users other than the todo's owner.
/// History is accessed only through the parent todo and is automatically
/// purged when the associated todo is permanently deleted.
///
/// @namespace TodoHistory
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model todo_app_todo_histories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The todo that was edited. {@link todo_app_todos.id}.
  todo_app_todo_id String
  
  /// The exact timestamp when this edit occurred. Always recorded in UTC. Used
  /// for sorting history from most recent to oldest.
  edited_at DateTime
  
  /// The title value before the edit. Null if title was not changed.
  before_title String?
  
  /// The title value after the edit. Null if title was not changed.
  after_title String?
  
  /// The description value before the edit. Null if description was not
  /// changed.
  before_description String?
  
  /// The description value after the edit. Null if description was not changed.
  after_description String?
  
  /// The start date value before the edit. Null if start date was not changed.
  before_startdate DateTime?
  
  /// The start date value after the edit. Null if start date was not changed.
  after_startdate DateTime?
  
  /// The due date value before the edit. Null if due date was not changed.
  before_duedate DateTime?
  
  /// The due date value after the edit. Null if due date was not changed.
  after_duedate DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  todo todo_app_todos @relation(fields: [todo_app_todo_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([todo_app_todo_id, edited_at])
}