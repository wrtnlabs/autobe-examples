  /// If set, todo is in trash and hidden from main list.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  user todo_app_users @relation(fields: [todo_app_user_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  histories todo_app_todo_histories[]
  
  //----
  // INDEXES
  //----
  @@unique([todo_app_user_id, title])
  @@index([todo_app_user_id, is_completed])
  @@index([todo_app_user_id, created_at])
  @@index([todo_app_user_id, start_date, created_at])
  @@index([todo_app_user_id, due_date, created_at])
