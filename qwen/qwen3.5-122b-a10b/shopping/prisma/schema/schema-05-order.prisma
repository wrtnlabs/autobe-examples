  //   - format: (propertyKey targetModel)
  //----
  orderItems ecommerce_order_items[]
  shipments ecommerce_shipments[]
  
  //----
  // INDEXES
  //----
  @@unique([order_number])
  @@index([ecommerce_customer_id, created_at])
  @@index([status])
}

