/// Customer reviews for products with ratings (1-5 stars) and optional text
/// content. Each review is tied to a specific order item to enforce
/// one-review-per-order policy. Reviews can be soft-deleted but remain
/// visible as "deleted user" content. Average product ratings are calculated
/// from non-deleted reviews.
///
/// Key relationships:
/// - Belongs to {@link ecommerce_mall_customers} - the customer who wrote
/// the review
/// - Belongs to {@link ecommerce_mall_products} - the product being reviewed
/// - Belongs to {@link ecommerce_mall_order_items} - the purchased item that
/// enabled review eligibility
///
/// Behavioral notes:
/// - One review per order item enforced via unique constraint
/// - Review only allowed after order item status becomes "delivered"
/// - Soft-delete preserves review content for historical records
/// - Snapshots for review edits are stored in ecommerce_mall_review_snapshots
///
/// @namespace Reviews
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_reviews {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Customer who wrote this review. {@link ecommerce_mall_customers.id}.
  customer_id String
  
  /// Product being reviewed. {@link ecommerce_mall_products.id}.
  product_id String
  
  /// Order item that enabled review eligibility. Ensures one review per order
  /// item (one review per product per order). {@link
  /// ecommerce_mall_order_items.id}.
  order_item_id String
  
  /// Star rating from 1 to 5. Required field for all reviews.
  rating Int
  
  /// Optional text content of the review. Can be empty or contain detailed
  /// feedback.
  content String?
  
  /// Soft-delete flag. When true, review is hidden from listings but preserved
  /// for historical records. Deleted reviews are shown as "deleted user"
  /// content.
  is_deleted Boolean
  
  /// Timestamp when the review was initially created.
  created_at DateTime
  
  /// Timestamp when the review was last modified. Updated on each edit.
  updated_at DateTime
  
  /// Timestamp when the review was soft-deleted. Null if review is active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer ecommerce_mall_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  product ecommerce_mall_products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  orderItem ecommerce_mall_order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots ecommerce_mall_review_snapshots[]
  
  //----
  // INDEXES
  //----
  @@unique([order_item_id])
  @@index([customer_id, created_at])
  @@index([product_id, created_at])
  @@index([is_deleted])
}