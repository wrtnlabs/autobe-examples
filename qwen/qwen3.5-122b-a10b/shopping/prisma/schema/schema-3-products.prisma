/// Core product catalog entities representing items sold by sellers. Each
/// product has a name, description, category classification, and base price.
/// Products belong to a seller who owns and manages them. Products can be
/// edited, with each modification creating a snapshot in
/// ecommerce_mall_product_snapshots for audit trail. Products can be
/// soft-deleted or suspended by administrators. Products have multiple
/// variants (ecommerce_mall_product_variants) representing different SKUs
/// with options like color and size, and multiple images
/// (ecommerce_mall_product_images) with the first image serving as
/// thumbnail.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_products {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Seller who owns and manages this product. {@link
  /// ecommerce_mall_sellers.id}.
  seller_id String
  
  /// Category classification for product organization and browsing. {@link
  /// ecommerce_mall_categories.id}.
  category_id String
  
  /// Product name. Required field for product identification and search.
  name String
  
  /// Product description providing detailed information about the product.
  description String
  
  /// Base price of the product in currency units. Variants can override this
  /// price.
  base_price Float
  
  /// Product lifecycle status: active (visible and purchasable), deleted
  /// (soft-deleted, hidden from listings), suspended (hidden by administrator
  /// for policy violations).
  status String
  
  /// Timestamp when the product was created.
  created_at DateTime
  
  /// Timestamp when the product was last modified. Triggers snapshot creation.
  updated_at DateTime
  
  /// Timestamp when the product was soft-deleted. Null if product is active or
  /// suspended.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  seller ecommerce_mall_sellers @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  category ecommerce_mall_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  variants ecommerce_mall_product_variants[]
  images ecommerce_mall_product_images[]
  productSnapshots ecommerce_mall_product_snapshots[]
  reviews ecommerce_mall_reviews[]
  wishlistEntries ecommerce_mall_wishlists[]
  
  //----
  // INDEXES
  //----
  @@index([seller_id, created_at])
  @@index([category_id, status])
  @@index([status, created_at])
}

/// SKU variants for products with unique SKU codes, optional price override,
/// and stock quantity tracking. Each variant belongs to exactly one {@link
/// ecommerce_mall_products} and represents a specific product configuration
/// that customers can purchase. Variant option values (e.g., color, size)
/// are stored in {@link ecommerce_mall_product_variant_options} for 1NF
/// compliance. Variant edits create snapshots in {@link
/// ecommerce_mall_product_snapshots} for audit trail. Stock quantity is
/// tracked through {@link ecommerce_mall_inventory_records} history rather
/// than stored directly.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_product_variants {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product's {@link ecommerce_mall_products.id}. Each variant belongs
  /// to exactly one product.
  ecommerce_mall_product_id String
  
  /// Unique SKU code identifying this variant. Must be unique across all
  /// variants in the system.
  sku_code String
  
  /// Optional price override for this variant. If null, uses the product's
  /// base price from {@link ecommerce_mall_products.basePrice}.
  price Float?
  
  /// Current stock quantity for this variant. Calculated from sum of all
  /// {@link ecommerce_mall_inventory_records} for this variant. Zero means out
  /// of stock.
  stock_quantity Int
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp. Null means active, non-null means deleted.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  product ecommerce_mall_products @relation(fields: [ecommerce_mall_product_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  inventoryRecords ecommerce_mall_inventory_records[]
  variantOptions ecommerce_mall_product_variant_options[]
  orderItems ecommerce_mall_order_items[]
  cartItems ecommerce_mall_cart_items[]
  
  //----
  // INDEXES
  //----
  @@unique([sku_code])
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_product_id, created_at], map: "ecommerce_mall_product_variants_ecommerce_mall_product_58e20e33")
}

/// Product images supporting multiple uploads per product with reorder
/// capability. The first image (sort_order=0) serves as the main thumbnail
/// displayed in search results and category listings. Image changes and
/// reordering are captured in product snapshots for audit trail purposes.
/// Images are always managed through their parent {@link
/// ecommerce_mall_products} entity and cannot be independently created or
/// deleted outside of product operations.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_product_images {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent product's {@link ecommerce_mall_products.id}. Images always belong
  /// to exactly one product and are deleted when the product is deleted.
  ecommerce_mall_product_id String
  
  /// URL reference to the stored image file. Points to CDN or file storage
  /// location where the image is hosted.
  url String
  
  /// Display order position for reordering images. Lower values appear first.
  /// The image with sort_order=0 serves as the main thumbnail.
  sort_order Int
  
  /// Whether this image is the primary/thumbnail image. True for the first
  /// image (sort_order=0), false for all others. Used for quick thumbnail
  /// identification.
  is_primary Boolean
  
  /// Timestamp when this image record was created.
  created_at DateTime
  
  /// Timestamp when this image record was last updated.
  updated_at DateTime
  
  /// Timestamp when this image was soft-deleted. Null if the image is still
  /// active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  product ecommerce_mall_products @relation(fields: [ecommerce_mall_product_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([ecommerce_mall_product_id, sort_order], map: "ecommerce_mall_product_images_ecommerce_mall_product_i_1067487d")
  @@index([ecommerce_mall_product_id])
}

/// Immutable audit trail capturing complete product state at each edit,
/// including all variant information. Records previous values, current
/// values, creation timestamp, and the seller who made the change. Snapshots
/// are preserved even after product deletion and can be viewed by sellers
/// and administrators for dispute resolution. {@link
/// ecommerce_mall_products} {@link ecommerce_mall_sellers}
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_product_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Product being snapshotted. {@link ecommerce_mall_products.id}
  ecommerce_mall_products_id String
  
  /// Seller who made the change. Nullable for system-generated or
  /// administrator actions. {@link ecommerce_mall_sellers.id}
  ecommerce_mall_sellers_id String?
  
  /// JSON object containing all product fields and variant data before the
  /// change.
  previous_values String
  
  /// JSON object containing all product fields and variant data after the
  /// change.
  current_values String
  
  /// Timestamp when the snapshot was created. Server-enforced.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  product ecommerce_mall_products @relation(fields: [ecommerce_mall_products_id], references: [id], onDelete: Cascade)
  seller ecommerce_mall_sellers? @relation(fields: [ecommerce_mall_sellers_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([ecommerce_mall_products_id])
  @@index([ecommerce_mall_sellers_id])
  @@index([created_at])
}

/// Normalized key-value storage for product variant option values (e.g.,
/// color, size, material). Each row stores one option attribute for a
/// variant, replacing JSON storage to ensure First Normal Form (1NF)
/// compliance. This table enables atomic querying and filtering of variant
/// options while maintaining referential integrity with {@link
/// ecommerce_mall_product_variants.id}.
///
/// @namespace Products
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model ecommerce_mall_product_variant_options {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged product variant's {@link ecommerce_mall_product_variants.id}.
  ecommerce_mall_product_variant_id String
  
  /// Option attribute name (e.g., "color", "size", "material").
  key String
  
  /// Option attribute value (e.g., "Red", "Large", "Cotton").
  value String
  
  /// Record creation timestamp.
  created_at DateTime
  
  /// Record last update timestamp.
  updated_at DateTime
  
  /// Soft deletion timestamp for audit trail preservation.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  variant ecommerce_mall_product_variants @relation(fields: [ecommerce_mall_product_variant_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@unique([ecommerce_mall_product_variant_id, key], map: "ecommerce_mall_product_variant_options_ecommerce_mall__0a67fc9a")
  // spellchecker: ignore-next-line
  @@index([ecommerce_mall_product_variant_id], map: "ecommerce_mall_product_variant_options_ecommerce_mall__5609b79e")
}