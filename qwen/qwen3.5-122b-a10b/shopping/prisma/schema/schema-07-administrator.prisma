  /// timeline reconstruction.
  changed_at DateTime
  
  /// Optional explanation for the grade change.
  ///
  /// May include context such as:
  /// - Promotion justification
  /// - Demotion reason
  /// - Administrative notes
  ///
  /// This field is nullable as some automated or system-initiated changes may
  /// not require a human-readable explanation.
  reason String?
  
  /// Timestamp when this audit record was created.
  ///
  /// Automatically set when the grade transition is recorded. Used for
  /// database-level audit trail consistency.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  admin ecommerce_admins @relation("ecommerce_admin_grade_transitions_of_ecommerce_admin_id", fields: [ecommerce_admin_id], references: [id], onDelete: Cascade)
  performedByAdmin ecommerce_admins @relation("ecommerce_admin_grade_transitions_of_performed_by_admin_id", fields: [performed_by_admin_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([ecommerce_admin_id, changed_at], map: "ecommerce_admin_grade_transitions_ecommerce_admin_id_c_f76adb88")
  // spellchecker: ignore-next-line
  @@index([performed_by_admin_id, changed_at], map: "ecommerce_admin_grade_transitions_performed_by_admin_i_2e7b2d50")
}