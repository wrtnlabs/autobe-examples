  /// Optional description of the work being tracked.
  description String?
  
  /// Record creation timestamp for audit trail.
  created_at DateTime
  
  /// Record last update timestamp for audit trail.
  updated_at DateTime
  
  /// Soft deletion timestamp for data preservation and recovery.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  employee hrm_platform_employees @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  project hrm_platform_projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
  task hrm_platform_tasks? @relation(fields: [task_id], references: [id], onDelete: Cascade)
  
