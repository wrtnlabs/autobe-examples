/// User-generated comments attached to articles for community discussion.
///
/// Comments enable readers to engage with article content through
/// single-level feedback. Each comment is authored by a registered member
/// and attached to a specific article. Members retain full control over
/// their comments, including editing and deletion rights.
///
/// Key relationships:
/// - Authored by a member: {@link discussion_board_members}
/// - Attached to an article: {@link discussion_board_articles}
///
/// Comments are displayed in chronological order (oldest first) and support
/// full-text search capabilities.
///
/// @namespace Comments
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_comments {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// The article this comment is attached to. {@link
  /// discussion_board_articles.id}
  discussion_board_article_id String
  
  /// The member who authored this comment. {@link discussion_board_members.id}
  discussion_board_member_id String
  
  /// The actual text content of the comment.
  content String
  
  /// Timestamp when the comment was first created.
  created_at DateTime
  
  /// Timestamp when the comment was last modified.
  updated_at DateTime
  
  /// Soft delete timestamp. Used for logical deletion while preserving audit
  /// trail.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  author discussion_board_members @relation(fields: [discussion_board_member_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots discussion_board_comment_snapshots[]
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, created_at], map: "discussion_board_comments_discussion_board_article_id__aa7deb51")
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_id, created_at], map: "discussion_board_comments_discussion_board_member_id_c_c3eff834")
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, updated_at], map: "discussion_board_comments_discussion_board_article_id__f89c0aa2")
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_id, updated_at], map: "discussion_board_comments_discussion_board_member_id_u_d2a3fb62")
  @@index([deleted_at])
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, discussion_board_member_id], map: "discussion_board_comments_discussion_board_article_id__9fdec8bd")
}

/// Point-in-time snapshots of comment modifications for audit trail and
/// revision history. Each time a comment is created or modified, a snapshot
/// is captured preserving the exact state at that moment including all field
/// values and foreign key references. This enables version control, content
/// moderation audits, and historical content recovery.
///
/// The snapshot denormalizes all parent comment fields to preserve the exact
/// state at snapshot time, even if the parent comment's relationships change
/// later. This is essential for accurate audit trails and historical
/// queries.
///
/// Key relationships:
/// - Belongs to {@link discussion_board_comments} via foreign key
/// - Denormalizes article reference from {@link discussion_board_articles}
/// - Denormalizes member reference from {@link discussion_board_members}
///
/// @namespace Comments
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_comment_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// References the parent comment {@link discussion_board_comments.id} that
  /// this snapshot belongs to.
  discussion_board_comment_id String
  
  /// Denormalized reference to the article this comment belongs to, captured
  /// at snapshot time.
  discussion_board_article_id String
  
  /// Denormalized reference to the member who authored this comment, captured
  /// at snapshot time.
  discussion_board_member_id String
  
  /// The text content of the comment at the time of snapshot.
  content String
  
  /// When the comment was originally created, captured at snapshot time.
  created_at DateTime
  
  /// When the comment was last updated, captured at snapshot time.
  updated_at DateTime
  
  /// Timestamp when this specific snapshot was taken.
  snapshot_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  comment discussion_board_comments @relation(fields: [discussion_board_comment_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([discussion_board_comment_id, snapshot_at], map: "discussion_board_comment_snapshots_discussion_board_co_bdc697c9")
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, snapshot_at], map: "discussion_board_comment_snapshots_discussion_board_ar_250b4d1d")
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_id, snapshot_at], map: "discussion_board_comment_snapshots_discussion_board_me_6c48b095")
}