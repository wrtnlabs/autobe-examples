/// Main entity storing article content for the discussion board platform.
///
/// Articles are the primary content units that users create, organize by
/// sections, and engage with through comments. Each article contains a title
/// and full text content, belongs to exactly one section, and is authored by
/// a registered member.
///
/// Key relationships:
/// - Belongs to a {@link discussion_board_sections} for organizational
/// categorization
/// - Owned by a {@link discussion_board_members} who created it
/// - Created through a {@link discussion_board_member_sessions} for audit trail
/// - Has many {@link discussion_board_comments} (handled in Comments component)
/// - Has many attachments (handled in Attachments component)
/// - Has many {@link discussion_board_tags} via junction table (handled in
/// Tags component)
///
/// Articles support soft deletion to preserve historical data while removing
/// from active listings. Administrators can delete any article regardless of
/// authorship for content moderation purposes.
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_articles {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged section's {@link discussion_board_sections.id}. Every article
  /// must be assigned to exactly one section for organizational
  /// categorization.
  discussion_board_section_id String
  
  /// Author member's {@link discussion_board_members.id}. Tracks which
  /// registered user created and owns this article.
  discussion_board_member_id String
  
  /// Creation session's {@link discussion_board_member_sessions.id}. Records
  /// the authentication session used when creating the article for audit
  /// purposes.
  discussion_board_member_session_id String
  
  /// Article title. Required field that identifies the article in listings and
  /// search results.
  title String
  
  /// Full text content of the article. Required field containing the main body
  /// text.
  content String
  
  /// Timestamp when the article was first created. Used for chronological
  /// sorting and display.
  created_at DateTime
  
  /// Timestamp when the article was last modified. Updated on every edit
  /// operation.
  updated_at DateTime
  
  /// Timestamp when the article was soft-deleted. Null indicates the article
  /// is active. Used for soft deletion to preserve historical data.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  section discussion_board_sections @relation(fields: [discussion_board_section_id], references: [id], onDelete: Cascade)
  author discussion_board_members @relation(fields: [discussion_board_member_id], references: [id], onDelete: Cascade)
  creationSession discussion_board_member_sessions @relation(fields: [discussion_board_member_session_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots discussion_board_article_snapshots[]
  views discussion_board_article_views[]
  comments discussion_board_comments[]
  articleTags discussion_board_article_tags[]
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_session_id], map: "discussion_board_articles_discussion_board_member_sess_6b82e9c5")
  // spellchecker: ignore-next-line
  @@index([discussion_board_section_id, created_at], map: "discussion_board_articles_discussion_board_section_id__cb7d94c3")
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_id, created_at], map: "discussion_board_articles_discussion_board_member_id_c_f434e708")
  @@index([deleted_at, created_at])
}

/// Point-in-time snapshots of articles for audit trail and revision history.
///
/// This table captures the complete state of an article at specific moments
/// in time, enabling:
///
/// - **Audit Trail**: Track all modifications made to articles over time
/// - **Revision History**: View previous versions of article content
/// - **Accountability**: Maintain record of what content existed when
///
/// Each snapshot is created when an article is modified (title, content,
/// section assignment, or author changes). Snapshots are immutable
/// historical records that preserve the exact state of the article at the
/// time of capture.
///
/// **Key Relationships**:
/// - References {@link discussion_board_articles.id} as the parent article
/// being snapshot
/// - References {@link discussion_board_members.id} as the article author at
/// snapshot time
/// - References {@link discussion_board_sections.id} as the section
/// assignment at snapshot time
/// - References {@link discussion_board_member_sessions.id} as the session
/// context at snapshot time
///
/// **Business Context**:
/// - Snapshots are append-only and never modified or deleted
/// - Multiple snapshots exist per article (one per modification event)
/// - Used for compliance, auditing, and potential content restoration
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_article_snapshots {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Parent article's {@link discussion_board_articles.id} that this snapshot
  /// captures.
  discussion_board_article_id String
  
  /// Article author's {@link discussion_board_members.id} at the time of
  /// snapshot.
  discussion_board_member_id String
  
  /// Article section's {@link discussion_board_sections.id} at the time of
  /// snapshot.
  discussion_board_section_id String
  
  /// Session's {@link discussion_board_member_sessions.id} used when the
  /// article was modified, captured for audit trail.
  discussion_board_member_session_id String?
  
  /// Article title captured at snapshot time.
  title String
  
  /// Article content captured at snapshot time.
  content String
  
  /// Timestamp when this snapshot was created.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  author discussion_board_members @relation(fields: [discussion_board_member_id], references: [id], onDelete: Cascade)
  section discussion_board_sections @relation(fields: [discussion_board_section_id], references: [id], onDelete: Cascade)
  session discussion_board_member_sessions? @relation(fields: [discussion_board_member_session_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_id], map: "discussion_board_article_snapshots_discussion_board_me_4bce7da7")
  // spellchecker: ignore-next-line
  @@index([discussion_board_section_id], map: "discussion_board_article_snapshots_discussion_board_se_46d007f4")
  // spellchecker: ignore-next-line
  @@unique([discussion_board_article_id, created_at], map: "discussion_board_article_snapshots_discussion_board_ar_1ada2369")
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_session_id], map: "discussion_board_article_snapshots_discussion_board_me_d93eac52")
}

/// Individual view events for articles, tracking when and by whom articles
/// were accessed.
///
/// This table records each view event to enable engagement analytics,
/// popular content identification, and user reading history. Each record
/// represents a single view occurrence, supporting both authenticated member
/// views and anonymous guest access.
///
/// Key relationships:
/// - References {@link discussion_board_articles.id} to identify which
/// article was viewed
/// - Optionally references {@link discussion_board_members.id} for
/// authenticated views
/// - Optionally references {@link discussion_board_member_sessions.id} to
/// track the session context
///
/// Used for:
/// - Analytics dashboards showing article popularity
/// - User reading history and recommendations
/// - Engagement metrics and trending content identification
///
/// @namespace Articles
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model discussion_board_article_views {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced article's {@link discussion_board_articles.id}.
  discussion_board_article_id String
  
  /// Viewing member's {@link discussion_board_members.id}, null for guest
  /// views.
  discussion_board_member_id String?
  
  /// Viewing session's {@link discussion_board_member_sessions.id}, null for
  /// guest views.
  discussion_board_member_session_id String?
  
  /// Timestamp when the article was viewed.
  viewed_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  article discussion_board_articles @relation(fields: [discussion_board_article_id], references: [id], onDelete: Cascade)
  member discussion_board_members? @relation(fields: [discussion_board_member_id], references: [id], onDelete: Cascade)
  memberSession discussion_board_member_sessions? @relation(fields: [discussion_board_member_session_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_session_id], map: "discussion_board_article_views_discussion_board_member_75e1af6c")
  // spellchecker: ignore-next-line
  @@index([discussion_board_article_id, viewed_at], map: "discussion_board_article_views_discussion_board_articl_4a3b96a7")
  // spellchecker: ignore-next-line
  @@index([discussion_board_member_id, viewed_at], map: "discussion_board_article_views_discussion_board_member_1c489dba")
}