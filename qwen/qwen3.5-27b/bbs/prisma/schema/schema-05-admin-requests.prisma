  status String
  
  /// Timestamp when the member submitted this admin privilege request.
  submitted_at DateTime
  
  /// Timestamp when the super administrator reviewed and made a decision on
  /// this request. Null for pending requests.
  reviewed_at DateTime?
  
  /// Timestamp when this record was created in the database.
  created_at DateTime
  
  /// Timestamp when this record was last modified.
  updated_at DateTime
  
