/// Core todo entity storing task information for member users.
///
/// This table represents individual todo items that members create to track
/// their tasks and responsibilities. Each todo contains a required title,
/// optional description and dates (start date, due date), completion status,
/// and soft delete flag for trash management.
///
/// Key relationships:
/// - Owned by {@link multi_user_todo_members} through member_id foreign key
/// - Has edit history entries in {@link multi_user_todo_todo_edit_histories}
/// for audit tracking
///
/// Business behaviors:
/// - Newly created todos are incomplete by default (completed=false)
/// - Soft delete moves todos to trash (deleted=true) rather than permanent
/// removal
/// - Todos can be restored from trash by setting deleted=false
/// - Only the owning member can access, modify, or delete their todos
///
/// @namespace Todos
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model multi_user_todo_todos {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged member's {@link multi_user_todo_members.id}. Establishes
  /// ownership of the todo item.
  multi_user_todo_member_id String
  
  /// Required task name or title. Cannot be empty.
  title String
  
  /// Optional task details or description. Can be left empty.
  description String?
  
  /// Optional start date for the task. Can be left empty.
  start_date DateTime?
  
  /// Optional due date for the task. Can be left empty.
  due_date DateTime?
  
  /// Completion status of the todo. False indicates incomplete, true indicates
  /// complete.
  completed Boolean
  
  /// Soft delete flag. False indicates active todo, true indicates todo is in
  /// trash.
  deleted Boolean
  
  /// Timestamp when the todo was created.
  created_at DateTime
  
  /// Timestamp when the todo was last updated.
  updated_at DateTime
  
  /// Timestamp when the todo was soft deleted (moved to trash). Null when todo
  /// is active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  member multi_user_todo_members @relation(fields: [multi_user_todo_member_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  editHistories multi_user_todo_todo_edit_histories[]
  
  //----
  // INDEXES
  //----
  @@index([multi_user_todo_member_id, created_at])
  @@index([multi_user_todo_member_id, start_date])
  @@index([multi_user_todo_member_id, due_date])
  @@index([multi_user_todo_member_id, completed])
  @@index([multi_user_todo_member_id, deleted])
}

/// Edit history audit trail for tracking all modifications to todos.
///
/// This table maintains a complete audit log of every field change made to
/// todo items. Each record represents a single field modification, capturing
/// the field name, previous value, and new value. This normalized design
/// enables efficient storage and retrieval of edit history while maintaining
/// full change tracking capability.
///
/// Key relationships:
/// - Belongs to a single {@link multi_user_todo_todos} item
/// - Each row represents exactly one field change (key-value pattern)
/// - Supports edit history viewing and audit compliance requirements
///
/// @namespace Todos
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model multi_user_todo_todo_edit_histories {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Reference to the todo item that was edited. {@link
  /// multi_user_todo_todos.id}
  multi_user_todo_todos_id String
  
  /// Timestamp when this edit occurred.
  edit_timestamp DateTime
  
  /// Name of the field that was changed (e.g., 'title', 'description',
  /// 'start_date', 'due_date', 'completed').
  field_name String
  
  /// Previous value of the field before the edit. Stored as string for
  /// flexibility across different field types.
  old_value String?
  
  /// New value of the field after the edit. Stored as string for flexibility
  /// across different field types.
  new_value String
  
  /// Record creation timestamp.
  created_at DateTime
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  todo multi_user_todo_todos @relation(fields: [multi_user_todo_todos_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([multi_user_todo_todos_id, edit_timestamp], map: "multi_user_todo_todo_edit_histories_multi_user_todo_to_05db6d09")
}