  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  orderItemSnapshot shopping_mall_order_item_snapshots @relation(fields: [shopping_mall_order_item_snapshot_id], references: [id], onDelete: Cascade)
  
