/// Customer wishlist items that link customers to products they want to
/// purchase later.
///
/// This table implements a many-to-many relationship between {@link
/// shopping_mall_customers} and products, allowing customers to bookmark
/// products of interest for future purchase consideration. Each wishlist
/// entry records when a customer added a product to their wishlist.
///
/// **Key behaviors**:
/// - One customer can wishlist multiple products
/// - One product can be wishlisted by multiple customers
/// - Duplicate wishlist entries are prevented by unique constraint
/// - When a product is deleted by a seller, wishlist entries are soft-deleted
/// - Customers can view, add to, and remove items from their own wishlist
///
/// **Related entities**:
/// - {@link shopping_mall_customers} - The customer who created the wishlist
/// item
/// - {@link shopping_mall_wishlist_item_snapshots} - Audit trail of wishlist
/// changes
///
/// @namespace Wishlists
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model shopping_mall_wishlist_items {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged customer's {@link shopping_mall_customers.id}.
  shopping_mall_customer_id String
  
  /// Timestamp when the product was added to the customer's wishlist.
  created_at DateTime
  
  /// Timestamp when the wishlist item was last updated.
  updated_at DateTime
  
  /// Timestamp when the wishlist item was soft-deleted. Null means the item is
  /// active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  customer shopping_mall_customers @relation(fields: [shopping_mall_customer_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots shopping_mall_wishlist_item_snapshots[]
  
  //----
  // INDEXES
  //----
  // spellchecker: ignore-next-line
  @@index([shopping_mall_customer_id, created_at], map: "shopping_mall_wishlist_items_shopping_mall_customer_id_dcbce088")
}

