  employee hrm_time_track_employees? @relation(fields: [hrm_time_track_employee_id], references: [id], onDelete: Cascade)
  project hrm_time_track_projects? @relation(fields: [hrm_time_track_project_id], references: [id], onDelete: Cascade)
  task hrm_time_track_tasks? @relation(fields: [hrm_time_track_task_id], references: [id], onDelete: Cascade)
  timesheet hrm_time_track_timesheets? @relation(fields: [hrm_time_track_timesheet_id], references: [id], onDelete: Cascade)
  role hrm_time_track_roles? @relation(fields: [hrm_time_track_role_id], references: [id], onDelete: Cascade)
  employeeContract hrm_time_track_employee_contracts? @relation(fields: [hrm_time_track_employee_contract_id], references: [id], onDelete: Cascade)
  department hrm_time_track_departments? @relation(fields: [hrm_time_track_department_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([hrm_time_track_member_id])
  @@index([hrm_time_track_employee_id])
  @@index([hrm_time_track_project_id])
  @@index([hrm_time_track_task_id])
  @@index([hrm_time_track_timesheet_id])
  @@index([hrm_time_track_role_id])
  // spellchecker: ignore-next-line
