/// Main task entity representing discrete work units within projects. Tasks
/// are the smallest unit of work tracking with status progression, priority
/// classification, and optional subtask relationships.
///
/// Tasks belong to projects and can be assigned to employees who are members
/// of that project. Each task may have an optional parent task for one-level
/// subtask hierarchy (subtasks cannot have their own subtasks). Task status
/// changes are automatically recorded in {@link hrm_platform_task_histories}
/// for audit trail purposes.
///
/// Key relationships:
/// - Belongs to exactly one {@link hrm_platform_projects}
/// - Optionally assigned to one {@link hrm_platform_employees} (must be
/// project member)
/// - Optionally has one parent {@link hrm_platform_tasks} (for subtasks)
/// - Has many child subtasks (through self-referential relationship)
/// - Has many {@link hrm_platform_task_histories} entries for status change
/// audit
/// - Has many {@link hrm_platform_task_snapshots} for point-in-time state
/// preservation
/// - Created by a {@link hrm_platform_members} for audit trail
///
/// Tasks support optional due dates for deadline tracking and estimated
/// hours for effort planning. The status field tracks task progression
/// through the workflow lifecycle.
///
/// @namespace Task
/// @author AutoBE - https://github.com/wrtnlabs/autobe
model hrm_platform_tasks {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Belonged project's {@link hrm_platform_projects.id}. Tasks must belong to
  /// exactly one project.
  hrm_platform_project_id String
  
  /// Assigned employee's {@link hrm_platform_employees.id}. Optional - task
  /// may remain unassigned. Employee must be a member of the project
  /// containing this task.
  assigned_employee_id String?
  
  /// Parent task's {@link hrm_platform_tasks.id}. Optional - if set, this task
  /// is a subtask of the parent. Subtasks cannot have their own subtasks (one
  /// level only).
  parent_task_id String?
  
  /// Creator member's {@link hrm_platform_members.id}. Tracks which
  /// authenticated member created this task for audit purposes.
  created_by_member_id String
  
  /// Task title or name. Required field that identifies the work item.
  title String
  
  /// Detailed description of the task work. Optional field providing
  /// additional context.
  description String?
  
  /// Current task status tracking workflow progression. Valid values depend on
  /// task status workflow configuration.
  status String
  
  /// Task priority classification for work ordering. Valid values defined in
  /// priority classification business rules.
  priority String
  
  /// Optional due date when the task should be completed. Used for planning
  /// and deadline tracking.
  due_date DateTime?
  
  /// Optional estimated hours representing anticipated time required to
  /// complete the task. Used for effort planning and capacity management.
  estimated_hours Float?
  
  /// Timestamp when the task was created.
  created_at DateTime
  
  /// Timestamp when the task was last updated.
  updated_at DateTime
  
  /// Timestamp when the task was soft deleted. Null means task is active.
  deleted_at DateTime?
  
  //----
  // BELONGED RELATIONS,
  //   - format: (propertyKey targetModel constraint)
  //----
  project hrm_platform_projects @relation(fields: [hrm_platform_project_id], references: [id], onDelete: Cascade)
  assignedEmployee hrm_platform_employees? @relation(fields: [assigned_employee_id], references: [id], onDelete: Cascade)
  parentTask hrm_platform_tasks? @relation("recursive", fields: [parent_task_id], references: [id], onDelete: Cascade)
  createdByMember hrm_platform_members @relation(fields: [created_by_member_id], references: [id], onDelete: Cascade)
  
  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  subtasks hrm_platform_tasks[] @relation("recursive")
  taskHistories hrm_platform_task_histories[]
  snapshots hrm_platform_task_snapshots[] @relation("hrm_platform_task_snapshots_of_hrm_platform_task_id")
  subtaskSnapshots hrm_platform_task_snapshots[] @relation("hrm_platform_task_snapshots_of_hrm_platform_task_parent_id")
  timers hrm_platform_timers[]
  timelogs hrm_platform_timelogs[]
  
  //----
  // INDEXES
  //----
  @@index([created_by_member_id])
  @@index([hrm_platform_project_id, status])
  @@index([assigned_employee_id, status])
  @@index([parent_task_id])
  @@index([created_at])
