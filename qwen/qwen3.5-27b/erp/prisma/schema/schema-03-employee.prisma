  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Referenced employee record's {@link hrm_platform_employees.id}. Each
  /// snapshot corresponds to exactly one employee record change.
  employees_id String
  
  /// Organization's {@link hrm_platform_organizations.id} where the employee
  /// works, captured at snapshot time.
  organizations_id String
  
  /// User's {@link hrm_platform_members.id} associated with this employee
  /// record, captured at snapshot time.
  members_id String
  
  /// Department's {@link hrm_platform_departments.id} where the employee is
  /// assigned, captured at snapshot time. Nullable if employee had no
  /// department assignment.
  departments_id String?
  
  /// Role's {@link hrm_platform_roles.id} assigned to the employee, captured
  /// at snapshot time.
  roles_id String
  
  /// Employment classification at snapshot time. Valid values: full-time,
  /// part-time, contractor, intern.
  employment_type String
  
  /// Employee status at snapshot time. Valid values: active, deactivated.
  status String
  
  /// Timestamp when this snapshot was created.
  created_at DateTime
  
  /// Original employee record creation timestamp, captured at snapshot time.
  employee_created_at DateTime
  
  /// Employee record last update timestamp, captured at snapshot time.
  employee_updated_at DateTime
  
  /// Employee record deletion timestamp, captured at snapshot time. Nullable
