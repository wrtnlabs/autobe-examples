///
/// Relationships:
/// - {@link hrm_platform_employees} - One snapshot per employee record
/// change (1:1 via unique constraint)
/// - {@link hrm_platform_organizations} - Organization context at snapshot time
/// - {@link hrm_platform_members} - User identity at snapshot time
/// - {@link hrm_platform_departments} - Department assignment at snapshot
/// time (nullable)
/// - {@link hrm_platform_roles} - Role assignment at snapshot time
///
/// @namespace Employee
/// @author AutoBE - https://github.com/wrtnlabs/autobe
