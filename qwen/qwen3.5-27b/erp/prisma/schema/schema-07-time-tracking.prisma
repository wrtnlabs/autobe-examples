  project hrm_platform_projects @relation(fields: [hrm_platform_project_id], references: [id], onDelete: Cascade)
  task hrm_platform_tasks? @relation(fields: [hrm_platform_task_id], references: [id], onDelete: Cascade)
  
  //----
  // INDEXES
  //----
  @@index([hrm_platform_project_id])
  @@index([hrm_platform_task_id])
  @@index([hrm_platform_employee_id, created_at])
}

/// Individual time entries recording work performed by employees on specific
