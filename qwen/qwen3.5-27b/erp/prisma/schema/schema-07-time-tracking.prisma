  //----
  // HAS RELATIONS
  //   - format: (propertyKey targetModel)
  //----
  snapshots hrm_platform_timesheet_snapshots[]
  
  //----
  // INDEXES
  //----
  @@index([approver_id])
  // spellchecker: ignore-next-line
