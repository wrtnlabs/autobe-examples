model hrm_platform_timers {
  //----
  // COLUMNS
  //----
  /// Primary Key.
  id String @id
  
  /// Employee who owns this timer session. Only one active timer allowed per
  /// employee at any time. {@link hrm_platform_employees.id}
  hrm_platform_employee_id String
  
  /// Project against which time is being tracked. Required for all timer
  /// sessions. {@link hrm_platform_projects.id}
  hrm_platform_project_id String
  
  /// Optional specific task within the project. Allows granular time tracking
  /// against individual work items. {@link hrm_platform_tasks.id}
  hrm_platform_task_id String?
  
  /// Optional description of work being performed during this timer session.
  description String?
  
  /// Timestamp when the timer was started and began tracking time.
  started_at DateTime
  
  /// Timestamp when the timer was stopped. Null while timer is actively
  /// running.
  stopped_at DateTime?
  
